---
import LayoutV2 from '../../../layouts/LayoutV2.astro';
import CTA from '../../../components/v2/CTA.astro';

// Primary keyword: "Web stranica za lokalne tvrtke"
// Placed in: slug, title, description, H1, and first line of body content.
const canonicalUrl = 'https://www.creativecomplete.com/hr/usluge/web-stranica-za-lokalne-tvrtke/';

const hreflangAlternates = {
  en: 'https://creativecomplete.com/services/local-business-website-development/',
  de: 'https://www.creativecomplete.com/de/dienstleistungen/website-fuer-lokale-unternehmen/',
  sl: 'https://www.creativecomplete.com/sl/storitve/spletna-stran-za-lokalna-podjetja/',
  hr: canonicalUrl,
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Web stranica za lokalne tvrtke",
      "description": "Web stranica za lokalne tvrtke koja spaja dizajn za konverzije, lokalni SEO, sustav za online rezervacije i automatizirano praćenje. Jedna stranica koja se pronalazi, rezervira poslove i sama prati kontakte.",
      "url": canonicalUrl,
      "provider": { "@type": "Organization", "name": "CreativeComplete", "url": "https://www.creativecomplete.com/" },
      "serviceType": "Izrada web stranica za lokalne tvrtke",
      "areaServed": ["HR", "BA", "RS", "ME"],
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Početna", "item": "https://www.creativecomplete.com/hr/" },
        { "@type": "ListItem", "position": 2, "name": "Usluge", "item": "https://www.creativecomplete.com/hr/usluge/" },
        { "@type": "ListItem", "position": 3, "name": "Web stranica za lokalne tvrtke", "item": canonicalUrl },
      ]
    },
  ]
};

const metrics = [
  { value: '312%', label: 'Više dolaznih poziva' },
  { value: 'Top 3', label: 'Postignut plasman na Google kartama' },
  { value: '24/7', label: 'Rezervacije rade automatski' },
  { value: '< 2s', label: 'Vrijeme učitavanja na mobitelu' },
];

const pillars = [
  {
    tag: 'Dizajn',
    title: 'Dizajn za konverzije',
    desc: 'Brza, mobilnim uređajima prilagođena stranica s jednim zadatkom: pretvoriti posjetitelja u rezerviranog klijenta. Jasne usluge, klik za poziv na svakom zaslonu i signali povjerenja gdje je važno. Ne lijepa brošura koja samo stoji.',
    icon: 'M12 2l7 4v6c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-4z',
  },
  {
    tag: 'Lokalni SEO',
    title: 'Lokalni SEO i Google poslovni profil',
    desc: 'Postavljamo vas među rezultate na Google kartama, gdje klijenti u vašoj blizini zaista traže. Postavljanje Google poslovnog profila, stranice za svako područje koje pokrivate i lokalni signali koji vas čine vidljivima za pretrage "u blizini".',
    icon: 'M12 21s-7-5.2-7-11a7 7 0 0114 0c0 5.8-7 11-7 11z M12 10a2 2 0 100-4 2 2 0 000 4z',
  },
  {
    tag: 'Rezervacije',
    title: 'Sustav za online rezervacije',
    desc: 'Klijenti rezerviraju izravno u vaš kalendar, u ponoć, nedjeljom, kad god odluče. Bez telefonskog dogovaranja, bez propuštenih poziva, bez izgubljenih upita jer se nitko nije javio. Stranica dogovara termin umjesto vas.',
    icon: 'M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z',
  },
  {
    tag: 'Automatizacija',
    title: 'Automatizirano praćenje',
    desc: 'Novi upiti dobivaju trenutačan odgovor. Rezervirani klijenti dobivaju podsjetnike da se stvarno pojave. Završeni poslovi pokreću zamolbu za recenziju koja automatski gradi vašu Google ocjenu. Posao koji obično propada kroz pukotine odrađuje se sam.',
    icon: 'M4 4v6h6M20 20v-6h-6M20 4a9 9 0 00-15 4M4 20a9 9 0 0015-4',
  },
];

const compare = [
  { label: 'Pojavljuje se na Google kartama pri lokalnim pretragama', them: false, you: true },
  { label: 'Prima rezervacije 24/7 bez telefonskog poziva', them: false, you: true },
  { label: 'Odmah odgovara na nove upite', them: false, you: true },
  { label: 'Automatski prikuplja Google recenzije', them: false, you: true },
  { label: 'Učitava se na mobitelu za manje od 2 sekunde', them: false, you: true },
  { label: 'Građena za konverzije, ne samo za lijep izgled', them: false, you: true },
];

const steps = [
  { n: '01', title: 'Analiza i plan', desc: 'Pogledamo kako se pojavljujete danas: vašu trenutnu stranicu, vaš Google poslovni profil i što vide klijenti u vašoj blizini kad traže ono što radite. Zatim iscrtamo točan sustav koji vaša tvrtka treba.' },
  { n: '02', title: 'Izrada web stranice', desc: 'Dizajniramo i gradimo brzu, mobilnim uređajima prilagođenu stranicu koja se učitava za manje od dvije sekunde i građena je za konverzije. Jasne usluge, snažni pozivi na akciju i sustav za rezervacije ugrađen od prvog dana.' },
  { n: '03', title: 'Postavljanje lokalnog SEO-a i rezervacija', desc: 'Optimiziramo vaš Google poslovni profil, izrađujemo stranice za svako područje koje pokrivate i povezujemo online rezervacije s vašim kalendarom. Upravo to čini da vas pronađu i rezerviraju.' },
  { n: '04', title: 'Automatizacija i pokretanje', desc: 'Trenutačni odgovori, podsjetnici za termine i automatske zamolbe za recenziju idu uživo. Krećete sa stranicom koja pronalazi klijente, rezervira ih i prati ih, dok vi radite stvarni posao.' },
];

const faqItems = [
  { name: "Što točno uključuje web stranica za lokalne tvrtke?", answer: "To su četiri stvari u jednoj izradi: stranica za konverzije, lokalni SEO s postavljanjem Google poslovnog profila, sustav za online rezervacije povezan s vašim kalendarom i automatizirano praćenje upita, podsjetnika i recenzija. Većina agencija proda vam stranicu i tu stane. Mi gradimo cijeli sustav, tako da stranica zaista donosi posao." },
  { name: "Već imam web stranicu. Zašto mi ne donosi klijente?", answer: "Većina lokalnih stranica su digitalne posjetnice. Izgledaju dobro, ali se ne plasiraju na Google kartama, ne mogu primiti rezervaciju i nikad ne prate kontakte. Zato ljudi prvo pronađu vašu konkurenciju, rezerviraju kod onoga tko se javi, a vaša stranica ostaje tiha. Popravljamo dijelove koji donose klijente, ne samo one koje gledate." },
  { name: "Po čemu se ovo razlikuje od vaše usluge web dizajna?", answer: "Web dizajn je jedan dio. Ovo je cijeli paket za lokalnu uslužnu tvrtku: dizajn plus lokalni SEO plus rezervacije plus automatizacija, izgrađeni tako da rade zajedno. Ako želite stranicu koja se lokalno plasira i sama rezervira poslove, ovo je pravi izbor." },
  { name: "Koliko traje izrada?", answer: "Većina projekata ide uživo za 3 do 6 tjedana, ovisno o tome koliko lokacija pokrivate i koliko sadržaja imate na početku. Radimo u fazama, tako da osnovna stranica može krenuti prva, a stranice lokacija i automatizacija dodaju se kasnije." },
  { name: "Radite li i s tvrtkama koje uopće nemaju online prisutnost?", answer: "Da, i to su često najbolji slučajevi. Švicarska tvrtka za čišćenje iz naše studije slučaja krenula je bez web stranice, bez Google poslovnog profila i bez recenzija. Za 90 dana bili su među prva tri na Google kartama s 312% više dolaznih poziva. Krenuti od nule je prednost, jer je svako poboljšanje brzo vidljivo." },
  { name: "Koliko košta?", answer: "Ovisi o tome koliko lokacija pokrivate i koliko automatizacije trebate. Rezervirajte besplatan poziv i iscrtat ćemo točan sustav za vašu tvrtku te vam dati fiksnu cijenu. Bez zamke pretplate, bez iznenađenja." },
];
---

<LayoutV2
  lang="hr"
  title="Web stranica za lokalne tvrtke: dizajn, lokalni SEO i rezervacije | CreativeComplete"
  description="Web stranica za lokalne tvrtke koja spaja dizajn za konverzije, lokalni SEO, online rezervacije i automatizirano praćenje. Većina konkurenata nema ništa od toga. Pogledajte prave rezultate."
  {canonicalUrl}
  {structuredData}
  {hreflangAlternates}
  navActive="services"
>
  <main>
    <!-- Breadcrumb -->
    <div class="v2-container v2-bc">
      <a href="/hr/">Početna</a><span>/</span><a href="/hr/usluge/">Usluge</a><span>/</span>
      <span>Web stranica za lokalne tvrtke</span>
    </div>

    <!-- Hero -->
    <section class="svc-hero">
      <div class="v2-container svc-hero__inner">
        <span class="v2-eyebrow" data-m="fade">Web stranice za lokalne tvrtke</span>
        <h1 class="v2-h1 svc-h1" data-m="up">
          Web stranica za lokalne tvrtke<br><span class="v2-grad">koja pretragu pretvara u rezervirane poslove</span>
        </h1>
        <p class="v2-lead svc-lead" data-m="up">
          Web stranica za lokalne tvrtke koja radi više od lijepog izgleda. Dobivate dizajn za konverzije,
          lokalni SEO koji vas postavlja na Google karte, sustav za online rezervacije i automatizirano
          praćenje. To je upravo postava koju većina lokalnih tvrtki u vašem okruženju nema, zbog čega
          njihove stranice ostaju tihe, a telefon šuti.
        </p>
        <div class="svc-hero-actions" data-m="up">
          <a href="https://cal.com/kerim-alihodza-7u7w6q/30min" class="v2-btn v2-btn-primary">
            Rezervirajte besplatan poziv
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#primjer" class="v2-btn v2-btn-ghost">Pogledajte pravi rezultat</a>
        </div>
      </div>
    </section>

    <!-- Metrics -->
    <section class="v2-section svc-metrics-section">
      <div class="v2-container svc-content-center">
        <div class="svc-metrics m-stagger" style={`--cols:${metrics.length}`}>
          {metrics.map(m => (
            <div class="svc-metric" data-m="up">
              <div class="svc-metric__n">{m.value}</div>
              <div class="svc-metric__l">{m.label}</div>
            </div>
          ))}
        </div>
        <p class="lbw-metrics-note">Brojke iz nedavnog projekta za klijenta. Cijela studija slučaja je niže.</p>
      </div>
    </section>

    <!-- Problem -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Problem
          </span>
          <h2 class="svc-h2">Vaša stranica možda izgleda dobro, a ipak ne radi ništa</h2>
        </div>
        <div class="svc-prose">
          <p data-m="up">
            Stranica koja samo lijepo izgleda je digitalna posjetnica. Ne pronalaze je, ne može primiti
            rezervaciju i nikad ne prati kontakte. Zato samo stoji tamo, tiha, dok vi i dalje lovite posao
            teškim putem.
          </p>
          <p data-m="up" style="--m-d:0.08s">
            Evo kako to zapravo ide. Netko u vašoj blizini traži ono što radite. Pritisne prve tvrtke na
            Google kartama, nazove onoga tko se javi, i rezervira. To je cijela odluka i traje otprilike
            jednu minutu. Ako niste među tim prvim rezultatima, posao odlazi konkurentu prije nego ste i
            znali da postoji.
          </p>
          <p data-m="up" style="--m-d:0.16s">
            Većini lokalnih tvrtki nedostaju svi dijelovi koji dobivaju tu minutu. Bez plasmana na kartama,
            bez online rezervacija, bez trenutačnog odgovora, bez sustava recenzija. To nije mala praznina.
            To je razlika između stranice koja zarađuje i one koja samo postoji. I svaki tjedan dok ostane
            tako, pozivi i dalje odlaze drugamo.
          </p>
        </div>
      </div>
    </section>

    <!-- The System (4 pillars) -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Sustav
          </span>
          <h2 class="svc-h2">Četiri sustava, jedna stranica. Postava koju konkurencija preskače.</h2>
          <p class="svc-section-sub">Svaki dio je koristan sam za sebe. Zajedno tihu stranicu pretvaraju u onu koja pronalazi klijente, rezervira ih i vraća im se.</p>
        </div>
        <div class="lbw-pillars">
          {pillars.map((p, i) => (
            <div class="lbw-pillar v2-card" data-m="up" style={`--m-d:${i * 0.08}s`}>
              <div class="lbw-pillar__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={p.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="lbw-pillar__tag">{p.tag}</span>
              <h3 class="lbw-pillar__title">{p.title}</h3>
              <p class="lbw-pillar__desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Comparison -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 3H5a2 2 0 00-2 2v14a2 2 0 002 2h4M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Praznina
          </span>
          <h2 class="svc-h2">Većina lokalnih stranica vs. vaša</h2>
        </div>
        <div class="lbw-compare" data-m="up">
          <div class="lbw-compare__head">
            <div class="lbw-compare__feature"></div>
            <div class="lbw-compare__col lbw-compare__col--them">Većina lokalnih stranica</div>
            <div class="lbw-compare__col lbw-compare__col--you">Vaš novi sustav</div>
          </div>
          {compare.map(row => (
            <div class="lbw-compare__row">
              <div class="lbw-compare__feature">{row.label}</div>
              <div class="lbw-compare__cell lbw-compare__cell--them">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-label="Ne"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <div class="lbw-compare__cell lbw-compare__cell--you">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-label="Da"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Real example: Belags case study -->
    <section class="v2-section svc-content-section" style="padding-top:0" id="primjer">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Pravi rezultat
          </span>
          <h2 class="svc-h2">Prava lokalna tvrtka koja je napravila upravo ovo</h2>
          <p class="svc-section-sub">Belags-Oberflächenreinigung, tvrtka za čišćenje u Arbonu, Švicarska. Kad smo počeli: bez web stranice, bez Google poslovnog profila, bez recenzija. Ništa.</p>
        </div>

        <div class="lbw-case v2-card-grad" data-m="up">
          <div class="lbw-case__grid">
            <div class="lbw-case__side">
              <span class="lbw-case__label">Prije</span>
              <ul class="lbw-case__list lbw-case__list--before">
                <li>Bez web stranice, dakle bez ikakve mogućnosti plasmana</li>
                <li>Uopće nije na Google kartama</li>
                <li>Nula recenzija i nikakvog načina za njihovo prikupljanje</li>
                <li>Svaki novi klijent dolazio je preko preporuke</li>
              </ul>
            </div>
            <div class="lbw-case__side">
              <span class="lbw-case__label lbw-case__label--after">Poslije</span>
              <ul class="lbw-case__list lbw-case__list--after">
                <li>Brza stranica za konverzije s klikom za poziv</li>
                <li>Među prva tri na Google kartama za ciljane pretrage</li>
                <li>Stranice lokacija za 4 grada u regiji</li>
                <li>Automatske zamolbe za recenziju nakon svakog posla</li>
              </ul>
            </div>
          </div>
          <div class="lbw-case__result">
            <strong>312% više dolaznih poziva</strong> u roku od 90 dana od pokretanja, kod tvrtke koja
            prije uopće nije imala online prisutnost. Isti tim, ista kvaliteta rada. Jedino što se
            promijenilo bila je web stranica izgrađena da je pronađu i da rezervira.
          </div>
          <div class="lbw-case__actions">
            <a href="/hr/projekti/belags-oberflaechenreinigung-arbon-case-study/" class="v2-btn v2-btn-outline">
              Pročitajte cijelu studiju slučaja
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Steps -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Kako radi
          </span>
          <h2 class="svc-h2">Od nevidljivog do rezerviranog u 4 koraka</h2>
        </div>
        <div class="svc-steps">
          {steps.map((s, i) => (
            <div class="svc-step" data-m="up" style={`--m-d:${i * 0.1}s`}>
              <div class="svc-step__n">{s.n}</div>
              <div class="svc-step__body">
                <h3 class="svc-step__title">{s.title}</h3>
                <p class="svc-step__desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Pitanja
          </span>
          <h2 class="svc-h2">Česta pitanja</h2>
        </div>
        <div class="svc-faq">
          {faqItems.map((item, i) => (
            <details class="svc-faq__item" data-m="up" style={`--m-d:${i * 0.07}s`}>
              <summary class="svc-faq__q">{item.name}</summary>
              <p class="svc-faq__a">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTA
      lang="hr"
      headline="Stranica koja pronalazi klijente i rezervira ih"
      subline="Rezervirajte besplatan poziv. Pokazat ćemo vam točno gdje vaša trenutna postava gubi posao i iscrtati sustav koji to popravlja. Fiksna cijena, bez zamke pretplate."
    />
  </main>
</LayoutV2>

<style lang="scss" is:global>
  .v2-bc {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 24px;
    padding-bottom: 8px;
