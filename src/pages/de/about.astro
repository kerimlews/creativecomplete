    <!-- CTA Section -->
    <section class="about-cta section-padding">
      <div class="container">
        <div class="cta-content">
          <h2>Bereit, Ihr Geschäft zu transformieren?</h2>
          <p>
            Lassen Sie uns besprechen, wie wir Ihnen helfen können, Prozesse zu automatisieren, 
            individuelle Software zu entwickeln oder Wachstum für Ihr Unternehmen voranzutreiben.
          </p>
          <div class="cta-actions">
            <a href={getLocalizedUrl('/contact/', currentLang)} class="cta-button cta-primary cta-lg">
              Starten Sie Ihr Projekt
            </a>
            <a href={getLocalizedUrl('/projects/', currentLang)} class="cta-button cta-secondary cta-lg">
              Unsere Arbeit ansehen
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</LayoutV2>








