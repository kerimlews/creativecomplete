---
import LayoutV2 from '../../../layouts/LayoutV2.astro';
import CTA from '../../../components/v2/CTA.astro';

// Primary keyword: "Website für lokale Unternehmen"
// Placed in: slug, title, description, H1, and first line of body content.
const canonicalUrl = 'https://www.creativecomplete.com/de/dienstleistungen/website-fuer-lokale-unternehmen/';

const hreflangAlternates = {
  en: 'https://creativecomplete.com/services/local-business-website-development/',
  de: canonicalUrl,
  sl: 'https://www.creativecomplete.com/sl/storitve/spletna-stran-za-lokalna-podjetja/',
  hr: 'https://www.creativecomplete.com/hr/usluge/web-stranica-za-lokalne-tvrtke/',
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Website für lokale Unternehmen",
      "description": "Website für lokale Unternehmen, die konversionsstarkes Design, Local SEO, ein Online-Buchungssystem und automatisierte Nachverfolgung vereint. Eine Website, die gefunden wird, Termine bucht und selbstständig nachfasst.",
      "url": canonicalUrl,
      "provider": { "@type": "Organization", "name": "CreativeComplete", "url": "https://www.creativecomplete.com/" },
      "serviceType": "Website-Entwicklung für lokale Unternehmen",
      "areaServed": ["DE", "AT", "CH"],
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.creativecomplete.com/de/" },
        { "@type": "ListItem", "position": 2, "name": "Dienstleistungen", "item": "https://www.creativecomplete.com/de/dienstleistungen/" },
        { "@type": "ListItem", "position": 3, "name": "Website für lokale Unternehmen", "item": canonicalUrl },
      ]
    },
  ]
};

const metrics = [
  { value: '312%', label: 'Mehr eingehende Anrufe' },
  { value: 'Top 3', label: 'Erreichtes Google-Maps-Ranking' },
  { value: '24/7', label: 'Buchungen laufen automatisch' },
  { value: '< 2s', label: 'Ladezeit auf dem Handy' },
];

const pillars = [
  {
    tag: 'Design',
    title: 'Konversionsstarkes Design',
    desc: 'Eine schnelle, mobil-optimierte Website mit einem einzigen Ziel: aus einem Besucher einen gebuchten Kunden machen. Klare Leistungen, Klick-zum-Anrufen auf jedem Bildschirm und Vertrauenssignale an der richtigen Stelle. Keine hübsche Broschüre, die nur herumsteht.',
    icon: 'M12 2l7 4v6c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-4z',
  },
  {
    tag: 'Local SEO',
    title: 'Local SEO und Google Unternehmensprofil',
    desc: 'Wir bringen Sie in die Google-Maps-Ergebnisse, wo Kunden in Ihrer Nähe tatsächlich suchen. Einrichtung des Google Unternehmensprofils, Standortseiten für jedes Gebiet, das Sie bedienen, und die lokalen Signale, die Sie bei "in der Nähe"-Suchen sichtbar machen.',
    icon: 'M12 21s-7-5.2-7-11a7 7 0 0114 0c0 5.8-7 11-7 11z M12 10a2 2 0 100-4 2 2 0 000 4z',
  },
  {
    tag: 'Buchung',
    title: 'Online-Buchungssystem',
    desc: 'Kunden buchen direkt in Ihren Kalender, um Mitternacht, an einem Sonntag, wann immer sie sich entscheiden. Kein Telefon-Pingpong, keine verpassten Anrufe, keine verlorenen Anfragen, weil niemand abgenommen hat. Die Website schließt den Termin für Sie ab.',
    icon: 'M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z',
  },
  {
    tag: 'Automatisierung',
    title: 'Automatisierte Nachverfolgung',
    desc: 'Neue Anfragen erhalten eine sofortige Antwort. Gebuchte Kunden bekommen Erinnerungen, damit sie auch erscheinen. Abgeschlossene Aufträge lösen eine Bewertungsanfrage aus, die Ihr Google-Rating automatisch aufbaut. Die Arbeit, die sonst untergeht, erledigt sich von selbst.',
    icon: 'M4 4v6h6M20 20v-6h-6M20 4a9 9 0 00-15 4M4 20a9 9 0 0015-4',
  },
];

const compare = [
  { label: 'Erscheint bei lokalen Suchen in Google Maps', them: false, you: true },
  { label: 'Nimmt Buchungen rund um die Uhr ohne Anruf entgegen', them: false, you: true },
  { label: 'Antwortet sofort auf neue Anfragen', them: false, you: true },
  { label: 'Sammelt automatisch Google-Bewertungen', them: false, you: true },
  { label: 'Lädt auf dem Handy in unter 2 Sekunden', them: false, you: true },
  { label: 'Gebaut, um zu konvertieren, nicht nur um schön auszusehen', them: false, you: true },
];

const steps = [
  { n: '01', title: 'Analyse und Plan', desc: 'Wir schauen uns an, wie Sie heute auftreten: Ihre aktuelle Website, Ihr Google Unternehmensprofil und was Kunden in Ihrer Nähe sehen, wenn sie nach Ihrer Leistung suchen. Dann erstellen wir das genaue System, das Ihr Unternehmen braucht.' },
  { n: '02', title: 'Website bauen', desc: 'Wir gestalten und bauen eine schnelle, mobil-optimierte Website, die in unter zwei Sekunden lädt und auf Konversion ausgelegt ist. Klare Leistungen, starke Handlungsaufforderungen und das Buchungssystem von Anfang an integriert.' },
  { n: '03', title: 'Local SEO und Buchung einrichten', desc: 'Wir optimieren Ihr Google Unternehmensprofil, erstellen Standortseiten für jedes Gebiet, das Sie bedienen, und verbinden die Online-Buchung mit Ihrem Kalender. Genau das sorgt dafür, dass Sie gefunden und gebucht werden.' },
  { n: '04', title: 'Automatisieren und live gehen', desc: 'Sofortantworten, Terminerinnerungen und automatische Bewertungsanfragen gehen live. Sie starten mit einer Website, die Kunden findet, sie bucht und nachfasst, während Sie die eigentliche Arbeit machen.' },
];

const faqItems = [
  { name: "Was umfasst die Website für lokale Unternehmen genau?", answer: "Es sind vier Dinge in einem Aufbau: eine konversionsstarke Website, Local SEO mit Einrichtung des Google Unternehmensprofils, ein Online-Buchungssystem, das mit Ihrem Kalender verbunden ist, und automatisierte Nachverfolgung für Anfragen, Erinnerungen und Bewertungen. Die meisten Agenturen verkaufen Ihnen die Website und hören da auf. Wir bauen das ganze System, damit die Website tatsächlich Aufträge bringt." },
  { name: "Ich habe bereits eine Website. Warum bringt sie keine Kunden?", answer: "Die meisten lokalen Websites sind digitale Visitenkarten. Sie sehen gut aus, aber sie ranken nicht in Google Maps, können keine Buchung entgegennehmen und fassen nie nach. Also finden die Leute zuerst Ihren Mitbewerber, buchen bei dem, der abnimmt, und Ihre Website bleibt still. Wir reparieren die Teile, die Kunden bringen, nicht nur die Teile, die Sie ansehen." },
  { name: "Wie unterscheidet sich das von Ihrem Webdesign-Angebot?", answer: "Webdesign ist ein Baustein. Das hier ist das Komplettpaket für ein lokales Dienstleistungsunternehmen: Design plus Local SEO plus Buchung plus Automatisierung, aufeinander abgestimmt. Wenn Sie eine Website wollen, die lokal rankt und selbstständig Aufträge bucht, dann ist das die richtige." },
  { name: "Wie lange dauert der Aufbau?", answer: "Die meisten Projekte gehen in 3 bis 6 Wochen live, je nachdem, wie viele Standorte Sie bedienen und wie viel Inhalt bereits vorhanden ist. Wir arbeiten in Phasen, sodass die Kernwebsite zuerst starten kann und Standortseiten sowie Automatisierung danach ergänzt werden." },
  { name: "Arbeiten Sie auch mit Unternehmen ohne jegliche Online-Präsenz?", answer: "Ja, und das sind oft die besten Fälle. Das Schweizer Reinigungsunternehmen in unserer Fallstudie startete ohne Website, ohne Google Unternehmensprofil und ohne Bewertungen. Innerhalb von 90 Tagen waren sie in den Top 3 bei Google Maps mit 312% mehr eingehenden Anrufen. Bei null zu starten ist ein Vorteil, weil jede Verbesserung schnell sichtbar wird." },
  { name: "Was kostet das?", answer: "Das hängt davon ab, wie viele Standorte Sie bedienen und wie viel Automatisierung Sie brauchen. Buchen Sie ein kostenloses Gespräch und wir erstellen das genaue System für Ihr Unternehmen und nennen Ihnen einen Festpreis. Keine Abo-Falle, keine Überraschungen." },
];
---

<LayoutV2
  lang="de"
  title="Website für lokale Unternehmen: Design, Local SEO & Buchung | CreativeComplete"
  description="Website für lokale Unternehmen, die konversionsstarkes Design, Local SEO, Online-Buchung und automatisierte Nachverfolgung vereint. Die meisten Mitbewerber haben nichts davon. Echte Ergebnisse ansehen."
  {canonicalUrl}
  {structuredData}
  {hreflangAlternates}
  navActive="services"
>
  <main>
    <!-- Breadcrumb -->
    <div class="v2-container v2-bc">
      <a href="/de/">Home</a><span>/</span><a href="/de/dienstleistungen/">Dienstleistungen</a><span>/</span>
      <span>Website für lokale Unternehmen</span>
    </div>

    <!-- Hero -->
    <section class="svc-hero">
      <div class="v2-container svc-hero__inner">
        <span class="v2-eyebrow" data-m="fade">Websites für lokale Unternehmen</span>
        <h1 class="v2-h1 svc-h1" data-m="up">
          Website für lokale Unternehmen<br><span class="v2-grad">die aus Suchanfragen gebuchte Aufträge macht</span>
        </h1>
        <p class="v2-lead svc-lead" data-m="up">
          Website für lokale Unternehmen, die mehr kann als nur gut aussehen. Sie bekommen
          konversionsstarkes Design, Local SEO, das Sie auf Google Maps bringt, ein Online-Buchungssystem
          und automatisierte Nachverfolgung. Es ist genau der Aufbau, den die meisten lokalen Unternehmen
          in Ihrer Umgebung nicht haben, weshalb ihre Websites still bleiben, während ihr Telefon nicht klingelt.
        </p>
        <div class="svc-hero-actions" data-m="up">
          <a href="https://cal.com/kerim-alihodza-7u7w6q/30min" class="v2-btn v2-btn-primary">
            Kostenloses Gespräch buchen
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#beispiel" class="v2-btn v2-btn-ghost">Echtes Ergebnis ansehen</a>
        </div>
      </div>
    </section>

    <!-- Metrics -->
    <section class="v2-section svc-metrics-section">
      <div class="v2-container svc-content-center">
        <div class="svc-metrics m-stagger" style={`--cols:${metrics.length}`}>
          {metrics.map(m => (
            <div class="svc-metric" data-m="up">
              <div class="svc-metric__n">{m.value}</div>
              <div class="svc-metric__l">{m.label}</div>
            </div>
          ))}
        </div>
        <p class="lbw-metrics-note">Zahlen aus einem aktuellen Kundenprojekt. Vollständige Fallstudie weiter unten.</p>
      </div>
    </section>

    <!-- Problem -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Das Problem
          </span>
          <h2 class="svc-h2">Ihre Website sieht vielleicht gut aus und bringt trotzdem nichts</h2>
        </div>
        <div class="svc-prose">
          <p data-m="up">
            Eine Website, die nur gut aussieht, ist eine digitale Visitenkarte. Sie wird nicht gefunden,
            kann keine Buchung entgegennehmen und fasst nie nach. Also steht sie einfach da, still,
            während Sie Aufträge weiter auf die harte Tour jagen.
          </p>
          <p data-m="up" style="--m-d:0.08s">
            So läuft es tatsächlich ab. Jemand in Ihrer Umgebung sucht nach dem, was Sie tun. Er tippt auf
            die ersten Unternehmen in Google Maps, ruft den an, der abnimmt, und bucht. Das ist die ganze
            Entscheidung, und sie dauert etwa eine Minute. Wenn Sie nicht in diesen Top-Ergebnissen stehen,
            geht der Auftrag an einen Mitbewerber, bevor Sie überhaupt wussten, dass es ihn gab.
          </p>
          <p data-m="up" style="--m-d:0.16s">
            Den meisten lokalen Unternehmen fehlen alle Bausteine, die diese Minute gewinnen. Kein
            Maps-Ranking, keine Online-Buchung, keine Sofortantwort, kein Bewertungssystem. Das ist keine
            kleine Lücke. Es ist der Unterschied zwischen einer Website, die verdient, und einer, die nur
            existiert. Und jede Woche, in der das so bleibt, gehen die Anrufe weiter woanders hin.
          </p>
        </div>
      </div>
    </section>

    <!-- The System (4 pillars) -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Das System
          </span>
          <h2 class="svc-h2">Vier Systeme, eine Website. Der Aufbau, den Mitbewerber auslassen.</h2>
          <p class="svc-section-sub">Jeder Teil ist für sich nützlich. Zusammen machen sie aus einer stillen Website eine, die Kunden findet, sie bucht und sie zurückkommen lässt.</p>
        </div>
        <div class="lbw-pillars">
          {pillars.map((p, i) => (
            <div class="lbw-pillar v2-card" data-m="up" style={`--m-d:${i * 0.08}s`}>
              <div class="lbw-pillar__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={p.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="lbw-pillar__tag">{p.tag}</span>
              <h3 class="lbw-pillar__title">{p.title}</h3>
              <p class="lbw-pillar__desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Comparison -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 3H5a2 2 0 00-2 2v14a2 2 0 002 2h4M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Die Lücke
          </span>
          <h2 class="svc-h2">Die meisten lokalen Websites vs. Ihre</h2>
        </div>
        <div class="lbw-compare" data-m="up">
          <div class="lbw-compare__head">
            <div class="lbw-compare__feature"></div>
            <div class="lbw-compare__col lbw-compare__col--them">Die meisten lokalen Websites</div>
            <div class="lbw-compare__col lbw-compare__col--you">Ihr neues System</div>
          </div>
          {compare.map(row => (
            <div class="lbw-compare__row">
              <div class="lbw-compare__feature">{row.label}</div>
              <div class="lbw-compare__cell lbw-compare__cell--them">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-label="Nein"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <div class="lbw-compare__cell lbw-compare__cell--you">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-label="Ja"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Real example: Belags case study -->
    <section class="v2-section svc-content-section" style="padding-top:0" id="beispiel">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Echtes Ergebnis
          </span>
          <h2 class="svc-h2">Ein echtes lokales Unternehmen, das genau das getan hat</h2>
          <p class="svc-section-sub">Belags-Oberflächenreinigung, ein Reinigungsunternehmen in Arbon, Schweiz. Als wir anfingen: keine Website, kein Google Unternehmensprofil, keine Bewertungen. Nichts.</p>
        </div>

        <div class="lbw-case v2-card-grad" data-m="up">
          <div class="lbw-case__grid">
            <div class="lbw-case__side">
              <span class="lbw-case__label">Vorher</span>
              <ul class="lbw-case__list lbw-case__list--before">
                <li>Keine Website, also keine Chance, für irgendetwas zu ranken</li>
                <li>Überhaupt nicht auf Google Maps</li>
                <li>Null Bewertungen und keine Möglichkeit, welche zu sammeln</li>
                <li>Jeder neue Kunde kam über Mundpropaganda</li>
              </ul>
            </div>
            <div class="lbw-case__side">
              <span class="lbw-case__label lbw-case__label--after">Nachher</span>
              <ul class="lbw-case__list lbw-case__list--after">
                <li>Schnelle, konversionsstarke Website mit Klick-zum-Anrufen</li>
                <li>Top 3 bei Google Maps für die Zielsuchen</li>
                <li>Standortseiten für 4 Städte in der Region</li>
                <li>Automatische Bewertungsanfragen nach jedem Auftrag</li>
              </ul>
            </div>
          </div>
          <div class="lbw-case__result">
            <strong>312% mehr eingehende Anrufe</strong> innerhalb von 90 Tagen nach dem Start, bei einem
            Unternehmen, das zuvor gar keine Online-Präsenz hatte. Gleiches Team, gleiche Arbeitsqualität.
            Das Einzige, was sich geändert hat, war eine Website, die gebaut wurde, um gefunden zu werden
            und zu buchen.
          </div>
          <div class="lbw-case__actions">
            <a href="/de/projekte/belags-oberflaechenreinigung-arbon-case-study/" class="v2-btn v2-btn-outline">
              Vollständige Fallstudie lesen
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Steps -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            So funktioniert es
          </span>
          <h2 class="svc-h2">Von unsichtbar zu gebucht in 4 Schritten</h2>
        </div>
        <div class="svc-steps">
          {steps.map((s, i) => (
            <div class="svc-step" data-m="up" style={`--m-d:${i * 0.1}s`}>
              <div class="svc-step__n">{s.n}</div>
              <div class="svc-step__body">
                <h3 class="svc-step__title">{s.title}</h3>
                <p class="svc-step__desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Fragen
          </span>
          <h2 class="svc-h2">Häufige Fragen</h2>
        </div>
        <div class="svc-faq">
          {faqItems.map((item, i) => (
            <details class="svc-faq__item" data-m="up" style={`--m-d:${i * 0.07}s`}>
              <summary class="svc-faq__q">{item.name}</summary>
              <p class="svc-faq__a">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTA
      lang="de"
      headline="Eine Website, die Kunden findet und sie bucht"
      subline="Buchen Sie ein kostenloses Gespräch. Wir zeigen Ihnen genau, wo Ihr aktueller Aufbau Aufträge verliert, und erstellen das System, das es behebt. Festpreis, keine Abo-Falle."
    />
  </main>
</LayoutV2>

<style lang="scss" is:global>
  .v2-bc {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 24px;
    padding-bottom: 8px;
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--fg-2);
    a { color: var(--fg-2); text-decoration: none; &:hover { color: var(--c1-light); } }
  }

  /* Hero */
  .svc-hero { padding: 52px 0 64px; }
  .svc-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .svc-h1 {
    margin-top: 16px;
    max-width: 100%;
    font-family: var(--font-display);
  }
  .svc-lead {
    max-width: 660px;
    margin-top: 20px;
  }
  .svc-hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
    justify-content: center;
  }
  .v2-btn-ghost {
    background: transparent;
    color: var(--fg-0);
