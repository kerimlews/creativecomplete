---
import LayoutV2 from '../../../layouts/LayoutV2.astro';
import CTA from '../../../components/v2/CTA.astro';

// ── New AI services (featured, hardcoded links) ───────────────────────────────
const aiServices = [
  {
    title: "KI-Leadqualifizierung: Jeder Lead in 60 Sekunden bewertet",
    description: "KI-Agenten qualifizieren jeden eingehenden Lead automatisch in unter 60 Sekunden — rund um die Uhr, auf 40+ Kanälen. 81 % Lead-Conversion-Rate.",
    href: "/de/dienstleistungen/ai-lead-qualification/",
    tag: "KI-Automatisierung",
    metric: "81 % Conversion",
  },
  {
    title: "KI-Werbemittel: CPL in 30 Tagen um 40–60% senken",
    description: "KI-generierte Werbemittel, trainiert auf $35 Mrd.+ Werbedaten. Creative Scoring KI prognostiziert Gewinner mit 90 %+ Genauigkeit. 14× mehr Conversions.",
    href: "/de/dienstleistungen/ai-ad-creative-engine/",
    tag: "KI-Werbung",
    metric: "14× mehr Conversions",
  },
  {
    title: "Speed-to-Lead System: Antwort in 60 Sekunden, 24/7",
    description: "Jeder Lead erhält innerhalb von 60 Sekunden eine qualifizierte Antwort — rund um die Uhr, auf 40+ Kanälen. 60 % kürzere Verkaufszyklen.",
    href: "/de/dienstleistungen/speed-to-lead-system/",
    tag: "Lead-Management",
    metric: "60s Antwortzeit",
  },
  {
    title: "WhatsApp-Datenbank-Monetarisierung: 42× ROI",
    description: "WhatsApp-Broadcast-Kampagnen und KI-gestützte Re-Engagement-Sequenzen verwandeln inaktive Kontakte in Umsatz — Ø 42.5× ROI.",
    href: "/de/dienstleistungen/whatsapp-datenbank-monetarisierung/",
    tag: "WhatsApp Marketing",
    metric: "Ø 42.5× ROI",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "KI Customer System Dienstleistungen — CreativeComplete",
  "description": "KI-Leadqualifizierung, KI-Werbemittel, Speed-to-Lead und WhatsApp-Monetarisierung für Agenturen im DACH-Raum.",
  "numberOfItems": aiServices.length,
  "itemListElement": aiServices.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Service",
      "name": s.title,
      "description": s.description,
      "url": `https://www.creativecomplete.com${s.href}`,
    }
  }))
};

---

<LayoutV2
  lang="de"
  title="KI Customer System Dienstleistungen — Agentur DACH | CreativeComplete"
  description="KI-Leadqualifizierung, KI-Werbemittel, Speed-to-Lead System und WhatsApp-Monetarisierung. CreativeComplete baut und betreibt das vollständige KI Customer System für Agenturen in Deutschland, Österreich und der Schweiz."
  canonicalUrl="https://www.creativecomplete.com/de/dienstleistungen/"
  structuredData={structuredData}
  priority={9}
>
  <div class="svc-page">

    <!-- ── Hero ────────────────────────────────────────────── -->
    <section class="svc-hero">
      <div class="v2-container">
        <div class="svc-bc"><a href="/de/">Home</a><span>/</span><span>Dienstleistungen</span></div>
        <div class="svc-hero__inner">
          <span class="v2-eyebrow">KI Customer System · DACH</span>
          <h1 class="v2-h1" style="margin-top:16px">
            KI-Dienstleistungen, die <span class="v2-grad">echte Ergebnisse liefern</span>
          </h1>
          <p class="v2-lead" style="margin-top:20px;max-width:58ch">
            Wir bauen, betreiben und optimieren das vollständige KI Customer System — von der Lead-Erfassung bis zur Monetarisierung bestehender Kontakte. Vollständig gemanagt, monatliche Pauschale.
          </p>
          <div class="svc-hero__cta">
            <a
              href="javascript:void(0)"
              class="v2-btn v2-btn-primary"
              data-cal-link="kerim-alihodza-7u7w6q/30min"
              data-cal-namespace="30min"
              data-cal-config='{"layout":"month_view","theme":"dark"}'
            >
              Kostenloses System-Audit sichern
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── AI Services Grid ─────────────────────────────────── -->
    <section class="svc-grid-section">
      <div class="v2-container">
        <div class="svc-section-head">
          <span class="v2-eyebrow">KI Customer System</span>
          <h2 class="v2-h2" style="margin-top:12px">
            <span class="v2-grad">Vier Motoren.</span> Ein System.
          </h2>
          <p class="v2-lead" style="margin-top:12px">
            Jeder Motor ist einzeln buchbar — oder aktivieren Sie alle vier für maximale Wirkung.
          </p>
        </div>

        <div class="svc-ai-grid">
          {aiServices.map((s, i) => (
            <a href={s.href} class="svc-ai-card" data-m="up" style={`--m-d:${i * 0.08}s`}>
              <div class="svc-ai-card__top">
                <span class="svc-ai-tag">{String(i + 1).padStart(2, '0')}</span>
                <span class="svc-ai-category">{s.tag}</span>
                <span class="svc-ai-metric">{s.metric}</span>
              </div>
              <h3 class="svc-ai-title">{s.title}</h3>
              <p class="svc-ai-desc">{s.description}</p>
              <div class="svc-ai-cta">
                Mehr erfahren
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M1.5 10.5L10.5 1.5M10.5 1.5H4.5M10.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Why managed ─────────────────────────────────────── -->
    <section class="svc-why">
      <div class="v2-container">
        <div class="svc-why__inner">
          <div class="svc-why__copy">
            <span class="v2-eyebrow">Warum gemanagt?</span>
            <h2 class="v2-h2" style="margin-top:16px">
              Kein Tool. <span class="v2-grad">Ein Team.</span>
            </h2>
            <p class="v2-lead" style="margin-top:16px">
              KI-Tools kaufen ist einfach. Sie zu konfigurieren, zu optimieren und 24/7 zu betreiben kostet Monate und internes Know-how, das die meisten Agenturen nicht haben.
            </p>
            <p class="v2-lead" style="margin-top:12px">
              CreativeComplete ist Ihre vollständige KI-Abteilung — für eine monatliche Pauschale ohne Überraschungskosten.
            </p>
            <a
              href="javascript:void(0)"
              class="v2-btn v2-btn-primary"
              style="margin-top:28px"
              data-cal-link="kerim-alihodza-7u7w6q/30min"
              data-cal-namespace="30min"
              data-cal-config='{"layout":"month_view","theme":"dark"}'
            >
              Kostenlos beraten lassen →
            </a>
          </div>
          <div class="svc-why__stats">
            {[
              { n: "81 %", l: "Lead-Conversion-Rate" },
              { n: "42.5×", l: "Broadcast-ROI" },
              { n: "14×", l: "Mehr Werbe-Conversions" },
              { n: "60s", l: "KI-Antwortzeit" },
            ].map(stat => (
              <div class="svc-why__stat">
                <div class="svc-why__stat-n">{stat.n}</div>
                <div class="svc-why__stat-l">{stat.l}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <CTA lang="de" />
  </div>
</LayoutV2>

<style lang="scss">
.svc-page { min-height: 100vh; }

.svc-bc {
  display: flex; align-items: center; gap: 8px;
  padding: 20px 0 0;
  font-size: 13px; font-family: var(--font-mono); color: var(--fg-2);
  a { color: var(--fg-2); transition: color .15s; &:hover { color: var(--c1-light); } }
}

.svc-hero {
  padding: 64px 0 80px;
  border-bottom: 1px solid var(--line);
}
.svc-hero__inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 800px;
}
.svc-hero__cta { margin-top: 32px; }

/* ── AI grid ── */
.svc-grid-section {
  padding: 80px 0;
  border-bottom: 1px solid var(--line);
}
.svc-section-head {
  margin-bottom: 48px;
}

.svc-ai-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;

  @media (max-width: 720px) { grid-template-columns: 1fr; }
}

.svc-ai-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 28px;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--r-xl);
  text-decoration: none;
  transition: border-color .2s, box-shadow .2s, transform .2s;

  &:hover {
    border-color: rgba(99,102,241,.35);
    box-shadow: 0 16px 48px rgba(0,0,0,.25);
    transform: translateY(-2px);

    .svc-ai-cta { gap: 8px; color: #a5b4fc; }
  }
}

.svc-ai-card__top {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.svc-ai-tag {
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .12em;
  color: var(--c1-light);
  background: rgba(99,102,241,.1);
  border: 1px solid rgba(99,102,241,.25);
  border-radius: var(--r-pill);
  padding: 2px 7px;
}
.svc-ai-category {
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--fg-2);
}
.svc-ai-metric {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .08em;
  color: var(--c2);
  background: rgba(34,211,238,.08);
  border: 1px solid rgba(34,211,238,.2);
  border-radius: var(--r-pill);
  padding: 2px 8px;
}
.svc-ai-title {
  font-family: var(--font-display);
  font-size: clamp(17px, 1.5vw, 22px);
  font-weight: 400;
  letter-spacing: -.01em;
  line-height: 1.25;
  color: var(--fg-0);
  margin: 0;
}
.svc-ai-desc {
  font-size: 13.5px;
  color: var(--fg-1);
  line-height: 1.65;
  margin: 0;
  flex: 1;
}
.svc-ai-cta {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .07em;
  color: rgba(99,102,241,.7);
  margin-top: auto;
  transition: gap .15s, color .15s;
}

/* ── Why section ── */
.svc-why {
  padding: 80px 0;
  border-bottom: 1px solid var(--line);
}
.svc-why__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}
.svc-why__stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.svc-why__stat {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  padding: 20px;
  text-align: center;
}
.svc-why__stat-n {
  font-family: var(--font-display);
  font-size: 32px;
  letter-spacing: -.03em;
  line-height: 1;
  background: var(--grad-text);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.svc-why__stat-l {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--fg-2);
  margin-top: 6px;
}
</style>
