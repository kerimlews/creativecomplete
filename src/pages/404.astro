---
import LayoutV2 from "../layouts/LayoutV2.astro";
import { getLanguageFromUrl, t, getLocalizedUrl } from '../utils/translations';

const currentLang = getLanguageFromUrl(Astro.url);
---

<LayoutV2 title={t('404.title', currentLang)} noindex={true}>
  <section class="e404">
    <!-- ambient blobs -->
    <div class="e404__blob e404__blob--1" aria-hidden="true"></div>
    <div class="e404__blob e404__blob--2" aria-hidden="true"></div>

    <div class="e404__card" data-m="up">
      <span class="v2-eyebrow">Error 404</span>

      <div class="e404__num" aria-hidden="true">404</div>

      <h1 class="e404__title">{t('404.subtitle', currentLang)}</h1>
      <p class="e404__desc">{t('404.description', currentLang)}</p>

      <div class="e404__actions">
        <a href={getLocalizedUrl('/', currentLang)} class="v2-btn v2-btn-primary e404__btn">
          {t('404.button', currentLang)}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/contact/" class="v2-btn e404__btn">Contact us</a>
      </div>

      <!-- signal lines decoration -->
      <div class="e404__lines" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
  </section>
</LayoutV2>

<style lang="scss">
  /* ── Layout ── */
  .e404 {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    position: relative;
    overflow: hidden;
  }

  /* ── Ambient blobs ── */
  .e404__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;

    &--1 {
      width: 560px;
      height: 560px;
      background: radial-gradient(circle, rgba(99,102,241,.18) 0%, transparent 70%);
      top: -120px;
      left: -160px;
      animation: blob-drift 14s ease-in-out infinite;
    }

    &--2 {
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(168,85,247,.14) 0%, transparent 70%);
      bottom: -80px;
      right: -100px;
      animation: blob-drift 18s ease-in-out infinite reverse;
    }
  }

  @keyframes blob-drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(30px, -20px) scale(1.05); }
    66%       { transform: translate(-20px, 15px) scale(.97); }
  }

  /* ── Card ── */
  .e404__card {
    position: relative;
    z-index: 1;
    max-width: 520px;
    width: 100%;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: 56px 48px 48px;
    box-shadow: 0 0 80px rgba(99,102,241,.08), 0 0 0 1px rgba(255,255,255,.03);

    @media (max-width: 560px) {
      padding: 40px 28px 36px;
    }
  }

  /* ── Big number ── */
  .e404__num {
    font-size: clamp(96px, 20vw, 160px);
    font-weight: 900;
    line-height: 1;
    margin: 20px 0 8px;
    background: linear-gradient(135deg, var(--c1) 0%, var(--c2) 55%, var(--c3) 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: num-shift 6s ease-in-out infinite;
    letter-spacing: -.04em;
  }

  @keyframes num-shift {
    0%, 100% { background-position: 0% 50%; }
    50%       { background-position: 100% 50%; }
  }

  /* ── Text ── */
  .e404__title {
    font-size: clamp(18px, 3vw, 24px);
    font-weight: 700;
    color: var(--fg-0);
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .e404__desc {
    font-size: 15px;
    color: var(--fg-2);
    line-height: 1.65;
    margin: 0 0 36px;
    max-width: 38ch;
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Buttons ── */
  .e404__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .e404__btn {
    height: 44px;
    font-size: 14px;
    min-width: 140px;
    justify-content: center;
  }

  /* ── Signal lines decoration ── */
  .e404__lines {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin-top: 40px;

    span {
      height: 3px;
      border-radius: 99px;
      background: var(--c1);
      opacity: .18;
      animation: line-pulse 2.4s ease-in-out infinite;

      &:nth-child(1) { width: 16px; animation-delay: 0s; }
      &:nth-child(2) { width: 32px; animation-delay: .2s; }
      &:nth-child(3) { width: 48px; animation-delay: .4s; }
      &:nth-child(4) { width: 32px; animation-delay: .6s; }
      &:nth-child(5) { width: 16px; animation-delay: .8s; }
    }
  }

  @keyframes line-pulse {
    0%, 100% { opacity: .18; transform: scaleX(1); }
    50%       { opacity: .55; transform: scaleX(1.15); }
  }
</style>
