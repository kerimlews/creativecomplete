  const imagePath = `/src/images/services/${slug}.png`;  
  return servicesImages[imagePath]();
}

function getProjectImage(slug: string) {  
  const imagePath = `/src/images/projects/${slug}.png`;    
  return projectsImages[imagePath]();
}

function getTestimonalImage(slug?: string) {  
