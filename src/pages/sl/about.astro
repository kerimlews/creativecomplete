    <!-- CTA Section -->
    <section class="about-cta section-padding">
      <div class="container">
        <div class="cta-content">
          <h2>Pripravljeni transformirati vaše podjetje?</h2>
          <p>
            Pogovorimo se, kako vam lahko pomagamo avtomatizirati procese, 
            razviti prilagojeno programsko opremo ali spodbujati rast vašega podjetja.
          </p>
          <div class="cta-actions">
            <a href={getLocalizedUrl('/contact/', currentLang)} class="cta-button cta-primary cta-lg">
              Začnite s projektom
            </a>
            <a href={getLocalizedUrl('/projekti/', currentLang)} class="cta-button cta-secondary cta-lg">
              Oglejte si naše delo
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>







