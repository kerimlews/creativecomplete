---
import LayoutV2 from '../../../layouts/LayoutV2.astro';
import CTA from '../../../components/v2/CTA.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('servicesSl');
  return services.map((service) => ({
    params: { slug: service.data.slug ?? service.id },
    props: { service },
  }));
}

const { service } = Astro.props;

const title       = service.data.title as string;
const description = service.data.description as string;
const slug        = (service.data.slug ?? service.id) as string;
const category    = (service.data.category ?? 'Storitev') as string;
const features    = (service.data.features as string[] | undefined) ?? [];
const ctaText     = (service.data.ctaText ?? 'Brezplačni audit') as string;
const faqItems    = (service.data.faq as { question: string; answer: string }[] | undefined) ?? [];

const canonicalUrl = `https://www.creativecomplete.com/sl/storitve/${slug}/`;

const siteUrl = 'https://www.creativecomplete.com';
const slToEnSlug: Record<string, string> = {
  'ai-oglasevalski-kreativni-sistem': '/services/ai-ad-creative-engine/',
  'ai-kvalifikacija-leadov': '/services/ai-lead-qualification/',
  'hitrost-do-leada': '/services/speed-to-lead-system/',
  'whatsapp-monetizacija-baze': '/services/whatsapp-database-monetization/',
};
const slToDeSlug: Record<string, string> = {
  'ai-oglasevalski-kreativni-sistem': '/de/dienstleistungen/ki-werbemittel-system/',
  'ai-kvalifikacija-leadov': '/de/dienstleistungen/ki-lead-qualifizierung/',
  'hitrost-do-leada': '/de/dienstleistungen/reaktionszeit-system/',
  'whatsapp-monetizacija-baze': '/de/dienstleistungen/whatsapp-datenbank-monetarisierung/',
};
const hreflangAlternates = slToEnSlug[slug] ? {
  en: siteUrl + slToEnSlug[slug],
  de: siteUrl + slToDeSlug[slug],
  sl: canonicalUrl,
} : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "provider": { "@type": "Organization", "name": "CreativeComplete", "url": "https://www.creativecomplete.com/" },
  "areaServed": ["SI", "HR"],
};

const images = import.meta.glob('/src/images/services/*.{png,jpg,jpeg,webp}');
const imageField = service.data.image as string | undefined;
let heroImg: any = null;
if (imageField) {
  const baseName = imageField.replace(/\.(png|jpg|jpeg|webp)$/, '');
  for (const ext of ['png', 'jpg', 'jpeg', 'webp']) {
    const p = `/src/images/services/${baseName}.${ext}`;
    if (images[p]) {
      try {
        const mod = await (images[p] as () => Promise<any>)();
        const img = mod.default ?? mod;
        if (img && 'src' in img) { heroImg = img; break; }
      } catch { /* skip */ }
    }
  }
}
---

<LayoutV2
  lang="sl"
  title={`${title} | CreativeComplete`}
  description={description}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  {hreflangAlternates}
>
  <main>

    <div class="v2-container svc-breadcrumb">
      <a href="/sl/">Domov</a><span>/</span>
      <a href="/sl/storitve/">Storitve</a><span>/</span>
      <span>{title}</span>
    </div>

    <section class="svc-hero">
      <div class="v2-container">
        <span class="v2-eyebrow">{category}</span>
        <h1 class="v2-h1 svc-h1">{title}</h1>

        {heroImg ? (
          <div class="svc-hero-img">
            <Image src={heroImg} alt={title} width={1200} height={Math.round((heroImg.height / heroImg.width) * 1200)} />
          </div>
        ) : (
          <div class="svc-hero-img svc-hero-placeholder">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="8.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 16l5-5 4 4 3-3 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="svc-placeholder-text">Slika kmalu</span>
          </div>
        )}

        <p class="v2-lead svc-lead">{description}</p>
        <div class="svc-hero-actions">
          <a
            href="javascript:void(0)"
            class="v2-btn v2-btn-primary"
            data-cal-link="kerim-alihodza-7u7w6q/30min"
            data-cal-namespace="30min"
            data-cal-config='{"layout":"month_view","theme":"dark"}'
          >
            {ctaText}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    {features.length > 0 && (
      <section class="svc-features v2-section">
        <div class="v2-container">
          <div class="v2-section-head">
            <span class="v2-eyebrow">Kaj je vključeno</span>
            <h2 class="v2-h3">Obseg storitve</h2>
          </div>
          <div class="svc-features-grid">
            {features.map((f, i) => (
              <div class="svc-feature-card">
                <span class="svc-feature-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="svc-feature-text">{f}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="v2-section">
      <div class="v2-container">
        <div class="svc-prose v2-prose" set:html={service.rendered?.html} />
      </div>
    </section>

    {faqItems.length > 0 && (
      <section class="v2-section svc-faq-section">
        <div class="v2-container svc-faq-container">
          <div class="svc-faq-head">
            <span class="v2-eyebrow">FAQ</span>
            <h2 class="v2-h3">{title} — Pogosta vprašanja</h2>
          </div>
          <div class="svc-faq-list">
            {faqItems.map((item, i) => (
              <details class="svc-faq-item">
                <summary class="svc-faq-q">
                  <span class="svc-faq-n">{String(i + 1).padStart(2, '0')}</span>
                  {item.question}
                  <svg class="svc-faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="svc-faq-a">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <CTA lang="sl" />
  </main>
</LayoutV2>

<style lang="scss">
.svc-breadcrumb {
  display: flex; align-items: center; gap: 8px;
  padding-top: 24px; padding-bottom: 8px;
  font-size: 13px; font-family: var(--font-mono); color: var(--fg-2); flex-wrap: wrap;
  a { color: var(--fg-2); transition: color .15s; &:hover { color: var(--c1-light); } }
}

.svc-hero { padding: 40px 0 64px; }
.svc-h1 { margin-top: 16px; max-width: 820px; }
.svc-hero-img {
  border-radius: var(--r-xl);
  overflow: hidden;
  border: 1px solid var(--line);
  margin: 28px 0;
  aspect-ratio: 16 / 7;
  img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
}
.svc-hero-placeholder {
  aspect-ratio: 2 / 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: var(--glass);
  min-height: 200px;
  opacity: 0.4;
  color: var(--fg-2);
}
.svc-placeholder-text {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.svc-lead { margin-top: 0; max-width: 58ch; }
.svc-hero-actions { margin-top: 32px; }

.svc-features { padding-top: 0; }
.svc-features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 12px;
  margin-top: 40px;
}
.svc-feature-card {
  display: flex; align-items: flex-start; gap: 14px;
  padding: 18px 20px;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
}
.svc-feature-n {
  font-family: var(--font-mono); font-size: 10px; font-weight: 700;
  letter-spacing: .1em; color: var(--c1-light); flex-shrink: 0; padding-top: 2px;
}
.svc-feature-text {
  font-size: 14px; color: var(--fg-0); line-height: 1.45;
}

.svc-prose {
  max-width: 780px;
  color: var(--fg-1); line-height: 1.8; font-size: 16px;

  :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 32px);
    letter-spacing: -0.015em; font-weight: 400;
    color: var(--fg-0); margin: 52px 0 16px; line-height: 1.15;
  }
  :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.6vw, 24px);
    letter-spacing: -0.01em; font-weight: 400;
    color: var(--fg-0); margin: 36px 0 12px;
  }
  :global(p) { margin: 0 0 18px; }
  :global(ul), :global(ol) {
    padding-left: 1.4em; margin: 0 0 18px;
    display: flex; flex-direction: column; gap: 8px;
  }
  :global(li) { color: var(--fg-1); }
  :global(strong) { color: var(--fg-0); font-weight: 600; }
  :global(a) {
    color: var(--c1-light); text-decoration: underline; text-underline-offset: 3px;
    &:hover { color: var(--fg-0); }
  }
  :global(blockquote) {
    border-left: 3px solid var(--c1); padding-left: 20px;
    margin: 28px 0; font-style: italic; color: var(--fg-1);
  }
  :global(hr) { border: 0; height: 1px; background: var(--line); margin: 36px 0; }
  :global(img) { display: block; width: 100%; height: auto; border-radius: var(--r-lg); margin: 28px 0; }
  :global(table) {
    width: 100%; border-collapse: collapse; margin: 28px 0;
    font-size: 14px; border-radius: 10px; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }
  :global(thead) { background: rgba(99,102,241,0.1); }
  :global(th) {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .1em;
    text-transform: uppercase; color: rgba(255,255,255,0.5); font-weight: 600;
    padding: 10px 14px; text-align: left;
    border-bottom: 1px solid rgba(99,102,241,0.2); white-space: nowrap;
  }
  :global(td) {
    padding: 10px 14px; color: var(--fg-1);
    border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: top; line-height: 1.5;
  }
  :global(tbody tr:last-child td) { border-bottom: none; }
  :global(tbody tr:nth-child(even)) { background: rgba(255,255,255,0.02); }
  :global(tbody tr:hover) { background: rgba(99,102,241,0.05); }
}

.svc-faq-section { padding-top: 0; }
.svc-faq-container { max-width: 860px; }
.svc-faq-head {
  display: flex; flex-direction: column; align-items: flex-start; gap: 12px;
  margin-bottom: 36px;
}
.svc-faq-list { display: flex; flex-direction: column; gap: 0; }
.svc-faq-item {
  border-bottom: 1px solid var(--line);
  &:first-child { border-top: 1px solid var(--line); }
}
.svc-faq-q {
  display: flex; align-items: center; gap: 12px;
  padding: 18px 0; cursor: pointer; list-style: none;
  font-weight: 500; font-size: 15px; color: var(--fg-0); transition: color .15s;
  &::-webkit-details-marker { display: none; }
  &:hover { color: var(--c1-light); }
  .svc-faq-arrow { margin-left: auto; flex-shrink: 0; color: var(--fg-2); transition: transform .2s; }
}
details[open] .svc-faq-arrow { transform: rotate(180deg); }
.svc-faq-n {
  font-family: var(--font-mono); font-size: 10px; color: var(--c1-light);
  flex-shrink: 0; letter-spacing: 0.1em;
}
.svc-faq-a { padding: 0 0 20px 30px; font-size: 14.5px; color: var(--fg-1); line-height: 1.7; }
</style>
