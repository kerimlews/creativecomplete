---
import LayoutV2 from '../../../layouts/LayoutV2.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import BreadCrumb from '../../../components/BreadCrumb.astro';
import { getCollection } from 'astro:content';
import BottomCTA from '../../../components/BottomCTA.astro';
import { t, getLocalizedUrl } from '../../../utils/translations';
import { getServiceUrl, getBasePath, detectLanguageFromPath } from '../../../utils/routing';
import type { Language } from '../../../utils/translations';

// Detect language from URL
const currentLang: Language = detectLanguageFromPath(Astro.url.pathname);
const basePath = getBasePath(currentLang);

const images = await import.meta.glob('/src/images/services/*.{png,jpg,jpeg,webp}');

// Function to get service image by slug
async function getImage(slug: string) {
  if (!slug) return null;
  
  // Try different extensions and path variations
  const extensions = ['png', 'jpg', 'jpeg', 'webp'];
  const baseName = slug.replace(/\.(png|jpg|jpeg|webp)$/, ''); // Remove extension if present
  
  for (const ext of extensions) {
    const imagePath = `/src/images/services/${baseName}.${ext}`;
    if (images[imagePath]) {
      try {
        const imageModule = await images[imagePath]() as any;
        // Handle default export (import.meta.glob returns { default: ImageMetadata })
        const imageData = imageModule.default || imageModule;
        
        // Validate it's a proper ImageMetadata object
        if (imageData && typeof imageData === 'object' && 'src' in imageData) {
          return imageData;
        }
      } catch (e) {
        // Continue to next extension
        continue;
      }
    }
  }
  
  return null;
}

// Get all services and filter by language
const langServices = await getCollection('servicesSl');
const services = await Promise.all(langServices.map(async s => {
  const serviceName = s.id.split('/').pop() || s.id;
  // Use service.data.image if it exists, otherwise try the service name
  const imageSlug = s.data.image || serviceName;
  const image = await getImage(imageSlug);
  return { ...s, image };
}));

// Sort services by priority (highest first) then featured
const sortedServices = services.toSorted((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return (b.data.priority || 5) - (a.data.priority || 5);
});

// Generate JSON-LD for services page
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t('services.title', currentLang),
  "description": t('services.description', currentLang),
  "numberOfItems": services.length,
  "itemListElement": services.map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Service",
      "name": service.data.title,
      "description": service.data.description,
      "url": `${Astro.url.origin}${getServiceUrl(currentLang, service.data.slug || service.id)}`,
      "serviceType": service.data.category
    }
  }))
};

const breadcrumbs = [
  { name: t('nav.home', currentLang), url: `${Astro.url.origin}${basePath}/` },
  { name: t('nav.services', currentLang), url: Astro.url.href }
];
---

<LayoutV2
  lang="sl"
  title={t('services.title', currentLang)}
  description={t('services.description', currentLang)}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
  openGraph={{
    title: t('services.hero_title', currentLang).replace(/<[^>]*>/g, ''),
    description: t('services.hero_subtitle', currentLang),
  }}
  priority={9}
>
  <div class="services-page">
    <!-- Hero Section -->
    <section class="services-hero section-padding">
      <div class="container">
        <div class="hero-content text-center">
          <BreadCrumb items={breadcrumbs} />
          
          <h1 class="hero-title">
            Digital Services That Deliver <span class="text-gradient">Real Results</span>
          </h1>
          <p class="hero-subtitle">
            {t('services.hero_subtitle', currentLang)}
          </p>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="services-grid-section section-padding">
      <div class="container">
        <!-- Services Grid -->
        <div class="services-grid services-grid-row" id="servicesGrid">
          {sortedServices.map((service, index) => {
            const serviceSlug = service.data.slug || service.id.split('/').pop() || service.id;
            // Only pass image if it exists and is a valid ImageMetadata object
            const hasValidImage = service.image && 
                                  typeof service.image === 'object' && 
                                  service.image !== null &&
                                  'src' in service.image;
            
            // Build props object conditionally
            const cardProps: any = {
              title: service.data.title,
              description: service.data.description,
              features: service.data.features,
              ctaText: service.data.ctaText,
              delay: service.data.delay,
              url: getServiceUrl(currentLang, serviceSlug),
              slug: serviceSlug,
              category: service.data.category || '',
              index: index
            };
            
            // Only add image prop if it's valid
            if (hasValidImage) {
              cardProps.image = service.image;
            }
            
            return (
              <ServiceCard {...cardProps} />
            );
          })}
        </div>

        <!-- Empty State -->
        {services.length === 0 && (
          <div class="empty-state text-center">
            <h3>{t('services.no_services', currentLang)}</h3>
            <p>{t('services.no_services_desc', currentLang)}</p>
            <a href={getLocalizedUrl('/contact/', currentLang)} class="cta-button cta-primary">{t('nav.contact', currentLang)}</a>
          </div>
        )}
      </div>
    </section>

    <!-- Process Section -->
    <section class="process-section section-padding bg-light">
      <div class="container">
        <div class="section-header text-center">
          <h2>{t('services.process_title', currentLang)}</h2>
          <p class="section-subtitle">{t('services.process_subtitle', currentLang)}</p>
        </div>

        <div class="process-steps">
          <div class="process-step" data-step="1">
            <div class="step-icon-wrapper">
              <div class="step-number">01</div>
              <div class="step-icon">🔍</div>
            </div>
            <h3>{t('services.discovery_title', currentLang)}</h3>
            <p>{t('services.discovery_desc', currentLang)}</p>
            <div class="step-connector"></div>
          </div>
          <div class="process-step" data-step="2">
            <div class="step-icon-wrapper">
              <div class="step-number">02</div>
              <div class="step-icon">⚡</div>
            </div>
            <h3>{t('services.implementation_title', currentLang)}</h3>
            <p>{t('services.implementation_desc', currentLang)}</p>
            <div class="step-connector"></div>
          </div>
          <div class="process-step" data-step="3">
            <div class="step-icon-wrapper">
              <div class="step-number">03</div>
              <div class="step-icon">📈</div>
            </div>
            <h3>{t('services.optimization_title', currentLang)}</h3>
            <p>{t('services.optimization_desc', currentLang)}</p>
            <div class="step-connector"></div>
          </div>
          <div class="process-step" data-step="4">
            <div class="step-icon-wrapper">
              <div class="step-number">04</div>
              <div class="step-icon">🚀</div>
            </div>
            <h3>{t('services.scale_title', currentLang)}</h3>
            <p>{t('services.scale_desc', currentLang)}</p>
          </div>
        </div>
      </div>
    </section>

    <BottomCTA 
      title={t('cta.title', currentLang)}
      subtitle={t('cta.subtitle', currentLang)}
      urgencyText={t('cta.urgency', currentLang)}
      valueProps={[]}
      primaryButton={{
        text: t('cta.primary_button', currentLang),
        href: getLocalizedUrl('/contact/', currentLang)
      }}
      securityNote={t('cta.security_note', currentLang)}
      showValueProps={false}
    />
  </div>
</LayoutV2>

<script>
// Scroll animations for service cards
document.addEventListener('DOMContentLoaded', function() {
  const servicesGrid = document.getElementById('servicesGrid') as HTMLElement | null;
  
  if (!servicesGrid) return;
  
  // Scroll animations for service cards
  const serviceCards = servicesGrid.querySelectorAll('.service-card') as NodeListOf<HTMLElement>;
  
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const cardObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        const target = entry.target as HTMLElement;
        setTimeout(() => {
          target.style.opacity = '1';
          target.style.transform = 'translateY(0)';
        }, index * 100);
        cardObserver.unobserve(entry.target);
      }
    });
  }, observerOptions);

  serviceCards.forEach((card: HTMLElement) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(30px)';
    card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    cardObserver.observe(card);
  });

  // Scroll animations for process steps
  const processSteps = document.querySelectorAll('.process-step') as NodeListOf<HTMLElement>;
  
  const stepObserverOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
  };

  const stepObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting && entry.target instanceof HTMLElement) {
        const step = entry.target;
        const stepNumber = step.getAttribute('data-step');
        
        setTimeout(() => {
          step.classList.add('animate-in');
          
          // Animate icon
          const iconWrapper = step.querySelector('.step-icon-wrapper');
          if (iconWrapper) {
            iconWrapper.classList.add('pulse');
          }
        }, index * 200);
        
        stepObserver.unobserve(entry.target);
      }
    });
  }, stepObserverOptions);

  processSteps.forEach((step: HTMLElement) => {
    step.style.opacity = '0';
    step.style.transform = 'scale(0.8) translateY(50px)';
    step.style.transition = 'all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)';
    stepObserver.observe(step);
  });
});
</script>

<style>
  .hero-title .text-gradient {
    background: linear-gradient(135deg, #ff7002 0%, #ffc2ae 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .services-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 1rem !important;
  }
  
  @media (max-width: 767px) {
    .services-grid {
      grid-template-columns: 1fr !important;
      gap: 0.75rem !important;
    }
  }
</style>

