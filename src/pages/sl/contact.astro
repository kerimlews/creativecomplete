---
import Layout from '../../layouts/Layout.astro';
import { getLanguageFromUrl, t, getLocalizedUrl } from '../../utils/translations';

const currentLang: 'sl' = 'sl';

const { title = t('contact.title', currentLang), subtitle = t('contact.subtitle', currentLang) } = Astro.props;
---

<Layout title={title} description={subtitle}>
    <!-- Contact Form Component -->
    <div class="contact-section section-padding">
      <div class="container">
        <div class="contact-content">
          <!-- Header -->
          <div class="contact-header text-center">
            <h2 class="contact-title">{title}</h2>
            <p class="contact-subtitle">{subtitle}</p>
          </div>
    
          <!-- Contact Form -->
          <form 
            class="contact-form" 
            id="contactForm" 
            action="https://formspree.io/f/xzzondpe" 
            method="POST"
          >
            <div class="form-grid">
              <!-- Name Field -->
              <div class="form-group">
                <label for="name" class="form-label">Polno ime *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  class="form-input" 
                  required 
                  placeholder="Vnesite vaše polno ime"
                />
              </div>
    
              <!-- Email Field -->
              <div class="form-group">
                <label for="email" class="form-label">E-poštni naslov *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="form-input" 
                  required 
                  placeholder="Vnesite vaš e-poštni naslov"
                />
              </div>
    
              <!-- Company Field -->
              <div class="form-group">
                <label for="company" class="form-label">Podjetje</label>
                <input 
                  type="text" 
                  id="company" 
                  name="company" 
                  class="form-input" 
                  placeholder="Ime vašega podjetja (neobvezno)"
                />
              </div>
    
              <!-- Phone Field -->
              <div class="form-group">
                <label for="phone" class="form-label">Telefonska številka</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="form-input" 
                  placeholder="Vaša telefonska številka (neobvezno)"
                />
              </div>
    
              <!-- Service Interest -->
              <div class="form-group full-width">
                <label for="service" class="form-label">Zanimanje za storitev</label>
                <select id="service" name="service" class="form-select">
                  <option value="">Izberite storitev</option>
                  <option value="web-development">Spletna razvoj</option>
                  <option value="mobile-app">Razvoj mobilnih aplikacij</option>
                  <option value="ui-ux">UI/UX oblikovanje</option>
                  <option value="digital-marketing">Digitalno trženje</option>
                  <option value="branding">Blagovna znamka</option>
                  <option value="consultation">Posvetovanje</option>
                  <option value="other">Drugo</option>
                </select>
              </div>
    
              <!-- Budget -->
              <div class="form-group full-width">
                <label for="budget" class="form-label">Proračun projekta</label>
                <select id="budget" name="budget" class="form-select">
                  <option value="">Izberite obseg proračuna</option>
                  <option value="under-5k">Pod 5.000 €</option>
                  <option value="5k-15k">5.000 € - 15.000 €</option>
                  <option value="15k-30k">15.000 € - 30.000 €</option>
                  <option value="30k-50k">30.000 € - 50.000 €</option>
                  <option value="over-50k">Nad 50.000 €</option>
                  <option value="not-sure">Še nisem prepričan</option>
                </select>
              </div>
    
              <!-- Message -->
              <div class="form-group full-width">
                <label for="message" class="form-label">Podrobnosti projekta *</label>
                <textarea 
                  id="message" 
                  name="message" 
                  class="form-textarea" 
                  required 
                  rows="6" 
                  placeholder="Povejte nam o vašem projektu, ciljih, časovnem okviru in posebnih zahtevah..."
                ></textarea>
              </div>
            </div>
    
            <!-- Submit Button -->
            <div class="form-actions">
              <button type="submit" class="cta-button primary large full-width">
                <span class="button-text">Pošlji sporočilo</span>
                <span class="button-loader" style="display: none;">
                  <div class="loading-spinner"></div>
                  Pošiljanje...
                </span>
              </button>
            </div>
    
            <!-- Form Status Message -->
            <div id="formStatus" class="form-status" style="display: none;"></div>
          </form>
        </div>
      </div>
    </div>
</Layout>

<script>
  // Client-side form validation and submission
  document.addEventListener('DOMContentLoaded', function() {
    const contactForm = document.getElementById('contactForm');
    const formStatus = document.getElementById('formStatus');
    const submitButton = contactForm.querySelector('button[type="submit"]');
    const buttonText = submitButton.querySelector('.button-text');
    const buttonLoader = submitButton.querySelector('.button-loader');

    contactForm.addEventListener('submit', async function(e) {
      e.preventDefault();

      // Show loading state
      buttonText.style.display = 'none';
      buttonLoader.style.display = 'flex';
      submitButton.disabled = true;

      // Hide previous status messages
      formStatus.style.display = 'none';

      try {
        const formData = new FormData(contactForm);
        
        // Submit directly to Formspree
        const response = await fetch(contactForm.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          // Success
          showFormStatus('Hvala za vaše sporočilo! Odgovorili vam bomo v 24 urah.', 'success');
          contactForm.reset();
        } else {
          // Error from Formspree
          const result = await response.json();
          showFormStatus(result.error || 'Nekaj je šlo narobe. Prosimo, poskusite znova.', 'error');
        }
      } catch (error) {
        // Network error
        showFormStatus('Napaka omrežja. Prosimo, preverite povezavo in poskusite znova.', 'error');
        console.error('Form submission error:', error);
      } finally {
        // Reset button state
        buttonText.style.display = 'block';
        buttonLoader.style.display = 'none';
        submitButton.disabled = false;
      }
    });

    function showFormStatus(message, type) {
      formStatus.textContent = message;
      formStatus.className = `form-status ${type}`;
      formStatus.style.display = 'block';
      
      // Auto-hide success messages after 5 seconds
      if (type === 'success') {
        setTimeout(() => {
          formStatus.style.display = 'none';
        }, 5000);
      }
    }

    // Real-time validation
    const inputs = contactForm.querySelectorAll('input, textarea, select');
    inputs.forEach(input => {
      input.addEventListener('blur', function() {
        validateField(this);
      });
      
      input.addEventListener('input', function() {
        // Clear error state when user starts typing
        if (this.style.borderColor === 'rgb(229, 62, 62)') {
          this.style.borderColor = '#E2E8F0';
        }
      });
    });

    function validateField(field) {
      if (field.required && !field.value.trim()) {
        field.style.borderColor = '#E53E3E';
        return false;
      } else if (field.type === 'email' && field.value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(field.value)) {
          field.style.borderColor = '#E53E3E';
          return false;
        } else {
          field.style.borderColor = '#38A169';
        }
      } else {
        field.style.borderColor = '#E2E8F0';
      }
      return true;
    }

    // Validate entire form before submission
    function validateForm() {
      let isValid = true;
      const requiredFields = contactForm.querySelectorAll('[required]');
      
      requiredFields.forEach(field => {
        if (!validateField(field)) {
          isValid = false;
        }
      });
      
      return isValid;
    }

    // Update form submission to include validation
    const originalSubmitHandler = contactForm.onsubmit;
    contactForm.onsubmit = function(e) {
      if (!validateForm()) {
        e.preventDefault();
        showFormStatus('Prosimo, izpolnite vsa obvezna polja pravilno.', 'error');
        return false;
      }
      return originalSubmitHandler ? originalSubmitHandler.call(this, e) : true;
    };
  });
</script>

