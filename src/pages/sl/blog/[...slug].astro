---
import LayoutV2 from '../../../layouts/LayoutV2.astro';
import CTA from '../../../components/v2/CTA.astro';
import AuthorBadge from '../../../components/v2/AuthorBadge.astro';
import LeadRoutingMotion from '../../../components/v2/LeadRoutingMotion.astro';
import AICreativeMotion from '../../../components/v2/AICreativeMotion.astro';
import BroadcastMotion from '../../../components/v2/BroadcastMotion.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('blogsSl');
  return all.map((post) => ({
    params: { slug: post.data.slug as string },
    props: { postId: post.id },
  }));
}

const { postId } = Astro.props;
const post = await getCollection('blogsSl').then(ps => ps.find(p => p.id === postId));
if (!post) throw new Error(`SL blog post not found: ${postId}`);

const slug        = (post.data.slug ?? post.id) as string;
const title       = post.data.title as string;
const description = post.data.description as string;
const category    = (post.data.category ?? 'Blog') as string;
const tags        = (post.data.tags as string[] | undefined) ?? [];
const faqItems    = (post.data.faq as { question: string; answer: string }[] | undefined) ?? [];
const published   = post.data.published as string;
const updated     = (post.data.updated ?? published) as string;

const publishedDate = new Date(published);
const publishedYear = publishedDate.getFullYear();
const publishedFmt  = publishedDate.toLocaleDateString('sl-SI', { year: 'numeric', month: 'long', day: 'numeric' });

const canonicalUrl = `https://www.creativecomplete.com/sl/blog/${slug}/`;
const ogImage = `${Astro.url.origin}/images/og/${slug}.svg`;

const siteUrl = 'https://www.creativecomplete.com';
const slToEnBlog: Record<string, string> = {
  'ai-prodajni-agenti':               'ai-sales-agents',
  'ai-oglasne-kreative':              'ai-ad-creatives',
  'whatsapp-pridobivanje-leadov':     'whatsapp-lead-generation',
  'hitrost-do-leada':                 'speed-to-lead',
  'avtomatizirana-distribucija-leadov': 'automated-lead-distribution',
  'crm-avtomatizacija':               'crm-automation',
  'ai-kvalifikacija-leadov':          'ai-lead-qualification',
  'whatsapp-broadcast-kampanje':      'whatsapp-broadcast-campaigns',
  'testiranje-oglasnih-kreativ':      'ad-creative-testing',
};
const slToDeBlog: Record<string, string> = {
  'ai-prodajni-agenti':               'ki-verkaufsagenten',
  'ai-oglasne-kreative':              'ki-werbemittel',
  'whatsapp-pridobivanje-leadov':     'whatsapp-lead-generierung',
  'hitrost-do-leada':                 'reaktionszeit',
  'avtomatizirana-distribucija-leadov': 'automatisierte-lead-verteilung',
  'crm-avtomatizacija':               'crm-automatisierung',
  'ai-kvalifikacija-leadov':          'ki-lead-qualifizierung',
  'whatsapp-broadcast-kampanje':      'whatsapp-broadcast-kampagnen',
  'testiranje-oglasnih-kreativ':      'werbemittel-testing',
};
const hreflangAlternates = slToEnBlog[slug] ? {
  en: `${siteUrl}/blog/${slToEnBlog[slug]}/`,
  de: `${siteUrl}/de/blog/${slToDeBlog[slug]}/`,
  sl: canonicalUrl,
} : undefined;

const serviceLinkSl: Record<string, { href: string; label: string }> = {
  'hitrost-do-leada':                 { href: '/sl/storitve/hitrost-do-leada/',                   label: 'Hitrost do leada' },
  'ai-kvalifikacija-leadov':          { href: '/sl/storitve/ai-kvalifikacija-leadov/',             label: 'AI kvalifikacija leadov' },
  'avtomatizirana-distribucija-leadov':{ href: '/sl/storitve/ai-kvalifikacija-leadov/',            label: 'AI kvalifikacija leadov' },
  'whatsapp-broadcast-kampanje':      { href: '/sl/storitve/whatsapp-monetizacija-baze/',          label: 'WhatsApp monetizacija' },
  'whatsapp-pridobivanje-leadov':     { href: '/sl/storitve/whatsapp-monetizacija-baze/',          label: 'WhatsApp monetizacija' },
  'ai-oglasne-kreative':              { href: '/sl/storitve/ai-oglasevalski-kreativni-sistem/',    label: 'AI oglaševalski sistem' },
  'testiranje-oglasnih-kreativ':      { href: '/sl/storitve/ai-oglasevalski-kreativni-sistem/',    label: 'AI oglaševalski sistem' },
  'ai-prodajni-agenti':               { href: '/sl/storitve/ai-kvalifikacija-leadov/',             label: 'AI kvalifikacija leadov' },
  'crm-avtomatizacija':               { href: '/sl/storitve/ai-kvalifikacija-leadov/',             label: 'AI kvalifikacija leadov' },
};
const relatedService = serviceLinkSl[slug];

const wordCount = (post.rendered?.html ?? '').replace(/<[^>]+>/g, '').split(/\s+/).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "url": canonicalUrl,
  "datePublished": published,
  "dateModified": updated,
  "inLanguage": "sl",
  "image": `${Astro.url.origin}/images/og/${slug}.svg`,
  "author": {
    "@type": "Person",
    "name": "Kerim Alihodza",
    "url": `${Astro.url.origin}/kerim-alihodza/`,
    "sameAs": "https://www.linkedin.com/in/kerim-alihodza/",
  },
  "publisher": {
    "@type": "Organization",
    "name": "CreativeComplete",
    "url": Astro.url.origin,
    "logo": { "@type": "ImageObject", "url": `${Astro.url.origin}/logo-gradient.svg` },
  },
  "keywords": tags.join(', '),
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
};

// FAQPage rich results deprecated May 7 2026 — schema removed; visible FAQ content remains on page.

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Domov", "item": `${Astro.url.origin}/sl/` },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${Astro.url.origin}/sl/blog/` },
    { "@type": "ListItem", "position": 3, "name": title },
  ],
};

const structuredData = [articleSchema, breadcrumbSchema];

const showRoutingMotion = ['avtomatizirana-distribucija-leadov','hitrost-do-leada','ai-kvalifikacija-leadov','ai-prodajni-agenti'].includes(slug);
const showCreativeMotion = ['ai-oglasne-kreative','testiranje-oglasnih-kreativ'].includes(slug);
const showBroadcastMotion = ['whatsapp-broadcast-kampanje','whatsapp-pridobivanje-leadov'].includes(slug);

const caseStudyLinkSl: Record<string, { href: string; label: string; cat: string }> = {
  'hitrost-do-leada':                 { href: '/sl/projekti/parcel-daily-conversion-boost/',      label: 'Parcel Daily: 60% več konverzij',       cat: 'Logistika · AI' },
  'ai-kvalifikacija-leadov':          { href: '/sl/projekti/imotorbike-ai-lead-qualification/',   label: 'iMotorbike: 2× dnevna kapaciteta',      cat: 'Avtomobilizem · AI' },
  'avtomatizirana-distribucija-leadov':{ href: '/sl/projekti/imotorbike-ai-lead-qualification/',  label: 'iMotorbike: 2× dnevna kapaciteta',      cat: 'Avtomobilizem · AI' },
  'whatsapp-broadcast-kampanje':      { href: '/sl/projekti/only-tourism-ai-visa-automation/',    label: 'Only Tourism: 6× mesečni leadi',        cat: 'Turizem · AI' },
  'whatsapp-pridobivanje-leadov':     { href: '/sl/projekti/only-tourism-ai-visa-automation/',    label: 'Only Tourism: 6× mesečni leadi',        cat: 'Turizem · AI' },
  'ai-oglasne-kreative':              { href: '/sl/projekti/parcel-daily-conversion-boost/',      label: 'Parcel Daily: 60% več konverzij',       cat: 'Logistika · AI' },
  'testiranje-oglasnih-kreativ':      { href: '/sl/projekti/nianave-ecommerce-scaling-case-study/', label: 'Nianave: $30k → $120k/mesec',        cat: 'E-Commerce · Marketing' },
  'ai-prodajni-agenti':               { href: '/sl/projekti/only-tourism-ai-visa-automation/',    label: 'Only Tourism: 6× mesečni leadi',        cat: 'Turizem · AI' },
  'crm-avtomatizacija':               { href: '/sl/projekti/prepme-automation-saas/',             label: 'PrepMe: 280 ur/mesec prihranjenega časa', cat: 'SaaS · Avtomatizacija' },
};
const relatedCaseStudy = caseStudyLinkSl[slug];

const allPosts = await getCollection('blogsSl');
const relatedPosts = allPosts
  .filter(p => (p.data.category ?? 'Blog') === category && (p.data.slug ?? p.id) !== slug)
  .map(p => ({
    slug: (p.data.slug ?? p.id) as string,
    title: p.data.title as string,
    description: p.data.description as string,
    category: (p.data.category ?? 'Blog') as string,
    priority: (p.data.priority as number | undefined) ?? 0,
    readMinutes: Math.max(1, Math.round(((p.body ?? '').split(/\s+/).length) / 200)),
  }))
  .sort((a, b) => b.priority - a.priority)
  .slice(0, 3);
---

<LayoutV2
  lang="sl"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  structuredData={structuredData}
  navActive="results"
  {hreflangAlternates}
  openGraph={{ type: 'article' }}
>
  <main>

    <div class="v2-container blog-breadcrumb">
      <a href="/sl/">Domov</a><span>/</span>
      <a href="/sl/blog/">Blog</a><span>/</span>
      <span>{title}</span>
    </div>

    <section class="blog-hero">
      <div class="v2-container">
        <div class="blog-hero__inner">
          <div class="blog-hero__left">
            <span class="v2-chip-neutral blog-category">{category}</span>
            <h1 class="v2-h2 blog-h1">{title}</h1>
            <p class="v2-lead blog-lead">{description}</p>

            <div class="blog-meta">
              <div class="blog-meta__item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span>{readMinutes} min branja</span>
              </div>
              <div class="blog-meta__item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span>{publishedFmt}</span>
              </div>
            </div>

            <div class="blog-tags">
              {tags.map((t) => <span class="v2-chip">{t}</span>)}
            </div>

            <AuthorBadge
              name="Kerim Alihodza"
              role="CEO & Business Mechanic"
              publishedYear={publishedYear}
            />
          </div>

          <div class="blog-hero__right">
            {showRoutingMotion && <LeadRoutingMotion />}
            {showCreativeMotion && <AICreativeMotion />}
            {showBroadcastMotion && <BroadcastMotion />}
          </div>
        </div>
      </div>
    </section>

    <!-- Stats bar -->
    <section class="blog-stats" aria-label="Ključni rezultati">
      <div class="v2-container">
        <div class="blog-stats__inner">
          <div class="blog-stats__item" data-m>
            <div class="blog-stats__n" data-count="200">0%</div>
            <div class="blog-stats__label">Več strank</div>
            <div class="blog-stats__sub">Optimizacija razdelitve leadov za večji obseg klepetov</div>
          </div>
          <div class="blog-stats__divider" aria-hidden="true"></div>
          <div class="blog-stats__item" data-m>
            <div class="blog-stats__n" data-count="94">0%</div>
            <div class="blog-stats__label">Hitrejše reševanje</div>
            <div class="blog-stats__sub">Usmerjanje leadov k pravemu agentu za točne odgovore</div>
          </div>
          <div class="blog-stats__divider" aria-hidden="true"></div>
          <div class="blog-stats__item" data-m>
            <div class="blog-stats__n" data-count="93">0%</div>
            <div class="blog-stats__label">CSAT ocena</div>
            <div class="blog-stats__sub">Hitri strokovni odgovori za izjemne izkušnje strank</div>
          </div>
        </div>
      </div>
    </section>

    <section class="v2-section" style="padding-top: 0">
      <div class="v2-container">
        <div class="blog-layout">

          <article class="blog-prose v2-prose" set:html={post.rendered?.html} />

          <aside class="blog-aside">

            {showRoutingMotion && slug === 'avtomatizirana-distribucija-leadov' && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">7 pravil usmerjanja</div>
                <ul class="blog-rules-list">
                  {['Razpoložljivost agenta','Round Robin','Tip stranke','Izmenska razporeditev','Jezikovna usmeritev','Specializacija','Funkcijska usmeritev'].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String(i + 1).padStart(2, '0')}</span>
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {showRoutingMotion && slug === 'hitrost-do-leada' && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">Sistem Hitrost do leada</div>
                <ul class="blog-rules-list">
                  {['Zajem leada (vsi kanali)','AI prvi odgovor (&lt;60s)','BANT kvalifikacija','Lead score (0–100)','Pametno usmerjanje','Predaja vroče lead','Follow-up zaporedja'].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String(i + 1).padStart(2, '0')}</span>
                      <span set:html={r} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {showRoutingMotion && ['ai-kvalifikacija-leadov','ai-prodajni-agenti'].includes(slug) && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">BANT okvir</div>
                <ul class="blog-rules-list">
                  {[
                    { label: 'Budget', desc: 'Finančna zmogljivost potrjena' },
                    { label: 'Authority', desc: 'Odločevalec identificiran' },
                    { label: 'Need', desc: 'Ujemanje problem-rešitev potrjeno' },
                    { label: 'Timeline', desc: 'Aktivno nakupno okno' },
                  ].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String.fromCharCode(66 + i)}</span>
                      <span><strong style="color:var(--fg-0)">{r.label}</strong> — {r.desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {showCreativeMotion && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">6 kreativnih sistemov</div>
                <ul class="blog-rules-list">
                  {[
                    'Ocenjevanje zmogljivosti',
                    'Generiranje variant',
                    'Izvoz za platforme',
                    'Avtomatizacija A/B testov',
                    'Zaščitena podoba blagovne znamke',
                    'Retargeting kreative',
                  ].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String(i + 1).padStart(2, '0')}</span>
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {showBroadcastMotion && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">3 broadcast segmenti</div>
                <ul class="blog-rules-list">
                  {[
                    { label: 'Nedavni kupci', desc: '0–90 dni · 12–25% odziv' },
                    { label: 'Neaktivni visoko-vredni', desc: '91–365 dni · 8–18% odziv' },
                    { label: 'Nekonvertirani leadi', desc: 'Topel interes · 5–12% odziv' },
                  ].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String(i + 1).padStart(2, '0')}</span>
                      <span><strong style="color:var(--fg-0)">{r.label}</strong> — {r.desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {relatedService && (
              <a href={relatedService.href} class="blog-aside__service-link">
                <span class="blog-aside__service-eyebrow">Ta članek je del naše storitve</span>
                <span class="blog-aside__service-name">{relatedService.label}</span>
                <span class="blog-aside__service-cta">
                  Oglej si celotno storitev
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            )}

            {relatedCaseStudy && (
              <a href={relatedCaseStudy.href} class="blog-aside__case-link">
                <span class="blog-aside__case-eyebrow">Videno v praksi</span>
                <span class="blog-aside__case-cat">{relatedCaseStudy.cat}</span>
                <span class="blog-aside__case-title">{relatedCaseStudy.label}</span>
                <span class="blog-aside__case-read">Preberi primer →</span>
              </a>
            )}

            <div class="blog-aside__cta">
              <div class="blog-aside__cta-glow" aria-hidden="true"></div>
              <p class="blog-aside__cta-text">Pripravljen zgraditi svoj AI Customer System?</p>
              <a
                href="javascript:void(0)"
                class="v2-btn v2-btn-primary blog-aside__cta-btn"
                data-cal-link="kerim-alihodza-7u7w6q/30min"
                data-cal-namespace="30min"
                data-cal-config='{"layout":"month_view","theme":"dark"}'
              >
                Brezplačni sistemski audit
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>

          </aside>
        </div>
      </div>
    </section>

    {faqItems.length > 0 && (
      <section class="v2-section blog-faq-section">
        <div class="v2-container blog-faq-container">
          <div class="blog-faq-head">
            <span class="v2-eyebrow">FAQ</span>
            <h2 class="v2-h3 blog-faq-title">{title} — Pogosta vprašanja</h2>
          </div>
          <div class="blog-faq-list">
            {faqItems.map((item, i) => (
              <details class="blog-faq-item">
                <summary class="blog-faq-q">
                  <span class="blog-faq-n">{String(i + 1).padStart(2, '0')}</span>
                  {item.question}
                  <svg class="blog-faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="blog-faq-a">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="blog-related v2-section">
        <div class="v2-container">
          <div class="blog-related__head">
            <span class="v2-eyebrow">Preberi še</span>
            <h2 class="v2-h3 blog-related__title">Več o: {category}</h2>
          </div>
          <div class="blog-related__grid">
            {relatedPosts.map(p => (
              <a href={`/sl/blog/${p.slug}/`} class="blog-related__card">
                <span class="blog-related__cat">{p.category}</span>
                <h3 class="blog-related__card-title">{p.title}</h3>
                <p class="blog-related__card-desc">{p.description}</p>
                <span class="blog-related__read">
                  {p.readMinutes} min branja
                  <svg width="10" height="10" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                    <path d="M1.5 9.5L9.5 1.5M9.5 1.5H3.5M9.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <CTA lang="sl" />
  </main>
</LayoutV2>

<style lang="scss">
.blog-breadcrumb {
  display: flex; align-items: center; gap: 8px;
  padding-top: 24px; padding-bottom: 8px;
  font-size: 13px; font-family: var(--font-mono); color: var(--fg-2);
  flex-wrap: wrap;
  a { color: var(--fg-2); transition: color .15s; &:hover { color: var(--c1-light); } }
}

.blog-hero { padding: 48px 0 56px; }
.blog-hero__inner {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 64px;
  align-items: center;
  @media (max-width: 1024px) { grid-template-columns: 1fr; gap: 40px; }
  > * { min-width: 0; }
}
.blog-hero__left { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
.blog-hero__right { overflow: hidden; }
.blog-category { align-self: flex-start; }
.blog-h1 { margin: 0; }
.blog-lead { margin: 0; }

.blog-meta {
  display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
}
.blog-meta__item {
  display: flex; align-items: center; gap: 5px;
  font-size: 12px; font-family: var(--font-mono);
  color: var(--fg-2); letter-spacing: 0.04em;
  svg { color: var(--c1-light); }
}

.blog-tags { display: flex; gap: 6px; flex-wrap: wrap; }

/* Stats */
.blog-stats { padding: 0 0 48px; }
.blog-stats__inner {
  display: flex; align-items: stretch;
  background: var(--bg-card); border: 1px solid var(--line);
  border-radius: var(--r-xl); overflow: hidden;
}
.blog-stats__item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 36px 24px; text-align: center;
  opacity: 0; transition: opacity .3s;
  &.io-in { opacity: 1; }
}
.blog-stats__divider {
  width: 1px; background: var(--line); flex-shrink: 0;
  @media (max-width: 640px) { display: none; }
}
.blog-stats__n {
  font-family: var(--font-display); font-size: clamp(36px, 5vw, 60px);
  letter-spacing: -0.02em;
  background: var(--grad-text); -webkit-background-clip: text;
  -webkit-text-fill-color: transparent; background-clip: text; line-height: 1;
}
.blog-stats__label { font-size: 13px; font-weight: 600; color: var(--fg-0); margin-top: 8px; }
.blog-stats__sub { font-size: 11.5px; color: var(--fg-2); line-height: 1.5; margin-top: 6px; max-width: 22ch; }
@media (max-width: 640px) {
