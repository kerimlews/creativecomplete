---
import { Image } from 'astro:assets';
import LayoutV2 from '../../layouts/LayoutV2.astro';
import CTA from '../../components/v2/CTA.astro';
import { getCollection } from 'astro:content';
import { generateServiceJsonLd } from '../../utils/jsonld';
import { getServiceUrl } from '../../utils/routing';
import type { Language } from '../../utils/translations';

export async function getStaticPaths() {
  const langServices = await getCollection('servicesEn');
  return langServices
    .filter((s) => !!s.data.slug)
    .map((service) => ({
      params: { slug: service.data.slug as string },
      props: { serviceId: service.id },
    }));
}

const { serviceId } = Astro.props;
const currentLang: Language = 'en';

const service = await getCollection('servicesEn').then(
  (ss) => ss.find((s) => s.id === serviceId)
);
if (!service) throw new Error(`Service not found: ${serviceId}`);

// Image loading
const images = import.meta.glob('/src/images/services/*.{png,jpg,jpeg,webp}');
const serviceImagesResults = await Promise.all(
  Object.entries(images)
    .filter(([path]) => {
      const serviceName = service.id.split('/').pop() || service.id;
      return path.includes(`/src/images/services/${serviceName}`);
    })
    .map(async ([, image]) => {
      try {
        const mod = await (image as () => Promise<any>)();
        const img = mod.default ?? mod;
        return img && typeof img === 'object' && 'src' in img ? img : null;
      } catch { return null; }
    })
);
let heroImg: any = serviceImagesResults.find(Boolean) ?? null;

if (!heroImg && service.data.image) {
  const baseName = (service.data.image as string).replace(/\.(png|jpg|jpeg|webp)$/, '');
  for (const ext of ['png', 'jpg', 'jpeg', 'webp']) {
    const p = `/src/images/services/${baseName}.${ext}`;
    if (images[p]) {
      try {
        const mod = await (images[p] as () => Promise<any>)();
        const img = mod.default ?? mod;
        if (img && 'src' in img) { heroImg = img; break; }
      } catch { /* skip */ }
    }
  }
}

// Related services for sidebar
const allServices = await getCollection('servicesEn');
const related = allServices
  .filter((s) => s.id !== service.id)
  .slice(0, 5)
  .map((s) => ({
    title: s.data.title as string,
    slug: (s.data.slug ?? s.id.split('/').pop() ?? s.id) as string,
    category: (s.data.category ?? '') as string,
    url: getServiceUrl(currentLang, (s.data.slug ?? s.id.split('/').pop() ?? s.id) as string),
  }));

const features: string[] = (service.data.features as string[] | undefined) ?? [];
const faq: { question: string; answer: string }[] = (service.data.faq as any) ?? [];
const category = service.data.category as string | undefined;

const seoTitle = `${service.data.title as string} | CreativeComplete`;

const structuredData = generateServiceJsonLd(service);
const breadcrumbs = [
  { name: 'Home', url: `${Astro.url.origin}/` },
  { name: 'Services', url: `${Astro.url.origin}/services/` },
  { name: service.data.title as string, url: Astro.url.href },
];
---

<LayoutV2
  title={seoTitle}
  description={service.data.description as string}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
  openGraph={{
    title: seoTitle,
    description: service.data.description as string,
  }}
  priority={service.data.priority}
>
  <main>
    <!-- Breadcrumb -->
    <div class="v2-container v2-breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/services/">Services</a>
      <span>/</span>
      <span>{service.data.title as string}</span>
    </div>

    <!-- Hero -->
    <section class="v2-proj-hero">
      <div class="v2-container">
        <div class="v2-proj-hero__inner">
          <!-- Left -->
          <div class="v2-proj-hero__left">
            {category && <span class="v2-chip-neutral">{category}</span>}
            <h1 class="v2-h2" style="margin-top:20px">{service.data.title as string}</h1>
            <p class="v2-lead" style="margin-top:16px">{service.data.description as string}</p>

            {features.length > 0 && (
              <div style="margin-top:24px;width:100%">
                <div class="v2-proj-tags__label">What's included</div>
                <div class="v2-svc-features-list">
                  {features.map((f) => (
                    <div class="v2-svc-feature-item">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2 7l4 4 6-7" stroke="var(--c2)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <a
              href="javascript:void(0)"
              data-cal-link="kerim-alihodza-7u7w6q/30min"
              data-cal-namespace="30min"
              data-cal-config='{"layout":"month_view","theme":"dark"}'
              class="v2-btn v2-btn-primary"
              style="margin-top:28px;width:fit-content"
            >
              {service.data.ctaText || 'Get free audit'}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <!-- Right: hero image or placeholder -->
          {heroImg ? (
            <div class="v2-proj-hero__img">
              <Image src={heroImg} alt={service.data.title as string} width={700} height={420} />
            </div>
          ) : (
            <div class="v2-proj-hero__img v2-proj-placeholder">
              <div class="v2-proj-placeholder__inner">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="8.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M3 16l5-5 4 4 3-3 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="v2-proj-placeholder__text">Image coming soon</span>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Content + Sidebar -->
    <section class="v2-section" style="padding-top:0">
      <div class="v2-container">
        <div class="v2-proj-content">
          <div class="v2-prose" set:html={service.rendered?.html} />

          {related.length > 0 && (
            <aside class="v2-proj-aside">
              <div class="v2-proj-aside__head">Other services</div>
              <ul>
                {related.map((r) => (
                  <li>
                    <a href={r.url} class="v2-proj-aside__link">
                      <span class="v2-proj-aside__cat">{r.category}</span>
                      <span class="v2-proj-aside__title">{r.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>
      </div>
    </section>

    {faq.length > 0 && (
      <section class="v2-section v2-faq-section">
        <div class="v2-container">
          <div class="v2-section-head center">
            <span class="v2-eyebrow">FAQ</span>
            <h2 class="v2-h3">Frequently Asked Questions</h2>
          </div>
          <div class="v2-faq-list">
            {faq.map((item) => (
              <details class="v2-faq-item">
                <summary class="v2-faq-q">{item.question}</summary>
                <div class="v2-faq-a">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <CTA />
  </main>
</LayoutV2>

<style lang="scss">
  .v2-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 24px;
    padding-bottom: 8px;
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--fg-2);

    a { color: var(--fg-2); transition: color .15s; &:hover { color: var(--c1-light); } }
  }

  .v2-proj-hero {
    padding: 48px 0 64px;
  }

  .v2-proj-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .v2-proj-hero__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .v2-proj-hero__img {
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--line);

    img { width: 100%; height: auto; display: block; }
  }

  .v2-proj-placeholder {
    aspect-ratio: 5 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--glass);
    min-height: 260px;
  }

  .v2-proj-placeholder__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0.4;
    color: var(--fg-2);
  }

  .v2-proj-placeholder__text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .v2-proj-tags__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-2);
    display: block;
    margin-bottom: 10px;
  }

  .v2-svc-features-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .v2-svc-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
    color: var(--fg-1);
    line-height: 1.4;

    svg { flex-shrink: 0; margin-top: 2px; }
  }

  .v2-proj-content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 64px;
    align-items: start;

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  .v2-prose {
    color: var(--fg-1);
    line-height: 1.75;
    font-size: 16px;
    max-width: 72ch;

    :global(h2) {
      font-family: var(--font-display);
      font-size: clamp(22px, 2.2vw, 32px);
      letter-spacing: -0.015em;
      font-weight: 400;
      color: var(--fg-0);
      margin: 48px 0 16px;
      line-height: 1.15;
    }
    :global(h3) {
      font-family: var(--font-display);
      font-size: clamp(18px, 1.6vw, 24px);
      letter-spacing: -0.01em;
      font-weight: 400;
      color: var(--fg-0);
      margin: 32px 0 12px;
    }
    :global(p) { margin: 0 0 16px; }
    :global(ul), :global(ol) {
      padding-left: 1.5em;
      margin: 0 0 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    :global(li) { color: var(--fg-1); }
    :global(strong) { color: var(--fg-0); font-weight: 600; }
    :global(a) {
      color: var(--c1-light);
      text-decoration: underline;
      text-underline-offset: 3px;
      &:hover { color: var(--fg-0); }
    }
    :global(code) {
      font-family: var(--font-mono);
      font-size: 0.88em;
      background: var(--glass-hover);
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 1px 6px;
      color: var(--c2);
    }
    :global(blockquote) {
      border-left: 3px solid var(--c1);
      padding-left: 20px;
      margin: 24px 0;
      font-style: italic;
      color: var(--fg-1);
    }
    :global(hr) {
      border: 0;
      height: 1px;
      background: var(--line);
      margin: 32px 0;
    }
    :global(img) {
      border-radius: var(--r-lg);
      border: 1px solid var(--line);
      margin: 24px 0;
      max-width: 100%;
    }
    :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 28px 0;
      font-size: 14px;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
    }
    :global(thead) {
      background: rgba(99,102,241,0.1);
    }
    :global(th) {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
      font-weight: 600;
      padding: 10px 14px;
      text-align: left;
      border-bottom: 1px solid rgba(99,102,241,0.2);
      white-space: nowrap;
    }
    :global(td) {
      padding: 10px 14px;
      color: var(--fg-1);
      border-bottom: 1px solid rgba(255,255,255,0.05);
      vertical-align: top;
      line-height: 1.5;
    }
    :global(tbody tr:last-child td) {
      border-bottom: none;
    }
    :global(tbody tr:nth-child(even)) {
      background: rgba(255,255,255,0.02);
    }
    :global(tbody tr:hover) {
      background: rgba(99,102,241,0.05);
    }
  }

  .v2-proj-aside {
    position: sticky;
    top: 88px;

    @media (max-width: 1024px) { position: static; }
  }

  .v2-proj-aside__head {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-2);
    margin-bottom: 16px;
  }

  .v2-proj-aside ul {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .v2-proj-aside__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color .15s, background .15s;

    &:hover { border-color: var(--line-accent); background: var(--glass); }
  }

  .v2-proj-aside__cat {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c1-light);
  }

  .v2-proj-aside__title {
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-0);
    line-height: 1.4;
  }

  /* FAQ */
  .v2-faq-section {
    border-top: 1px solid var(--line);
  }

  .v2-faq-list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .v2-faq-item {
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    overflow: hidden;
    transition: border-color .15s;

    &[open] { border-color: var(--line-accent); }
  }

  .v2-faq-q {
    padding: 18px 20px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    color: var(--fg-1);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color .15s;
    gap: 16px;

    &::-webkit-details-marker { display: none; }
    &::after { content: '+'; font-size: 20px; font-weight: 300; color: var(--fg-2); flex-shrink: 0; }
  }

  .v2-faq-item[open] .v2-faq-q {
    color: var(--fg-0);
    &::after { content: '−'; }
  }

  .v2-faq-a {
    padding: 0 20px 18px;
    font-size: 14px;
    color: var(--fg-1);
    line-height: 1.7;
  }
</style>
