---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const canonicalUrl = 'https://creativecomplete.com/services/ai-lead-qualification/';

const hreflangAlternates = {
  en: canonicalUrl,
  de: 'https://www.creativecomplete.com/de/dienstleistungen/ki-lead-qualifizierung/',
  sl: 'https://www.creativecomplete.com/sl/storitve/ai-kvalifikacija-leadov/',
};

const faqItems = [
  { name: "How does AI lead qualification work?", answer: "When a lead reaches out through any channel, our AI starts a WhatsApp conversation right away. It checks budget, authority, need, and timeline, then scores the lead from 0 to 100. Hot leads go to closers. Warm leads go to your SDRs. Cold leads enter a nurture sequence." },
  { name: "What channels does AI lead qualification cover?", answer: "Our system captures and qualifies leads from 40+ channels including WhatsApp, Instagram DMs, Facebook Messenger, web forms, landing pages, Google click-to-message, and more. Every channel feeds into the same qualification engine." },
  { name: "How long does it take to qualify a lead?", answer: "Under 60 seconds for a full qualification. The AI responds within seconds, runs the conversation in plain language, and delivers a scored lead profile to your CRM before anyone on your team has seen the notification." },
  { name: "Does AI qualification replace my sales team?", answer: "No. It makes your reps more productive. They only talk to leads scored 70 or higher with confirmed budget and intent. That cuts out 80% of time spent on people who were never going to buy." },
  { name: "What results can I expect?", answer: "Clients typically see a 3x improvement in close rate, 80% less time spent on qualification, and a 60-second average response time versus the industry average of 4 to 6 hours." },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "AI Lead Qualification Service",
      "description": "Automated BANT lead scoring via WhatsApp. Every inbound lead qualified in under 60 seconds: budget, authority, need, and timeline confirmed before any rep gets involved.",
      "url": canonicalUrl,
      "provider": { "@type": "Organization", "name": "CreativeComplete", "url": "https://creativecomplete.com/" },
      "serviceType": "AI Lead Qualification",
      "areaServed": "Worldwide",
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://creativecomplete.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://creativecomplete.com/services/" },
        { "@type": "ListItem", "position": 3, "name": "AI Lead Qualification", "item": canonicalUrl },
      ]
    },
  ]
};
---

<ServiceLayout
  title="AI Lead Qualification Service: Score Every Lead in 60 Seconds | CreativeComplete"
  description="Automated BANT lead scoring via WhatsApp. Every lead qualified in under 60 seconds. Hot leads go to closers, cold leads into nurture, no manual sorting."
  {canonicalUrl}
  {structuredData}
  {hreflangAlternates}
  image="ai-lead-qualification"
  h1="AI Lead Qualification: Every Lead Scored in 60 Seconds"
  h1Grad="Every Lead Scored in 60 Seconds"
  lead="Your reps should talk to leads worth their time. Our AI qualifies every inbound through WhatsApp before anyone on your team gets involved. Budget, authority, need, timeline. All checked. Hot leads reach closers in under a minute. Cold leads go into nurture on their own."
  blogHref="/blog/ai-lead-qualification/"
  blogLabel="Read the full playbook"
  metrics={[
    { value: '60s', label: 'Avg. qualification time' },
    { value: '92/100', label: 'Avg. hot lead score' },
    { value: '3x', label: 'Close rate increase' },
    { value: '80%', label: 'Rep admin time saved' },
  ]}
  steps={[
    { n: '01', title: 'Lead Inbound', desc: 'A lead reaches you through any channel: WhatsApp, web form, ad click, or DM. The system picks it up instantly from 40+ sources, around the clock.' },
    { n: '02', title: 'AI Engages', desc: 'Within seconds, the AI starts a WhatsApp conversation. It checks budget, authority, need, and timeline in plain language. Not a survey. Not a bot script.' },
    { n: '03', title: 'Score Assigned', desc: 'A score from 0 to 100 is computed: Hot (80+), Warm (50-79), Cold (20-49), Disqualified (under 20). The full profile goes straight to your CRM.' },
    { n: '04', title: 'Routed Instantly', desc: 'Hot leads go to the right closer with full context. Warm leads go to SDRs. Cold leads enter a nurture sequence. No manual sorting. No lead slips through.' },
  ]}
  problemTitle="Your Reps Are Wasting 80% of Their Time"
  problemBody={[
    "Most B2B sales teams spend most of their time talking to people who were never going to buy. No budget. Not the decision maker. Just browsing. The rep runs the discovery call, writes the proposal, and the lead never replies.",
    "The problem is not your reps. It is the lack of a pre-qualification layer. Without one, every lead looks the same when it arrives. Your team has no way to tell a 30,000 euro opportunity from a time-waster without spending 45 minutes finding out.",
    "AI Lead Qualification puts a BANT filter in place before any human gets involved. Budget confirmed. Authority identified. Need validated. Timeline stated. A lead that passes all four goes to the right closer with a full dossier. A lead that fails goes into the right nurture sequence, automatically, without manual sorting.",
  ]}
  {faqItems}
  breadcrumbs={[{ label: 'AI Lead Qualification' }]}
/>
