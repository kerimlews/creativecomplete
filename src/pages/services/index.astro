---
import LayoutV2 from '../../layouts/LayoutV2.astro';
import CTA from '../../components/v2/CTA.astro';
import { getCollection } from 'astro:content';
import { t, getLocalizedUrl, getServicesRouteName } from '../../utils/translations';
import { getServiceUrl, getBasePath, detectLanguageFromPath, filterByLanguage } from '../../utils/routing';
import type { Language } from '../../utils/translations';

// Detect language from URL
const currentLang: Language = detectLanguageFromPath(Astro.url.pathname);
const basePath = getBasePath(currentLang);

const images = await import.meta.glob('/src/images/services/*.{png,jpg,jpeg,webp}');

// Function to get service image by slug
async function getImage(slug: string) {
  if (!slug) return null;
  
  // Try different extensions and path variations
  const extensions = ['png', 'jpg', 'jpeg', 'webp'];
  const baseName = slug.replace(/\.(png|jpg|jpeg|webp)$/, ''); // Remove extension if present
  
  for (const ext of extensions) {
    const imagePath = `/src/images/services/${baseName}.${ext}`;
    if (images[imagePath]) {
      try {
        const imageModule = await images[imagePath]();
        // Handle default export (import.meta.glob returns { default: ImageMetadata })
        const imageData = imageModule.default || imageModule;
        
        // Validate it's a proper ImageMetadata object
        if (imageData && typeof imageData === 'object' && 'src' in imageData) {
          return imageData;
        }
      } catch (e) {
        // Continue to next extension
        continue;
      }
    }
  }
  
  return null;
}

// Get all services and filter by language
const langServices = await getCollection('servicesEn');
const services = (await Promise.all(langServices.map(async s => {
  const serviceName = s.id.split('/').pop() || s.id;
  // Use service.data.image if it exists, otherwise try the service name
  const imageSlug = s.data.image || serviceName;
  const image = await getImage(imageSlug);
  return image ? { ...s, image } : null;
}))).filter(s => s !== null);

// Sort services by priority (highest first) then featured
const sortedServices = services.toSorted((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return (b.data.priority || 5) - (a.data.priority || 5);
});

// Generate JSON-LD for services page
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t('services.title', currentLang),
  "description": t('services.description', currentLang),
  "numberOfItems": services.length,
  "itemListElement": services.map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Service",
      "name": service.data.title,
      "description": service.data.description,
      "url": `${Astro.url.origin}${getServiceUrl(currentLang, service.data.slug || service.id)}`,
      "serviceType": service.data.category
    }
  }))
};

const breadcrumbs = [
  { name: t('nav.home', currentLang), url: `${Astro.url.origin}${basePath}/` },
  { name: t('nav.services', currentLang), url: Astro.url.href }
];
---

<LayoutV2
  title={t('services.title', currentLang)}
  description={t('services.description', currentLang)}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
  openGraph={{
    title: t('services.title', currentLang),
    description: t('services.description', currentLang),
  }}
  hreflangAlternates={{
    en: 'https://www.creativecomplete.com/services/',
    de: 'https://www.creativecomplete.com/de/dienstleistungen/',
    sl: 'https://www.creativecomplete.com/sl/storitve/',
  }}
>
  <main>
    <section class="v2-proj-list v2-section">
      <div class="v2-container">
        <div class="v2-section-head center">
          <span class="v2-eyebrow">What we offer</span>
          <h1 class="v2-h2">Our <span class="v2-grad">Services</span></h1>
          <p class="v2-lead">
            End-to-end AI Customer System services. We build, run, and manage every layer so you can focus on growing.
          </p>
        </div>

        <div class="v2-proj-grid">
          {sortedServices.map((service) => {
            const serviceSlug = service.data.slug || service.id.split('/').pop() || service.id;
            const url = getServiceUrl(currentLang, serviceSlug);
            return (
              <a href={url} class="v2-proj-card">
                <div class="v2-proj-card__body">
                  {service.data.category && (
                    <span class="v2-chip-neutral">{service.data.category}</span>
                  )}
                  <h2 class="v2-proj-card__title">{service.data.title}</h2>
                  <p class="v2-proj-card__desc">{service.data.description}</p>
                  {service.data.features && service.data.features.length > 0 && (
                    <ul class="v2-svc-idx__features">
                      {(service.data.features as string[]).slice(0, 4).map((f: string) => (
                        <li>{f}</li>
                      ))}
                    </ul>
                  )}
                  <span class="v2-proj-card__cta">
                    Learn more
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                      <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <CTA />
  </main>
</LayoutV2>

<style lang="scss">
  .v2-proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;

    @media (max-width: 768px) { grid-template-columns: 1fr; }
  }

  .v2-proj-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    text-decoration: none;
    transition: border-color .2s, transform .2s;

    &:hover {
      border-color: var(--line-accent);
      transform: translateY(-2px);
    }
  }

  .v2-proj-card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    flex: 1;
  }

  .v2-proj-card__title {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.6vw, 22px);
    letter-spacing: -0.01em;
    font-weight: 400;
    color: var(--fg-0);
    line-height: 1.2;
    margin: 0;
  }

  .v2-proj-card__desc {
    font-size: 14px;
    color: var(--fg-1);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .v2-proj-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--c1-light);
    transition: gap .15s;

    .v2-proj-card:hover & { gap: 10px; }
  }

  .v2-svc-idx__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;

    li {
      font-size: 13px;
      color: var(--fg-2);
      padding-left: 14px;
      position: relative;

      &::before {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--c2);
        font-size: 11px;
        top: 1px;
      }
    }
  }
</style>
