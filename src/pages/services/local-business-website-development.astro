---
import LayoutV2 from '../../layouts/LayoutV2.astro';
import CTA from '../../components/v2/CTA.astro';

// Primary keyword: "local business website development"
// Placed in: slug, title, description, H1, and first line of body content.
const canonicalUrl = 'https://creativecomplete.com/services/local-business-website-development/';

const hreflangAlternates = {
  en: canonicalUrl,
  de: 'https://www.creativecomplete.com/de/dienstleistungen/website-fuer-lokale-unternehmen/',
  sl: 'https://www.creativecomplete.com/sl/storitve/spletna-stran-za-lokalna-podjetja/',
  hr: 'https://www.creativecomplete.com/hr/usluge/web-stranica-za-lokalne-tvrtke/',
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Local Business Website Development",
      "description": "Local business website development that combines conversion-focused design, local SEO, an online booking system, and automated follow-up. One website that gets found, books jobs, and follows up on its own.",
      "url": canonicalUrl,
      "provider": { "@type": "Organization", "name": "CreativeComplete", "url": "https://creativecomplete.com/" },
      "serviceType": "Local Business Website Development",
      "areaServed": "Worldwide",
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://creativecomplete.com/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://creativecomplete.com/services/" },
        { "@type": "ListItem", "position": 3, "name": "Local Business Website Development", "item": canonicalUrl },
      ]
    },
  ]
};

const metrics = [
  { value: '312%', label: 'More inbound calls' },
  { value: 'Top 3', label: 'Google Maps ranking reached' },
  { value: '24/7', label: 'Bookings taken automatically' },
  { value: '< 2s', label: 'Page load on mobile' },
];

const pillars = [
  {
    tag: 'Design',
    title: 'Conversion-focused design',
    desc: 'A fast, mobile-first site built around one job: turning a visitor into a booked customer. Clear services, click-to-call on every screen, and trust signals where they matter. Not a pretty brochure that sits there.',
    icon: 'M12 2l7 4v6c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-4z',
  },
  {
    tag: 'Local SEO',
    title: 'Local SEO and Google Business Profile',
    desc: 'We put you in the Google Maps results where nearby customers actually search. Google Business Profile setup, location pages for each area you serve, and the local signals that get you found for "near me" searches.',
    icon: 'M12 21s-7-5.2-7-11a7 7 0 0114 0c0 5.8-7 11-7 11z M12 10a2 2 0 100-4 2 2 0 000 4z',
  },
  {
    tag: 'Booking',
    title: 'Online booking system',
    desc: 'Customers book straight into your calendar, at midnight, on a Sunday, whenever they decide. No phone tag, no missed calls, no leads lost because nobody picked up. The website closes the appointment for you.',
    icon: 'M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 012 2v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z',
  },
  {
    tag: 'Automation',
    title: 'Automated follow-up',
    desc: 'New enquiries get an instant reply. Booked customers get reminders so they show up. Finished jobs trigger a review request that builds your Google rating on autopilot. The work that usually falls through the cracks runs itself.',
    icon: 'M4 4v6h6M20 20v-6h-6M20 4a9 9 0 00-15 4M4 20a9 9 0 0015-4',
  },
];

const compare = [
  { label: 'Shows up in Google Maps for local searches', them: false, you: true },
  { label: 'Takes bookings 24/7 without a phone call', them: false, you: true },
  { label: 'Replies to new enquiries instantly', them: false, you: true },
  { label: 'Collects Google reviews automatically', them: false, you: true },
  { label: 'Loads in under 2 seconds on mobile', them: false, you: true },
  { label: 'Built to convert, not just to look nice', them: false, you: true },
];

const steps = [
  { n: '01', title: 'Audit and plan', desc: 'We look at how you show up today: your current site, your Google Business Profile, and what nearby customers see when they search for what you do. Then we map the exact system your business needs.' },
  { n: '02', title: 'Build the website', desc: 'We design and build a fast, mobile-first site that loads in under two seconds and is built to convert. Clear services, strong calls to action, and the booking system wired in from day one.' },
  { n: '03', title: 'Set up local SEO and booking', desc: 'We optimize your Google Business Profile, create location pages for every area you serve, and connect online booking to your calendar. This is what gets you found and gets you booked.' },
  { n: '04', title: 'Automate and launch', desc: 'Instant replies, appointment reminders, and automatic review requests go live. You launch with a website that finds customers, books them, and follows up while you do the actual work.' },
];

const faqItems = [
  { name: "What does local business website development actually include?", answer: "It is four things in one build: a conversion-focused website, local SEO with Google Business Profile setup, an online booking system connected to your calendar, and automated follow-up for enquiries, reminders, and reviews. Most agencies sell you the website and stop there. We build the whole system so the site actually brings in work." },
  { name: "I already have a website. Why is it not bringing in customers?", answer: "Most local websites are digital business cards. They look fine, but they do not rank in Google Maps, they cannot take a booking, and they never follow up. So people find your competitor first, book with whoever answers, and your site sits quiet. We fix the parts that produce customers, not just the parts you look at." },
  { name: "How is this different from your web design service?", answer: "Web design is one piece. This is the full package for a local service business: design plus local SEO plus booking plus automation, built to work together. If you want a site that ranks locally and books jobs on its own, this is the one." },
  { name: "How long does it take to build?", answer: "Most builds go live in 3 to 6 weeks depending on how many locations you serve and how much content we start with. We work in stages so the core site can launch first, then local pages and automation get layered on." },
  { name: "Do you work with businesses that have no online presence at all?", answer: "Yes, and those are often the best fit. The Swiss cleaning business in our case study started with no website, no Google Business Profile, and no reviews. Within 90 days they were in the top 3 on Google Maps with 312% more inbound calls. Starting from zero is an advantage, because every improvement is visible fast." },
  { name: "How much does it cost?", answer: "It depends on how many locations you serve and how much automation you need. Book a free call and we will map the exact system for your business and give you a fixed price. No retainer trap, no surprises." },
];
---

<LayoutV2
  title="Local Business Website Development, Local SEO & Booking | CreativeComplete"
  description="Local business website development that combines conversion design, local SEO, online booking, and automated follow-up. Most competitors have none of it, so their site sits invisible. See real results."
  {canonicalUrl}
  {structuredData}
  {hreflangAlternates}
  navActive="services"
>
  <main>
    <!-- Breadcrumb -->
    <div class="v2-container v2-bc">
      <a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span>
      <span>Local Business Website Development</span>
    </div>

    <!-- Hero -->
    <section class="svc-hero">
      <div class="v2-container svc-hero__inner">
        <span class="v2-eyebrow" data-m="fade">Local Business Websites</span>
        <h1 class="v2-h1 svc-h1" data-m="up">
          Local Business Website Development<br><span class="v2-grad">That Turns Searches Into Booked Jobs</span>
        </h1>
        <p class="v2-lead svc-lead" data-m="up">
          Local business website development that does more than look good. You get conversion-focused
          design, local SEO that puts you on Google Maps, an online booking system, and automated
          follow-up. It is the exact setup most local businesses in your area do not have, which is why
          their websites sit quiet while their phone stays silent.
        </p>
        <div class="svc-hero-actions" data-m="up">
          <a href="https://cal.com/kerim-alihodza-7u7w6q/30min" class="v2-btn v2-btn-primary">
            Book a free call
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#example" class="v2-btn v2-btn-ghost">See a real result</a>
        </div>
      </div>
    </section>

    <!-- Metrics -->
    <section class="v2-section svc-metrics-section">
      <div class="v2-container svc-content-center">
        <div class="svc-metrics m-stagger" style={`--cols:${metrics.length}`}>
          {metrics.map(m => (
            <div class="svc-metric" data-m="up">
              <div class="svc-metric__n">{m.value}</div>
              <div class="svc-metric__l">{m.label}</div>
            </div>
          ))}
        </div>
        <p class="lbw-metrics-note">Numbers from a recent client build. Full case study below.</p>
      </div>
    </section>

    <!-- Problem -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            The Problem
          </span>
          <h2 class="svc-h2">Your Website Might Look Fine and Still Do Nothing</h2>
        </div>
        <div class="svc-prose">
          <p data-m="up">
            A website that only looks good is a digital business card. It does not get found, it cannot
            take a booking, and it never follows up. So it sits there, quiet, while you keep chasing work
            the hard way.
          </p>
          <p data-m="up" style="--m-d:0.08s">
            Here is what actually happens. Someone in your area searches for what you do. They tap the
            first few businesses in Google Maps, call whoever answers, and book. That is the whole
            decision, and it takes about a minute. If you are not in those top results, the job goes to a
            competitor before you ever knew it existed.
          </p>
          <p data-m="up" style="--m-d:0.16s">
            Most local businesses have none of the pieces that win that minute. No Maps ranking, no online
            booking, no instant reply, no review system. That is not a small gap. It is the difference
            between a website that earns and one that just exists. And every week it stays that way, the
            calls keep going somewhere else.
          </p>
        </div>
      </div>
    </section>

    <!-- The System (4 pillars) -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            The System
          </span>
          <h2 class="svc-h2">Four Systems, One Website. The Setup Competitors Skip.</h2>
          <p class="svc-section-sub">Each part is useful on its own. Together they turn a quiet website into one that finds customers, books them, and keeps them coming back.</p>
        </div>
        <div class="lbw-pillars">
          {pillars.map((p, i) => (
            <div class="lbw-pillar v2-card" data-m="up" style={`--m-d:${i * 0.08}s`}>
              <div class="lbw-pillar__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={p.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="lbw-pillar__tag">{p.tag}</span>
              <h3 class="lbw-pillar__title">{p.title}</h3>
              <p class="lbw-pillar__desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Comparison -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 3H5a2 2 0 00-2 2v14a2 2 0 002 2h4M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            The Gap
          </span>
          <h2 class="svc-h2">Most Local Websites vs. Yours</h2>
        </div>
        <div class="lbw-compare" data-m="up">
          <div class="lbw-compare__head">
            <div class="lbw-compare__feature"></div>
            <div class="lbw-compare__col lbw-compare__col--them">Most local websites</div>
            <div class="lbw-compare__col lbw-compare__col--you">Your new system</div>
          </div>
          {compare.map(row => (
            <div class="lbw-compare__row">
              <div class="lbw-compare__feature">{row.label}</div>
              <div class="lbw-compare__cell lbw-compare__cell--them">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-label="No"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </div>
              <div class="lbw-compare__cell lbw-compare__cell--you">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-label="Yes"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Real example: Belags case study -->
    <section class="v2-section svc-content-section" style="padding-top:0" id="example">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Real Result
          </span>
          <h2 class="svc-h2">A Real Local Business That Did This</h2>
          <p class="svc-section-sub">Belags-Oberflächenreinigung, a pressure washing company in Arbon, Switzerland. When we started: no website, no Google Business Profile, no reviews. Nothing.</p>
        </div>

        <div class="lbw-case v2-card-grad" data-m="up">
          <div class="lbw-case__grid">
            <div class="lbw-case__side">
              <span class="lbw-case__label">Before</span>
              <ul class="lbw-case__list lbw-case__list--before">
                <li>No website, so no way to rank for anything</li>
                <li>Not on Google Maps at all</li>
                <li>Zero reviews and no way to collect them</li>
                <li>Every new customer came from word of mouth</li>
              </ul>
            </div>
            <div class="lbw-case__side">
              <span class="lbw-case__label lbw-case__label--after">After</span>
              <ul class="lbw-case__list lbw-case__list--after">
                <li>Fast, conversion-built site with click-to-call</li>
                <li>Top 3 on Google Maps for target searches</li>
                <li>Location pages for 4 cities in the region</li>
                <li>Automatic review requests after every job</li>
              </ul>
            </div>
          </div>
          <div class="lbw-case__result">
            <strong>312% more inbound calls</strong> within 90 days of launch, from a business that had no
            online presence at all. Same team, same quality of work. The only thing that changed was a
            website built to be found and to book.
          </div>
          <div class="lbw-case__actions">
            <a href="/projects/belags-oberflaechenreinigung-arbon-case-study/" class="v2-btn v2-btn-outline">
              Read the full case study
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Steps -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            How It Works
          </span>
          <h2 class="svc-h2">From Invisible to Booked in 4 Steps</h2>
        </div>
        <div class="svc-steps">
          {steps.map((s, i) => (
            <div class="svc-step" data-m="up" style={`--m-d:${i * 0.1}s`}>
              <div class="svc-step__n">{s.n}</div>
              <div class="svc-step__body">
                <h3 class="svc-step__title">{s.title}</h3>
                <p class="svc-step__desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="v2-section svc-content-section" style="padding-top:0">
      <div class="v2-container svc-content-center">
        <div class="v2-section-head" data-m="up">
          <span class="v2-eyebrow svc-eyebrow-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Questions
          </span>
          <h2 class="svc-h2">Common Questions</h2>
        </div>
        <div class="svc-faq">
          {faqItems.map((item, i) => (
            <details class="svc-faq__item" data-m="up" style={`--m-d:${i * 0.07}s`}>
              <summary class="svc-faq__q">{item.name}</summary>
              <p class="svc-faq__a">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTA
      headline="Get a website that finds customers and books them"
      subline="Book a free call. We will show you exactly where your current setup is losing work, and map the system that fixes it. Fixed price, no retainer trap."
    />
  </main>
</LayoutV2>

<style lang="scss" is:global>
  .v2-bc {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 24px;
    padding-bottom: 8px;
    font-size: 13px;
    font-family: var(--font-mono);
    color: var(--fg-2);
    a { color: var(--fg-2); text-decoration: none; &:hover { color: var(--c1-light); } }
  }

  /* Hero */
  .svc-hero { padding: 52px 0 64px; }
  .svc-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .svc-h1 {
    margin-top: 16px;
    max-width: 100%;
    font-family: var(--font-display);
  }
  .svc-lead {
    max-width: 660px;
    margin-top: 20px;
  }
  .svc-hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
    justify-content: center;
  }
  .v2-btn-ghost {
    background: transparent;
    color: var(--fg-0);
    border: 1px solid var(--line-2);
    &:hover { background: var(--glass-hover); border-color: var(--line-accent); transform: translateY(-1px); }
  }

  /* Eyebrow with icon */
  .svc-eyebrow-icon {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    svg { opacity: 0.7; }
  }

  /* Section H2 */
  .svc-h2 {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-0);
    margin: 12px 0 0;
    line-height: 1.2;
  }

  .svc-section-sub {
    font-size: 15px;
    color: var(--fg-2);
    margin-top: 12px;
    max-width: 620px;
    line-height: 1.6;
  }

  /* Content centering */
  .svc-content-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    .v2-section-head { margin-bottom: 0; }
  }

  /* Metrics */
  .svc-metrics-section { padding-top: 0; padding-bottom: 64px; }
  .svc-metrics {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    width: 100%;
    @media (max-width: 640px) { grid-template-columns: repeat(2, 1fr); }
  }
  .svc-metric {
    background: var(--bg-card);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
  }
  .svc-metric__n {
    font-family: var(--font-display);
    font-size: 40px;
    letter-spacing: -0.025em;
    line-height: 1;
    background: var(--grad-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .svc-metric__l {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .lbw-metrics-note {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .04em;
    color: var(--fg-3);
  }

  /* Prose */
  .svc-prose {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--fg-1);
    margin-top: 32px;
    text-align: center;
  }

  /* Pillars */
  .lbw-pillars {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    width: 100%;
    max-width: 920px;
    margin-top: 40px;
    @media (max-width: 720px) { grid-template-columns: 1fr; }
  }
  .lbw-pillar {
    padding: 28px 26px;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .lbw-pillar__icon {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--r-sm);
    background: rgba(99,102,241,0.1);
    border: 1px solid rgba(99,102,241,0.22);
    color: var(--c1-light);
    margin-bottom: 18px;
