---
import LayoutV2 from '../layouts/LayoutV2.astro';
import Hero from '../components/v2/Hero.astro';
import Clients from '../components/v2/Clients.astro';
import Stats from '../components/v2/Stats.astro';
import Services from '../components/v2/Services.astro';
import Results from '../components/v2/Results.astro';
import BlogScroll from '../components/v2/BlogScroll.astro';
import Testimonials from '../components/v2/Testimonials.astro';
import FAQ from '../components/v2/FAQ.astro';
import Track from '../components/v2/Track.astro';
import EndToEnd from '../components/v2/EndToEnd.astro';
import CTA from '../components/v2/CTA.astro';
import BookingSection from '../components/v2/BookingSection.astro';
import { generateOrganizationJsonLd, generateWebSiteJsonLd } from '../utils/jsonld';

const siteUrl = Astro.url.origin;
const structuredData = [
  generateOrganizationJsonLd(),
  generateWebSiteJsonLd(siteUrl, ['en', 'sl', 'de']),
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "AI Customer System in Action — CreativeComplete",
    "description": "See how the AI Customer System qualifies leads in under 60 seconds, generates ad creatives automatically, and monetizes existing contact databases for agencies.",
    "thumbnailUrl": `${siteUrl}/og-default.svg`,
    "uploadDate": "2026-01-15T00:00:00+00:00",
    "embedUrl": "https://player.vimeo.com/video/1191978034",
    "publisher": {
      "@type": "Organization",
      "name": "CreativeComplete",
      "url": siteUrl,
    },
  },
];
---

<LayoutV2
  title="AI Customer System for Lead Qualification & Conversion | CreativeComplete"
  description="AI Customer System that qualifies new leads in under 60 seconds, converts them with AI-generated creatives, and generates 42.5× ROI from your existing lead database. Built and managed by CreativeComplete."
  navActive="home"
  structuredData={structuredData}
>
  <main>
    <Hero />
    <Track />
    <Clients />
    <Stats />
    <EndToEnd />
    <Services />
    <Results />
    <BlogScroll />
    <Testimonials />
    <FAQ />
    <CTA />
    <BookingSection />
  </main>
</LayoutV2>
