---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { generateAboutPageJsonLd } from '../utils/jsonld';
import logo from '../images/logo-svg.svg';

// Page metadata
const pageTitle = 'About Us - Creative Complete | Custom Software & Automation Solutions';
const pageDescription = 'Learn about Creative Complete - we build custom software, automate business processes, and drive growth. Founded by Kerim Alihodza.';

// Breadcrumbs
const breadcrumbs = [
  { name: 'Home', url: `${Astro.url.origin}/` },
  { name: 'About', url: Astro.url.href }
];

// JSON-LD structured data
const aboutStructuredData = generateAboutPageJsonLd({
  name: 'Creative Complete',
  description: pageDescription,
  url: 'https://creativecomplete.com/about',
  founder: {
    name: 'Kerim Alihodza',
    url: 'https://creativecomplete.com/kerim-alihodza'
  },
  foundingDate: '2023',
  services: [
    'Custom Software Development',
    'Business Process Automation',
    'SaaS Development',
    'E-commerce Solutions',
    'Mobile App Development',
    'SEO & Digital Marketing'
  ]
});

---

<Layout 
  title={pageTitle}
  description={pageDescription}
  structuredData={aboutStructuredData}
  breadcrumbs={breadcrumbs}
  openGraph={{
    title: pageTitle,
    description: pageDescription,
    type: 'website'
  }}
  twitterCard={{
    title: pageTitle,
    description: pageDescription
  }}
  priority={0.8}
>
  <div class="about-page">
    <!-- Hero Section -->
    <section class="about-hero section-padding">
      <div class="container">
        <div class="about-hero-content">
          <!-- Company Logo -->
          <div class="company-logo">
            <Image
              src={logo}
              alt="Creative Complete Logo" 
              width={70} 
              height={100}
            />
            <h1 class="company-name">Creative Complete</h1>
          </div>
          
          <div class="about-intro">
            <h2>We Build Software That Solves Real Business Problems</h2>
            <p class="lead">
              From custom SaaS platforms to business automation systems, we transform complex challenges into elegant digital solutions that drive growth and efficiency.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Founder Section -->
    <section class="founder-section section-padding">
      <div class="container">
        <div class="founder-content">
          <div class="founder-header">
            <h2>Meet Our Founder</h2>
            <p class="section-subtitle">The vision behind Creative Complete</p>
          </div>
          
          <div class="founder-profile">
            <div class="founder-info">
              <h3>Kerim Alihodza</h3>
              <p class="founder-title">Founder & Lead Developer</p>
              <div class="founder-bio">
                <p>
                  With over a decade of experience in software development and digital transformation, 
                  Kerim founded Creative Complete to bridge the gap between complex business problems 
                  and practical technology solutions.
                </p>
                <p>
                  His expertise spans full-stack development, system architecture, and growth strategy, 
                  with a proven track record of delivering results for businesses across multiple industries.
                </p>
              </div>
              <div class="founder-cta">
                <a href="/kerim-alihodza/" class="cta-button cta-primary cta-md">
                  Learn More About Kerim
                </a>
              </div>
            </div>
            
            <div class="founder-stats">
              <div class="stat-item">
                <div class="stat-number">10+</div>
                <div class="stat-label">Years Experience</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">50+</div>
                <div class="stat-label">Projects Delivered</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">$2M+</div>
                <div class="stat-label">Revenue Generated</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Do Section -->
    <section class="services-section section-padding">
      <div class="container">
        <div class="section-header">
          <h2>What We Do</h2>
          <p class="section-subtitle">
            We specialize in building custom solutions that automate processes, 
            streamline operations, and drive measurable business growth.
          </p>
        </div>

        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon">🚀</div>
            <h3>Custom Software Development</h3>
            <p>
              Bespoke applications tailored to your unique business needs, 
              built with scalable architecture and modern technologies.
            </p>
            <ul class="service-features">
              <li>SaaS Platforms</li>
              <li>Web Applications</li>
              <li>API Development</li>
              <li>System Integration</li>
            </ul>
          </div>

          <div class="service-card">
            <div class="service-icon">⚡</div>
            <h3>Business Process Automation</h3>
            <p>
              Eliminate manual work and reduce errors by automating repetitive 
              tasks and streamlining your workflows.
            </p>
            <ul class="service-features">
              <li>Workflow Automation</li>
              <li>AI Integration</li>
              <li>CRM Systems</li>
              <li>Data Processing</li>
            </ul>
          </div>

          <div class="service-card">
            <div class="service-icon">📈</div>
            <h3>Growth & Optimization</h3>
            <p>
              Drive revenue growth through strategic SEO, conversion optimization, 
              and data-driven marketing strategies.
            </p>
            <ul class="service-features">
              <li>SEO Strategy</li>
              <li>Conversion Rate Optimization</li>
              <li>E-commerce Scaling</li>
              <li>Performance Analytics</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Process Section -->
