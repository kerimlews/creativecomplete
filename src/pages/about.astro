    <!-- CTA Section -->
    <section class="about-cta section-padding">
      <div class="container">
        <div class="cta-content">
          <h2>Ready to Transform Your Business?</h2>
          <p>
            Let's discuss how we can help you automate processes, 
            build custom software, or drive growth for your business.
          </p>
          <div class="cta-actions">
            <a href="/contact/" class="cta-button cta-primary cta-lg">
              Start Your Project
            </a>
            <a href="/projects/" class="cta-button cta-secondary cta-lg">
              View Our Work
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>