---
// CORRECTED DYNAMIC IMAGE IMPORTS FOR PROJECTS
import LayoutV2 from '../layouts/LayoutV2.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BottomCTA from '../components/BottomCTA.astro';
import { getCollection } from 'astro:content';
import Testimonials from '../components/Testimonials.astro';
import { getProjectImage, getTestimonalImage, testimonials } from '../utils/constants';
import { t, getLocalizedUrl } from '../utils/translations';
import { getBasePath } from '../utils/routing';
import { getHomepageServicesData } from '../utils/homepageData';
import { getProjectUrl } from '../utils/routing';
import { capitalize } from '../utils/helpers';

// Set language to German
const currentLang: 'de' = 'de';
const basePath = getBasePath(currentLang);

// Best case study for banner - Fitovision: The All-in-One Gym Platform
const bestCaseStudy = {
  slug: 'fitovision-gym-saas',
  title: '⚡ 245% Traffic Boom 🚀',
  url: getProjectUrl(currentLang, 'fitovision-gym-saas')
};

// Generate services data based on language
const SERVICES_DATA = getHomepageServicesData(currentLang);

// Load projects dynamically from content/[lang] based on current language
const allProjects = await getCollection(`projects${capitalize(currentLang)}`);
const projects = allProjects
  .filter(project => {
    const parts = project?.filePath ? project.filePath.split('/') : [];
    const projectLang = parts[3] || 'en';
    return projectLang === currentLang;
  })
  .map((project) => {
    return {
      ...project.data,
      slug: project.data.slug || project.id,
      image: getProjectImage(project.data.slug || project.id),
      lang: currentLang
    };
  });

const TESTIMONIALS = testimonials.map(t => ({ ...t, image: t.image ? getTestimonalImage(t.image) : null }));

// Merge testimonials with projects - match by caseStudy slug or create fake project
const mergedTestimonialsWithProjects = TESTIMONIALS.map((testimonial) => {
  // Try to find matching project by caseStudy slug
  const matchingProject = projects.find(p => p.slug === testimonial.caseStudy);
  
  if (matchingProject) {
    return {
      ...testimonial,
      project: matchingProject
    };
  }
  
  // Create fake project with real name if no match found
  const fakeProject = {
    title: `How We Engineered ${testimonial.company} Platform`,
    description: testimonial.text.substring(0, 150) + '...',
    slug: testimonial.caseStudy || testimonial.company.toLowerCase().replace(/\s+/g, '-'),
    category: "UI-UX / SEO / CRM / Marketing",
    image: testimonial.image || null,
    featured: false,
    stats: [
      { value: "287%", label: "Growth" },
      { value: "90 Days", label: "Results" }
    ],
    lang: currentLang
  };
  
  return {
    ...testimonial,
    project: fakeProject
  };
});

---

<LayoutV2 
  title={t('homepage.page_title', currentLang)} 
  description={t('homepage.page_description', currentLang)}
  canonicalUrl="https://www.creativecomplete.com/de/"
  lang="de"
>

<!-- HERO SECTION - CONVERSION FOCUSED -->
<Hero 
  bannerText={bestCaseStudy.title}
  bannerLink={bestCaseStudy.url}
/>

<Process />

<Services />

<Testimonials items={mergedTestimonialsWithProjects} />

<!-- FINAL CTA -->
<BottomCTA 
  title={t('cta.title', currentLang)}
  subtitle={t('cta.subtitle', currentLang)}
  urgencyText={t('cta.urgency', currentLang)}
  valueProps={[]}
  primaryButton={{
    text: t('cta.primary_button', currentLang),
    href: getLocalizedUrl('/contact/', currentLang)
  }}
  securityNote={t('cta.security_note', currentLang)}
  showValueProps={false}
/>
</LayoutV2>
