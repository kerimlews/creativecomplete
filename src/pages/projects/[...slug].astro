---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BottomCTA from '../../components/BottomCTA.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  
  return projects.map((project) => {
    const lang = project?.filePath?.split('/')[3];
    const slug = project.id;
        
    return {
      params: { 
        slug: (lang === 'en' ? [slug] : [lang, slug]).join('/') 
      },
      props: { project },
    };
  });
}

const { project } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: `${Astro.url.origin}/` },
  { name: 'Projects', url: `${Astro.url.origin}/projects/` },
  { name: project.data.title, url: `${Astro.url.href}/` }
];

const images = import.meta.glob('/src/images/projects/*.{png,jpg,jpeg,webp}');

const projectImages = await Promise.all(Object.entries(images)
  .filter(([path]) => path.includes(`/src/images/projects/${project.id}`))
  .map(async ([path, image]) => ({
    src: image(),
    alt: project.data.title
  })));
  console.log(projectImages);
  
const hasMultipleImages = projectImages.length > 1;
const displayImages = hasMultipleImages ? projectImages.slice(0, 3) : projectImages;

const allProjects = await getCollection('projects');
const relatedArticles = allProjects
  .slice(0, 7)
  .map(project => ({
    slug: project.id,
    title: project.data.title,
    description: project.data.description,
    category: project.data.category || 'General',
    readTime: project.data.readTime || '5 min read'
  }));
---

<script src="../../scripts/imagePopup.ts"></script>

<Layout 
  title={project.data.title}
  description={project.data.description}
  breadcrumbs={breadcrumbs}
  openGraph={{
    title: project.data.title,
    description: project.data.description,
  }}
  service={project}
>
  <article class="service-detail">
    <header class="service-header">
      <div class="container">
        <nav class="breadcrumb">
          {breadcrumbs.map((bread, index) => index === breadcrumbs.length - 1 ? (
            <span style="white-space: nowrap;">{bread.name}</span>
          ) : (
            <a href={bread.url}>{bread.name}</a>
          ))}
        </nav>
        
        <!-- Move h1 to full width above the hero content -->
        <div class="service-title-fullwidth">
          <h1>{project.data.title}</h1>
        </div>
        
        <div class="service-hero">
          <div class="service-info">
            <!-- Remove the h1 from here -->
            <p class="service-description">{project.data.description}</p>
            
            <div class="service-meta">
              <div class="meta-item">
                <span class="meta-label">Stack</span>
                <span class="meta-value">{project.data.category}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Author</span>
                <a class="meta-value" href={`/kerim-alihodza/`}>Kerim Alihodza</a>
              </div>
              {project.data.stats && project.data.stats.length > 0 && (
                project.data.stats.map((stat, index) => (
                  <div class="stat" key={index}>
                    <div class="stat-value">{stat.value}</div>
                    <div class="stat-label">{stat.label}</div>
                  </div>
                ))
              )}
            </div>

            <div class="service-actions">
              {project.data.url && (
                <a 
                  href={project.data.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="cta-button cta-secondary cta-lg"
                >
                  View Live Project
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </a>
              )}
              
              <a href="/contact/" class="cta-button cta-primary cta-lg">
                Start Your Project Now
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2"/>
                </svg>
              </a>
            </div>
          </div>

          <div class="service-visual">
            {hasMultipleImages ? (
              <div class="stacked-images">
                {displayImages.map((img, index) => (
                  <div class="stacked-item" data-index={index}>
                    <Image 
                      src={img.src} 
                      alt={`${img.alt} - Image ${index + 1}`}
                      width={600}
                      height={400}
                      loading={index === 0 ? "eager" : "lazy"}
                    />
                  </div>
                ))}
                {projectImages.length > 3 && (
                  <div class="image-counter">
                    +{projectImages.length - 3} more
                  </div>
                )}
              </div>
            ) : projectImages.length === 1 ? (
              <div class="service-image">
                <Image 
                  src={projectImages[0].src} 
                  alt={projectImages[0].alt}
                  width={600}
                  height={500}
                  loading="eager"
                />
              </div>
            ) : (
              <div class="service-image">
                <div>No images available</div>
              </div>
            )}
          </div>

          <div class="image-popup" id="imagePopup">
            <div class="popup-content">
              <button class="close-btn" id="closePopup">×</button>
              <img class="popup-image" id="popupImage" />
              <button class="popup-nav prev" id="prevImage">‹</button>
              <button class="popup-nav next" id="nextImage">›</button>
              <div class="popup-counter" id="popupCounter"></div>
            </div>
          </div>
        </div>    
      </div>
    </header>

    <!-- Rest of your content remains the same -->
    <div class="service-content">
      <div class="container">
        <div class="content-container">
          <div class="main-content">
            <div set:html={project.rendered?.html} />
          </div>

          <aside class="related-articles-sidebar">
            <div class="sidebar-header">
              <h3>Related Articles</h3>
              <p>More insights you might find helpful</p>
            </div>
            
            <div class="related-articles-list">
              {relatedArticles.map(article => (
                <a href={`/projects/${article.slug}/`} class="related-article-card">
                  <span class="article-category">{article.category}</span>
                  <h4 class="article-title">{article.title}</h4>
                  <p class="article-excerpt">{article.description}</p>
                  <div class="article-meta">
                    <span class="read-time">📖 {article.readTime}</span>
                    <span class="article-link">Read more</span>
                  </div>
                </a>
              ))}
            </div>

            <div class="sidebar-cta">
              <h4>Need Help With Your Project?</h4>
              <p>Let's discuss how we can bring your ideas to life</p>
              <a href="/contact/" class="cta-button cta-primary">
                Get Free Consultation
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2"/>
                </svg>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </div>

    <BottomCTA title="Start Your Project" />
  </article>
</Layout>
