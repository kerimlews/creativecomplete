---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BottomCTA from '../../components/BottomCTA.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  
  return projects.map((project) => {
      
    // src/content/projects/en/paperpile-saas-scaling-case-study.md
    const lang = project?.filePath?.split('/')[3]; // 'en', 'de', etc.
    const slug = project.id; // actual slug
        
    return {
      params: { 
        slug: (lang === 'en' ? [slug] : [lang, slug]).join('/') 
      },
      props: { project },
    };
  });
}

const { project } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: Astro.url.origin },
  { name: 'Projects', url: `${Astro.url.origin}/projects` },
  { name: project.data.title, url: `${Astro.url.href}/` }
];

const images = import.meta.glob('/src/images/projects/*.{png,jpg,jpeg,webp}');

const path = `/src/images/projects/${project.id}.png`;

const image = images[path]();

// Get related articles (you can customize this logic based on your content)
const allProjects = await getCollection('projects');
const relatedArticles = allProjects
  .slice(0, 7) // Get top 3 related articles
  .map(project => ({
    slug: project.id,
    title: project.data.title,
    description: project.data.description,
    category: project.data.category || 'General',
    readTime: project.data.readTime || '5 min read'
  }));

---

<Layout 
  title={project.data.title}
  description={project.data.description}
  breadcrumbs={breadcrumbs}
  openGraph={{
    title: project.data.title,
    description: project.data.description,
    image: project.data.image
  }}
  service={project}
>
  <article class="service-detail">
    <header class="service-header">
      <div class="container">
        <nav class="breadcrumb">
          <a href="/">Home</a> / <a href="/projects/">Projects</a> / <span>{project.data.title}</span>
        </nav>
        <div class="service-hero">
          <div class="service-info">
            <h1>{project.data.title}</h1>
            <p class="service-description">{project.data.description}</p>
            
            <div class="service-meta">
              <div class="meta-item">
                <span class="meta-label">Stack</span>
                <span class="meta-value">{project.data.category}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Author</span>
                <a class="meta-value" href={`/kerim-alihodza/`}>Kerim Alihodza</a>
              </div>
              {project.data.stats && project.data.stats.length > 0 && (
                project.data.stats.map((stat, index) => (
                  <div class="stat" key={index}>
                    <div class="stat-value">{stat.value}</div>
                    <div class="stat-label">{stat.label}</div>
                  </div>
                ))
              )}
            </div>

            <div class="service-actions">
              <!-- Add View Live button if project has a live URL -->
              {project.data.url && (
                <a 
                  href={project.data.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="cta-button cta-secondary cta-lg"
                >
                  View Live Project
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </a>
              )}
              
              <a href="/contact/" class="cta-button cta-primary cta-lg">
                Start Your Project Now
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="service-visual">
            <Image src={image} alt={project.data.title} width={500} height={500} />
          </div>
        </div>    
      </div>
    </header>

    <div class="service-content">
      <div class="container">
        <div class="content-container">
          <!-- Main Content -->
          <div class="main-content">
            <div set:html={project.rendered?.html} />
          </div>

          <!-- Related Articles Sidebar -->
          <aside class="related-articles-sidebar">
            <div class="sidebar-header">
              <h3>Related Articles</h3>
              <p>More insights you might find helpful</p>
            </div>
            
            <div class="related-articles-list">
              {relatedArticles.map(article => (
                <a href={`/projects/${article.slug}/`} class="related-article-card">
                  <span class="article-category">{article.category}</span>
                  <h4 class="article-title">{article.title}</h4>
                  <p class="article-excerpt">{article.description}</p>
                  <div class="article-meta">
                    <span class="read-time">📖 {article.readTime}</span>
                    <span class="article-link">Read more</span>
                  </div>
                </a>
              ))}
            </div>

            <div class="sidebar-cta">
              <h4>Need Help With Your Project?</h4>
              <p>Let's discuss how we can bring your ideas to life</p>
              <a href="/contact/" class="cta-button cta-primary">
                Get Free Consultation
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2"/>
                </svg>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </div>

    <BottomCTA title="Start Your Project" />
  </article>
</Layout>

<style>
  /* Service Detail Page Styles */
  .service-detail {
    background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
    color: var(--white);
    min-height: 100vh;
  }

  /* Style for the secondary button */
  .cta-secondary {
    background: transparent;
    border: 2px solid #4299e1;
    color: #4299e1;
  }

  .cta-secondary:hover {
    background: #4299e1;
    color: white;
  }

  .service-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Content Layout */
  .content-container {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 3rem;
    align-items: start;
  }

  .main-content {
    max-width: 100%;
  }

  /* Related Articles Sidebar */
  .related-articles-sidebar {
    position: sticky;
    top: 2rem;
  }

  .sidebar-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .sidebar-header h3 {
    background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .sidebar-header p {
    color: #A0AEC0;
    font-size: 0.9rem;
  }

  .related-articles-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .related-article-card {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .related-article-card:hover {
    transform: translateY(-3px);
    border-color: #FF6B35;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1), 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .related-article-card:hover .article-title {
    color: #FF8C42;
  }

  .related-article-card:hover .article-link {
    color: #FF8C42;
    transform: translateX(3px);
  }

  .article-category {
    display: inline-block;
    background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .article-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: white;
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .article-excerpt {
    color: #A0AEC0;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: #A0AEC0;
  }

  .read-time {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .article-link {
    color: #FF6B35;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .article-link::after {
    content: '→';
    transition: transform 0.3s ease;
  }

  .related-article-card:hover .article-link::after {
    transform: translateX(3px);
  }

  .sidebar-cta {
    margin-top: 3rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.1) 0%, rgba(255, 140, 66, 0.05) 100%);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .sidebar-cta h4 {
    background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
  }

  .sidebar-cta p {
    color: #A0AEC0;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .sidebar-cta .cta-button {
    width: 100%;
    justify-content: center;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .content-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .related-articles-sidebar {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .service-actions {
      flex-direction: column;
    }

    .content-container {
      gap: 1.5rem;
    }

    .related-article-card {
      padding: 1.25rem;
    }

    .sidebar-cta {
      margin-top: 2rem;
      padding: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .article-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .article-link {
      align-self: flex-end;
    }
  }
</style>