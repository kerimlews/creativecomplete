---
// src/pages/projects/index.astro
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BreadCrumb from '../../components/BreadCrumb.astro';
import { getCollection } from 'astro:content';
import BottomCTA from '../../components/BottomCTA.astro';
import { t, getLocalizedUrl } from '../../utils/translations';
import { getProjectUrl, getBasePath, detectLanguageFromPath, filterByLanguage } from '../../utils/routing';
import type { Language } from '../../utils/translations';
import { getProjectsByLanguage } from '../../content.config';

// Detect language from URL
const currentLang: Language = detectLanguageFromPath(Astro.url.pathname);
const basePath = getBasePath(currentLang);

const images = import.meta.glob('/src/images/projects/*.{png,jpg,jpeg,webp}');

// Function to get project image by slug
async function getImage(slug: string) {
  if (!slug) return null;
  
  // Try different extensions and path variations
  const extensions = ['png', 'jpg', 'jpeg', 'webp'];
  const baseName = slug.replace(/\.(png|jpg|jpeg|webp)$/, ''); // Remove extension if present
  
  for (const ext of extensions) {
    const imagePath = `/src/images/projects/${baseName}.${ext}`;
    if (images[imagePath]) {
      try {
        const imageModule = await images[imagePath]();
        // Check if it's a valid ImageMetadata object
        if (imageModule && typeof imageModule === 'object') {
          // import.meta.glob for images returns { default: ImageMetadata }
          return ('default' in imageModule ? imageModule.default : imageModule) as any;
        }
      } catch (e) {
        // Continue to next extension
        continue;
      }
    }
  }
  
  return null;
}

// Get all projects and filter by language
const projects = await getCollection('projectsEn');

// Transform projects data for the card component
const transformedProjects = await Promise.all(projects.map(async project => {
  // Extract stats from project data if available
  const stats = project.data.stats || [];
  const projectImage = project.data.image;

  if (!projectImage) {
    console.warn('Project image is missing for: ' + project.id);
    return null;
  }

  const image = await getImage(projectImage);

  if (!image) {
    console.warn('Project image not found for: ' + project.id + ' (slug: ' + projectImage + ')');
    return null;
  }

  // Validate image is a proper ImageMetadata object
  if (typeof image !== 'object' || !('src' in image)) {
    console.warn('Invalid image metadata for: ' + project.id);
    return null;
  }

  return {
    title: project.data.title,
    description: project.data.description,
    image,
    slug: project.data.slug || projectImage,
    category: project.data.category,
    url: project.data.url,
    featured: project.data.featured,
    logo: project.data.logo || null,
    stats: stats
  };
}));

// Filter out null values
const validProjects = transformedProjects.filter((project): project is NonNullable<typeof project> => project !== null);

// Sort projects by featured first, then by published date
const sortedProjects = validProjects.toSorted((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return 0;
});


// Generate JSON-LD for projects page
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": t('projects.title', currentLang),
  "description": t('projects.subtitle', currentLang),
  "numberOfItems": projects.length,
  "itemListElement": projects.map((project, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "CreativeWork",
      "name": project.data.title,
      "description": project.data.description,
      "url": `${Astro.url.origin}${getProjectUrl(currentLang, project.data.slug || project.id)}`,
      "genre": project.data.category
    }
  }))
};

const breadcrumbs = [
  { name: t('nav.home', currentLang), url: `${Astro.url.origin}${basePath}/` },
  { name: t('nav.projects', currentLang), url: Astro.url.href }
];

---

<Layout 
  title={t('projects.title', currentLang)}
  description={t('projects.subtitle', currentLang)}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
  openGraph={{
    title: t('projects.title', currentLang),
    description: t('projects.subtitle', currentLang),
  }}
  priority={8}
>
  <div class="services-page projects-page">
    <!-- Merged Hero & Projects Grid Section -->
    <section class="projects-hero-grid section-padding">
      <div class="container">
        <div class="hero-content text-center">
          <BreadCrumb items={breadcrumbs} />
        </div>
        
        <div class="section-header text-center">
          <h2>Our Project Portfolio</h2>
          <p class="section-subtitle">Each project includes detailed case studies with verified metrics and real business outcomes</p>
        </div>

        <!-- Projects Grid -->
        <div class="projects-grid" id="projectsGrid">
          {sortedProjects.map((project, index) => (
            <ProjectCard 
              project={{
                ...project,
                slug: project.slug,
                lang: currentLang
              }} 
              data-index={index}
            />
          ))}
        </div>

        <!-- Empty State -->
        {projects.length === 0 && (
          <div class="empty-state text-center">
            <h3>{t('projects.no_projects', currentLang)}</h3>
            <p>{t('projects.no_projects_desc', currentLang)}</p>
            <a href={getLocalizedUrl('/contact/', currentLang)} class="cta-button cta-primary">{t('nav.contact', currentLang)}</a>
          </div>
        )}
      </div>
    </section>

    <BottomCTA 
      title={t('cta.title', currentLang)}
      subtitle={t('cta.subtitle', currentLang)}
      urgencyText={t('cta.urgency', currentLang)}
      valueProps={[]}
      primaryButton={{
        text: t('cta.primary_button', currentLang),
        href: getLocalizedUrl('/contact/', currentLang)
      }}
      securityNote={t('cta.security_note', currentLang)}
      showValueProps={false}
    />
  </div>
</Layout>

<script>
  // Intersection Observer for scroll animations
  document.addEventListener('DOMContentLoaded', function() {
    // Animate project cards
    const projectCards = document.querySelectorAll('.project-card');
    
    const cardObserverOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };
    
    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('animate-in');
          }, index * 100); // Stagger animation
          cardObserver.unobserve(entry.target);
        }
      });
    }, cardObserverOptions);
    
    projectCards.forEach(card => {
      cardObserver.observe(card);
    });
  });
</script>

