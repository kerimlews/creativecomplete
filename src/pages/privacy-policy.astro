---
// src/pages/privacy-policy.astro
import { Image } from 'astro:assets';
import BottomCTA from '../components/BottomCTA.astro';
import Layout from '../layouts/Layout.astro';
import logo from '../images/logo-svg.svg';

const pageTitle = 'Privacy Policy - Creative Complete';
const pageDescription = 'Learn how Creative Complete protects your privacy and handles your data. Our commitment to transparency and GDPR compliance.';
const canonicalUrl = '/privacy-policy/';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy-policy/' }
];
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <div class="service-detail">
    <!-- Header Section -->
    <section class="service-header">
      <div class="container">
        <nav class="breadcrumb">
          <a href="/">Home</a>
          <span>›</span>
          <span>Privacy Policy</span>
        </nav>
        
        <div class="service-hero">
          <div class="service-info">
            <h1>Privacy Policy</h1>
            <p class="service-description">
              Your privacy is important to us. This policy explains how we collect, use, and protect your personal information.
            </p>
            
            <div class="service-meta">
              <div class="meta-item">
                <span class="meta-label">Last Updated</span>
                <span class="meta-value">December 2024</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Compliance</span>
                <span class="featured-badge">GDPR Ready</span>
              </div>
            </div>
          </div>
          
          <div class="service-visual">
            <Image
              src={logo} 
              alt="Privacy Protection" 
              width="400" 
              height="300"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Policy Content -->
    <section class="service-content">
      <div class="container">
        <div class="content-container">
          <!-- Main Content -->
          <article class="main-content">
            <div class="content-section">
              <h2>1. Information We Collect</h2>
              
              <h3>1.1 Personal Information</h3>
              <p>We may collect personal information that you voluntarily provide to us, including:</p>
              <ul>
                <li>Name and contact information (email, phone number)</li>
                <li>Company information and job title</li>
                <li>Project details and requirements</li>
                <li>Communication preferences</li>
                <li>Billing and payment information</li>
              </ul>

              <h3>1.2 Automatically Collected Information</h3>
              <p>With your consent, we use Google Analytics to collect:</p>
              <ul>
                <li>IP address (anonymized)</li>
                <li>Browser type and version</li>
                <li>Pages visited and time spent</li>
                <li>Referring website and exit pages</li>
                <li>Device information and operating system</li>
                <li>Clickstream data and interactions</li>
              </ul>
            </div>

            <div class="content-section">
              <h2>2. How We Use Your Information</h2>
              <p>We use the collected information for legitimate business purposes:</p>
              <ul>
                <li>Providing and improving our digital agency services</li>
                <li>Communicating with you about projects and inquiries</li>
                <li>Analyzing website performance and user behavior</li>
                <li>Marketing and business development (with your consent)</li>
                <li>Legal compliance and fraud prevention</li>
                <li>Customer support and service delivery</li>
              </ul>
            </div>

            <div class="content-section">
              <h2>3. Google Analytics & Cookies</h2>
              
              <div class="feature-card">
                <h3>Cookie Consent Management</h3>
                <p>We use Google Analytics with explicit user consent. You have full control over your cookie preferences through our consent management platform.</p>
                
                <h4>Types of Cookies We Use:</h4>
                <ul>
                  <li><strong>Essential Cookies:</strong> Required for basic website functionality</li>
                  <li><strong>Analytics Cookies:</strong> Help us understand how visitors interact with our website</li>
                  <li><strong>Marketing Cookies:</strong> Used to track effectiveness of campaigns (optional)</li>
                </ul>
              </div>

              <p>All data collected through Google Analytics is anonymized and aggregated for analysis purposes. We do not use this data to identify individual users.</p>
            </div>

            <div class="content-section">
              <h2>4. Data Sharing and Disclosure</h2>
              <p>We do not sell your personal information. We may share data with:</p>
              <ul>
                <li>Service providers (like Google Analytics, hosting providers)</li>
                <li>Legal authorities when required by law</li>
                <li>Business partners with your explicit consent</li>
                <li>Payment processors for transaction completion</li>
              </ul>
              <p>All third-party providers are vetted for GDPR compliance and data protection standards.</p>
            </div>

            <div class="content-section">
              <h2>5. Data Retention</h2>
              <p>We retain personal information only as long as necessary for the purposes outlined in this policy, or as required by law. Typical retention periods:</p>
              <ul>
                <li>Client project data: 7 years after project completion</li>
                <li>Marketing communications: Until consent is withdrawn</li>
                <li>Analytics data: 26 months maximum</li>
                <li>Financial records: 7 years for tax purposes</li>
              </ul>
            </div>

            <div class="content-section">
              <h2>6. Your Rights</h2>
              <p>Under GDPR and other privacy laws, you have the right to:</p>
              <ul>
                <li>Access your personal data</li>
                <li>Correct inaccurate data</li>
                <li>Request deletion of your data (Right to be Forgotten)</li>
                <li>Withdraw consent for data processing</li>
                <li>Object to data processing</li>
                <li>Data portability</li>
                <li>Restrict processing in certain circumstances</li>
              </ul>
              
              <p>To exercise any of these rights, please contact us at <strong>info@creativecomplete.com</strong>.</p>
            </div>

            <div class="content-section">
              <h2>7. Data Security</h2>
              <p>We implement appropriate security measures to protect your personal information from unauthorized access, alteration, or destruction. These include:</p>
              <ul>
                <li>SSL encryption on all data transmissions</li>
                <li>Regular security audits and updates</li>
                <li>Access controls and authentication protocols</li>
                <li>Secure data storage with encryption at rest</li>
                <li>Employee training on data protection</li>
              </ul>
            </div>

            <div class="content-section">
              <h2>8. International Data Transfers</h2>
              <p>Your data may be processed in countries outside your residence. We ensure adequate protection through:</p>
              <ul>
                <li>Standard Contractual Clauses (SCCs)</li>
                <li>Adequacy decisions where applicable</li>
                <li>Binding Corporate Rules for intra-company transfers</li>
                <li>Data protection impact assessments</li>
              </ul>
            </div>

            <div class="content-section">
              <h2>9. Children's Privacy</h2>
              <p>Our services are not directed to individuals under 16. We do not knowingly collect personal information from children. If we become aware that we have collected personal data from a child without verification of parental consent, we take steps to remove that information.</p>
            </div>

            <div class="content-section">
              <h2>10. Changes to This Policy</h2>
              <p>We may update this privacy policy periodically to reflect changes in our practices or legal requirements. We will notify you of significant changes by:</p>
              <ul>
                <li>Posting the new policy on our website with updated date</li>
                <li>Sending email notifications to registered users</li>
                <li>Displaying prominent notices on our platform</li>
              </ul>
            </div>

            <div class="content-section">
              <h2>11. Contact Us</h2>
              <p>If you have any questions about this Privacy Policy or our data practices, please contact our Data Protection Officer:</p>
              
              <div class="feature-card">
                <h4>Creative Complete Data Protection</h4>
                <ul>
                  <li>Email: privacy@creativecomplete.com</li>
                  <li>Website: www.creativecomplete.com</li>
                  <li>Response Time: Within 48 hours</li>
                </ul>
              </div>
              
              <p>You also have the right to lodge a complaint with your local data protection authority.</p>
            </div>
          </article>

          <!-- Sidebar -->
          <aside class="related-articles-sidebar">
            <div class="sidebar-header">
              <h3>Privacy Resources</h3>
              <p>Quick access to related information</p>
            </div>

            <div class="related-articles-list">
              <a href="/terms-of-use/" class="related-article-card">
                <span class="article-category">Legal</span>
                <h4 class="article-title">Terms of Use</h4>
                <p class="article-excerpt">Understand the terms governing your use of our services and website.</p>
                <div class="article-meta">
                  <span class="read-time">📄 Legal Document</span>
                  <span class="article-link">Read More</span>
                </div>
              </a>

              <a href="/contact/" class="related-article-card">
                <span class="article-category">Support</span>
                <h4 class="article-title">Contact DPO</h4>
                <p class="article-excerpt">Get in touch with our Data Protection Officer for privacy concerns.</p>
                <div class="article-meta">
                  <span class="read-time">👥 Support</span>
                  <span class="article-link">Contact Us</span>
                </div>
              </a>
            </div>

            <div class="sidebar-cta">
              <h4>Privacy Questions?</h4>
              <p>We're here to help you understand your data rights and our privacy practices.</p>
              <a href="/contact/" class="cta-button primary">Contact Our DPO</a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <BottomCTA />
  </div>
</Layout>