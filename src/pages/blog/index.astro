---
import { getCollection } from 'astro:content';
import LayoutV2 from '../../layouts/LayoutV2.astro';

const allPosts = await getCollection('blogs');

// Sort by priority desc, then published date desc
const posts = allPosts
  .map(post => {
    const wordCount = (post.body ?? '').replace(/<[^>]+>/g, '').split(/\s+/).length;
    const readMinutes = Math.max(1, Math.round(wordCount / 200));
    return {
      slug: (post.data.slug ?? post.id) as string,
      title: post.data.title as string,
      description: post.data.description as string,
      category: (post.data.category ?? 'Blog') as string,
      tags: (post.data.tags as string[] | undefined) ?? [],
      published: post.data.published as string,
      priority: (post.data.priority as number | undefined) ?? 0,
      readMinutes,
    };
  })
  .sort((a, b) => {
    if (b.priority !== a.priority) return b.priority - a.priority;
    return new Date(b.published).getTime() - new Date(a.published).getTime();
  });

const categories = ['All', ...Array.from(new Set(posts.map(p => p.category)))];
---

<LayoutV2
  title="Blog — AI Customer Systems, Lead Management & Sales Automation | CreativeComplete"
  description="Practical guides on automated lead distribution, AI customer systems, and sales automation. Real numbers from real client builds."
  navActive="blog"
>
  <main>

    <!-- Hero -->
    <section class="blog-index-hero">
      <div class="v2-container">
        <span class="v2-eyebrow" data-m="fade">From the blog</span>
        <h1 class="v2-h2 blog-index-h1" data-m="up" style="--m-d:.05s">
          Guides that <span class="v2-grad">close deals.</span>
        </h1>
        <p class="v2-lead blog-index-lead" data-m="up" style="--m-d:.1s">
          Practical breakdowns on automated lead distribution, AI systems, and sales automation — with real numbers from real builds.
        </p>

        <!-- Search -->
        <div class="blog-search" data-m="up" style="--m-d:.15s">
          <svg class="blog-search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.6"/>
            <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <input
            id="blog-search-input"
            class="blog-search__input"
            type="search"
            placeholder="Search articles…"
            autocomplete="off"
            aria-label="Search articles"
          />
          <span class="blog-search__kbd" aria-hidden="true">⌘K</span>
        </div>
      </div>
    </section>

    <!-- Posts grid -->
    <section class="blog-index-body">
      <div class="v2-container">

        <!-- Category filters -->
        <div class="blog-filters" id="blog-filters">
          {categories.map((cat, i) => (
            <button
              class:list={['blog-filter-btn', { active: i === 0 }]}
              data-cat={cat}
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- No results -->
        <p class="blog-no-results" id="blog-no-results" hidden>
          No articles match your search.
        </p>

        <!-- Cards -->
        <div class="blog-grid" id="blog-grid">
          {posts.map((post, i) => {
            const date = new Date(post.published).toLocaleDateString('en-US', {
              year: 'numeric', month: 'short', day: 'numeric',
            });
            return (
              <a
                href={`/blog/${post.slug}/`}
                class="blog-card"
                data-m="up"
                style={`--m-d:${i * 0.06}s`}
                data-title={post.title.toLowerCase()}
                data-desc={post.description.toLowerCase()}
                data-tags={post.tags.join(' ').toLowerCase()}
                data-cat={post.category}
              >
                <div class="blog-card__top">
                  <span class="blog-card__cat">{post.category}</span>
                  <span class="blog-card__meta">{date} · {post.readMinutes} min read</span>
                </div>

                <h2 class="blog-card__title">{post.title}</h2>
                <p class="blog-card__desc">{post.description}</p>

                <div class="blog-card__foot">
                  <div class="blog-card__tags">
                    {post.tags.slice(0, 3).map(tag => (
                      <span class="blog-card__tag">{tag}</span>
                    ))}
                  </div>
                  <span class="blog-card__arrow">
                    Read
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>

      </div>
    </section>

  </main>
</LayoutV2>

<script>
const input   = document.getElementById('blog-search-input') as HTMLInputElement;
const grid    = document.getElementById('blog-grid');
const noRes   = document.getElementById('blog-no-results');
const filters = document.getElementById('blog-filters');
const cards   = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.blog-card')) : [];

let activeCat = 'All';

function filterCards() {
  const q = input?.value.toLowerCase().trim() ?? '';
  let visible = 0;

  cards.forEach(card => {
    const matchSearch =
      !q ||
      (card.dataset.title ?? '').includes(q) ||
      (card.dataset.desc ?? '').includes(q) ||
      (card.dataset.tags ?? '').includes(q);

    const matchCat =
      activeCat === 'All' || card.dataset.cat === activeCat;

    const show = matchSearch && matchCat;
    card.hidden = !show;
    if (show) visible++;
  });

  if (noRes) noRes.hidden = visible > 0;
}

input?.addEventListener('input', filterCards);

// Keyboard shortcut ⌘K / Ctrl+K
document.addEventListener('keydown', e => {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
    e.preventDefault();
    input?.focus();
  }
});

// Category filter buttons
filters?.addEventListener('click', e => {
  const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.blog-filter-btn');
  if (!btn) return;
  filters.querySelectorAll('.blog-filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  activeCat = btn.dataset.cat ?? 'All';
  filterCards();
});
</script>

<style lang="scss">
/* Hero */
.blog-index-hero {
  padding: 72px 0 48px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;

  .v2-eyebrow { margin-bottom: 16px; }
}
.blog-index-h1 { margin: 0 0 16px; max-width: 18ch; }
.blog-index-lead { margin: 0 0 36px; max-width: 54ch; }

/* Search */
.blog-search {
  position: relative;
  width: 100%;
  max-width: 480px;
}
.blog-search__icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: rgba(255,255,255,0.3);
  pointer-events: none;
}
.blog-search__input {
  width: 100%;
  height: 48px;
  padding: 0 48px 0 44px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  color: rgba(255,255,255,0.9);
  font-size: 14px;
  font-family: inherit;
  outline: none;
  box-sizing: border-box;
  transition: border-color .2s, background .2s;

  &::placeholder { color: rgba(255,255,255,0.28); }
  &:focus {
    border-color: rgba(99,102,241,0.5);
    background: rgba(99,102,241,0.06);
  }

  /* Remove browser search cancel button */
  &::-webkit-search-cancel-button { display: none; }
}
.blog-search__kbd {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-family: ui-monospace, monospace;
  font-size: 10px;
  color: rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 5px;
  padding: 2px 6px;
  pointer-events: none;
}

/* Body */
.blog-index-body { padding: 0 0 96px; }

/* Filters */
.blog-filters {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 40px;
}
.blog-filter-btn {
  height: 34px;
  padding: 0 16px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.1);
  background: transparent;
  color: rgba(255,255,255,0.45);
  font-size: 13px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  transition: border-color .15s, color .15s, background .15s;

  &:hover {
    border-color: rgba(99,102,241,0.4);
    color: rgba(255,255,255,0.8);
  }
  &.active {
    background: rgba(99,102,241,0.12);
    border-color: rgba(99,102,241,0.45);
    color: #a5b4fc;
  }
}

/* No results */
.blog-no-results {
  text-align: center;
  color: rgba(255,255,255,0.3);
  font-size: 15px;
  padding: 64px 0;
}

/* Grid */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
}

/* Card */
.blog-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 28px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  text-decoration: none;
  transition: border-color .2s, background .2s, transform .2s;

  &:hover {
    border-color: rgba(99,102,241,0.35);
    background: rgba(99,102,241,0.05);
    transform: translateY(-2px);

    .blog-card__arrow { color: #a5b4fc; gap: 6px; }
  }
}
.blog-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.blog-card__cat {
  font-family: ui-monospace, monospace;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #a5b4fc;
  background: rgba(99,102,241,0.12);
  border: 1px solid rgba(99,102,241,0.22);
  padding: 2px 8px;
  border-radius: 20px;
  white-space: nowrap;
}
.blog-card__meta {
  font-family: ui-monospace, monospace;
  font-size: 10px;
  color: rgba(255,255,255,0.25);
  white-space: nowrap;
}
.blog-card__title {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -.02em;
  line-height: 1.3;
  color: rgba(255,255,255,0.9);
  margin: 0;
}
.blog-card__desc {
  font-size: 13.5px;
  line-height: 1.6;
  color: rgba(255,255,255,0.4);
  margin: 0;
  flex: 1;

  /* Clamp to 3 lines */
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.blog-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: auto;
  padding-top: 4px;
}
.blog-card__tags {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}
.blog-card__tag {
  font-size: 10px;
  color: rgba(255,255,255,0.25);
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  padding: 2px 7px;
  border-radius: 20px;
}
.blog-card__arrow {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 600;
  color: rgba(99,102,241,0.7);
  white-space: nowrap;
  flex-shrink: 0;
  transition: color .15s, gap .15s;
}
</style>
