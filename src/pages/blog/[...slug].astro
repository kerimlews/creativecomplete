---
import LayoutV2 from '../../layouts/LayoutV2.astro';
import CTA from '../../components/v2/CTA.astro';
import AuthorBadge from '../../components/v2/AuthorBadge.astro';
import LeadRoutingMotion from '../../components/v2/LeadRoutingMotion.astro';
import AICreativeMotion from '../../components/v2/AICreativeMotion.astro';
import BroadcastMotion from '../../components/v2/BroadcastMotion.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('blogs');
  return all.map((post) => ({
    params: { slug: post.data.slug as string },
    props: { postId: post.id },
  }));
}

const { postId } = Astro.props;

const post = await getCollection('blogs').then(
  (ps) => ps.find((p) => p.id === postId)
);
if (!post) throw new Error(`Blog post not found: ${postId}`);

const slug         = (post.data.slug ?? post.id) as string;
const title        = post.data.title as string;
const description  = post.data.description as string;
const category     = (post.data.category ?? 'Blog') as string;
const tags         = (post.data.tags as string[] | undefined) ?? [];
const faqItems     = (post.data.faq as { question: string; answer: string }[] | undefined) ?? [];
const published    = post.data.published as string;
const updated      = (post.data.updated ?? published) as string;

const publishedDate  = new Date(published);
const publishedYear  = publishedDate.getFullYear();
const publishedFmt   = publishedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonicalUrl = `${Astro.url.origin}/blog/${slug}/`;
const ogImage = `${Astro.url.origin}/images/og/${slug}.svg`;

// Sidebar: related service page per post
const serviceLink: Record<string, { href: string; label: string }> = {
  'speed-to-lead':               { href: '/services/speed-to-lead-system/',          label: 'Speed to Lead System' },
  'ai-lead-qualification':       { href: '/services/ai-lead-qualification/',         label: 'AI Lead Qualification' },
  'automated-lead-distribution': { href: '/services/ai-lead-qualification/',         label: 'AI Lead Qualification' },
  'whatsapp-broadcast-campaigns':{ href: '/services/whatsapp-database-monetization/', label: 'WhatsApp Monetization' },
  'whatsapp-lead-generation':    { href: '/services/whatsapp-database-monetization/', label: 'WhatsApp Monetization' },
  'ai-ad-creatives':             { href: '/services/ai-ad-creative-engine/',         label: 'AI Ad Creative Engine' },
  'ad-creative-testing':         { href: '/services/ai-ad-creative-engine/',         label: 'AI Ad Creative Engine' },
  'ai-sales-agents':             { href: '/services/ai-lead-qualification/',         label: 'AI Lead Qualification' },
  'crm-automation':              { href: '/services/ai-lead-qualification/',         label: 'AI Lead Qualification' },
};
const relatedService = serviceLink[slug];

// Sidebar: relevant case study per post
const caseStudyLink: Record<string, { href: string; label: string; cat: string }> = {
  'speed-to-lead':               { href: '/projects/parcel-daily-conversion-boost/',      label: 'Parcel Daily: 60% Conversion Boost',   cat: 'Logistics · AI' },
  'ai-lead-qualification':       { href: '/projects/imotorbike-ai-lead-qualification/',   label: 'iMotorbike: 2× Daily Lead Capacity',   cat: 'Automotive · AI' },
  'automated-lead-distribution': { href: '/projects/imotorbike-ai-lead-qualification/',   label: 'iMotorbike: 2× Daily Lead Capacity',   cat: 'Automotive · AI' },
  'whatsapp-broadcast-campaigns':{ href: '/projects/only-tourism-ai-visa-automation/',    label: 'Only Tourism: 6× Monthly Leads',       cat: 'Travel · AI' },
  'whatsapp-lead-generation':    { href: '/projects/only-tourism-ai-visa-automation/',    label: 'Only Tourism: 6× Monthly Leads',       cat: 'Travel · AI' },
  'ai-ad-creatives':             { href: '/projects/parcel-daily-conversion-boost/',      label: 'Parcel Daily: 60% Conversion Boost',   cat: 'Logistics · AI' },
  'ad-creative-testing':         { href: '/projects/nianave-ecommerce-scaling-case-study/', label: 'Nianave: $30k → $120k/Month',        cat: 'E-commerce · Marketing' },
  'ai-sales-agents':             { href: '/projects/only-tourism-ai-visa-automation/',    label: 'Only Tourism: 6× Monthly Leads',       cat: 'Travel · AI' },
  'crm-automation':              { href: '/projects/prepme-automation-saas/',             label: 'PrepMe: 280 Hours/Month Saved',        cat: 'SaaS · Automation' },
};
const relatedCaseStudy = caseStudyLink[slug];

// Reading time estimate
const wordCount = (post.rendered?.html ?? '').replace(/<[^>]+>/g, '').split(/\s+/).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

// JSON-LD schemas
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "url": canonicalUrl,
  "datePublished": published,
  "dateModified": updated,
  "author": {
    "@type": "Person",
    "name": "Kerim Alihodza",
    "url": `${Astro.url.origin}/kerim-alihodza/`,
  },
  "publisher": {
    "@type": "Organization",
    "name": "CreativeComplete",
    "url": Astro.url.origin,
  },
  "keywords": tags.join(', '),
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
};

const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer },
  })),
} : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": Astro.url.origin + '/' },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": Astro.url.origin + '/blog/' },
    { "@type": "ListItem", "position": 3, "name": title, "item": canonicalUrl },
  ],
};

const structuredData = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];

// Detect which motion graphic to show based on category/tags
const showRoutingMotion = ['automated lead distribution', 'speed to lead', 'AI lead qualification', 'lead scoring', 'AI sales agents', 'automated follow-up'].some(t => tags.includes(t))
  || ['automated-lead-distribution', 'speed-to-lead', 'ai-lead-qualification', 'ai-sales-agents'].includes(slug);
const showCreativeMotion = ['AI ad creatives', 'ad creative testing', 'creative optimization'].some(t => tags.includes(t))
  || ['ai-ad-creatives', 'ad-creative-testing'].includes(slug);
const showBroadcastMotion = ['WhatsApp broadcast', 'WhatsApp marketing', 'WhatsApp lead generation', 'WhatsApp sales'].some(t => tags.includes(t))
  || ['whatsapp-broadcast-campaigns', 'whatsapp-lead-generation'].includes(slug);

// Related posts (same category, excluding current)
const allPosts = await getCollection('blogs');
const relatedPosts = allPosts
  .filter(p => {
    const pCat = (p.data.category ?? 'Blog') as string;
    const pSlug = (p.data.slug ?? p.id) as string;
    return pCat === category && pSlug !== slug;
  })
  .map(p => ({
    slug: (p.data.slug ?? p.id) as string,
    title: p.data.title as string,
    description: p.data.description as string,
    category: (p.data.category ?? 'Blog') as string,
    priority: (p.data.priority as number | undefined) ?? 0,
    readMinutes: Math.max(1, Math.round(((p.body ?? '').split(/\s+/).length) / 200)),
  }))
  .sort((a, b) => b.priority - a.priority)
  .slice(0, 3);
---

<LayoutV2
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  structuredData={structuredData}
  navActive="results"
>
  <main>

    <!-- Breadcrumb -->
    <div class="v2-container blog-breadcrumb">
      <a href="/">Home</a><span>/</span>
      <a href="/blog/">Blog</a><span>/</span>
      <span>{title}</span>
    </div>

    <!-- Hero -->
    <section class="blog-hero">
      <div class="v2-container">
        <div class="blog-hero__inner">

          <!-- Left: headline + meta -->
          <div class="blog-hero__left">
            <span class="v2-chip-neutral blog-category">{category}</span>

            <h1 class="v2-h2 blog-h1">{title}</h1>
            <p class="v2-lead blog-lead">{description}</p>

            <div class="blog-meta">
              <div class="blog-meta__item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span>{readMinutes} min read</span>
              </div>
              <div class="blog-meta__item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span>{publishedFmt}</span>
              </div>
            </div>

            <!-- Tags -->
            <div class="blog-tags">
              {tags.map((t) => <span class="v2-chip">{t}</span>)}
            </div>

            <AuthorBadge
              name="Kerim Alihodza"
              role="CEO & Business Mechanic"
              publishedYear={publishedYear}
            />
          </div>

          <!-- Right: motion graphic -->
          <div class="blog-hero__right">
            {showRoutingMotion && <LeadRoutingMotion />}
            {showCreativeMotion && <AICreativeMotion />}
            {showBroadcastMotion && <BroadcastMotion />}
          </div>
        </div>
      </div>
    </section>

    <!-- Stats bar -->
    <section class="blog-stats" aria-label="Key results">
      <div class="v2-container">
        <div class="blog-stats__inner">
          <div class="blog-stats__item" data-m>
            <div class="blog-stats__n" data-count="200">0%</div>
            <div class="blog-stats__label">More customers</div>
            <div class="blog-stats__sub">Optimize lead distribution to handle higher chat volumes</div>
          </div>
          <div class="blog-stats__divider" aria-hidden="true"></div>
          <div class="blog-stats__item" data-m>
            <div class="blog-stats__n" data-count="94">0%</div>
            <div class="blog-stats__label">Faster resolutions</div>
            <div class="blog-stats__sub">Route leads to the right agent for accurate replies</div>
          </div>
          <div class="blog-stats__divider" aria-hidden="true"></div>
          <div class="blog-stats__item" data-m>
            <div class="blog-stats__n" data-count="93">0%</div>
            <div class="blog-stats__label">CSAT Score</div>
            <div class="blog-stats__sub">Quick, expert answers deliver exceptional customer experiences</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Article content + sidebar -->
    <section class="v2-section" style="padding-top: 0">
      <div class="v2-container">
        <div class="blog-layout">

          <!-- Prose -->
          <article class="blog-prose v2-prose" set:html={post.rendered?.html} />

          <!-- Sidebar -->
          <aside class="blog-aside">

            <!-- Lead management quick reference -->
            {showRoutingMotion && slug === 'automated-lead-distribution' && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">7 Routing Rules</div>
                <ul class="blog-rules-list">
                  {['Agent Availability','Round Robin','Customer Type','Shift-Based','Language-Based','Skill-Based','Function-Based'].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String(i + 1).padStart(2, '0')}</span>
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {showRoutingMotion && slug === 'speed-to-lead' && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">Speed to Lead System</div>
                <ul class="blog-rules-list">
                  {['Instant Capture (all channels)','AI First Response (&lt;60s)','BANT Qualification','Lead Score (0–100)','Smart Routing','Hot Lead Handoff','Follow-up Sequences'].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String(i + 1).padStart(2, '0')}</span>
                      <span set:html={r} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {showRoutingMotion && ['ai-lead-qualification','ai-sales-agents'].includes(slug) && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">BANT Framework</div>
                <ul class="blog-rules-list">
                  {[
                    { label: 'Budget', desc: 'Financial capacity confirmed' },
                    { label: 'Authority', desc: 'Decision-maker identified' },
                    { label: 'Need', desc: 'Problem-solution fit confirmed' },
                    { label: 'Timeline', desc: 'Active buying window' },
                  ].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String.fromCharCode(66 + i)}</span>
                      <span><strong style="color:var(--fg-0)">{r.label}</strong> — {r.desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {showCreativeMotion && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">6 Creative Systems</div>
                <ul class="blog-rules-list">
                  {[
                    'Performance Scoring',
                    'Variant Generation',
                    'Multi-Platform Export',
                    'A/B Testing Automation',
                    'Brand-Locked Output',
                    'Retargeting Creatives',
                  ].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String(i + 1).padStart(2, '0')}</span>
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {showBroadcastMotion && (
              <div class="blog-aside__card">
                <div class="blog-aside__head">3 Broadcast Segments</div>
                <ul class="blog-rules-list">
                  {[
                    { label: 'Recent Buyers', desc: '0–90 days · 12–25% response' },
                    { label: 'Dormant High-Value', desc: '91–365 days · 8–18% response' },
                    { label: 'Unconverted Leads', desc: 'Warm interest · 5–12% response' },
                  ].map((r, i) => (
                    <li>
                      <span class="blog-rules-list__n">{String(i + 1).padStart(2, '0')}</span>
                      <span><strong style="color:var(--fg-0)">{r.label}</strong> — {r.desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Related service page -->
            {relatedService && (
              <a href={relatedService.href} class="blog-aside__service-link">
                <span class="blog-aside__service-eyebrow">This is part of our</span>
                <span class="blog-aside__service-name">{relatedService.label}</span>
                <span class="blog-aside__service-cta">
                  See the full service
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            )}

            <!-- Live case study -->
            {relatedCaseStudy && (
              <a href={relatedCaseStudy.href} class="blog-aside__case-link">
                <span class="blog-aside__case-eyebrow">Seen in production</span>
                <span class="blog-aside__case-cat">{relatedCaseStudy.cat}</span>
                <span class="blog-aside__case-title">{relatedCaseStudy.label}</span>
                <span class="blog-aside__case-read">
                  Read case study →
                </span>
              </a>
            )}

            <!-- CTA card -->
            <div class="blog-aside__cta">
              <div class="blog-aside__cta-glow" aria-hidden="true"></div>
              <p class="blog-aside__cta-text">Ready to build your AI Customer System?</p>
              <a
                href="javascript:void(0)"
                class="v2-btn v2-btn-primary blog-aside__cta-btn"
                data-cal-link="kerim-alihodza-7u7w6q/30min"
                data-cal-namespace="30min"
                data-cal-config='{"layout":"month_view","theme":"dark"}'
              >
                Get free system audit
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>

          </aside>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    {faqItems.length > 0 && (
      <section class="v2-section blog-faq-section">
        <div class="v2-container blog-faq-container">
          <div class="blog-faq-head">
            <span class="v2-eyebrow">FAQ</span>
            <h2 class="v2-h3 blog-faq-title">{title} — Questions Answered</h2>
          </div>
          <div class="blog-faq-list">
            {faqItems.map((item, i) => (
              <details class="blog-faq-item">
                <summary class="blog-faq-q">
                  <span class="blog-faq-n">{String(i + 1).padStart(2, '0')}</span>
                  {item.question}
                  <svg class="blog-faq-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="blog-faq-a">{item.answer}</div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Related posts -->
    {relatedPosts.length > 0 && (
      <section class="blog-related v2-section">
        <div class="v2-container">
          <div class="blog-related__head">
            <span class="v2-eyebrow">Read next</span>
            <h2 class="v2-h3 blog-related__title">More on {category}</h2>
          </div>
          <div class="blog-related__grid">
            {relatedPosts.map(p => (
              <a href={`/blog/${p.slug}/`} class="blog-related__card">
                <span class="blog-related__cat">{p.category}</span>
                <h3 class="blog-related__card-title">{p.title}</h3>
                <p class="blog-related__card-desc">{p.description}</p>
                <span class="blog-related__read">
                  {p.readMinutes} min read
                  <svg width="10" height="10" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                    <path d="M1.5 9.5L9.5 1.5M9.5 1.5H3.5M9.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <CTA />
  </main>
</LayoutV2>

<style lang="scss">
/* Breadcrumb */
.blog-breadcrumb {
  display: flex; align-items: center; gap: 8px;
  padding-top: 24px; padding-bottom: 8px;
  font-size: 13px; font-family: var(--font-mono); color: var(--fg-2);
  flex-wrap: wrap;
  a { color: var(--fg-2); transition: color .15s; &:hover { color: var(--c1-light); } }
}

/* Hero */
.blog-hero { padding: 48px 0 56px; }
.blog-hero__inner {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 64px;
  align-items: center;
  @media (max-width: 1024px) { grid-template-columns: 1fr; gap: 40px; }
  > * { min-width: 0; }
}
.blog-hero__left { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
.blog-hero__right { overflow: hidden; }
.blog-category { align-self: flex-start; }
.blog-h1 { margin: 0; }
.blog-lead { margin: 0; }

.blog-meta {
  display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
}
.blog-meta__item {
  display: flex; align-items: center; gap: 5px;
  font-size: 12px; font-family: var(--font-mono);
  color: var(--fg-2); letter-spacing: 0.04em;
  svg { color: var(--c1-light); }
}

.blog-tags { display: flex; gap: 6px; flex-wrap: wrap; }

/* Stats */
.blog-stats {
  padding: 0 0 48px;
}
.blog-stats__inner {
  display: flex;
  align-items: stretch;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--r-xl);
  overflow: hidden;
}
.blog-stats__item {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: 36px 24px; text-align: center;
  opacity: 0; transition: opacity .3s;
  &.io-in { opacity: 1; }
}
.blog-stats__divider {
  width: 1px; background: var(--line); flex-shrink: 0;
  @media (max-width: 640px) { display: none; }
}
.blog-stats__n {
  font-family: var(--font-display);
  font-size: clamp(36px, 5vw, 60px);
  letter-spacing: -0.02em;
  background: var(--grad-text);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; line-height: 1;
}
.blog-stats__label {
  font-size: 13px; font-weight: 600; color: var(--fg-0);
  margin-top: 8px;
}
.blog-stats__sub {
  font-size: 11.5px; color: var(--fg-2); line-height: 1.5;
  margin-top: 6px; max-width: 22ch;
}
@media (max-width: 640px) {
  .blog-stats__inner { flex-direction: column; }
  .blog-stats__item { border-bottom: 1px solid var(--line); &:last-child { border-bottom: none; } }
}

/* Content layout */
.blog-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 64px;
  align-items: start;
  @media (max-width: 1024px) { grid-template-columns: 1fr; gap: 48px; }
}

/* Prose */
.blog-prose {
  color: var(--fg-1); line-height: 1.8; font-size: 16px;

  :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 32px);
    letter-spacing: -0.015em; font-weight: 400;
    color: var(--fg-0); margin: 52px 0 16px; line-height: 1.15;
  }
  :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(18px, 1.6vw, 24px);
    letter-spacing: -0.01em; font-weight: 400;
    color: var(--fg-0); margin: 36px 0 12px;
  }
  :global(p) { margin: 0 0 18px; }
  :global(ul), :global(ol) {
    padding-left: 1.4em; margin: 0 0 18px;
    display: flex; flex-direction: column; gap: 8px;
  }
  :global(li) { color: var(--fg-1); }
  :global(strong) { color: var(--fg-0); font-weight: 600; }
  :global(a) {
    color: var(--c1-light); text-decoration: underline; text-underline-offset: 3px;
    &:hover { color: var(--fg-0); }
  }
  :global(blockquote) {
    border-left: 3px solid var(--c1); padding-left: 20px;
    margin: 28px 0; font-style: italic; color: var(--fg-1);
  }
  :global(hr) { border: 0; height: 1px; background: var(--line); margin: 36px 0; }
  :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    margin: 28px 0;
  }
  :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 14px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }
  :global(thead) {
    background: rgba(99,102,241,0.1);
  }
  :global(th) {
    font-family: var(--font-mono);
