---
import { getLanguageFromUrl, t } from '../utils/translations';

export interface Props {
  starsCount?: number;
  ratingPrefix?: string;
  rating?: string;
  ratingMiddleText?: string;
  clientsCount?: string;
  ratingPrefix2?: string;
}

const currentLang = getLanguageFromUrl(Astro.url);

const {
  starsCount = 5,
  ratingPrefix,
  rating = "5.0",
  ratingMiddleText,
  clientsCount = "30+",
  ratingPrefix2
} = Astro.props;

const defaultRatingPrefix = ratingPrefix || t('happy_clients.rate', currentLang);
const defaultRatingMiddleText = ratingMiddleText || t('happy_clients.by', currentLang);
const defaultRatingPrefix2 = ratingPrefix2 || t('happy_clients.happy_clients', currentLang);

// Generate stars array
const stars = Array.from({ length: starsCount }, () => "★");
---

<div class="hero-social-proof">
    <div class="stars-container">
    {stars.map((star) => (
      <span class="star">{star}</span>
    ))}
    </div>
    <span class="rating-text">{defaultRatingPrefix} <strong>{rating}</strong> {defaultRatingMiddleText} <strong>{clientsCount}</strong> {defaultRatingPrefix2}</span>
</div>