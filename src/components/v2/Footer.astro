    { label: "Speed to Lead",         href: "/blog/speed-to-lead/"                },
    { label: "AI Lead Qualification", href: "/blog/ai-lead-qualification/"        },
    { label: "WhatsApp Broadcasts",   href: "/blog/whatsapp-broadcast-campaigns/" },
