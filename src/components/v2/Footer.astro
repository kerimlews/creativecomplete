    { label: "Rezerviraj brezplačni audit", cal: true },
    { label: "Zasebnost",                   href: "/privacy-policy/" },
    { label: "Pogoji uporabe",              href: "/terms-of-use/"   },
  ],
};

const footerDesc: Record<string, string> = {
  en: "Your embedded AI Customer System team. We capture every lead, qualify them in 60 seconds, and monetize your existing database, fully managed, no headcount added.",
  de: "Ihr eingebettetes KI Customer System Team. Wir erfassen jeden Lead, qualifizieren ihn in 60 Sekunden und monetarisieren Ihre bestehende Datenbank — vollständig gemanagt, kein zusätzliches Personal.",
  sl: "Vaša vgrajena ekipa AI Customer System. Zajemamo vsak lead, ga kvalificiramo v 60 sekundah in monetiziramo vašo obstoječo bazo — popolnoma upravljano, brez novih zaposlitev.",
};

const auditLabel: Record<string, string> = {
  en: "Book free audit",
  de: "Kostenloses Audit buchen",
  sl: "Rezerviraj brezplačni audit",
};

const colHeads: Record<string, { system: string; services: string; blog: string; company: string; resources: string }> = {
  en: { system: "AI Customer System", services: "Services",        blog: "Blog", company: "Company",    resources: "Resources"  },
  de: { system: "KI Customer System", services: "Dienstleistungen", blog: "Blog", company: "Unternehmen", resources: "Ressourcen" },
  sl: { system: "AI Customer System", services: "Storitve",         blog: "Blog", company: "Podjetje",    resources: "Viri"       },
};

const legalLabel: Record<string, { copyright: string; privacy: string; terms: string; contact: string }> = {
  en: { copyright: "© 2026 CreativeComplete · AI Customer System Agency", privacy: "Privacy", terms: "Terms",       contact: "Contact" },
  de: { copyright: "© 2026 CreativeComplete · KI Customer System Agentur", privacy: "Datenschutz", terms: "AGB",   contact: "Kontakt" },
  sl: { copyright: "© 2026 CreativeComplete · AI Customer System agencija", privacy: "Zasebnost", terms: "Pogoji", contact: "Kontakt" },
};

const system   = systemLinks[lang];
const services = serviceLinks[lang];
const company  = companyLinks[lang];
const resources = resourceLinks[lang];
const heads    = colHeads[lang];
const legal    = legalLabel[lang];

const langs = [
  { code: "EN", href: "/"     },
  { code: "SL", href: "/sl/" },
  { code: "DE", href: "/de/" },
];
---

<footer class="v2-footer">
  <div class="v2-container">
    <div class="v2-footer__grid">
      <!-- Brand -->
      <div class="v2-footer__brand">
        <a href={`${base}/`} class="v2-footer__logo">
          <img src="/logo-gradient.svg" alt="CreativeComplete" class="v2-footer__logo-img" width="20" height="32" />
          <span class="v2-footer__logo-text">Creative<span class="v2-grad">Complete</span></span>
        </a>
        <p class="v2-footer__desc">{footerDesc[lang]}</p>
        <div class="v2-footer__partner-chips">
          <span class="v2-chip">WhatsApp Business API</span>
          <span class="v2-chip-cyan">AI Creative Engine</span>
        </div>
      </div>

      <!-- System -->
      <div>
        <div class="v2-footer__head">{heads.system}</div>
        <ul>
          {system.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <div class="v2-footer__head">{heads.services}</div>
        <ul>
          {services.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <!-- Blog (always EN) -->
      <div>
        <div class="v2-footer__head">{heads.blog}</div>
        <ul>
          {blogLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <div class="v2-footer__head">{heads.company}</div>
        <ul>
          {company.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <!-- Resources + CTA -->
      <div>
        <div class="v2-footer__head">{heads.resources}</div>
        <ul>
          {resources.map(l => (
            <li>
              {l.cal ? (
                <a
                  href="javascript:void(0)"
                  data-cal-link="kerim-alihodza-7u7w6q/30min"
                  data-cal-namespace="30min"
                  data-cal-config='{"layout":"month_view","theme":"dark"}'
                >{l.label}</a>
              ) : (
                <a href={l.href}>{l.label}</a>
              )}
            </li>
          ))}
        </ul>
        <div style="margin-top:24px">
          <a
            href="javascript:void(0)"
            data-cal-link="kerim-alihodza-7u7w6q/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","theme":"dark"}'
            class="v2-btn v2-btn-primary"
            style="height:42px;font-size:13px;"
          >
            {auditLabel[lang]}
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
              <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <hr class="v2-hr" style="margin:40px 0 24px" />

    <div class="v2-footer__legal">
      <div>{legal.copyright}</div>
      <div class="v2-footer__legal-right">
        <a href="/privacy-policy/">{legal.privacy}</a>
        <a href="/terms-of-use/">{legal.terms}</a>
        <a href={`${base}/contact/`}>{legal.contact}</a>
        <div class="v2-footer__langs">
          {langs.map(l => (
            <a href={l.href} class:list={['v2-footer__lang', { active: l.href === `${base}/` || (l.href === '/' && lang === 'en') }]}>{l.code}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
