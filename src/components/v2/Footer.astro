    { label: "AI kvalifikacija leadov",   href: "/sl/blog/ai-lead-qualification/"        },
    { label: "WhatsApp broadcast",        href: "/sl/blog/whatsapp-broadcast-campaigns/" },
    { label: "AI oglaševalski kreativci", href: "/sl/blog/ai-ad-creatives/"              },
    { label: "AI prodajni agenti",        href: "/sl/blog/ai-sales-agents/"              },
