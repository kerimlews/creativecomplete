---
// HeroMotion.astro — AI Customer System live dashboard
// 3 phases: Lead Capture → AI Qualify → Campaign Launch
// Social integrations orbit around the dashboard card
---

<div class="v2-hm" id="v2Hm">

  <!-- ── Orbiting integration icons ────────────────────────── -->
  <div class="v2-hm__orbs" aria-hidden="true">

    <!-- WhatsApp — left top -->
    <div class="v2-hm__orb wa" style="--d:0s">
      <svg width="30" height="30" viewBox="0 0 30 30">
        <rect width="30" height="30" rx="8" fill="#25d366"/>
        <path d="M15 5C9.48 5 5 9.48 5 15c0 1.85.5 3.59 1.38 5.08L5 25l5.04-1.35A10 10 0 1015 5zm0 18.2A8.2 8.2 0 116.8 15c0 1.5.41 2.9 1.12 4.1l.7 1.14-1.1.29 1.22-.04.75.75A8.18 8.18 0 0015 23.2zm4.6-5.86c-.24-.12-1.4-.69-1.62-.77-.21-.08-.37-.12-.52.12-.16.24-.6.77-.74.93-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2a7.3 7.3 0 01-1.34-1.67c-.14-.24-.01-.37.1-.49.1-.1.24-.28.36-.43.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.52-1.25-.71-1.71-.19-.45-.38-.39-.52-.4h-.45c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16z" fill="white"/>
      </svg>
      <span class="v2-hm__orb-ring"></span>
    </div>

    <!-- Instagram — right top -->
    <div class="v2-hm__orb ig" style="--d:.45s">
      <svg width="30" height="30" viewBox="0 0 30 30">
        <defs><linearGradient id="hig" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="35%" stop-color="#dc2743"/><stop offset="75%" stop-color="#cc2366"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs>
        <rect width="30" height="30" rx="8" fill="url(#hig)"/>
        <rect x="7" y="7" width="16" height="16" rx="4.5" fill="none" stroke="white" stroke-width="1.8"/>
        <circle cx="15" cy="15" r="4.5" fill="none" stroke="white" stroke-width="1.8"/>
        <circle cx="21.5" cy="8.5" r="1.3" fill="white"/>
      </svg>
      <span class="v2-hm__orb-ring"></span>
    </div>

    <!-- TikTok — left mid -->
    <div class="v2-hm__orb tt" style="--d:.9s">
      <svg width="30" height="30" viewBox="0 0 30 30">
        <rect width="30" height="30" rx="8" fill="#010101"/>
        <path d="M20.4 8.4a5.6 5.6 0 01-3.4-3.6h-2.8v13.7a2.84 2.84 0 01-2.83 2.6 2.84 2.84 0 01-2.84-2.84 2.84 2.84 0 012.84-2.84c.27 0 .53.04.77.11v-2.9a6.56 6.56 0 00-.77-.05 6.56 6.56 0 00-6.56 6.56 6.56 6.56 0 006.56 6.56 6.56 6.56 0 006.56-6.56V11.3a9.1 9.1 0 005.3 1.68V10.1a5.6 5.6 0 01-2.77-.33z" fill="white"/>
      </svg>
      <span class="v2-hm__orb-ring"></span>
    </div>

    <!-- Facebook — right mid -->
    <div class="v2-hm__orb fb" style="--d:1.35s">
      <svg width="30" height="30" viewBox="0 0 30 30">
        <rect width="30" height="30" rx="8" fill="#1877f2"/>
        <path d="M17.5 30V19h3.8l.57-4.4H17.5v-2.78c0-1.2.33-2.02 2.12-2.02H22V6.17A28.2 28.2 0 0018.8 6c-3.4 0-5.72 2.08-5.72 5.9v3.7H9.3V20h3.78V30h4.42z" fill="white"/>
      </svg>
      <span class="v2-hm__orb-ring"></span>
    </div>

    <!-- Meta Ads — top center -->
    <div class="v2-hm__orb meta" style="--d:1.8s">
      <svg width="30" height="30" viewBox="0 0 30 30">
        <rect width="30" height="30" rx="8" fill="#0668E1"/>
        <path d="M5 17.5C5 19.7 6.5 21.5 8.5 21.5s3.5-1.8 3.5-4c0-.65-.12-1.26-.34-1.8l-3.16-5.2-3.16 5.2c-.22.54-.34 1.15-.34 1.8zM15 13l-2.3 4h4.6L15 13zm6.5 8.5c1.93 0 3.5-1.8 3.5-4 0-.65-.12-1.26-.34-1.8l-3.16-5.2-3.16 5.2c-.22.54-.34 1.15-.34 1.8 0 2.2 1.57 4 3.5 4z" fill="white"/>
      </svg>
      <span class="v2-hm__orb-ring"></span>
    </div>

    <!-- Google Ads — bottom right -->
    <div class="v2-hm__orb gg" style="--d:2.25s">
      <svg width="30" height="30" viewBox="0 0 30 30">
        <rect width="30" height="30" rx="8" fill="#1a1a2e" opacity=".8"/>
        <rect width="30" height="30" rx="8" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="1"/>
        <path d="M24.5 15.24c0-.73-.07-1.44-.18-2.13H15v4.03h5.55a4.73 4.73 0 01-2.06 3.1v2.58h3.32C23.6 21.1 24.5 18.4 24.5 15.24z" fill="#4285f4"/>
        <path d="M15 25c2.77 0 5.1-.92 6.81-2.5l-3.32-2.58c-.92.62-2.1.98-3.49.98-2.68 0-4.95-1.81-5.76-4.24H5.84v2.67C7.53 22.56 11.07 25 15 25z" fill="#34a853"/>
        <path d="M9.24 16.66a5.94 5.94 0 01-.31-1.84c0-.64.11-1.26.31-1.84V10.1H5.84A10.44 10.44 0 005 14.82c0 1.68.4 3.27 1.12 4.67l3.12-2.83z" fill="#fbbc05"/>
        <path d="M15 9.14c1.52 0 2.88.52 3.95 1.54l2.95-2.95C20.09 6.08 17.77 5 15 5c-3.93 0-7.47 2.44-9.16 6.1l3.4 2.64C10.05 10.95 12.32 9.14 15 9.14z" fill="#ea4335"/>
      </svg>
      <span class="v2-hm__orb-ring"></span>
    </div>

    <!-- Email — left bottom -->
    <div class="v2-hm__orb em" style="--d:2.7s">
      <svg width="30" height="30" viewBox="0 0 30 30">
        <rect width="30" height="30" rx="8" fill="#6366f1"/>
        <rect x="5" y="9" width="20" height="13" rx="2" fill="none" stroke="white" stroke-width="1.8"/>
        <polyline points="5,10.5 15,17.5 25,10.5" fill="none" stroke="white" stroke-width="1.8" stroke-linejoin="round"/>
      </svg>
      <span class="v2-hm__orb-ring"></span>
    </div>

    <!-- SMS — bottom center -->
    <div class="v2-hm__orb sms" style="--d:3.15s">
      <svg width="30" height="30" viewBox="0 0 30 30">
        <rect width="30" height="30" rx="8" fill="#22d3ee"/>
        <path d="M6 8h18a1 1 0 011 1v11a1 1 0 01-1 1H10l-5 4V9a1 1 0 011-1z" fill="none" stroke="white" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M10 14h10M10 11h7" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <span class="v2-hm__orb-ring"></span>
    </div>

  </div>

  <!-- ── Sci-fi corner brackets ─────────────────────────────── -->
  <span class="v2-hm__corner tl" aria-hidden="true"></span>
  <span class="v2-hm__corner tr" aria-hidden="true"></span>
  <span class="v2-hm__corner bl" aria-hidden="true"></span>
  <span class="v2-hm__corner br" aria-hidden="true"></span>
  <div class="v2-hm__scan"       aria-hidden="true"></div>

  <!-- ── Header ─────────────────────────────────────────────── -->
  <div class="v2-hm__hdr">
    <div class="v2-hm__live">
      <span class="v2-hm__live-dot"></span>
      AI Customer System
    </div>
    <nav class="v2-hm__tabs">
      <button class="v2-hm__tab on" data-p="0">01 Capture</button>
      <button class="v2-hm__tab"    data-p="1">02 Qualify</button>
      <button class="v2-hm__tab"    data-p="2">03 Campaign</button>
    </nav>
  </div>

  <!-- ── Progress bar ───────────────────────────────────────── -->
  <div class="v2-hm__prog-track">
    <div class="v2-hm__prog-fill" id="v2HmProg"></div>
  </div>

  <!-- ── 3-column body ──────────────────────────────────────── -->
  <div class="v2-hm__body">

    <!-- Sidebar icon nav -->
    <nav class="v2-hm__sb">
      <div class="v2-hm__sb-i on">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M1.5 2.5h13v9h-13zM1.5 11.5l3.5-3.5M14.5 11.5l-3.5-3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="v2-hm__sb-i">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="6" r="3" stroke="currentColor" stroke-width="1.3"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </div>
      <div class="v2-hm__sb-i">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><rect x="2" y="10" width="3" height="4" rx=".5" fill="currentColor" opacity=".35"/><rect x="6.5" y="7" width="3" height="7" rx=".5" fill="currentColor" opacity=".6"/><rect x="11" y="3" width="3" height="11" rx=".5" fill="currentColor"/></svg>
      </div>
      <div class="v2-hm__sb-i">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 3h10v7H9.5L7 13V10H3z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <span class="v2-hm__sb-badge" id="v2SbN">80</span>
    </nav>

    <!-- Inbox panel -->
    <div class="v2-hm__inbox">

      <div class="v2-hm__in-hdr">
        <span class="v2-hm__in-title">Inbox</span>
        <span class="v2-hm__in-count" id="v2InC">80</span>
      </div>

      <!-- AI Agents -->
      <div class="v2-hm__grp-lbl">AI Agents <span>▲</span></div>
      <div class="v2-hm__agent-row">
        <div class="v2-hm__av-sm">A</div>
        <span class="v2-hm__agent-name">AI Sales Agent</span>
        <span class="v2-hm__n-badge">50</span>
      </div>

      <!-- Lifecycle -->
      <div class="v2-hm__grp-lbl">Lifecycle <span>▲</span></div>
      <div class="v2-hm__lc-list">
        <div class="v2-hm__lc">
          <svg width="10" height="10" viewBox="0 0 10 10"><rect width="10" height="10" rx="2" fill="rgba(99,102,241,.25)"/><path d="M2 3.5h6M2 5h4.5M2 6.5h3" stroke="#818cf8" stroke-width="1" stroke-linecap="round"/></svg>
          New Lead<span class="v2-hm__n" id="v2NL">13</span>
        </div>
        <div class="v2-hm__lc hot" id="v2LcHot">
          🔥 Hot Lead<span class="v2-hm__n hot" id="v2HL">2</span>
        </div>
        <div class="v2-hm__lc">
          <svg width="10" height="10" viewBox="0 0 10 10"><rect width="10" height="10" rx="2" fill="rgba(34,211,238,.15)"/><path d="M5 2v6M2.5 4.5L5 2l2.5 2.5" stroke="#22d3ee" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Payment<span class="v2-hm__n">2</span>
        </div>
        <div class="v2-hm__lc">
          <svg width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="4" fill="rgba(168,85,247,.2)"/><path d="M3 5l1.5 1.5L7 3" stroke="#a855f7" stroke-width="1.2" stroke-linecap="round"/></svg>
          Customer
        </div>
        <div class="v2-hm__lc">
          <svg width="10" height="10" viewBox="0 0 10 10"><rect width="10" height="10" rx="2" fill="rgba(34,211,238,.1)"/><path d="M2 5l2 2 4-4" stroke="#22d3ee" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Closed · Won
        </div>
      </div>

      <!-- Contact rows (JS-populated) -->
      <div class="v2-hm__contacts" id="v2Ct"></div>

    </div>

    <!-- Right: phase panels -->
    <div class="v2-hm__right">

      <!-- ═══ Phase 0 — CAPTURE ═══ -->
      <div class="v2-hm__panel on" id="v2P0" data-p="0">

        <div class="v2-hm__p-eye">
          <span class="v2-hm__live-dot"></span>
          40+ channels · capturing now
        </div>

        <!-- Channel tags appear one by one -->
        <div class="v2-hm__ch-grid">
          <span class="v2-hm__chtag wa"  style="--d:.1s">WA</span>
          <span class="v2-hm__chtag ig"  style="--d:.25s">IG</span>
          <span class="v2-hm__chtag tt"  style="--d:.4s">TT</span>
          <span class="v2-hm__chtag fb"  style="--d:.55s">FB</span>
          <span class="v2-hm__chtag em"  style="--d:.7s">EMAIL</span>
          <span class="v2-hm__chtag sms" style="--d:.85s">SMS</span>
        </div>

        <!-- Unify strip -->
        <div class="v2-hm__unify" style="--d:1.1s">
          <div class="v2-hm__unify-line"></div>
          <span class="v2-hm__unify-txt">
            <span class="v2-hm__live-dot" style="width:5px;height:5px"></span>
            all channels · zero missed leads
          </span>
        </div>

        <!-- Live lead feed -->
        <div class="v2-hm__feed">
          <div class="v2-hm__frow" style="--d:1.5s">
            <div class="v2-hm__av ind">K</div>
            <div class="v2-hm__frow-info">
              <span class="v2-hm__frow-name">Kara Finley</span>
              <span class="v2-hm__frow-src">WhatsApp · Meta Ad</span>
            </div>
            <span class="v2-hm__fscore hot">HOT 94</span>
          </div>
          <div class="v2-hm__frow" style="--d:2.0s">
            <div class="v2-hm__av vio">M</div>
            <div class="v2-hm__frow-info">
              <span class="v2-hm__frow-name">Marc B.</span>
              <span class="v2-hm__frow-src">Instagram DM</span>
            </div>
            <span class="v2-hm__fscore warm">WARM 74</span>
          </div>
          <div class="v2-hm__frow" style="--d:2.5s">
            <div class="v2-hm__av cyn">E</div>
            <div class="v2-hm__frow-info">
              <span class="v2-hm__frow-name">Emma R.</span>
              <span class="v2-hm__frow-src">TikTok Lead Gen</span>
            </div>
            <span class="v2-hm__fscore warm">WARM 61</span>
          </div>
        </div>

        <!-- Score bar -->
        <div class="v2-hm__q-bar" style="--d:3.2s">
          <div class="v2-hm__q-row">
            <span class="v2-hm__q-name">Kara F.</span>
            <div class="v2-hm__q-track">
              <div class="v2-hm__q-fill" style="--w:94%;--d:3.2s"></div>
            </div>
            <span class="v2-hm__q-val">94</span>
          </div>
          <div class="v2-hm__q-tags">
            <span class="v2-hm__qtag hot">🔥 HOT LEAD</span>
            <span class="v2-hm__qtag booked">📅 Booked · Thu 3pm</span>
            <span class="v2-hm__qtag ai">AI · 34s</span>
          </div>
        </div>

      </div>

      <!-- ═══ Phase 1 — QUALIFY ═══ -->
      <div class="v2-hm__panel" id="v2P1" data-p="1">

        <div class="v2-hm__conv-hdr">
          <div class="v2-hm__av ind">K</div>
          <div class="v2-hm__conv-meta">
            <span class="v2-hm__conv-name">Kara Finley</span>
            <span class="v2-hm__conv-src">WhatsApp · Meta Ad</span>
          </div>
          <span class="v2-hm__hot-tag">🔥 Hot Lead</span>
          <button class="v2-hm__close-btn">Close</button>
        </div>

        <!-- Messages -->
        <div class="v2-hm__msgs" id="v2Msgs">

          <div class="v2-hm__msg in" style="--d:.2s">
            <div class="v2-hm__av-xs ind">K</div>
            <div class="v2-hm__bbl">Hi! Saw your ad. Agency owner — 300 leads/mo, €8k budget. Can you help?</div>
          </div>

          <div class="v2-hm__typing" style="--d:.9s">
            <span class="v2-hm__td"></span><span class="v2-hm__td"></span><span class="v2-hm__td"></span>
            <span class="v2-hm__typing-lbl">AI qualifying · <b style="color:var(--c2)">34s</b></span>
          </div>

          <div class="v2-hm__msg out" style="--d:1.8s">
            <div class="v2-hm__bbl ai">
              Hi Kara! Are you the decision-maker? What's your current lead-to-sale conversion rate?
              <div class="v2-hm__bbl-tag">AI Agent · Instant</div>
            </div>
          </div>

          <div class="v2-hm__sys" style="--d:2.5s">
            Lifecycle Stage <b>New Lead → Hot Lead</b> · AI Sales Agent
          </div>

          <div class="v2-hm__msg in" style="--d:3.1s">
            <div class="v2-hm__av-xs ind">K</div>
            <div class="v2-hm__bbl">Yes, sole decision-maker. ~12% — losing leads at follow-up.</div>
          </div>

          <div class="v2-hm__msg out" style="--d:3.9s">
            <div class="v2-hm__bbl ai">
              We have a slot in 30 minutes. Would you be available?
              <div class="v2-hm__bbl-tag">AI Agent</div>
            </div>
          </div>

          <div class="v2-hm__msg in" style="--d:4.7s">
            <div class="v2-hm__av-xs ind">K</div>
            <div class="v2-hm__bbl">Yes, I am free.</div>
          </div>

          <div class="v2-hm__sys confirmed" style="--d:5.4s">
            @Sales team — <b>appointment confirmed</b> · Thu 3pm
          </div>

        </div>

        <!-- Compose -->
        <div class="v2-hm__compose">
          <div class="v2-hm__comp-left">
            <svg width="13" height="13" viewBox="0 0 30 30"><rect width="30" height="30" rx="7" fill="#25d366"/><path d="M15 5.5C9.8 5.5 5.5 9.8 5.5 15c0 1.7.45 3.3 1.24 4.67L5.5 24.5l4.97-1.22A9.5 9.5 0 1015 5.5z" fill="white"/></svg>
            WhatsApp ▾
          </div>
          <div class="v2-hm__comp-ai">✨ AI Assist</div>
        </div>

      </div>

      <!-- ═══ Phase 2 — CAMPAIGN ═══ -->
      <div class="v2-hm__panel" id="v2P2" data-p="2">

        <div class="v2-hm__p2-hdr">
          <span class="v2-hm__p-eye" style="--dot-c:var(--c3);--dot-s:var(--c3)">
            <span class="v2-hm__live-dot" style="background:var(--c3);box-shadow:0 0 8px var(--c3)"></span>
            AI Creative Engine · Generating
          </span>
          <span class="v2-hm__chip-vio">4,000 contacts</span>
        </div>

        <!-- Brief prompt -->
        <div class="v2-hm__brief" style="--d:.15s">
          <span class="v2-hm__brief-lbl">BRIEF</span>
          <span class="v2-hm__brief-txt">Agency lead gen · CEO audience · €5–10k<span class="v2-hm__cur">|</span></span>
        </div>

        <!-- 6 creative cards -->
        <div class="v2-hm__cre-grid">
          <div class="v2-hm__cre win" style="--d:.5s">
            <div class="v2-hm__cre-img win"></div>
            <div class="v2-hm__cre-foot"><span class="v2-hm__cre-sc win">▲ 97</span><span class="v2-hm__cre-chip">SCALING</span></div>
            <div class="v2-hm__cre-shim"></div>
          </div>
          <div class="v2-hm__cre win" style="--d:.7s">
            <div class="v2-hm__cre-img win"></div>
            <div class="v2-hm__cre-foot"><span class="v2-hm__cre-sc win">▲ 91</span><span class="v2-hm__cre-chip">SCALING</span></div>
            <div class="v2-hm__cre-shim"></div>
          </div>
          <div class="v2-hm__cre win" style="--d:.9s">
            <div class="v2-hm__cre-img win"></div>
            <div class="v2-hm__cre-foot"><span class="v2-hm__cre-sc win">▲ 89</span><span class="v2-hm__cre-chip">SCALING</span></div>
            <div class="v2-hm__cre-shim"></div>
          </div>
          <div class="v2-hm__cre" style="--d:1.1s">
            <div class="v2-hm__cre-img"></div>
            <div class="v2-hm__cre-foot"><span class="v2-hm__cre-sc">▼ 74</span></div>
          </div>
          <div class="v2-hm__cre" style="--d:1.3s">
            <div class="v2-hm__cre-img"></div>
            <div class="v2-hm__cre-foot"><span class="v2-hm__cre-sc">▼ 68</span></div>
          </div>
          <div class="v2-hm__cre" style="--d:1.5s">
            <div class="v2-hm__cre-img"></div>
            <div class="v2-hm__cre-foot"><span class="v2-hm__cre-sc">▼ 63</span></div>
          </div>
        </div>

        <!-- Drip sequence preview -->
        <div class="v2-hm__drip" style="--d:2.0s">
          <div class="v2-hm__drip-row done"  style="--d:2.0s"><span class="v2-hm__drip-d">D+0</span>  <span class="v2-hm__drip-t">AI offer · WhatsApp blast</span>    <span class="v2-hm__drip-s done">SENT</span></div>
          <div class="v2-hm__drip-row done"  style="--d:2.4s"><span class="v2-hm__drip-d">D+2</span>  <span class="v2-hm__drip-t">Follow-up + case study</span>        <span class="v2-hm__drip-s done">SENT</span></div>
          <div class="v2-hm__drip-row live"  style="--d:2.8s"><span class="v2-hm__drip-d">D+5</span>  <span class="v2-hm__drip-t">Personalised offer · IG + WA</span> <span class="v2-hm__drip-s live">LIVE</span></div>
          <div class="v2-hm__drip-row sched" style="--d:3.2s"><span class="v2-hm__drip-d">D+12</span> <span class="v2-hm__drip-t">Final push · scarcity hook</span>   <span class="v2-hm__drip-s sched">SCHED</span></div>
