<script>
  (() => {
    const DURATION = 6800;
    const root = document.getElementById('v2Hm');
    if (!root) return;

    const tabs   = [...root.querySelectorAll<HTMLElement>('.v2-hm__tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.v2-hm__panel')];
    const prog   = root.querySelector<HTMLElement>('.v2-hm__prog-fill');
    let cur = 0, autoId: ReturnType<typeof setInterval>;

    // Contacts data
    const contacts = [
      { av:'K', grad:'#6366f1,#a855f7', name:'Kara Finley', src:'WhatsApp', time:'Now',    hot:true  },
      { av:'M', grad:'#a855f7,#e879f9', name:'Marc B.',     src:'Instagram', time:'2m',    hot:false },
      { av:'E', grad:'#06b6d4,#22d3ee', name:'Emma R.',     src:'TikTok',    time:'5m',    hot:false },
      { av:'L', grad:'#f59e0b,#f97316', name:'Lee',          src:'Facebook',  time:'Oct 8', hot:false },
      { av:'S', grad:'#6366f1,#22d3ee', name:'Shanny',       src:'WhatsApp',  time:'Oct 6', hot:false },
    ];

    function buildContacts() {
      const ct = document.getElementById('v2Ct');
      if (!ct) return;
      ct.innerHTML = contacts.map((c, i) => `
        <div class="v2-hm__ct" style="--d:${0.3 + i * 0.18}s">
          <div class="v2-hm__av-xs" style="background:linear-gradient(135deg,${c.grad})">${c.av}</div>
          <div class="v2-hm__ct-info">
            <span class="v2-hm__ct-name">${c.name}</span>
            <span class="v2-hm__ct-src">${c.src}</span>
          </div>
          <span class="v2-hm__ct-time">${c.time}</span>
          ${c.hot ? '<span class="v2-hm__ct-hot">🔥</span>' : ''}
        </div>
      `).join('');
    }

    function animateCounter(el: HTMLElement | null, from: number, to: number, dur: number) {
      if (!el) return;
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - t0) / dur, 1);
        const e = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.round(from + (to - from) * e));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    function go(idx: number) {
      tabs.forEach(t  => t.classList.remove('on'));
      panels.forEach(p => { p.classList.remove('on'); void p.offsetWidth; });

      cur = idx;
      tabs[idx]?.classList.add('on');
      panels[idx]?.classList.add('on');

      if (prog) {
        prog.style.transition = 'none';
        prog.style.width = '0%';
        void prog.offsetWidth;
        prog.style.transition = `width ${DURATION}ms linear`;
        prog.style.width = '100%';
      }

      // Phase-specific animations
      if (idx === 0) {
        buildContacts();
        animateCounter(document.getElementById('v2InC'),  80, 83, 2400);
        animateCounter(document.getElementById('v2SbN'),  80, 83, 2400);
      }

      if (idx === 1) {
        animateCounter(document.getElementById('v2HL'),  2, 3, 900);
      }

      if (idx === 2) {
        setTimeout(() => {
          const roi = document.getElementById('v2RoiN');
          if (!roi) return;
          roi.textContent = '0';
          const dur2 = 1800;
          const t0 = performance.now();
          const tick = (now: number) => {
            const t = Math.min((now - t0) / dur2, 1);
            const e = 1 - Math.pow(1 - t, 3);
            roi.textContent = (e * 42.5).toFixed(1);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, 4000);
      }
    }

    function restart() {
      clearInterval(autoId);
      autoId = setInterval(() => go((cur + 1) % 3), DURATION);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { go(i); restart(); });
    });

    go(0);
    restart();
  })();
</script>


