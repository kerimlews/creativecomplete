---
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).results;

const projectsUrl: Record<string, string> = { en: '/projects/', de: '/de/projekte/', sl: '/sl/projekti/' };
const pUrl = projectsUrl[lang] ?? '/projects/';
---

<section class="v2-results" id="results">
  <div class="v2-container">
    <div class="v2-results__banner">
      <div class="v2-section-head center" style="margin:0">
        <span class="v2-eyebrow" data-m="fade">{c.eyebrow}</span>
        <h2 class="v2-h2" data-m="up" style="--m-d:.1s">
          {c.title} <span class="v2-grad">{c.titleGrad}</span>
        </h2>
      </div>
      <div class="v2-results__grid m-stagger">
        {c.items.map((r, i) => (
          <div class="v2-results__item" data-m="up" style={`--m-d:${i * 0.1}s`}>
            <div class="v2-results__n" data-count={r.n}>{r.n}</div>
            <div class="v2-results__l">{r.l}</div>
            <div class="v2-results__c">{r.c}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="v2-sc" data-m="up" style="--m-d:.45s">
      <a href={pUrl} class="v2-sc__btn">
        {c.ctaSeeStudies}
      </a>
      <a href="https://cal.com/kerim-alihodza-7u7w6q/30min" class="v2-sc__btn primary" style="margin-left:12px"
        >
        {c.ctaWant}
      </a>
    </div>
  </div>
</section>
