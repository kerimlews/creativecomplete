---
import ServiceMotion from './ServiceMotion.astro';

const services = [
  {
    motionKey: 'qualify' as const,
    tag: '01',
    kicker: 'Under 60 seconds · 24/7',
    title: 'AI Lead Qualification',
    body: 'AI Customer System qualifies every inbound lead automatically using AI Agents, scoring intent, budget, and timeline in under 60 seconds across WhatsApp, Instagram, TikTok, Facebook, and 8+ more channels.',
    list: [
      'AI Agents handle first touch 24/7',
      'BANT qualification in every language',
      'Hot leads → sales calendar instantly',
      '80% of routine inquiries automated',
    ],
    color: 'var(--c1)',
    text: "#fff",
    cta: 'Qualify my leads with AI →',
  },
  {
    motionKey: 'creative' as const,
    tag: '02',
    kicker: '$35B+ trained · Weekly production',
    title: 'AI Ad Creative Engine',
    body: 'AI Customer System generates high-converting ad creatives trained on $35B+ in ad spend data. Creative Scoring AI predicts winners with 90%+ accuracy before you spend a single cent.',
    list: [
      'Creatives in minutes, not days',
      'Trained on $35B+ real ad spend data',
      'Creative Scoring AI, 90%+ accuracy',
      'Meta, TikTok, Google, LinkedIn',
    ],
    color: 'var(--c3)',
    text: "#fff",
    cta: 'Generate winning creatives →',
  },
  {
    motionKey: 'capture' as const,
    tag: '03',
    kicker: '40+ channels · Zero missed leads',
    title: 'Lead Capture & Conversion',
    body: 'AI Customer System unifies WhatsApp, Instagram, TikTok, Facebook, email, SMS, and web chat into one inbox. Capture every lead, convert them with AI, retain them with smart sequences.',
    list: [
      'Unified inbox: 40+ channels',
      'WhatsApp Business API integration',
      'Conversation-Led Growth™ framework',
      'Real-time routing with full context',
    ],
    color: 'var(--c2)',
    text: "#464040",
    cta: 'Capture every lead →',
  },
  {
    motionKey: 'monetize' as const,
    tag: '04',
    kicker: 'Ongoing revenue · Avg. 42.5×',
    title: 'Existing Lead Monetization',
    body: 'AI Customer System mines your existing CRM for profit. WhatsApp broadcast campaigns and AI-powered re-engagement sequences turn dormant contacts into revenue, averaging 42.5× ROI on the first campaign.',
    list: [
      'WhatsApp broadcasts (avg. 42.5× ROI)',
      'Dormant CRM re-engagement flows',
      'Behavior-triggered sequences',
      'Segment by intent, lifecycle, value',
    ],
    color: 'var(--c2)',
    text: "#464040",
    cta: 'Monetize my existing database →',
  },
];
---

<section class="v2-services v2-section" id="engines">
  <div class="v2-container">

    <div class="v2-section-head center">
      <span class="v2-eyebrow" data-m="fade">What we do</span>
      <h2 class="v2-h2" data-m="up" style="--m-d:.1s">
        <span class="v2-grad">Four engines.</span>
      </h2>
      <p class="v2-lead" data-m="up" style="--m-d:.2s">
        We capture every lead, convert them with AI, and retain them with automated follow-ups.
        Most agencies handle each stage separately. We own the full lifecycle.
      </p>

      <!-- Animated engine cards -->
      <div class="v2-eng-strip" data-m="up" style="--m-d:.3s">
        <div class="v2-eng-card" style="--ec:#6366f1;--bd:0s">
          <div class="v2-eng-card__top">
            <span class="v2-eng-num">01</span>
            <div class="v2-eng-icon-wrap">
              <div class="v2-eng-ring"></div>
              <div class="v2-eng-icon">🤖</div>
            </div>
          </div>
          <div class="v2-eng-title">AI Lead Qualification</div>
          <div class="v2-eng-metric-row">
            <div class="v2-eng-metric">60s</div>
            <div class="v2-eng-metric-l">avg qualify time</div>
          </div>
        </div>

        <div class="v2-eng-divider"></div>

        <div class="v2-eng-card" style="--ec:#a855f7;--bd:.45s">
          <div class="v2-eng-card__top">
            <span class="v2-eng-num">02</span>
            <div class="v2-eng-icon-wrap">
              <div class="v2-eng-ring"></div>
              <div class="v2-eng-icon">🎨</div>
            </div>
          </div>
          <div class="v2-eng-title">AI Creative Engine</div>
          <div class="v2-eng-metric-row">
            <div class="v2-eng-metric">90%+</div>
            <div class="v2-eng-metric-l">prediction accuracy</div>
          </div>
        </div>

        <div class="v2-eng-divider"></div>

        <div class="v2-eng-card" style="--ec:#22d3ee;--bd:.9s">
          <div class="v2-eng-card__top">
            <span class="v2-eng-num">03</span>
            <div class="v2-eng-icon-wrap">
              <div class="v2-eng-ring"></div>
              <div class="v2-eng-icon">📡</div>
            </div>
          </div>
          <div class="v2-eng-title">Lead Capture</div>
          <div class="v2-eng-metric-row">
            <div class="v2-eng-metric">40+</div>
            <div class="v2-eng-metric-l">channels unified</div>
          </div>
        </div>

        <div class="v2-eng-divider"></div>

        <div class="v2-eng-card" style="--ec:#e879f9;--bd:1.35s">
          <div class="v2-eng-card__top">
            <span class="v2-eng-num">04</span>
            <div class="v2-eng-icon-wrap">
              <div class="v2-eng-ring"></div>
              <div class="v2-eng-icon">💰</div>
            </div>
          </div>
          <div class="v2-eng-title">Lead Monetization</div>
          <div class="v2-eng-metric-row">
            <div class="v2-eng-metric">42.5×</div>
            <div class="v2-eng-metric-l">avg ROI</div>
          </div>
        </div>
      </div>
    </div>

    <div class="v2-svc-list">
      {services.map((s, i) => (
        <div class:list={['v2-svc-row', { 'v2-svc-row--flip': i % 2 === 1 }]} data-m="up" style={`--m-d:${i * 0.08}s;--svc-color:${s.color}`}>

          <!-- Copy side -->
          <div class="v2-svc-copy">
            <div class="v2-svc-meta">
              <span class="v2-svc-tag">{s.tag}</span>
              <span class="v2-svc-kicker" style={`color:${s.color}`}>{s.kicker}</span>
            </div>
            <h3 class="v2-svc-title">{s.title}</h3>
            <p class="v2-svc-body">{s.body}</p>
            <ul class="v2-svc-list-items">
              {s.list.map(item => (
                <li>
                  <span class="v2-svc-check" style={`border-color:${s.color}40;background:${s.color}10`}>
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="none">
                      <path d="M1.5 4.5L3 6L6.5 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style={`color:${s.color}`}/>
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="v2-svc-row-cta">
              <a href="javascript:void(0)" class="v2-sc__btn primary v2-svc-cta-btn"
                 style={`--svc-color:${s.color}; color:${s.text} !important;`}
                 data-cal-link="kerim-alihodza-7u7w6q/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","theme":"dark"}'>
                {s.cta}
              </a>
            </div>
          </div>

          <!-- Motion demo side -->
          <div class="v2-svc-demo">
            <ServiceMotion service={s.motionKey} />
          </div>

        </div>
      ))}
    </div>

    <div class="v2-sc" data-m="up" style="--m-d:.4s">
      <a href="javascript:void(0)" class="v2-sc__btn" data-cal-link="kerim-alihodza-7u7w6q/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","theme":"dark"}'>
        Activate all 4 engines →
      </a>
    </div>

  </div>
</section>


<style lang="scss">

.v2-services { padding: 96px 0; }

.v2-section-head.center { text-align: center; margin-bottom: 72px; }

/* ── Engine strip ─────────────────────────────────── */
@keyframes eng-bob {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-7px); }
}
@keyframes eng-glow {
  0%, 100% { opacity: .25; transform: scale(1); }
  50%       { opacity: .55; transform: scale(1.22); }
}
@keyframes eng-metric {
  0%, 100% { opacity: .75; }
  50%       { opacity: 1; }
}

.v2-eng-strip {
  display: flex;
  align-items: stretch;
  gap: 0;
  width: 100%;
  max-width: 680px;
  margin: 32px auto 0;
  border-radius: var(--r-lg);
  border: 1px solid var(--line);
  background: var(--bg-card);
  overflow: hidden;
  box-shadow: 0 0 40px rgba(99,102,241,.06);
}

.v2-eng-divider {
  width: 1px;
  background: var(--line);
  flex-shrink: 0;
  align-self: stretch;
}

.v2-eng-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 14px 14px;
  position: relative;
  overflow: hidden;
  animation: eng-bob 3.2s ease-in-out infinite;
  animation-delay: var(--bd, 0s);

  &::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 1.5px;
    background: linear-gradient(90deg, transparent, var(--ec), transparent);
    opacity: .65;
  }

  &::after {
    content: '';
    position: absolute; inset: 0;
    background:
      linear-gradient(var(--ec)02 1px, transparent 1px),
      linear-gradient(90deg, var(--ec)02 1px, transparent 1px);
    background-size: 18px 18px;
    pointer-events: none;
  }
}

.v2-eng-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.v2-eng-num {
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .12em;
  color: var(--ec);
  background: color-mix(in srgb, var(--ec) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--ec) 25%, transparent);
  border-radius: 4px;
  padding: 1px 5px;
}

.v2-eng-icon-wrap {
  position: relative;
  width: 30px; height: 30px;
}

.v2-eng-ring {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1px solid var(--ec);
  animation: eng-glow 2.8s ease-in-out infinite;
  animation-delay: var(--bd, 0s);
}

.v2-eng-icon {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: color-mix(in srgb, var(--ec) 14%, transparent);
  border: 1px solid color-mix(in srgb, var(--ec) 28%, transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

.v2-eng-title {
  font-size: 11px;
  font-weight: 600;
  color: var(--fg-0);
  line-height: 1.25;
  letter-spacing: -.01em;
}

.v2-eng-metric-row {
  padding-top: 8px;
  border-top: 1px solid color-mix(in srgb, var(--ec) 15%, transparent);
}

.v2-eng-metric {
  font-family: var(--font-display);
  font-size: 20px;
  letter-spacing: -.03em;
  color: var(--ec);
  line-height: 1;
  animation: eng-metric 2.8s ease-in-out infinite;
  animation-delay: var(--bd, 0s);
}

.v2-eng-metric-l {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: var(--fg-2);
  margin-top: 2px;
}

@media (max-width: 640px) {
  .v2-eng-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 100%;
  }
  .v2-eng-divider {
    display: none;
  }
  .v2-eng-card {
    border: 1px solid var(--line);
    border-radius: 0;
    &:nth-child(1) { border-top: none; border-left: none; }
    &:nth-child(3) { border-top: none; border-left: none; border-bottom: none; }
    &:nth-child(5) { border-top: none; border-right: none; border-bottom: none; }
    &:nth-child(7) { border: none; }
  }
}

.v2-svc-list {
  display: flex;
  flex-direction: column;
  gap: 80px;
}

/* Each row: copy + demo side-by-side */
.v2-svc-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;

  /* Flip — demo left, copy right */
  &.v2-svc-row--flip {
    .v2-svc-copy { order: 2; }
    .v2-svc-demo  { order: 1; }
  }
}

/* ── Copy ──────────────────────────────────────── */
.v2-svc-copy {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.v2-svc-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}

.v2-svc-tag {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--svc-color, var(--c1-light));
  padding: 3px 9px;
  border-radius: var(--r-pill);
  background: color-mix(in srgb, var(--svc-color, var(--c1)) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--svc-color, var(--c1)) 25%, transparent);
}

.v2-svc-kicker {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.v2-svc-title {
  font-family: var(--font-display);
  font-size: clamp(26px, 2.4vw, 38px);
  font-weight: 400;
  letter-spacing: -.015em;
  line-height: 1.15;
  color: var(--fg-0);
  margin: 0;
}

.v2-svc-body {
  font-size: 15px;
  color: var(--fg-1);
  line-height: 1.7;
  margin: 0;
  max-width: 48ch;
}

.v2-svc-list-items {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;

  li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--fg-1);
    line-height: 1.4;
  }
}

.v2-svc-check {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1px solid;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ── Row CTA ────────────────────────────────────── */
.v2-svc-row-cta {
  margin-top: 24px;
}

.v2-svc-cta-btn {
  background: var(--svc-color) !important;
  border-color: transparent !important;
  color: #cfc0c0 !important;
  box-shadow: 0 4px 20px rgba(0,0,0,.18) !important;

  &:hover {
    filter: brightness(1.1);
    box-shadow: 0 6px 28px rgba(0,0,0,.28) !important;
  }
}

/* ── Demo panel ─────────────────────────────────── */
.v2-svc-demo {
  /* ServiceMotion fills this container */
  min-height: 320px;
  display: flex;
  align-items: stretch;

  /* pass max-width down to .sm */
  > :global(.sm) {
    flex: 1;
    width: 100%;
  }
}

/* ── Divider between rows ───────────────────────── */
.v2-svc-row + .v2-svc-row {
  padding-top: 80px;
  border-top: 1px solid var(--line);
}

/* ── Responsive ─────────────────────────────────── */
@media (max-width: 960px) {
  .v2-svc-row {
    grid-template-columns: 1fr;
    gap: 32px;

    &.v2-svc-row--flip {
      .v2-svc-copy { order: 1; }
      .v2-svc-demo  { order: 2; }
    }
  }

  .v2-svc-body { max-width: 100%; }
}

@media (max-width: 640px) {
  .v2-services { padding: 64px 0; }
  .v2-svc-list { gap: 56px; }
  .v2-svc-row + .v2-svc-row { padding-top: 56px; }
  .v2-svc-title { font-size: 24px; }
}

</style>
