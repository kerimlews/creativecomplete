---
import ServiceMotion from './ServiceMotion.astro';
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).services;

const motionKeys = ['qualify', 'creative', 'capture', 'monetize'] as const;
const colors = ['var(--c1)', 'var(--c3)', 'var(--c2)', 'var(--c2)'];
const texts  = ['#fff', '#fff', '#464040', '#464040'];
const blogBase = lang === 'de' ? '/de/blog' : lang === 'sl' ? '/sl/blog' : '/blog';
const blogHrefs = [
  `${blogBase}/ai-lead-qualification/`,
  `${blogBase}/ai-ad-creatives/`,
  `${blogBase}/speed-to-lead/`,
  `${blogBase}/whatsapp-broadcast-campaigns/`,
];
const engColors = ['#6366f1', '#a855f7', '#22d3ee', '#e879f9'];
const engMetrics = ['60s', '90%+', '40+', '42.5×'];
const engDelays = ['0s', '.45s', '.9s', '1.35s'];
const engEmojis = ['🤖', '🎨', '📡', '💰'];

const services = c.services.map((s, i) => ({
  ...s,
  motionKey: motionKeys[i],
  color: colors[i],
  text: texts[i],
  blogHref: blogHrefs[i],
  engColor: engColors[i],
  engMetric: engMetrics[i],
  engDelay: engDelays[i],
  engEmoji: engEmojis[i],
}));
---

<section class="v2-services v2-section" id="engines">
  <div class="v2-container">

    <div class="v2-section-head center">
      <span class="v2-eyebrow" data-m="fade">{c.eyebrow}</span>
      <h2 class="v2-h2" data-m="up" style="--m-d:.1s">
        <span class="v2-grad">{c.title}</span>
      </h2>
      <p class="v2-lead" data-m="up" style="--m-d:.2s">
        {c.lead}
      </p>

      <!-- Animated engine cards -->
      <div class="v2-eng-strip" data-m="up" style="--m-d:.3s">
        {services.map((s, i) => (
          <>
            {i > 0 && <div class="v2-eng-divider"></div>}
            <div class="v2-eng-card" style={`--ec:${s.engColor};--bd:${s.engDelay}`}>
              <div class="v2-eng-card__top">
                <span class="v2-eng-num">{s.tag}</span>
                <div class="v2-eng-icon-wrap">
                  <div class="v2-eng-ring"></div>
                  <div class="v2-eng-icon">{s.engEmoji}</div>
                </div>
              </div>
              <div class="v2-eng-title">{s.engTitle}</div>
              <div class="v2-eng-metric-row">
                <div class="v2-eng-metric">{s.engMetric}</div>
                <div class="v2-eng-metric-l">{s.engMetricLabel}</div>
              </div>
            </div>
          </>
        ))}
      </div>
    </div>

    <div class="v2-svc-list">
      {services.map((s, i) => (
        <div class:list={['v2-svc-row', { 'v2-svc-row--flip': i % 2 === 1 }]} data-m="up" style={`--m-d:${i * 0.08}s;--svc-color:${s.color}`}>

          <!-- Copy side -->
          <div class="v2-svc-copy">
            <div class="v2-svc-meta">
              <span class="v2-svc-tag">{s.tag}</span>
              <span class="v2-svc-kicker" style={`color:${s.color}`}>{s.kicker}</span>
            </div>
            <h3 class="v2-svc-title">{s.title}</h3>
            <p class="v2-svc-body">{s.body}</p>
            <ul class="v2-svc-list-items">
              {s.list.map(item => (
                <li>
                  <span class="v2-svc-check" style={`border-color:${s.color}40;background:${s.color}10`}>
                    <svg width="8" height="8" viewBox="0 0 8 8" fill="none">
                      <path d="M1.5 4.5L3 6L6.5 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style={`color:${s.color}`}/>
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="v2-svc-row-cta">
              <a href="javascript:void(0)" class="v2-sc__btn primary v2-svc-cta-btn"
                 style={`--svc-color:${s.color}; color:${s.text} !important;`}
                 data-cal-link="kerim-alihodza-7u7w6q/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","theme":"dark"}'>
                {s.cta}
              </a>
              <a href={s.blogHref} class="v2-svc-blog-link" style={`color:${s.color}`}>
                {s.blogLabel}
              </a>
            </div>
          </div>

          <!-- Motion demo side -->
          <div class="v2-svc-demo">
            <ServiceMotion service={s.motionKey} />
          </div>

        </div>
      ))}
    </div>

    <div class="v2-sc" data-m="up" style="--m-d:.4s">
      <a href="javascript:void(0)" class="v2-sc__btn" data-cal-link="kerim-alihodza-7u7w6q/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","theme":"dark"}'>
        {c.bottomCta}
      </a>
    </div>

  </div>
</section>


<style lang="scss">

.v2-services { padding: 96px 0; }

.v2-section-head.center { text-align: center; margin-bottom: 72px; }

/* ── Engine strip ─────────────────────────────────── */
@keyframes eng-bob {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-7px); }
}
@keyframes eng-glow {
  0%, 100% { opacity: .25; transform: scale(1); }
  50%       { opacity: .55; transform: scale(1.22); }
}
@keyframes eng-metric {
  0%, 100% { opacity: .75; }
  50%       { opacity: 1; }
}

.v2-eng-strip {
  display: flex;
  align-items: stretch;
  gap: 0;
  width: 100%;
  max-width: 680px;
  margin: 32px auto 0;
  border-radius: var(--r-lg);
  border: 1px solid var(--line);
  background: var(--bg-card);
  overflow: hidden;
  box-shadow: 0 0 40px rgba(99,102,241,.06);
}

.v2-eng-divider {
  width: 1px;
  background: var(--line);
  flex-shrink: 0;
  align-self: stretch;
}

.v2-eng-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 14px 14px;
  position: relative;
  overflow: hidden;
  animation: eng-bob 3.2s ease-in-out infinite;
  animation-delay: var(--bd, 0s);

  &::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 1.5px;
    background: linear-gradient(90deg, transparent, var(--ec), transparent);
    opacity: .65;
  }

  &::after {
    content: '';
    position: absolute; inset: 0;
    background:
      linear-gradient(var(--ec)02 1px, transparent 1px),
      linear-gradient(90deg, var(--ec)02 1px, transparent 1px);
    background-size: 18px 18px;
    pointer-events: none;
  }
}

.v2-eng-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.v2-eng-num {
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .12em;
  color: var(--ec);
  background: color-mix(in srgb, var(--ec) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--ec) 25%, transparent);
  border-radius: 4px;
  padding: 1px 5px;
}

.v2-eng-icon-wrap {
  position: relative;
  width: 30px; height: 30px;
}

.v2-eng-ring {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1px solid var(--ec);
  animation: eng-glow 2.8s ease-in-out infinite;
  animation-delay: var(--bd, 0s);
}

.v2-eng-icon {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: color-mix(in srgb, var(--ec) 14%, transparent);
  border: 1px solid color-mix(in srgb, var(--ec) 28%, transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

.v2-eng-title {
  font-size: 11px;
  font-weight: 600;
  color: var(--fg-0);
  line-height: 1.25;
  letter-spacing: -.01em;
}

.v2-eng-metric-row {
  padding-top: 8px;
  border-top: 1px solid color-mix(in srgb, var(--ec) 15%, transparent);
}

.v2-eng-metric {
  font-family: var(--font-display);
  font-size: 20px;
  letter-spacing: -.03em;
  color: var(--ec);
  line-height: 1;
  animation: eng-metric 2.8s ease-in-out infinite;
  animation-delay: var(--bd, 0s);
}

.v2-eng-metric-l {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: var(--fg-2);
  margin-top: 2px;
}

@media (max-width: 640px) {
  .v2-eng-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 100%;
  }
  .v2-eng-divider {
    display: none;
  }
  .v2-eng-card {
    border: 1px solid var(--line);
    border-radius: 0;
    &:nth-child(1) { border-top: none; border-left: none; }
    &:nth-child(3) { border-top: none; border-left: none; border-bottom: none; }
    &:nth-child(5) { border-top: none; border-right: none; border-bottom: none; }
    &:nth-child(7) { border: none; }
  }
}

.v2-svc-list {
  display: flex;
  flex-direction: column;
  gap: 80px;
}

/* Each row: copy + demo side-by-side */
.v2-svc-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;

  /* Flip — demo left, copy right */
  &.v2-svc-row--flip {
    .v2-svc-copy { order: 2; }
    .v2-svc-demo  { order: 1; }
  }
}

/* ── Copy ──────────────────────────────────────── */
.v2-svc-copy {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.v2-svc-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}

.v2-svc-tag {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--svc-color, var(--c1-light));
  padding: 3px 9px;
  border-radius: var(--r-pill);
  background: color-mix(in srgb, var(--svc-color, var(--c1)) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--svc-color, var(--c1)) 25%, transparent);
}

.v2-svc-kicker {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.v2-svc-title {
  font-family: var(--font-display);
  font-size: clamp(26px, 2.4vw, 38px);
  font-weight: 400;
  letter-spacing: -.015em;
  line-height: 1.15;
  color: var(--fg-0);
  margin: 0;
}

.v2-svc-body {
  font-size: 15px;
  color: var(--fg-1);
  line-height: 1.7;
  margin: 0;
  max-width: 48ch;
}

.v2-svc-list-items {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;

  li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--fg-1);
    line-height: 1.4;
  }
}

.v2-svc-check {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1px solid;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ── Row CTA ────────────────────────────────────── */
.v2-svc-row-cta {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-items: flex-start;
}
.v2-svc-blog-link {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .06em;
  text-decoration: none;
  opacity: 0.7;
  transition: opacity .15s;
  &:hover { opacity: 1; }
}

.v2-svc-cta-btn {
  background: var(--svc-color) !important;
  border-color: transparent !important;
  color: #cfc0c0 !important;
  box-shadow: 0 4px 20px rgba(0,0,0,.18) !important;

  &:hover {
    filter: brightness(1.1);
    box-shadow: 0 6px 28px rgba(0,0,0,.28) !important;
  }
}

/* ── Demo panel ─────────────────────────────────── */
.v2-svc-demo {
  /* ServiceMotion fills this container */
  min-height: 320px;
  display: flex;
  align-items: stretch;

  /* pass max-width down to .sm */
  > :global(.sm) {
    flex: 1;
    width: 100%;
  }
}

/* ── Divider between rows ───────────────────────── */
.v2-svc-row + .v2-svc-row {
  padding-top: 80px;
  border-top: 1px solid var(--line);
}

/* ── Responsive ─────────────────────────────────── */
@media (max-width: 960px) {
  .v2-svc-row {
    grid-template-columns: 1fr;
    gap: 32px;

    &.v2-svc-row--flip {
      .v2-svc-copy { order: 1; }
      .v2-svc-demo  { order: 2; }
    }
  }

  .v2-svc-body { max-width: 100%; }
}

@media (max-width: 640px) {
  .v2-services { padding: 64px 0; }
  .v2-svc-list { gap: 56px; }
  .v2-svc-row + .v2-svc-row { padding-top: 56px; }
  .v2-svc-title { font-size: 24px; }
}

</style>
