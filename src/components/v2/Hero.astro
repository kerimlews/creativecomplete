</style>

<script is:inline>
(function () {
  var rt = document.querySelector('.v2-rt');
  if (!rt) return;

  var paths = rt.querySelectorAll('.rt-path');
  var nodes = rt.querySelectorAll('.rt-node');
  var agents = rt.querySelectorAll('.v2-rt__agent');

  // Initialise paths as invisible (drawn from dashoffset = full length)
  paths.forEach(function (p) {
    try {
      var len = p.getTotalLength ? p.getTotalLength() : 500;
      p.style.strokeDasharray = len;
      p.style.strokeDashoffset = len;
    } catch (e) {
      p.style.strokeDasharray = 500;
      p.style.strokeDashoffset = 500;
    }
  });

  function runAnim() {
    var trunk = rt.querySelector('.rt-trunk');
    if (trunk) {
      trunk.style.transition = 'stroke-dashoffset .45s cubic-bezier(.4,0,.2,1)';
      trunk.style.strokeDashoffset = '0';
    }
    rt.querySelectorAll('.rt-branch').forEach(function (b, i) {
      setTimeout(function () {
        b.style.transition = 'stroke-dashoffset .55s cubic-bezier(.4,0,.2,1)';
        b.style.strokeDashoffset = '0';
      }, 380 + i * 65);
    });
    nodes.forEach(function (n, i) {
      setTimeout(function () {
        n.style.transition = 'opacity .3s ease';
        n.style.opacity = '1';
      }, 720 + i * 55);
    });
    agents.forEach(function (a) { a.classList.add('rt-in'); });
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      runAnim();
      io.disconnect();
    });
  }, { threshold: 0.15 });

  io.observe(rt);
})();
</script>
