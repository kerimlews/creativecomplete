---
import { Image } from 'astro:assets';
import heroImg from '../../images/ai-custormer-system.png';
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).hero;

const socials = [
  {
    id: 'wa', name: 'WhatsApp', stat: '94 leads today',
    iconBg: '#25D366', pos: 'tr', circle: true,
    border: 'rgba(37,211,102,.3)', chipBg: 'rgba(37,211,102,.1)',
    icon: `<svg viewBox="0 0 24 24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
  },
  {
    id: 'ig', name: 'Instagram', stat: '51 replies',
    iconBg: 'radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%)',
    pos: 'bl', border: 'rgba(225,48,108,.3)', chipBg: 'rgba(225,48,108,.1)',
    icon: `<svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
  {
    id: 'tt', name: 'TikTok', stat: '38 leads',
    iconBg: '#010101', pos: 'tl',
    border: 'rgba(105,201,208,.3)', chipBg: 'rgba(105,201,208,.1)',
    icon: `<svg viewBox="0 0 24 24" fill="#fff"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`,
  },
  {
    id: 'fb', name: 'Facebook', stat: '32 chats',
    iconBg: '#1877F2', pos: 'br', circle: true,
    border: 'rgba(24,119,242,.3)', chipBg: 'rgba(24,119,242,.1)',
    icon: `<svg viewBox="0 0 24 24" fill="#fff"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>`,
  },
  {
    id: 'li', name: 'LinkedIn', stat: '19 replies',
    iconBg: '#0A66C2', pos: 'mr',
    border: 'rgba(10,102,194,.3)', chipBg: 'rgba(10,102,194,.1)',
    icon: `<svg viewBox="0 0 24 24" fill="#fff"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    id: 'tg', name: 'Telegram', stat: '13 msgs',
    iconBg: '#26A5E4', pos: 'ml', circle: true,
    border: 'rgba(38,165,228,.3)', chipBg: 'rgba(38,165,228,.1)',
    icon: `<svg viewBox="0 0 24 24" fill="#fff"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`,
  },
];

const rtAgents = [
  { name: 'Sarah K.',  typeLabel: 'LANG',  typeIcon: '🌐', flag: '🇬🇧', role: lang === 'de' ? 'Sprachagentin'    : lang === 'sl' ? 'Jezikovni agent'  : 'Language Agent',   criteria: lang === 'de' ? 'Sprachzuweisung'  : lang === 'sl' ? 'Ujemanje jezika'    : 'Language match',   color: '#6366f1', glow: 'rgba(99,102,241,.25)', img: 'sarah-k.jpg' },
  { name: 'Alex M.',   typeLabel: 'SKILL', typeIcon: '🧠', flag: '🇩🇪', role: lang === 'de' ? 'Skill-Spezialist' : lang === 'sl' ? 'Skill specialist'  : 'Skill Specialist', criteria: lang === 'de' ? 'Kompetenzniveau'  : lang === 'sl' ? 'Raven spretnosti'  : 'Skill level',      color: '#a855f7', glow: 'rgba(168,85,247,.25)', img: 'alex-m.jpg'  },
  { name: 'David L.',  typeLabel: 'LIVE',  typeIcon: '⚡', flag: '🇦🇺', role: lang === 'de' ? 'Rezeptionist'     : lang === 'sl' ? 'Receptionist'      : 'Receptionist',     criteria: lang === 'de' ? 'Verfügbarkeit'    : lang === 'sl' ? 'Razpoložljivost'   : 'Availability',     color: '#22d3ee', glow: 'rgba(34,211,238,.25)', img: 'david-l.jpg' },
  { name: 'Maria R.',  typeLabel: 'VIP',   typeIcon: '👑', flag: '🇪🇸', role: lang === 'de' ? 'VIP-Betreuerin'   : lang === 'sl' ? 'VIP specialist'    : 'VIP Handler',      criteria: lang === 'de' ? 'Kundentyp'        : lang === 'sl' ? 'Vrsta stranke'     : 'Customer type',    color: '#f59e0b', glow: 'rgba(245,158,11,.25)',  img: 'maria-r.jpg' },
];
const rtCopy = {
  en: { heading: 'Every lead routed to the right agent.', sub: 'Every lead is routed automatically based on language, skill, availability, and customer type.' },
  de: { heading: 'Jeder Lead zum richtigen Agenten geleitet.', sub: 'Jeder Lead wird automatisch nach Sprache, Skill, Verfügbarkeit und Kundentyp weitergeleitet.' },
  sl: { heading: 'Vsak lead usmerjen k pravemu agentu.', sub: 'Vsak lead je samodejno usmerjen glede na jezik, znanje, razpoložljivost in vrsto stranke.' },
};
const rt = rtCopy[lang];

const proofItems = [
  { client: 'iMotorbike',   cat: 'Automotive', stat: '80%',  accent: '#E8420C', glow: 'rgba(232,66,12,.22)',   logo: '/images/logos/clients/imotorbike.svg',   label: lang === 'de' ? 'Anfragen automatisiert' : lang === 'sl' ? 'poizvedb avtomatiziranih' : 'inquiries automated',       slug: 'imotorbike-ai-lead-qualification' },
  { client: 'Only Tourism', cat: 'Travel',     stat: '60%',  accent: '#0055ff', glow: 'rgba(0,85,255,.22)',    logo: '/images/logos/clients/only-tourism.svg', label: lang === 'de' ? 'mehr Conversions'       : lang === 'sl' ? 'rast konverzij'           : 'conversion rate increase',  slug: 'only-tourism-ai-visa-automation'  },
  { client: 'Parcel Daily', cat: 'Logistics',  stat: '300%', accent: '#F97316', glow: 'rgba(249,115,22,.22)',  logo: '/images/logos/clients/parcel-daily.svg', label: lang === 'de' ? 'Umsatzwachstum in 6M'  : lang === 'sl' ? 'rast prihodkov v 6M'      : 'revenue growth in 6 months',slug: 'parcel-daily-conversion-boost'    },
];
const proofEyebrow = lang === 'de' ? 'Echte Agentur-Ergebnisse' : lang === 'sl' ? 'Resnični rezultati agencij' : 'Real agency results';
const projectBase  = lang === 'en' ? '/projects' : `/${lang}/projects`;
---

<section class="v2-hero">
  <div class="v2-container">

    <div class="v2-hero__top">
      <div class="v2-hero__badge">
        <span class="v2-hero__badge-dot"></span>
        <span class="v2-hero__badge-text">{c.badge}</span>
      </div>
      <h1 class="v2-h1">
        {c.h1Line1} <br/>
        <span class="v2-grad">{c.h1Line2}</span>
      </h1>
      <p class="v2-hero__subtitle" set:html={c.subtitle} />

      <div class="v2-hero__actions">
        <a
          href="javascript:void(0)"
          class="v2-btn v2-btn-primary"
          data-cal-link="kerim-alihodza-7u7w6q/30min"
          data-cal-namespace="30min"
          data-cal-config='{"layout":"month_view","theme":"dark"}'
        >
          {c.ctaPrimary}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#how-it-works" class="v2-btn v2-btn-outline">{c.ctaSecondary}</a>
      </div>

      <div class="v2-hero__trust">
        <div class="v2-hero__logos">
          <div class="v2-hero__logo-pill">
            <img src="/images/logos/only-tourism.svg" alt="Only Tourism" height="22" loading="lazy" />
          </div>
        </div>
        <span class="v2-hero__trust-sep" aria-hidden="true"></span>
        <span class="v2-hero__trust-text">{c.trustText}</span>
      </div>
    </div>

    <!-- Visual: image + floating social chips -->
    <div class="v2-hero__visual-wrap">

      {socials.map((s, i) => (
        <div
          class={`v2-hero__chip v2-hero__chip--${s.pos}`}
          style={`--chip-bg:${s.chipBg};--chip-border:${s.border};--chip-delay:${i * 0.35}s`}
          aria-hidden="true"
        >
          <span class="v2-hero__chip-icon" style={`background:${s.iconBg}${s.circle ? ';border-radius:50%' : ''}`}>
            <Fragment set:html={s.icon} />
          </span>
          <span class="v2-hero__chip-body">
            <span class="v2-hero__chip-name">{s.name}</span>
            <span class="v2-hero__chip-stat">{s.stat}</span>
          </span>
        </div>
      ))}

      <div class="v2-hero__visual">
        <Image
          src={heroImg}
          alt="AI Customer System — unified inbox managing leads across WhatsApp, Instagram, TikTok, Facebook and 40+ channels"
          loading="eager"
          quality={90}
        />
      </div>

    </div>

    <!-- ── Scroll-animated lead routing tree ─────────────── -->
    <div class="v2-rt">

      <svg class="v2-rt__svg" viewBox="0 0 800 200" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <defs>
          <!-- Trunk: fades in from image, precise userSpace coords -->
          <linearGradient id="rtTrunkGrad" gradientUnits="userSpaceOnUse" x1="400" y1="0" x2="400" y2="80">
            <stop offset="0%"   stop-color="rgba(99,102,241,0.4)"/>
            <stop offset="100%" stop-color="#6366f1"/>
          </linearGradient>
          <!-- Branch gradients: all begin indigo at fork, bleed into agent color -->
          <linearGradient id="rtB1Grad" gradientUnits="userSpaceOnUse" x1="400" y1="80" x2="100" y2="200">
            <stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#6366f1"/>
          </linearGradient>
          <linearGradient id="rtB2Grad" gradientUnits="userSpaceOnUse" x1="400" y1="80" x2="300" y2="200">
            <stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#a855f7"/>
          </linearGradient>
          <linearGradient id="rtB3Grad" gradientUnits="userSpaceOnUse" x1="400" y1="80" x2="500" y2="200">
            <stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#22d3ee"/>
          </linearGradient>
          <linearGradient id="rtB4Grad" gradientUnits="userSpaceOnUse" x1="400" y1="80" x2="700" y2="200">
            <stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#f59e0b"/>
          </linearGradient>
          <filter id="rtNodeGlow" x="-100%" y="-100%" width="300%" height="300%">
            <feGaussianBlur stdDeviation="3" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        <!-- Trunk: starts at hero image bottom edge, grows down to fork -->
        <path class="rt-path rt-trunk" d="M 400 0 L 400 80"
          stroke="url(#rtTrunkGrad)" stroke-width="2.5" stroke-linecap="round"/>
        <!-- Branches: unified start color splits into agent colors -->
        <path class="rt-path rt-branch" d="M 400 80 C 400 140 100 140 100 200"
          stroke="url(#rtB1Grad)" stroke-width="2.5" stroke-linecap="round"/>
        <path class="rt-path rt-branch" d="M 400 80 C 400 140 300 140 300 200"
          stroke="url(#rtB2Grad)" stroke-width="2.5" stroke-linecap="round"/>
        <path class="rt-path rt-branch" d="M 400 80 C 400 140 500 140 500 200"
          stroke="url(#rtB3Grad)" stroke-width="2.5" stroke-linecap="round"/>
        <path class="rt-path rt-branch" d="M 400 80 C 400 140 700 140 700 200"
          stroke="url(#rtB4Grad)" stroke-width="2.5" stroke-linecap="round"/>
        <!-- Endpoint glow nodes -->
        <circle class="rt-node" cx="100" cy="200" r="5" fill="#6366f1" filter="url(#rtNodeGlow)"/>
        <circle class="rt-node" cx="300" cy="200" r="5" fill="#a855f7" filter="url(#rtNodeGlow)"/>
        <circle class="rt-node" cx="500" cy="200" r="5" fill="#22d3ee" filter="url(#rtNodeGlow)"/>
        <circle class="rt-node" cx="700" cy="200" r="5" fill="#f59e0b" filter="url(#rtNodeGlow)"/>
      </svg>

      <!-- Agent characters: one per branch endpoint (4-col grid aligns with SVG) -->
      <div class="v2-rt__agents">
        {rtAgents.map((a, i) => (
          <div class="v2-rt__agent" style={`--col:${a.color};--glow:${a.glow};--i:${i}`}>
            <!-- Full-bleed AI portrait -->
            <img
              src={`/images/agents/${a.img}`}
              alt={`${a.name}, ${a.role}`}
              class="v2-rt__photo"
              loading="lazy"
            />
            <!-- Type pill — top left -->
            <div class="v2-rt__strip" aria-hidden="true">
              <span class="v2-rt__strip-icon">{a.typeIcon}</span>
              <span class="v2-rt__strip-label">{a.typeLabel}</span>
            </div>
            <!-- Country flag — top right -->
            <span class="v2-rt__flag" aria-hidden="true">{a.flag}</span>
            <!-- Glass info panel — bottom -->
            <div class="v2-rt__info">
              <span class="v2-rt__name">{a.name}</span>
              <span class="v2-rt__role">{a.role}</span>
              <span class="v2-rt__badge">{a.criteria}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Heading + subheading: routing criteria explanation -->
      <div class="v2-rt__copy" data-m="up" style="--m-d:.1s">
        <h2 class="v2-rt__h2">{rt.heading}</h2>
        <p class="v2-rt__sub">{rt.sub}</p>
      </div>

    </div>

    <!-- ── Real agency results proof strip ───────────────── -->
    <div class="v2-proof">
      <div class="v2-proof__head" data-m="fade">
        <span class="v2-eyebrow">{proofEyebrow}</span>
      </div>
      <div class="v2-proof__grid">
        {proofItems.map((p, i) => (
          <a
            href={`${projectBase}/${p.slug}/`}
            class="v2-proof__card"
            data-m="up"
            style={`--m-d:${i * 0.08}s; --accent:${p.accent}; --glow:${p.glow}`}
          >
            <!-- glow orb -->
            <span class="v2-proof__orb" aria-hidden="true"/>
            <!-- header row: category + arrow -->
            <div class="v2-proof__card-head">
              <span class="v2-proof__cat">{p.cat}</span>
              <svg class="v2-proof__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 12L12 2M12 2H5M12 2V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <!-- stat -->
            <span class="v2-proof__stat">{p.stat}</span>
            <span class="v2-proof__stat-label">{p.label}</span>
            <!-- client logo -->
            <div class="v2-proof__logo-wrap">
              <img
                src={p.logo}
                alt={p.client}
                class="v2-proof__logo"
                loading="lazy"
                height="28"
              />
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- Schema: Lead routing to agents presentation for Google -->
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Automated Lead Routing to Sales Agents",
  "description": "AI-powered system that automatically routes incoming leads to the right sales agent based on language, skill level, availability and customer type in under 2 seconds.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Lead arrives via any channel",
      "text": "A new lead arrives via WhatsApp, Instagram, Facebook, TikTok, email or SMS and enters the AI Customer System."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "AI routing engine evaluates criteria",
      "text": "The routing engine instantly evaluates the lead against criteria including language, customer type, agent availability and required skill level."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Lead assigned to the right agent in under 2 seconds",
      "text": "The lead is automatically routed to the best-matched available agent — Sales Rep by language match, Senior Closer by skill level, Support by availability, or Account Manager by customer type."
    }
  ],
  "tool": [{ "@type": "HowToTool", "name": "AI Customer System by CreativeComplete" }]
})} />

<style lang="scss">

@keyframes hero-float-a {
  0%,100% { transform: translateY(0px); }
  45%     { transform: translateY(-10px); }
}
@keyframes hero-float-b {
  0%,100% { transform: translateY(0px); }
  40%     { transform: translateY(-7px); }
  70%     { transform: translateY(-13px); }
}
@keyframes hero-float-c {
  0%,100% { transform: translateY(0px); }
  55%     { transform: translateY(-8px); }
}
@keyframes chip-in {
  from { opacity: 0; transform: translateY(14px) scale(.9); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ── Hero top ───────────────────────────────────────── */
.v2-hero__top {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20px;
  margin-bottom: 24px;

  .v2-h1 { font-size: clamp(36px, 5.5vw, 80px); }
}

.v2-hero__subtitle {
