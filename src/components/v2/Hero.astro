---
import { Image } from 'astro:assets';
import chatImg from '../../images/chat.png';
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).hero;
---

<section class="v2-hero">
  <div class="v2-container">

    <div class="v2-hero__top">
      <div class="v2-hero__badge">
        <span class="v2-hero__badge-dot"></span>
        <span class="v2-hero__badge-text">{c.badge}</span>
      </div>
      <h1 class="v2-h1">
        {c.h1Line1} <br/>
        <span class="v2-grad">{c.h1Line2}</span>
      </h1>
      <p class="v2-hero__subtitle">{c.subtitle}</p>

      <div class="v2-hero__actions">
        <a
          href="javascript:void(0)"
          class="v2-btn v2-btn-primary"
          data-cal-link="kerim-alihodza-7u7w6q/30min"
          data-cal-namespace="30min"
          data-cal-config='{"layout":"month_view","theme":"dark"}'
        >
          {c.ctaPrimary}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#how-it-works" class="v2-btn v2-btn-outline">{c.ctaSecondary}</a>
      </div>

      <div class="v2-hero__trust">
        <div class="v2-hero__logos">
          <div class="v2-hero__logo-pill">
            <img src="/images/logos/only-tourism.svg" alt="Only Tourism" height="22" loading="lazy" />
          </div>
        </div>
        <span class="v2-hero__trust-sep" aria-hidden="true"></span>
        <span class="v2-hero__trust-text">{c.trustText}</span>
      </div>
    </div>

    <div class="v2-hero__visual">
      <Image
        src={chatImg}
        alt="AI Sales Agent managing leads in real time - inbox, lifecycle stages, and WhatsApp conversations"
        loading="eager"
        quality={90}
      />
    </div>

  </div>
</section>

<style lang="scss">
.v2-hero__top {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20px;
  margin-bottom: 48px;

  .v2-h1 { font-size: clamp(36px, 5.5vw, 80px); }
}

.v2-hero__subtitle {
  font-size: clamp(16px, 1.4vw, 20px);
  color: var(--fg-1);
  max-width: 52ch;
  line-height: 1.6;
  margin: 0;
}

.v2-hero__actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}

.v2-hero__trust {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}

.v2-hero__logos {
  display: flex;
  align-items: center;
  gap: 8px;
}

.v2-hero__logo-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px 14px;
  border-radius: 99px;
  background: var(--bg-card);
  border: 1px solid var(--line);

  img {
    display: block;
    height: 20px;
    width: auto;
    filter: brightness(0) invert(0.65);
    transition: filter .2s;
  }

  &:hover img { filter: brightness(0) invert(0.85); }
}

.v2-hero__trust-sep {
  width: 1px;
  height: 16px;
  background: var(--line);
  flex-shrink: 0;
}

.v2-hero__trust-text {
  font-size: 12px;
  font-family: var(--font-mono);
  letter-spacing: .05em;
  color: var(--fg-2);
  white-space: nowrap;
}

.v2-hero__visual {
  position: relative;
  border-radius: var(--r-xl);
  overflow: hidden;
  box-shadow:
    0 0 0 1px var(--line),
    0 32px 100px rgba(0, 0, 0, 0.55),
    0 0 80px rgba(99, 102, 241, 0.12);

  img {
    width: 100%;
    height: auto;
    display: block;
  }
}
</style>
