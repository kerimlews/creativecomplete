---
// LeadJourneyMotion.astro — full-width, no bg, persistent social orbit left
---

<div class="ljm" id="ljm">

  <!-- ══ Persistent social icons — always visible, always floating ══ -->
  <div class="ljm__orbs">
    <div class="ljm__orb-line"></div>

    <div class="ljm__ob" style="--d:0s">
      <svg width="38" height="38" viewBox="0 0 30 30"><rect width="30" height="30" rx="8" fill="#25d366"/><path d="M15 5C9.48 5 5 9.48 5 15c0 1.85.5 3.59 1.38 5.08L5 25l5.04-1.35A10 10 0 1015 5zm4.6 13.34c-.24-.12-1.4-.69-1.62-.77-.21-.08-.37-.12-.52.12-.16.24-.6.77-.74.93s-.28.18-.52.06c-.24-.12-1.02-.38-1.94-1.2a7.3 7.3 0 01-1.34-1.67c-.14-.24-.01-.37.1-.49.1-.1.24-.28.36-.43.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.52-1.25-.71-1.71-.19-.45-.38-.39-.52-.4h-.45c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16z" fill="white"/></svg>
      <span class="ljm__ob-ring"></span>
    </div>

    <div class="ljm__ob" style="--d:.55s">
      <svg width="38" height="38" viewBox="0 0 30 30"><defs><linearGradient id="lig2" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="50%" stop-color="#dc2743"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs><rect width="30" height="30" rx="8" fill="url(#lig2)"/><rect x="7" y="7" width="16" height="16" rx="4" fill="none" stroke="white" stroke-width="1.8"/><circle cx="15" cy="15" r="4.2" fill="none" stroke="white" stroke-width="1.8"/><circle cx="21.5" cy="8.5" r="1.3" fill="white"/></svg>
      <span class="ljm__ob-ring"></span>
    </div>

    <div class="ljm__ob" style="--d:1.1s">
      <svg width="38" height="38" viewBox="0 0 30 30"><rect width="30" height="30" rx="8" fill="#010101"/><path d="M20.4 8.4a5.6 5.6 0 01-3.4-3.6h-2.8v13.7a2.84 2.84 0 01-2.83 2.6 2.84 2.84 0 01-2.84-2.84 2.84 2.84 0 012.84-2.84c.27 0 .53.04.77.11v-2.9a6.56 6.56 0 00-.77-.05 6.56 6.56 0 00-6.56 6.56 6.56 6.56 0 006.56 6.56 6.56 6.56 0 006.56-6.56V11.3a9.1 9.1 0 005.3 1.68V10.1a5.6 5.6 0 01-2.77-.33z" fill="white"/></svg>
      <span class="ljm__ob-ring"></span>
    </div>

    <div class="ljm__ob" style="--d:1.65s">
      <svg width="38" height="38" viewBox="0 0 30 30"><rect width="30" height="30" rx="8" fill="#1877f2"/><path d="M17.5 30V19h3.8l.57-4.4H17.5v-2.78c0-1.2.33-2.02 2.12-2.02H22V6.17A28.2 28.2 0 0018.8 6c-3.4 0-5.72 2.08-5.72 5.9v3.7H9.3V20h3.78V30h4.42z" fill="white"/></svg>
      <span class="ljm__ob-ring"></span>
    </div>

    <div class="ljm__ob" style="--d:2.2s">
      <svg width="38" height="38" viewBox="0 0 30 30"><rect width="30" height="30" rx="8" fill="#6366f1"/><rect x="5" y="9" width="20" height="13" rx="2" fill="none" stroke="white" stroke-width="1.8"/><polyline points="5,10.5 15,17.5 25,10.5" fill="none" stroke="white" stroke-width="1.8" stroke-linejoin="round"/></svg>
      <span class="ljm__ob-ring"></span>
    </div>

    <div class="ljm__ob" style="--d:2.75s">
      <svg width="38" height="38" viewBox="0 0 30 30"><rect width="30" height="30" rx="8" fill="#22d3ee"/><path d="M6 8h18a1 1 0 011 1v11a1 1 0 01-1 1H10l-5 4V9a1 1 0 011-1z" fill="none" stroke="white" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 14h10M10 11h7" stroke="white" stroke-width="1.4" stroke-linecap="round"/></svg>
      <span class="ljm__ob-ring"></span>
    </div>
  </div>


  <!-- ══ Main stage ════════════════════════════════════════════════ -->
  <div class="ljm__stage">

    <div class="ljm__prog-track"><div class="ljm__prog" id="ljmProg"></div></div>

    <div class="ljm__dots">
      {Array.from({length:8}).map((_,i) => <span class:list={['ljm__d', {on: i===0}]} data-i={i}></span>)}
    </div>


    <!-- ── SLIDE 0 · CAPTURE ── -->
    <div class="ljm__slide on" data-s="0">
      <div class="ljm__eye"><span class="ljm__live-dot"></span>Lead Capture · 40+ channels</div>

      <div class="ljm__ch-grid">
        <span class="ljm__chtag wa"  style="--d:.1s">WA</span>
        <span class="ljm__chtag ig"  style="--d:.25s">Instagram</span>
        <span class="ljm__chtag tt"  style="--d:.4s">TikTok</span>
        <span class="ljm__chtag fb"  style="--d:.55s">Facebook</span>
        <span class="ljm__chtag em"  style="--d:.7s">Email</span>
        <span class="ljm__chtag sms" style="--d:.85s">SMS</span>
      </div>

      <div class="ljm__unify" style="--d:1.1s">
        <div class="ljm__unify-line"></div>
        <span><span class="ljm__live-dot" style="width:6px;height:6px"></span> all channels · zero missed leads</span>
      </div>

      <div class="ljm__notif" style="--d:1.8s">
        <div class="ljm__av ig">M</div>
        <div class="ljm__notif-txt">
          <strong>Maria Santos</strong>
          <span>Instagram DM · just now</span>
        </div>
        <span class="ljm__tag new">NEW LEAD</span>
      </div>
    </div>


    <!-- ── SLIDE 1 · INQUIRY ── -->
    <div class="ljm__slide" data-s="1">
      <div class="ljm__eye" style="color:var(--c3)"><span class="ljm__live-dot" style="background:var(--c3);box-shadow:0 0 8px var(--c3)"></span>Lead Inquiry · Instagram DM</div>

      <div class="ljm__conv-hdr">
        <div class="ljm__av ig">M</div>
        <div>
          <div class="ljm__conv-name">Maria Santos</div>
          <div class="ljm__conv-src">
            <svg width="13" height="13" viewBox="0 0 30 30"><defs><linearGradient id="lig3" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#f09433"/><stop offset="100%" stop-color="#bc1888"/></linearGradient></defs><rect width="30" height="30" rx="7" fill="url(#lig3)"/><rect x="7" y="7" width="16" height="16" rx="4" fill="none" stroke="white" stroke-width="1.8"/><circle cx="15" cy="15" r="4.2" fill="none" stroke="white" stroke-width="1.8"/></svg>
            Instagram · Meta Ad → Real Estate
          </div>
        </div>
      </div>

      <div class="ljm__msgs">
        <div class="ljm__msg in" style="--d:.4s">
          Hi! I saw your ad about the Oak Street apartments. I'm interested in the 3-bedroom unit. My budget is <strong>€450,000</strong>. Is it still available? 🏠
        </div>
      </div>
    </div>


    <!-- ── SLIDE 2 · AI QUALIFY ── -->
    <div class="ljm__slide" data-s="2">
      <div class="ljm__eye"><span class="ljm__live-dot"></span>AI Qualification · 18 seconds</div>

      <div class="ljm__msgs">
        <div class="ljm__msg in sm" style="--d:.2s">
          Hi! Interested in Oak St 3BR. Budget €450k — still available?
        </div>
        <div class="ljm__typing" style="--d:.7s">
          <span class="ljm__td"></span><span class="ljm__td"></span><span class="ljm__td"></span>
          <span class="ljm__typing-lbl">AI qualifying · 18s</span>
        </div>
        <div class="ljm__msg out" style="--d:1.5s">
          Yes! Oak St 3BR is available at €445,000. Are you pre-approved for financing? Looking to move within 3 months?
          <div class="ljm__msg-tag">AI Agent · Instant</div>
        </div>
        <div class="ljm__msg in" style="--d:2.5s">
          Yes, pre-approved for €500k. We want to move in 6 weeks! 🙌
        </div>
        <div class="ljm__sys" style="--d:3.3s">
          <span class="ljm__sys-dot"></span>
          Lifecycle <strong>New Lead → Hot Lead</strong> · Assigned to Sales Rep · Score 96
        </div>
      </div>
    </div>


    <!-- ── SLIDE 3 · HOT LEAD ── -->
    <div class="ljm__slide" data-s="3">
      <div class="ljm__eye" style="color:#fb923c"><span class="ljm__live-dot" style="background:#f97316;box-shadow:0 0 8px #f97316"></span>Lead Qualified</div>

      <div class="ljm__hot-card">
        <div class="ljm__hot-fire">🔥 HOT LEAD</div>
        <div class="ljm__hot-row">
          <div class="ljm__av lg ig">M</div>
          <div>
            <div class="ljm__hot-name">Maria Santos</div>
            <div class="ljm__hot-meta">Pre-approved €500k · Moving in 6 weeks</div>
          </div>
          <span class="ljm__score-big">96</span>
        </div>
        <div class="ljm__score-track"><div class="ljm__score-fill"></div></div>
        <div class="ljm__hot-chips">
          <span class="ljm__hc ig">Instagram</span>
          <span class="ljm__hc grn">Pre-approved</span>
          <span class="ljm__hc cyn">6 weeks</span>
          <span class="ljm__hc vio">3BR Oak St</span>
        </div>
        <div class="ljm__hot-assign">
          Assigned → <strong>Sarah (Sales Rep)</strong> · Thu 14:00
        </div>
      </div>
    </div>


    <!-- ── SLIDE 4 · 1000 LEADS ── -->
    <div class="ljm__slide" data-s="4">
      <div class="ljm__eye"><span class="ljm__live-dot"></span>CRM · Hot Leads Pool</div>

      <div class="ljm__pool-top">
        <span class="ljm__pool-n" id="ljmPoolN">0</span>
        <span class="ljm__pool-label">Hot Leads Ready</span>
      </div>
      <div class="ljm__dot-grid" id="ljmGrid"></div>
      <div class="ljm__pool-chips">
        <span class="ljm__pc">WhatsApp Broadcast</span>
        <span class="ljm__pc cyn">Follow-up Sequence</span>
        <span class="ljm__pc vio">3-week drip</span>
      </div>
    </div>


    <!-- ── SLIDE 5 · WEEK 1 ── -->
    <div class="ljm__slide" data-s="5">
      <div class="ljm__eye" style="color:var(--c2)"><span class="ljm__live-dot" style="background:var(--c2);box-shadow:0 0 8px var(--c2)"></span>Follow-up Sequence · Week 1</div>

      <div class="ljm__week-card">
        <div class="ljm__wk-badge w1">WEEK 1</div>
        <div class="ljm__wk-tmpl">
          <div class="ljm__wk-hdr">
            <svg width="15" height="15" viewBox="0 0 30 30"><rect width="30" height="30" rx="7" fill="#25d366"/><path d="M15 5C9.48 5 5 9.48 5 15c0 1.85.5 3.59 1.38 5.08L5 25l5.04-1.35A10 10 0 1015 5z" fill="white"/></svg>
            WhatsApp Broadcast · 1,000 leads
          </div>
          <div class="ljm__wk-body">
            Hi <span class="ljm__var">&#123;&#123;first_name&#125;&#125;</span> 👋<br/>
            Exclusive listing — 3BR Oak Street, €445,000.<br/>
            <strong>Reply YES to get full details + photos.</strong>
          </div>
        </div>
        <div class="ljm__wk-stats">
          <span class="ljm__wks sent">📤 1,000 Sent</span>
          <span class="ljm__wks open">👁 680 Opened</span>
          <span class="ljm__wks mute">💬 Waiting...</span>
        </div>
      </div>
    </div>


    <!-- ── SLIDE 6 · WEEK 2 ── -->
    <div class="ljm__slide" data-s="6">
      <div class="ljm__eye" style="color:var(--c3)"><span class="ljm__live-dot" style="background:var(--c3);box-shadow:0 0 8px var(--c3)"></span>Follow-up Sequence · Week 2</div>

      <div class="ljm__week-card">
        <div class="ljm__wk-badge w2">WEEK 2</div>
        <div class="ljm__wk-tmpl">
          <div class="ljm__wk-hdr">
            <svg width="15" height="15" viewBox="0 0 30 30"><rect width="30" height="30" rx="7" fill="#25d366"/><path d="M15 5C9.48 5 5 9.48 5 15c0 1.85.5 3.59 1.38 5.08L5 25l5.04-1.35A10 10 0 1015 5z" fill="white"/></svg>
            WhatsApp Broadcast · 1,000 leads
          </div>
          <div class="ljm__wk-body">
            <span class="ljm__var">&#123;&#123;first_name&#125;&#125;</span>, Oak Street just dropped to <strong>€435,000</strong> 🏠<br/>
            3 other buyers viewing this week.<br/>
            <strong>Reply NOW to schedule a private showing.</strong>
          </div>
        </div>
        <div class="ljm__wk-stats">
          <span class="ljm__wks sent">📤 1,000 Sent</span>
          <span class="ljm__wks open">👁 710 Opened</span>
          <span class="ljm__wks reply">💬 42 Replies</span>
        </div>
      </div>
    </div>


    <!-- ── SLIDE 7 · WEEK 3 + CLOSE ── -->
    <div class="ljm__slide" data-s="7">
      <div class="ljm__eye" style="color:#4ade80"><span class="ljm__live-dot" style="background:#22c55e;box-shadow:0 0 8px #22c55e"></span>Week 3 · Deal Closed</div>

      <div class="ljm__msgs">
        <div class="ljm__msg out sm" style="--d:.2s">
          <span class="ljm__var">&#123;&#123;first_name&#125;&#125;</span>, final chance — showing this Saturday. Only 2 slots left 🏠
          <div class="ljm__msg-tag">AI Sequence · D+21</div>
        </div>
        <div class="ljm__msg in" style="--d:1.2s">
          YES! I'm ready to move forward. Can we meet Friday? 🙌
        </div>
        <div class="ljm__sys green" style="--d:2.1s">
          🎉 <strong>Deal Closed</strong> · €435,000 · Maria Santos
        </div>
      </div>

      <div class="ljm__close-stats">
        <div class="ljm__cs"><span class="ljm__cs-n">3</span><span class="ljm__cs-l">Weeks</span></div>
        <div class="ljm__cs"><span class="ljm__cs-n c2">42.5×</span><span class="ljm__cs-l">ROI</span></div>
        <div class="ljm__cs"><span class="ljm__cs-n grn">€435k</span><span class="ljm__cs-l">Deal Value</span></div>
      </div>
    </div>

  </div><!-- /stage -->
</div>


<script>
(() => {
  const DURATIONS = [4200, 4000, 5500, 4000, 3500, 4000, 4000, 5500];
  const root  = document.getElementById('ljm');
  if (!root) return;
  const slides = [...root.querySelectorAll<HTMLElement>('.ljm__slide')];
  const dots   = [...root.querySelectorAll<HTMLElement>('.ljm__d')];
  const prog   = root.querySelector<HTMLElement>('.ljm__prog');
  let cur = 0, timer: ReturnType<typeof setTimeout>;

  function buildGrid() {
    const el = document.getElementById('ljmGrid');
    if (!el || el.childElementCount > 0) return;
    const f = document.createDocumentFragment();
    for (let i = 0; i < 500; i++) {
      const d = document.createElement('span');
      d.className = 'ljm__gdot';
      d.style.setProperty('--di', String((i * 7) % 500));
      f.appendChild(d);
    }
    el.appendChild(f);
  }

  function counter(el: HTMLElement | null, to: number, dur: number) {
    if (!el) return;
    const t0 = performance.now();
    (function tick(now: number) {
      const p = Math.min((now - t0) / dur, 1);
      el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(tick);
    })(t0);
  }

  function go(idx: number) {
    slides.forEach(s => s.classList.remove('on'));
    dots.forEach(d => d.classList.remove('on'));
    cur = idx;
    slides[idx]?.classList.add('on');
    dots[idx]?.classList.add('on');
    if (prog) {
      prog.style.transition = 'none'; prog.style.width = '0%';
      void prog.offsetWidth;
      prog.style.transition = `width ${DURATIONS[idx]}ms linear`;
      prog.style.width = '100%';
    }
    if (idx === 4) { buildGrid(); counter(document.getElementById('ljmPoolN'), 1000, 2000); }
    clearTimeout(timer);
    timer = setTimeout(() => go((cur + 1) % slides.length), DURATIONS[idx]);
  }

  dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
  go(0);
})();
</script>


<style lang="scss">

@keyframes ljm-fade    { from{opacity:0} to{opacity:1} }
@keyframes ljm-up      { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:none} }
@keyframes ljm-in      { from{opacity:0;transform:translateX(-12px)} to{opacity:1;transform:none} }
@keyframes ljm-scale   { from{opacity:0;transform:scale(.8)} to{opacity:1;transform:scale(1)} }
@keyframes ljm-pulse   { 0%,100%{box-shadow:0 0 6px var(--c2)} 50%{box-shadow:0 0 20px var(--c2),0 0 40px rgba(34,211,238,.3)} }
@keyframes ljm-bounce  { 0%,100%{transform:translateY(0);opacity:.4} 50%{transform:translateY(-4px);opacity:1} }
@keyframes ljm-fill    { from{width:0} to{width:var(--w,80%)} }
@keyframes ljm-notif   { from{opacity:0;transform:translateY(14px) scale(.96)} to{opacity:1;transform:none} }
@keyframes ljm-dot-in  { from{opacity:0;transform:scale(0)} to{opacity:.6;transform:scale(1)} }
@keyframes ljm-fire    { 0%,100%{text-shadow:0 0 14px rgba(249,115,22,.6)} 50%{text-shadow:0 0 32px rgba(249,115,22,.9),0 0 60px rgba(249,115,22,.35)} }
@keyframes ljm-scorefill { from{width:0} to{width:96%} }

/* float with slight drift — each icon gets its own path */
@keyframes ljm-float-a { 0%,100%{transform:translateY(0) translateX(0)} 33%{transform:translateY(-8px) translateX(3px)} 66%{transform:translateY(-4px) translateX(-3px)} }
@keyframes ljm-float-b { 0%,100%{transform:translateY(0) translateX(0)} 33%{transform:translateY(-5px) translateX(-4px)} 66%{transform:translateY(-9px) translateX(2px)} }
@keyframes ljm-float-c { 0%,100%{transform:translateY(0) translateX(0)} 33%{transform:translateY(-7px) translateX(4px)} 66%{transform:translateY(-3px) translateX(-2px)} }

@keyframes ljm-ring    { 0%{transform:scale(1);opacity:.5} 100%{transform:scale(2.4);opacity:0} }

/* ── Root ──────────────────────────────────────────────── */
.ljm {
  display: flex;
  gap: 0;
  width: 100%;
  position: relative;
}

/* ── Social icons column ────────────────────────────────── */
.ljm__orbs {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 24px 0;
  width: 56px;
  flex-shrink: 0;
  position: relative;
}

.ljm__orb-line {
  position: absolute;
  top: 28px; bottom: 28px;
  left: 50%; transform: translateX(-50%);
  width: 1px;
  background: linear-gradient(to bottom, transparent, rgba(99,102,241,.35) 30%, rgba(34,211,238,.35) 70%, transparent);
  pointer-events: none;
}

.ljm__ob {
  position: relative;
  svg { display: block; border-radius: 9px; filter: drop-shadow(0 4px 14px rgba(0,0,0,.45)); }
  &:nth-child(odd)  { animation: ljm-float-a 4s ease-in-out infinite; animation-delay: var(--d,0s); }
  &:nth-child(even) { animation: ljm-float-b 4.5s ease-in-out infinite; animation-delay: var(--d,0s); }
  &:nth-child(3n)   { animation: ljm-float-c 3.8s ease-in-out infinite; animation-delay: var(--d,0s); }
}
.ljm__ob-ring {
  position: absolute; inset: -5px; border-radius: 13px;
  border: 1px solid rgba(255,255,255,.15);
  animation: ljm-ring 3s ease-out infinite;
  animation-delay: var(--d, 0s);
}

/* connector dots from icons into stage */
.ljm__ob::after {
  content: "";
  position: absolute; top: 50%; left: 100%;
  width: 16px; height: 1px;
  background: linear-gradient(90deg, rgba(255,255,255,.18), transparent);
  transform: translateY(-50%);
}

/* ── Stage ──────────────────────────────────────────────── */
.ljm__stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ljm__prog-track { height: 2px; background: rgba(255,255,255,.05); }
.ljm__prog { height: 100%; width: 0; background: linear-gradient(90deg,var(--c1),var(--c3),var(--c2)); }

.ljm__dots {
  display: flex; gap: 7px; padding: 10px 16px 0;
}
.ljm__d {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--line); cursor: pointer; transition: background .2s, transform .2s;
  &.on { background: var(--c2); transform: scale(1.5); box-shadow: 0 0 8px var(--c2); }
}

/* ── Slides ─────────────────────────────────────────────── */
.ljm__slide {
  display: none; flex-direction: column; gap: 14px;
  padding: 14px 18px 20px;
  &.on { display: flex; animation: ljm-fade .3s ease both; }
}

/* ── Eyebrow ─────────────────────────────────────────────── */
.ljm__eye {
  display: inline-flex; align-items: center; gap: 7px;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--c2);
  opacity: 0; .ljm__slide.on & { animation: ljm-fade .3s ease .1s both; }
}
.ljm__live-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--c2); box-shadow: 0 0 8px var(--c2);
  animation: ljm-pulse 2s ease-in-out infinite; flex-shrink: 0;
}

/* ── SLIDE 0 — channel tags ─────────────────────────────── */
.ljm__ch-grid {
  display: flex; flex-wrap: wrap; gap: 6px;
  opacity: 0; .ljm__slide.on & { animation: ljm-up .3s ease .15s both; }
}
.ljm__chtag {
  font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .07em;
  padding: 4px 10px; border-radius: var(--r-pill);
  opacity: 0; .ljm__slide.on & { animation: ljm-scale .3s cubic-bezier(.22,.68,0,1.3) both; animation-delay: var(--d,.1s); }
  &.wa  { background:rgba(37,211,102,.1);  color:#25d366; border:1px solid rgba(37,211,102,.3); }
  &.ig  { background:rgba(232,121,249,.1); color:#e879f9; border:1px solid rgba(232,121,249,.3); }
