---
import { Image } from 'astro:assets';
import channelsImg from '../../images/channels.png';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    eyebrow: '40+ channels',
    title: 'Every channel your leads use.',
    titleGrad: 'One unified inbox.',
    sub: 'WhatsApp, Instagram, Facebook Messenger, TikTok, email, SMS, live chat. Every conversation your leads start, handled in one place by your AI sales agent.',
    cta: 'See how it connects →',
    alt: 'Channel catalog showing 40+ connected platforms - WhatsApp, TikTok, Instagram, Messenger, Viber, LINE and more',
  },
  de: {
    eyebrow: '40+ Kanäle',
    title: 'Jeder Kanal, den Ihre Leads nutzen.',
    titleGrad: 'Ein einheitlicher Posteingang.',
    sub: 'WhatsApp, Instagram, Facebook Messenger, TikTok, E-Mail, SMS, Live-Chat. Jedes Gespräch, das Ihre Leads starten, wird an einem Ort von Ihrem KI-Vertriebsagenten bearbeitet.',
    cta: 'Wie es sich verbindet →',
    alt: 'Kanal-Katalog mit 40+ verbundenen Plattformen: WhatsApp, TikTok, Instagram, Messenger, Viber, LINE und mehr',
  },
  sl: {
    eyebrow: '40+ kanalov',
    title: 'Vsak kanal, ki ga vaši leadi uporabljajo.',
    titleGrad: 'Ena enotna mapa.',
    sub: 'WhatsApp, Instagram, Facebook Messenger, TikTok, e-pošta, SMS, live chat. Vsak pogovor vaših leadov, upravljan na enem mestu z vašim AI prodajnim agentom.',
    cta: 'Oglejte si, kako deluje →',
    alt: 'Katalog kanalov z 40+ povezanimi platformami: WhatsApp, TikTok, Instagram, Messenger, Viber, LINE in več',
  },
} as const;

const c = content[lang];
---

<section class="v2-channels">
  <div class="v2-container">

    <div class="v2-channels__head" data-m="fade">
      <span class="v2-eyebrow">{c.eyebrow}</span>
      <h2 class="v2-channels__title">
        {c.title}<br/>
        <span class="v2-grad">{c.titleGrad}</span>
      </h2>
      <p class="v2-channels__sub">{c.sub}</p>
    </div>

    <div class="v2-channels__visual" data-m="up" style="--m-d:.1s">
      <Image
        src={channelsImg}
        alt={c.alt}
        loading="lazy"
        quality={90}
      />
    </div>

    <div class="v2-channels__cta" data-m="up" style="--m-d:.2s">
      <a
        href="javascript:void(0)"
        class="v2-btn v2-btn-primary"
        data-cal-link="kerim-alihodza-7u7w6q/30min"
        data-cal-namespace="30min"
        data-cal-config='{"layout":"month_view","theme":"dark"}'
      >
        {c.cta}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style lang="scss">
.v2-channels {
  padding: 80px 0;
  border-bottom: 1px solid var(--line);
}

.v2-channels__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16px;
  margin-bottom: 48px;
}

.v2-channels__title {
  font-family: var(--font-display);
  font-size: clamp(24px, 3vw, 42px);
  font-weight: 400;
  letter-spacing: -.02em;
  color: var(--fg-0);
  margin: 0;
  line-height: 1.2;
}

.v2-channels__sub {
  font-size: clamp(15px, 1.3vw, 18px);
  color: var(--fg-1);
  max-width: 56ch;
  line-height: 1.65;
  margin: 0;
}

.v2-channels__cta {
  display: flex;
  justify-content: center;
  margin-top: 40px;
}

.v2-channels__visual {
  border-radius: var(--r-xl);
  overflow: hidden;
  box-shadow:
    0 0 0 1px var(--line),
    0 24px 80px rgba(0, 0, 0, 0.45),
    0 0 60px rgba(99, 102, 241, 0.1);

  img {
    width: 100%;
    height: auto;
    display: block;
  }
}
</style>
