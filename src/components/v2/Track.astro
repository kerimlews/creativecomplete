---
// Track.astro — Onboarding flow: Schedule → Questions → Price → Setup → You Win
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).track as any;

const stepIcons = [
  `<rect x="3" y="4" width="18" height="18" rx="2.5" stroke-width="1.8"/><path d="M16 2v4M8 2v4M3 10h18" stroke-width="1.8"/><circle cx="8" cy="15" r="1.2" fill="currentColor"/><circle cx="12" cy="15" r="1.2" fill="currentColor"/><circle cx="16" cy="15" r="1.2" fill="currentColor"/>`,
  `<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke-width="1.8"/><path d="M8 10h8M8 14h5" stroke-width="1.8"/>`,
  `<path d="M12 2a10 10 0 100 20A10 10 0 0012 2z" stroke-width="1.8"/><path d="M12 6v6l4 2" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/>`,
  `<path d="M4 17l8 4 8-4M4 12l8 4 8-4M12 2L4 7l8 4 8-4-8-4z" stroke-width="1.8" stroke-linejoin="round"/>`,
  `<path d="M6 9H4.5a2.5 2.5 0 010-5H6M18 9h1.5a2.5 2.5 0 000-5H18M18 2H6v7a6 6 0 0012 0V2z" stroke-width="1.8"/><path d="M12 16v4M8 22h8" stroke-width="1.8"/><path d="M9 13l2 2 4-4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>`,
];

const stepColors = ['#6366f1', '#a855f7', '#22d3ee', '#f97316', '#10b981'];
const stepBgs    = ['rgba(99,102,241,.12)', 'rgba(168,85,247,.12)', 'rgba(34,211,238,.1)', 'rgba(249,115,22,.1)', 'rgba(16,185,129,.1)'];
const stepGlows  = ['rgba(99,102,241,.3)', 'rgba(168,85,247,.3)', 'rgba(34,211,238,.28)', 'rgba(249,115,22,.28)', 'rgba(16,185,129,.28)'];
---

<section class="v2-track" id="how-it-works">
  <div class="v2-container">

    <div class="v2-track__head">
      <span class="v2-eyebrow" data-m="fade">{c.eyebrow}</span>
      <h2 class="v2-track__title" data-m="up" style="--m-d:.08s">
        {c.title} <span class="v2-grad">{c.titleGrad}</span>{c.titleSuffix}
      </h2>
    </div>

    <div class="v2-track__steps">

      {c.steps.map((step: any, i: number) => (
        <div class:list={['v2-track__step', { win: i === 4 }]} data-m="up" style={`--m-d:${0.05 + i * 0.08}s; --step-color:${stepColors[i]}; --step-bg:${stepBgs[i]}; --step-glow:${stepGlows[i]}; --step-i:${i}`}>
          <div class:list={['v2-track__num', { win: i === 4 }]}>{String(i + 1).padStart(2, '0')}</div>
          <div class:list={['v2-track__icon', { win: i === 4 }]}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={stepIcons[i]} />
          </div>
          <div class:list={['v2-track__label', { win: i === 4 }]}>{step.label}</div>
          <div class="v2-track__desc">{step.desc}</div>
          {i < 4 && <div class="v2-track__connector" aria-hidden="true"></div>}
        </div>
      ))}

    </div>

    <div class="v2-sc" data-m="up" style="--m-d:.45s">
      <a href="https://cal.com/kerim-alihodza-7u7w6q/30min" class="v2-sc__btn primary"
        >
        {c.cta}
      </a>
    </div>

  </div>
</section>


<style lang="scss">

.v2-track {
  padding: 72px 0 80px;
  border-bottom: 1px solid var(--line);
}

.v2-track__head {
  text-align: center;
  margin-bottom: 56px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}

.v2-track__title {
  font-family: var(--font-display);
  font-size: clamp(24px, 3vw, 42px);
  font-weight: 400;
  letter-spacing: -.02em;
  color: var(--fg-0);
  margin: 0;
  max-width: 600px;
}

/* ── Steps row ─────────────────────────────────────────── */
.v2-track__steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  position: relative;
}

/* ── Individual step ───────────────────────────────────── */
.v2-track__step {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 12px;
  position: relative;

  &:last-child .v2-track__connector { display: none; }
}

/* number badge */
.v2-track__num {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  color: var(--step-color, var(--fg-3));
  opacity: .7;
  margin-bottom: 10px;

  &.win {
    color: #10b981;
    opacity: 1;
    text-shadow: 0 0 12px rgba(16,185,129,.5);
  }
}

/* icon circle */
.v2-track__icon {
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background: var(--step-bg, rgba(99,102,241,.1));
  border: 1.5px solid var(--step-color, #6366f1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--step-color, #6366f1);
  margin-bottom: 16px;
  position: relative;
  z-index: 2;
  box-shadow: 0 0 18px var(--step-glow, rgba(99,102,241,.25)), 0 4px 16px rgba(0,0,0,.25);
  transition: box-shadow .3s ease, transform .3s ease;
  animation: trk-icon-glow 3s ease-in-out calc(var(--step-i, 0) * 0.55s) infinite;

  &::before {
    content: '';
    position: absolute; inset: -5px;
    border-radius: 50%;
    border: 1px solid var(--step-color, #6366f1);
    opacity: .18;
    animation: trk-ring-pulse 3s ease-in-out calc(var(--step-i, 0) * 0.55s) infinite;
  }

  .v2-track__step:hover & {
    transform: translateY(-3px) scale(1.06);
    box-shadow: 0 0 32px var(--step-glow, rgba(99,102,241,.4)), 0 8px 24px rgba(0,0,0,.3);
  }

  &.win {
    background: rgba(16,185,129,.1);
    border-color: #10b981;
    color: #10b981;
  }
}

/* per-step SVG animations */
.v2-track__step:nth-child(1) .v2-track__icon svg { animation: trk-bounce 2.8s ease-in-out infinite; }
.v2-track__step:nth-child(2) .v2-track__icon svg { animation: trk-ping  2.4s ease-in-out infinite; }
.v2-track__step:nth-child(3) .v2-track__icon svg { animation: trk-tick  3.2s ease-in-out infinite; }
.v2-track__step:nth-child(4) .v2-track__icon svg { animation: trk-float 2.6s ease-in-out infinite; }
.v2-track__step:nth-child(5) .v2-track__icon svg { animation: trk-star  2.2s ease-in-out infinite; }

@keyframes trk-icon-glow {
  0%,100% { box-shadow: 0 0 18px var(--step-glow), 0 4px 16px rgba(0,0,0,.25); }
  50%     { box-shadow: 0 0 32px var(--step-glow), 0 6px 22px rgba(0,0,0,.2); }
}
@keyframes trk-ring-pulse {
  0%,100% { opacity: .18; transform: scale(1); }
  50%     { opacity: .08; transform: scale(1.15); }
}
@keyframes trk-bounce {
  0%,100% { transform: translateY(0); }
  40%     { transform: translateY(-5px); }
  60%     { transform: translateY(-3px); }
}
@keyframes trk-ping {
  0%,100% { transform: scale(1); }
  40%     { transform: scale(1.12); }
  70%     { transform: scale(0.96); }
}
@keyframes trk-tick {
  0%,80%,100% { transform: rotate(0deg); }
  90%         { transform: rotate(8deg); }
}
@keyframes trk-float {
  0%,100% { transform: translateY(0) rotate(0deg); }
  50%     { transform: translateY(-4px) rotate(3deg); }
}
@keyframes trk-star {
  0%,100% { transform: scale(1) rotate(0deg); filter: brightness(1); }
  50%     { transform: scale(1.15) rotate(10deg); filter: brightness(1.4); }
}

/* step label */
.v2-track__label {
  font-size: 14px;
  font-weight: 600;
  color: var(--fg-0);
  margin-bottom: 8px;
  line-height: 1.3;

  &.win {
    color: var(--c2);
    text-shadow: 0 0 16px rgba(34,211,238,.35);
  }
}

/* step description */
.v2-track__desc {
  font-size: 12.5px;
  color: var(--fg-2);
  line-height: 1.6;
  max-width: 160px;
}

/* horizontal connector line between steps */
.v2-track__connector {
  position: absolute;
  top: 80px; /* vertically centered on the 68px icon */
  left: calc(50% + 40px);
  right: calc(-50% + 40px);
  height: 1px;
  background: linear-gradient(90deg, var(--line) 60%, transparent);
  z-index: 1;

  /* animated dash */
  &::after {
    content: "";
    position: absolute;
    top: -1px; left: 0;
    width: 8px; height: 3px;
    border-radius: 2px;
    background: var(--c1-light);
    opacity: .6;
    animation: trk-dash 2.5s ease-in-out infinite;
  }
}

@keyframes trk-dash {
  0%   { left: 0%;   opacity: .6; }
  100% { left: 100%; opacity: 0; }
}

/* ── Responsive ─────────────────────────────────────────── */
@media (max-width: 900px) {
  .v2-track__steps {
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 0;
  }

  .v2-track__step:nth-child(3) .v2-track__connector,
  .v2-track__step:last-child .v2-track__connector { display: none; }
}

@media (max-width: 560px) {
  .v2-track { padding: 48px 0 56px; }
  .v2-track__steps {
    grid-template-columns: 1fr 1fr;
    gap: 32px 0;
  }
  .v2-track__step:nth-child(2) .v2-track__connector,
  .v2-track__step:nth-child(4) .v2-track__connector { display: none; }
  .v2-track__step.win { grid-column: 1 / -1; }
}

</style>
