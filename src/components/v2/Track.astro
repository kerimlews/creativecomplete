---
// Track.astro — Onboarding flow: Schedule → Questions → Price → Setup → You Win
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).track as any;

const stepIcons = [
  `<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>`,
  `<path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>`,
  `<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>`,
  `<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>`,
  `<path d="M6 9H4.5a2.5 2.5 0 010-5H6"/><path d="M18 9h1.5a2.5 2.5 0 000-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0012 0V2z"/>`,
];
---

<section class="v2-track" id="how-it-works">
  <div class="v2-container">

    <div class="v2-track__head">
      <span class="v2-eyebrow" data-m="fade">{c.eyebrow}</span>
      <h2 class="v2-track__title" data-m="up" style="--m-d:.08s">
        {c.title} <span class="v2-grad">{c.titleGrad}</span>{c.titleSuffix}
      </h2>
    </div>

    <div class="v2-track__steps">

      {c.steps.map((step: any, i: number) => (
        <div class:list={['v2-track__step', { win: i === 4 }]} data-m="up" style={`--m-d:${0.05 + i * 0.08}s`}>
          <div class:list={['v2-track__num', { win: i === 4 }]}>{String(i + 1).padStart(2, '0')}</div>
          <div class:list={['v2-track__icon', { win: i === 4 }]}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={stepIcons[i]} />
          </div>
          <div class:list={['v2-track__label', { win: i === 4 }]}>{step.label}</div>
          <div class="v2-track__desc">{step.desc}</div>
          {i < 4 && <div class="v2-track__connector" aria-hidden="true"></div>}
        </div>
      ))}

    </div>

    <div class="v2-sc" data-m="up" style="--m-d:.45s">
      <a href="javascript:void(0)" class="v2-sc__btn primary"
         data-cal-link="kerim-alihodza-7u7w6q/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","theme":"dark"}'>
        {c.cta}
      </a>
    </div>

  </div>
</section>


<style lang="scss">

.v2-track {
  padding: 72px 0 80px;
  border-bottom: 1px solid var(--line);
}

.v2-track__head {
  text-align: center;
  margin-bottom: 56px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}

.v2-track__title {
  font-family: var(--font-display);
  font-size: clamp(24px, 3vw, 42px);
  font-weight: 400;
  letter-spacing: -.02em;
  color: var(--fg-0);
  margin: 0;
  max-width: 600px;
}

/* ── Steps row ─────────────────────────────────────────── */
.v2-track__steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  position: relative;
}

/* ── Individual step ───────────────────────────────────── */
.v2-track__step {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 12px;
  position: relative;

  &:last-child .v2-track__connector { display: none; }
}

/* number badge */
.v2-track__num {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  color: var(--fg-3);
  margin-bottom: 10px;

  &.win {
    color: var(--c2);
    text-shadow: 0 0 12px rgba(34,211,238,.5);
  }
}

/* icon circle */
.v2-track__icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--bg-elev);
  border: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--fg-2);
  margin-bottom: 16px;
  position: relative;
  z-index: 2;
  transition: border-color .25s, box-shadow .25s, color .25s;

  .v2-track__step:hover & {
    border-color: rgba(99,102,241,.4);
    color: var(--c1-light);
    box-shadow: 0 0 20px rgba(99,102,241,.15);
  }

  &.win {
    background: rgba(34,211,238,.06);
    border-color: rgba(34,211,238,.35);
    color: var(--c2);
    box-shadow: 0 0 28px rgba(34,211,238,.15);
  }
}

/* step label */
.v2-track__label {
  font-size: 14px;
  font-weight: 600;
  color: var(--fg-0);
  margin-bottom: 8px;
  line-height: 1.3;

  &.win {
    color: var(--c2);
    text-shadow: 0 0 16px rgba(34,211,238,.35);
  }
}

/* step description */
.v2-track__desc {
  font-size: 12.5px;
  color: var(--fg-2);
  line-height: 1.6;
  max-width: 160px;
}

/* horizontal connector line between steps */
.v2-track__connector {
  position: absolute;
  top: 68px; /* vertically centered on the icon */
  left: calc(50% + 32px);
  right: calc(-50% + 32px);
  height: 1px;
  background: linear-gradient(90deg, var(--line) 60%, transparent);
  z-index: 1;

  /* animated dash */
  &::after {
    content: "";
    position: absolute;
    top: -1px; left: 0;
    width: 8px; height: 3px;
    border-radius: 2px;
    background: var(--c1-light);
    opacity: .6;
    animation: trk-dash 2.5s ease-in-out infinite;
  }
}

@keyframes trk-dash {
  0%   { left: 0%;   opacity: .6; }
  100% { left: 100%; opacity: 0; }
}

/* ── Responsive ─────────────────────────────────────────── */
@media (max-width: 900px) {
  .v2-track__steps {
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 0;
  }

  .v2-track__step:nth-child(3) .v2-track__connector,
  .v2-track__step:last-child .v2-track__connector { display: none; }
}

@media (max-width: 560px) {
  .v2-track { padding: 48px 0 56px; }
  .v2-track__steps {
    grid-template-columns: 1fr 1fr;
    gap: 32px 0;
  }
  .v2-track__step:nth-child(2) .v2-track__connector,
  .v2-track__step:nth-child(4) .v2-track__connector { display: none; }
  .v2-track__step.win { grid-column: 1 / -1; }
}

</style>
