---
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).stats;
---

<section class="v2-stats-strip">
  <div class="v2-container">
    <div class="v2-stats-strip__grid">
      {c.items.map((s, i) => (
        <div class="v2-stats-strip__cell" style={`--m-d:${i * 0.1}s`}>
          <div class="v2-stats-strip__n" data-count={s.n}>{s.n}</div>
          <div class="v2-stats-strip__l">{s.l}</div>
          <div class="v2-stats-strip__c">{s.c}</div>
        </div>
      ))}
    </div>
    <p class="v2-stats-strip__source">Client median results across 50+ agency deployments. Individual results vary.</p>
    <div class="v2-sc" data-m="up" style="--m-d:.45s">
      <a href="https://cal.com/kerim-alihodza-7u7w6q/30min" class="v2-sc__btn"
        >
        {c.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .v2-stats-strip__source {
    text-align: center;
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--fg-2);
    letter-spacing: 0.05em;
    margin: 12px 0 0;
    opacity: 0.7;
  }
</style>
