---
export interface Props {
  active?: 'home' | 'services' | 'process' | 'results' | 'projects' | 'blog';
}
const { active = 'home' } = Astro.props;

const seg = Astro.url.pathname.split('/').filter(Boolean)[0];
const lang = (seg === 'de' || seg === 'sl') ? seg : 'en';
const base = lang === 'en' ? '' : `/${lang}`;

const navContent: Record<string, { home: string; engines: string; howItWorks: string; results: string; projects: string; blog: string; audit: string }> = {
  en: { home: 'Home', engines: 'Engines', howItWorks: 'How it works', results: 'Results', projects: 'Projects', blog: 'Blog', audit: 'Free audit' },
  de: { home: 'Home', engines: 'Engines', howItWorks: 'So funktioniert\'s', results: 'Ergebnisse', projects: 'Projekte', blog: 'Blog', audit: 'Kostenloses Audit' },
  sl: { home: 'Home', engines: 'Sistemi', howItWorks: 'Kako deluje', results: 'Rezultati', projects: 'Projekti', blog: 'Blog', audit: 'Brezplačni audit' },
};
const n = navContent[lang];

const projectsHref = lang === 'de' ? '/de/projekte/' : lang === 'sl' ? '/sl/projekti/' : '/projects/';

const links = [
  { id: 'home',     label: n.home,        href: `${base}/` },
  { id: 'engines',  label: n.engines,     href: `${base}/#engines` },
  { id: 'process',  label: n.howItWorks,  href: `${base}/#how-it-works` },
  { id: 'results',  label: n.results,     href: `${base}/#results` },
  { id: 'projects', label: n.projects,    href: projectsHref },
  { id: 'blog',     label: n.blog,        href: `${base}/blog/` },
];
---

<nav class="v2-nav">
  <div class="v2-container">
    <div class="v2-nav__inner">
      <!-- Logo -->
      <a href={`${base}/`} class="v2-nav__logo">
        <img src="/logo-gradient.svg" alt="CreativeComplete" class="v2-nav__logo-img" width="22" height="36" />
        <span class="v2-nav__logo-text">Creative<span class="v2-grad">Complete</span></span>
      </a>

      <!-- Links -->
      <ul class="v2-nav__links" id="v2NavLinks">
        {links.map(l => (
          <li>
            <a href={l.href} class:list={[{ active: active === l.id }]}>{l.label}</a>
          </li>
        ))}
      </ul>

      <!-- Right -->
      <div class="v2-nav__right">
        <span class="v2-nav__badge">⭐ 50+ Agencies Served</span>
        <a href="https://cal.com/kerim-alihodza-7u7w6q/30min" class="v2-btn v2-btn-primary" style="height:40px;padding:0 18px;font-size:14px;">
          {n.audit}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Mobile burger -->
      <button class="v2-nav__menu" id="v2NavMenu" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('v2NavMenu');
  const links = document.getElementById('v2NavLinks');
  btn?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });

  const nav = document.querySelector('.v2-nav') as HTMLElement;
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });
</script>
