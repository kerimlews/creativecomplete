---

<section class="v2-clients">
  <div class="v2-container">
    <div class="v2-clients__row">
{logos.map(logo => (
        <div class="v2-clients__logo" title={logo.name}>
          {logo.img ? (
            <img src={logo.img} alt={logo.name} loading="lazy" />
          ) : (
            <Fragment set:html={logo.svg} />
          )}
          <span class="v2-clients__logo-name">{logo.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .v2-clients {
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

.v2-clients__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: nowrap;
  }

  .v2-clients__logo {
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0.4;
    transition: opacity 0.2s;
    white-space: nowrap;
    color: var(--fg-1);
    flex-shrink: 0;

    &:hover { opacity: 0.9; }

    svg { height: 20px; width: auto; display: block; }
    img { height: 20px; width: auto; display: block; filter: brightness(0) invert(0.6); }
  }

  .v2-clients__logo-name {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--fg-1);
  }

  @media (max-width: 768px) {
    .v2-clients__row { flex-wrap: wrap; gap: 20px 32px; }
  }
</style>
