---
import { Image } from 'astro:assets';
import cv1 from '../../images/homepage/creative-v1.avif';
import cv2 from '../../images/homepage/creative-v2.avif';
import cv3 from '../../images/homepage/creative-v3.avif';

const variants = [
  { img: cv1, score: '97', delay: '0' },
  { img: cv2, score: '91', delay: '1' },
  { img: cv3, score: '89', delay: '2' },
];
---

<div class="acm" aria-label="AI creative generation diagram">

  <!-- Brief input -->
  <div class="acm__brief">
    <span class="acm__live"><span class="acm__live-dot"></span>Generating</span>
    <div class="acm__brief-rows">
      <div class="acm__brief-row">
        <span class="acm__brief-label">Brand</span>
        <span class="acm__brief-val">CreativeComplete</span>
      </div>
      <div class="acm__brief-row">
        <span class="acm__brief-label">Platforms</span>
        <span class="acm__brief-val">Instagram · Facebook · Google</span>
      </div>
      <div class="acm__brief-row">
        <span class="acm__brief-label">Goal</span>
        <span class="acm__brief-val acm__brief-val--tag">Lead generation</span>
      </div>
    </div>
  </div>

  <!-- Connector -->
  <div class="acm__connector" aria-hidden="true">
    <div class="acm__connector-line"></div>
    <div class="acm__pkt" style="--d:0s"></div>
    <div class="acm__pkt" style="--d:.35s"></div>
    <div class="acm__pkt" style="--d:.7s"></div>
  </div>

  <!-- Engine -->
  <div class="acm__engine">
    <div class="acm__engine-glow" aria-hidden="true"></div>
    <div class="acm__engine-inner">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>AI Creative Engine</span>
      <div class="acm__bars" aria-hidden="true">
        <span style="--peak:90%"></span>
        <span style="--peak:55%"></span>
        <span style="--peak:80%"></span>
        <span style="--peak:65%"></span>
        <span style="--peak:95%"></span>
      </div>
    </div>
  </div>

  <!-- Connector 2 -->
  <div class="acm__connector" aria-hidden="true">
    <div class="acm__connector-line"></div>
    <div class="acm__pkt" style="--d:.15s"></div>
    <div class="acm__pkt" style="--d:.5s"></div>
    <div class="acm__pkt" style="--d:.85s"></div>
  </div>

  <!-- Output grid -->
  <div class="acm__output">
    {variants.map(v => (
      <div class="acm__creative" style={`--i:${v.delay}`}>
        <Image class="acm__creative-img" src={v.img} alt="AI generated ad creative variant" loading="lazy" />
        <div class="acm__creative-score">
          <span class="acm__score-dot"></span>
          <span>▲ {v.score}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Result -->
  <div class="acm__result">
    <div class="acm__result-dot"></div>
    <span>4 scored variants · <strong>Ready to publish</strong></span>
    <span class="acm__result-time">38s</span>
  </div>

</div>

<style lang="scss">
@keyframes acm-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}
@keyframes acm-drop {
  0%   { top: 0; opacity: 1; }
  85%  { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}
@keyframes acm-bar {
  0%, 100% { height: 20%; }
  50%       { height: var(--peak, 70%); }
}
@keyframes acm-glow {
  0%, 100% { opacity: 0.4; }
  50%       { opacity: 1; }
}
@keyframes acm-card-in {
  from { opacity: 0; transform: translateY(8px) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes acm-result-in {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}
.acm {
  position: relative;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  background: rgba(8, 10, 22, 0.7);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 20px;
  padding: 22px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  overflow: hidden;

  &::before {
    content: "";
    position: absolute;
    top: -60px; left: 50%; transform: translateX(-50%);
    width: 280px; height: 200px;
    background: radial-gradient(ellipse at center top, rgba(168,85,247,0.1) 0%, transparent 65%);
    pointer-events: none;
  }
}

/* Brief */
.acm__brief {
  background: rgba(168,85,247,0.07);
  border: 1px solid rgba(168,85,247,0.2);
  border-radius: 12px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.acm__live {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: rgba(168,85,247,0.8);
  align-self: flex-start;
}
.acm__live-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #a855f7;
  box-shadow: 0 0 8px #a855f7;
  animation: acm-blink 1.4s ease-in-out infinite;
}
.acm__brief-rows { display: flex; flex-direction: column; gap: 6px; }
.acm__brief-row {
  display: flex; align-items: center; gap: 8px;
  font-size: 11.5px;
}
.acm__brief-label {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .1em;
  color: rgba(255,255,255,0.3);
  width: 56px;
  flex-shrink: 0;
}
.acm__brief-val {
  color: rgba(255,255,255,0.8);
  font-size: 11.5px;
}
.acm__brief-val--tag {
  background: rgba(168,85,247,0.15);
  border: 1px solid rgba(168,85,247,0.3);
  border-radius: 99px;
  padding: 1px 8px;
  font-size: 10px;
  font-family: var(--font-mono);
  letter-spacing: .08em;
  color: #d8b4fe;
}

/* Connector */
.acm__connector {
  display: flex;
  justify-content: center;
  position: relative;
  height: 24px;
  flex-shrink: 0;
}
.acm__connector-line {
  width: 1px; height: 100%;
  background: linear-gradient(to bottom, rgba(168,85,247,0.5), rgba(168,85,247,0.1));
}
.acm__pkt {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 5px; height: 5px;
  border-radius: 50%;
  background: #a855f7;
  box-shadow: 0 0 8px #a855f7;
  animation: acm-drop 1.1s var(--d, 0s) ease-in infinite;
}

/* Engine */
.acm__engine { position: relative; }
.acm__engine-glow {
  position: absolute;
  inset: -10px;
  border-radius: 18px;
  background: radial-gradient(ellipse at center, rgba(168,85,247,0.2) 0%, transparent 70%);
  animation: acm-glow 2.2s ease-in-out infinite;
  pointer-events: none;
}
.acm__engine-inner {
  position: relative;
  display: flex; align-items: center; gap: 8px;
  padding: 9px 14px;
  background: rgba(168,85,247,0.1);
  border: 1px solid rgba(168,85,247,0.4);
  border-radius: 10px;
  color: #d8b4fe;
  font-size: 12px; font-weight: 600; letter-spacing: -.01em;
  > svg { flex-shrink: 0; }
}
.acm__bars {
  margin-left: auto;
  display: flex; align-items: flex-end; gap: 2px;
  height: 16px;
  span {
    display: block; width: 3px;
    background: #a855f7; border-radius: 2px;
    animation: acm-bar .85s ease-in-out infinite alternate;
    &:nth-child(1) { animation-delay: 0s; }
    &:nth-child(2) { animation-delay: .17s; }
    &:nth-child(3) { animation-delay: .07s; }
    &:nth-child(4) { animation-delay: .22s; }
    &:nth-child(5) { animation-delay: .11s; }
  }
}

/* Output grid */
.acm__output {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  min-width: 0;
}
.acm__creative {
  position: relative;
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.07);
  animation: acm-card-in .4s calc(var(--i) * 0.12s + 0.5s) both;
  min-width: 0;
}
.acm__creative-img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 1;
  object-fit: cover;
  object-position: center;
}
.acm__creative-score {
  display: flex; align-items: center; gap: 5px;
  padding: 4px 8px;
  background: rgba(0,0,0,0.4);
  font-family: var(--font-mono);
  font-size: 10px; font-weight: 700;
  color: rgba(255,255,255,0.75);
}
.acm__score-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 6px #22c55e;
}

/* Result */
.acm__result {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 13px;
  background: rgba(34,197,94,0.06);
  border: 1px solid rgba(34,197,94,0.2);
  border-radius: 10px;
  font-size: 12px; color: rgba(255,255,255,0.5);
  animation: acm-result-in .4s 1.2s both;
  strong { color: #fff; }
}
.acm__result-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #22c55e; box-shadow: 0 0 10px #22c55e;
  flex-shrink: 0;
  animation: acm-blink 1.2s ease-in-out infinite;
}
.acm__result-time {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 11px; font-weight: 700;
  color: #4ade80;
}
</style>
