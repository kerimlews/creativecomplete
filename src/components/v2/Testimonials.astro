---
import { Image } from 'astro:assets';
import { testimonials, getTestimonalImage } from '../../utils/constants';
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lc = getV2Content(lang).testimonials;

// Resolve image promises
const resolved = await Promise.all(
  testimonials.map(async (t) => ({
    ...t,
    imgModule: t.image ? await getTestimonalImage(t.image) : null,
  }))
);

const main = resolved[0];
const small = resolved.slice(1, 3);

// Stats associated with each testimonial
const stats: Record<string, string> = {
  'fitovision-gym-saas':                         '245% traffic in 90 days',
  'prepme-automation-saas':                      'Hundreds of hours saved monthly',
  'careconnect-recruitment-automation':          'Full recruitment automation',
  'belags-oberflaechenreinigung-arbon-case-study': '#1 on Google Maps in Arbon',
};
---

<section class="v2-testi v2-section">
  <div class="v2-container">
    <div class="v2-section-head">
      <span class="v2-eyebrow">{lc.eyebrow}</span>
      <h2 class="v2-h2">
        <span class="v2-grad">Testimonials</span>
      </h2>
    </div>

    <div class="v2-testi__grid">
      <!-- Main featured testimonial -->
      <a href={`/projects/${main.caseStudy}/`} class="v2-testi__main v2-testi__link" data-m="up">
        <div class="v2-testi__stars">
          {Array.from({ length: 5 }).map(() => (
            <span class="v2-testi__star"></span>
          ))}
        </div>
        <blockquote class="v2-testi__quote">"{main.text}"</blockquote>
        <div class="v2-testi__stat">{stats[main.caseStudy] ?? ''}</div>
        <div class="v2-testi__author">
          {main.imgModule ? (
            <Image
              src={(main.imgModule as any).default}
              alt={main.author}
              width={40}
              height={40}
              class="v2-testi__avatar v2-testi__avatar--img"
            />
          ) : (
            <div class="v2-testi__avatar v2-testi__avatar--fallback">{main.avatar}</div>
          )}
          <div>
            <div class="v2-testi__name">{main.author}</div>
            <div class="v2-testi__role">{main.role}, {main.company}</div>
          </div>
        </div>
        <div class="v2-testi__read">{lc.readCaseStudy}</div>
      </a>

      <!-- Small testimonials -->
      {resolved.slice(1).map((t, i) => (
        <a href={`/projects/${t.caseStudy}/`} class="v2-testi__small v2-testi__link" data-m="scale" style={`--m-d:${0.15 + i * 0.12}s`}>
          <div class="v2-testi__stars" style="margin-bottom:16px">
            {Array.from({ length: 5 }).map(() => (
              <span class="v2-testi__star"></span>
            ))}
          </div>
          <blockquote class="v2-testi__quote">"{t.text}"</blockquote>
          <div class="v2-testi__stat">{stats[t.caseStudy] ?? ''}</div>
          <div class="v2-testi__author" style="margin-top:16px">
            {t.imgModule ? (
              <Image
                src={(t.imgModule as any).default}
                alt={t.author}
                width={40}
                height={40}
                class="v2-testi__avatar v2-testi__avatar--img"
              />
            ) : (
              <div class="v2-testi__avatar v2-testi__avatar--fallback">{t.avatar}</div>
            )}
            <div>
              <div class="v2-testi__name">{t.author}</div>
              <div class="v2-testi__role">{t.role}, {t.company}</div>
            </div>
          </div>
          <div class="v2-testi__read">{lc.readCaseStudy}</div>
        </a>
      ))}
    </div>
    <div class="v2-sc" data-m="up" style="--m-d:.3s">
      <a href="javascript:void(0)" class="v2-sc__btn primary" data-cal-link="kerim-alihodza-7u7w6q/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","theme":"dark"}'>
        {lc.joinCta}
      </a>
      
    </div>

  </div>
</section>
