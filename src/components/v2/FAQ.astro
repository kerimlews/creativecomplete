---
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  items?: { q: string; a: string }[];
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const lc = getV2Content(lang);

// defaultItems comes from the i18n utility for the current lang
const defaultItems = lc.faq;

const { items = defaultItems } = Astro.props;

// Left-side labels vary by language
const faqLabels: Record<string, { eyebrow: string; headline: string; headlineGrad: string; lead: string; btn: string }> = {
  en: { eyebrow: 'Common questions', headline: 'answered.', headlineGrad: 'Questions,', lead: 'Everything agencies ask before bringing us in as their AI team.', btn: 'Book free audit' },
  de: { eyebrow: 'Häufige Fragen', headline: 'beantwortet.', headlineGrad: 'Fragen,', lead: 'Alles, was Agenturen fragen, bevor sie uns als ihr KI-Team engagieren.', btn: 'Kostenloses Audit buchen' },
  sl: { eyebrow: 'Pogosta vprašanja', headline: 'odgovorjeno.', headlineGrad: 'Vprašanja,', lead: 'Vse, kar agencije vprašajo, preden nas vključijo kot svojo AI ekipo.', btn: 'Rezerviraj brezplačen pregled' },
  hr: { eyebrow: 'Česta pitanja', headline: 'odgovori.', headlineGrad: 'Pitanja,', lead: 'Sve što agencije pitaju prije nego nas uključe kao svoj AI tim.', btn: 'Rezerviraj besplatni audit' },
};
const ll = faqLabels[lang] ?? faqLabels.en;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(it => ({
    "@type": "Question",
    "name": it.q,
    "acceptedAnswer": { "@type": "Answer", "text": it.a }
  }))
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<section class="v2-faq v2-section" id="faq">
  <div class="v2-container">
    <div class="v2-faq__inner">
      <!-- Left: headline + CTA -->
      <div class="v2-faq__left" data-m="up">
        <span class="v2-eyebrow">{ll.eyebrow}</span>
        <h2 class="v2-h2" style="margin-top:16px">
          <span class="v2-grad">{ll.headlineGrad}</span> {ll.headline}
        </h2>
        <p class="v2-lead" style="margin-top:16px">
          {ll.lead}
        </p>
        <a href="https://cal.com/kerim-alihodza-7u7w6q/30min" class="v2-btn v2-btn-primary" style="margin-top:28px">
          {ll.btn}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Right: accordion -->
      <ul class="v2-faq__list">
        {items.map((it, i) => (
          <li class="v2-faq__item" data-m="left" style={`--m-d:${i * 0.06}s`}>
            <button class="v2-faq__btn" aria-expanded="false">
              <span class="v2-faq__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="v2-faq__q">{it.q}</span>
              <span class="v2-faq__icon" aria-hidden="true">+</span>
            </button>
            <div class="v2-faq__a">{it.a}</div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.v2-faq__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.v2-faq__item')!;
      const isOpen = item.classList.contains('open');
      // Close all
      document.querySelectorAll('.v2-faq__item.open').forEach(el => {
        el.classList.remove('open');
        el.querySelector('.v2-faq__btn')?.setAttribute('aria-expanded', 'false');
      });
      // Open clicked if it was closed
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
