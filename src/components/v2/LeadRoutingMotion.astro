---
// LeadRoutingMotion.astro — Animated lead routing diagram
---

<div class="lrm" aria-label="Automated lead distribution diagram">

  <!-- Source -->
  <div class="lrm__source">
    <div class="lrm__source-pulse" aria-hidden="true"></div>
    <div class="lrm__source-pulse lrm__source-pulse--2" aria-hidden="true"></div>
    <div class="lrm__source-card">
      <span class="lrm__live"><span class="lrm__live-dot"></span>Live</span>
      <div class="lrm__source-info">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <div>
          <strong>New Lead — James T.</strong>
          <span>Via WhatsApp · English · Hot</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Flow -->
  <div class="lrm__connector" aria-hidden="true">
    <div class="lrm__connector-line"></div>
    <div class="lrm__pkt" style="--d:0s"></div>
    <div class="lrm__pkt" style="--d:.4s"></div>
    <div class="lrm__pkt" style="--d:.8s"></div>
  </div>

  <!-- Router -->
  <div class="lrm__router">
    <div class="lrm__router-glow" aria-hidden="true"></div>
    <div class="lrm__router-inner">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M13 10V3L4 14h7v7l9-11h-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>AI Routing Engine</span>
      <div class="lrm__bars" aria-hidden="true">
        <span style="--peak:85%"></span>
        <span style="--peak:60%"></span>
        <span style="--peak:95%"></span>
        <span style="--peak:70%"></span>
        <span style="--peak:50%"></span>
      </div>
    </div>
  </div>

  <!-- Rules grid -->
  <div class="lrm__rules">
    <div class="lrm__rule" style="--i:0">
      <span class="lrm__rule-icon">👤</span>
      <div class="lrm__rule-body">
        <strong>Availability</strong>
        <span>Online agents only</span>
      </div>
      <span class="lrm__check" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
    <div class="lrm__rule" style="--i:1">
      <span class="lrm__rule-icon">🔄</span>
      <div class="lrm__rule-body">
        <strong>Round Robin</strong>
        <span>Balanced workload</span>
      </div>
      <span class="lrm__check" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
    <div class="lrm__rule" style="--i:2">
      <span class="lrm__rule-icon">⭐</span>
      <div class="lrm__rule-body">
        <strong>Customer Type</strong>
        <span>VIPs to best closers</span>
      </div>
      <span class="lrm__check" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
    <div class="lrm__rule" style="--i:3">
      <span class="lrm__rule-icon">🌙</span>
      <div class="lrm__rule-body">
        <strong>Shift-Based</strong>
        <span>24/7 coverage</span>
      </div>
      <span class="lrm__check" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
    <div class="lrm__rule" style="--i:4">
      <span class="lrm__rule-icon">🌍</span>
      <div class="lrm__rule-body">
        <strong>Language</strong>
        <span>Native speaker match</span>
      </div>
      <span class="lrm__check" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
    <div class="lrm__rule" style="--i:5">
      <span class="lrm__rule-icon">🧠</span>
      <div class="lrm__rule-body">
        <strong>Skill-Based</strong>
        <span>Experts on complex leads</span>
      </div>
      <span class="lrm__check" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
    <div class="lrm__rule lrm__rule--wide" style="--i:6">
      <span class="lrm__rule-icon">⚡</span>
      <div class="lrm__rule-body">
        <strong>Function-Based</strong>
        <span>Sales, Support, AM — zero handoffs</span>
      </div>
      <span class="lrm__check" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1.5 5l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
  </div>

  <!-- Assignment result -->
  <div class="lrm__assigned">
    <div class="lrm__assigned-dot"></div>
    <div class="lrm__assigned-text">
      Assigned to <strong>Sarah K.</strong>
      <span class="lrm__assigned-chips">
        <span>🇬🇧 EN</span>
        <span>Sales</span>
        <span>Online</span>
      </span>
    </div>
    <div class="lrm__assigned-time">1.8s</div>
  </div>

</div>

<style lang="scss">
@keyframes lrm-pulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1); opacity: 0; }
}
@keyframes lrm-pulse-ring {
  0% { transform: scale(0.85); opacity: 0.5; }
  100% { transform: scale(1.6); opacity: 0; }
}
@keyframes lrm-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
@keyframes lrm-drop {
  0% { top: 0; opacity: 1; }
  85% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}
@keyframes lrm-bar {
  0%, 100% { height: 20%; }
  50% { height: var(--peak, 70%); }
}
@keyframes lrm-glow {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
@keyframes lrm-rule-in {
  from { opacity: 0; transform: translateX(-6px); }
  to   { opacity: 1; transform: translateX(0); }
}
@keyframes lrm-rule-flash {
  0%   { background: rgba(99,102,241,0.18); border-color: rgba(99,102,241,0.5); }
  60%  { background: rgba(99,102,241,0.06); border-color: rgba(255,255,255,0.08); }
  100% { background: rgba(255,255,255,0.025); border-color: rgba(255,255,255,0.06); }
}
@keyframes lrm-check-in {
  from { opacity: 0; transform: scale(0); }
  to   { opacity: 1; transform: scale(1); }
}
@keyframes lrm-assigned-in {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

.lrm {
  position: relative;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  background: rgba(8, 10, 22, 0.7);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 20px;
  padding: 22px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  overflow: hidden;

  &::before {
    content: "";
    position: absolute;
    top: -60px; left: 50%; transform: translateX(-50%);
    width: 280px; height: 200px;
    background: radial-gradient(ellipse at center top, rgba(99,102,241,0.1) 0%, transparent 65%);
    pointer-events: none;
  }
}

/* Source */
.lrm__source {
  position: relative;
  display: flex;
  flex-direction: column;
}
.lrm__source-pulse {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 100%; height: 100%;
  border-radius: 14px;
  border: 1px solid rgba(99,102,241,0.4);
  animation: lrm-pulse-ring 2s ease-out infinite;
  pointer-events: none;
}
.lrm__source-pulse--2 {
  animation-delay: 1s;
}
.lrm__source-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px 14px;
  background: rgba(99,102,241,0.08);
  border: 1px solid rgba(99,102,241,0.25);
  border-radius: 12px;
  position: relative;
  z-index: 1;
}
.lrm__live {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(34,211,238,0.8);
  align-self: flex-start;
}
.lrm__live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22d3ee;
  box-shadow: 0 0 8px #22d3ee;
  animation: lrm-blink 1.4s ease-in-out infinite;
}
.lrm__source-info {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #a5b4fc;

  svg { flex-shrink: 0; }
  strong { display: block; font-size: 13px; font-weight: 600; color: #fff; }
  span { display: block; font-size: 11px; color: rgba(255,255,255,0.45); margin-top: 1px; }
}

/* Connector */
.lrm__connector {
  display: flex;
  justify-content: center;
  position: relative;
  height: 28px;
  flex-shrink: 0;
}
.lrm__connector-line {
  width: 1px;
  height: 100%;
  background: linear-gradient(to bottom, rgba(99,102,241,0.6), rgba(99,102,241,0.1));
}
.lrm__pkt {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 5px; height: 5px;
  border-radius: 50%;
  background: #6366f1;
  box-shadow: 0 0 8px #6366f1;
  animation: lrm-drop 1.2s var(--d, 0s) ease-in infinite;
}

/* Router */
.lrm__router {
  position: relative;
}
.lrm__router-glow {
  position: absolute;
  inset: -10px;
  border-radius: 18px;
  background: radial-gradient(ellipse at center, rgba(99,102,241,0.2) 0%, transparent 70%);
  animation: lrm-glow 2.4s ease-in-out infinite;
  pointer-events: none;
}
.lrm__router-inner {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  background: rgba(99,102,241,0.1);
  border: 1px solid rgba(99,102,241,0.4);
  border-radius: 10px;
  color: #a5b4fc;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: -0.01em;

  > svg { flex-shrink: 0; }
}
.lrm__bars {
  margin-left: auto;
  display: flex;
  align-items: flex-end;
  gap: 2px;
  height: 16px;

  span {
    display: block;
    width: 3px;
    background: #6366f1;
    border-radius: 2px;
    animation: lrm-bar 0.9s ease-in-out infinite alternate;

    &:nth-child(1) { animation-delay: 0s; }
    &:nth-child(2) { animation-delay: 0.18s; }
    &:nth-child(3) { animation-delay: 0.06s; }
    &:nth-child(4) { animation-delay: 0.24s; }
    &:nth-child(5) { animation-delay: 0.12s; }
  }
}

/* Rules grid */
.lrm__rules {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
  min-width: 0;
}
.lrm__rule {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 9px;
  min-width: 0;
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 9px;
  animation:
    lrm-rule-in  0.35s calc(var(--i) * 0.08s + 0.2s) both,
    lrm-rule-flash 0.6s calc(var(--i) * 0.22s + 0.5s) both;

  &--wide { grid-column: 1 / -1; }
}
.lrm__rule-icon { font-size: 15px; flex-shrink: 0; }
.lrm__rule-body {
  flex: 1;
  min-width: 0;

  strong {
    display: block;
    font-size: 11.5px;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  span {
    display: block;
    font-size: 10px;
    color: rgba(255,255,255,0.35);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}
.lrm__check {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: rgba(34,197,94,0.12);
  border: 1px solid rgba(34,197,94,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #22c55e;
  animation: lrm-check-in 0.3s calc(var(--i) * 0.22s + 0.7s) both;
}

/* Assignment */
.lrm__assigned {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 13px;
  background: rgba(34,197,94,0.06);
  border: 1px solid rgba(34,197,94,0.22);
  border-radius: 10px;
  animation: lrm-assigned-in 0.4s 1.9s both;
}
.lrm__assigned-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 10px #22c55e;
  flex-shrink: 0;
  animation: lrm-blink 1.2s ease-in-out infinite;
}
.lrm__assigned-text {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: rgba(255,255,255,0.55);
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;

  strong { color: #fff; font-weight: 600; }
}
.lrm__assigned-chips {
  display: flex;
  gap: 4px;

  span {
    font-size: 10px;
    font-family: var(--font-mono);
    padding: 2px 7px;
    border-radius: 99px;
    background: rgba(34,197,94,0.1);
    border: 1px solid rgba(34,197,94,0.2);
    color: #4ade80;
    white-space: nowrap;
  }
}
.lrm__assigned-time {
  font-family: var(--font-mono);
  font-size: 14px;
  font-weight: 700;
  color: #22c55e;
  flex-shrink: 0;
}
</style>
