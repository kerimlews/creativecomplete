    &.create  .e2e__tab-tag { color: var(--c3); }
    &.capture .e2e__tab-tag { color: #f97316; }
    &.convert .e2e__tab-tag { color: var(--c1-light); }
    &.retain  .e2e__tab-tag { color: var(--c2); }

    &.create  .e2e__tab-icon { background: rgba(168,85,247,.18); border-color: rgba(168,85,247,.4); color: var(--c3); }
    &.capture .e2e__tab-icon { background: rgba(249,115,22,.18);  border-color: rgba(249,115,22,.4);  color: #fb923c; }
    &.convert .e2e__tab-icon { background: rgba(99,102,241,.18);  border-color: rgba(99,102,241,.4);  color: var(--c1-light); }
    &.retain  .e2e__tab-icon { background: rgba(34,211,238,.15);  border-color: rgba(34,211,238,.4);  color: var(--c2); }
  }
