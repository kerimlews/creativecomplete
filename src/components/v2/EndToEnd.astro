    }
    &.convert {
      border-top-color: var(--c1-light);
      background: rgba(99,102,241,.1);
      box-shadow: 0 0 0 1px rgba(99,102,241,.25), 0 12px 40px rgba(0,0,0,.35);
    }
    &.retain {
      border-top-color: var(--c2);
      background: rgba(34,211,238,.08);
      box-shadow: 0 0 0 1px rgba(34,211,238,.2), 0 12px 40px rgba(0,0,0,.35);
    }

