<script is:inline>
  (() => {
    const DURATION = 5000;
    const tabs    = document.querySelectorAll('.e2e__tab');
    const panels  = document.querySelectorAll('.e2e__panel');
    if (!tabs.length) return;

    let current = 0;
    let timer   = null;

    function restartDemoAnims(panel) {
      const els = panel.querySelectorAll(
        '.e2e__dc,.e2e__ch-row-item,.e2e__inbox-row,.e2e__conv-msg,.e2e__conv-ai,.e2e__conv-hot,.e2e__conv-bant,.e2e__ret-row,.e2e__ret-stats,.e2e__demo-brief,.e2e__demo-footer,.e2e__demo-header,.e2e__demo-counter,.e2e__demo-time,.e2e__demo-roi,.e2e__bant-item,.e2e__bant-score'
      );
      els.forEach(el => {
        el.style.animation = 'none';
        void el.offsetWidth;
        el.style.animation = '';
      });
    }

    function goTo(idx) {
      const next = ((idx % tabs.length) + tabs.length) % tabs.length;
      tabs[current].classList.remove('active');
      tabs[current].setAttribute('aria-selected', 'false');
      panels[current].classList.remove('active');

      current = next;
      const tab = tabs[current];
      const panel = panels[current];

      const bar = tab.querySelector('.e2e__tab-progress');
      if (bar) { const c = bar.cloneNode(true); bar.replaceWith(c); }

      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      panel.classList.add('active');
      restartDemoAnims(panel);

      clearTimeout(timer);
      timer = setTimeout(() => goTo(current + 1), DURATION);
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => goTo(i)));
    timer = setTimeout(() => goTo(1), DURATION);
  })();
</script>

