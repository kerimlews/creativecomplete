/* ── ROI strip ──────────────────────────────────────── */
.e2e__strip {
  display: grid; grid-template-columns: repeat(5,1fr);
  margin-top: 32px; border-radius: var(--r-xl);
  background: var(--bg-elev); border: 1px solid var(--line);
