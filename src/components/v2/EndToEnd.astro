.e2e__tab {
  border-right: none;
  border: 1px solid rgba(255,255,255,.07);
  border-top: 3px solid transparent;
  border-radius: var(--r-lg);
  padding: 20px 18px 16px;
  gap: 12px;
  background: rgba(255,255,255,.025);
  transition: background .2s, box-shadow .2s, border-color .2s, transform .18s;

  /* inactive phase accent — subtle */
  &.create  { border-top-color: rgba(168,85,247,.4); }
  &.capture { border-top-color: rgba(249,115,22,.4); }
  &.convert { border-top-color: rgba(99,102,241,.4); }
  &.retain  { border-top-color: rgba(34,211,238,.4); }

  &:hover {
    background: rgba(255,255,255,.045);
    transform: translateY(-1px);
  }

  /* active: full phase color + card glow */
  &.active {
    transform: translateY(-2px);

    &.create {
      border-top-color: var(--c3);
      background: rgba(168,85,247,.08);
      box-shadow: 0 0 0 1px rgba(168,85,247,.2), 0 12px 40px rgba(0,0,0,.35);
