---
// EndToEnd.astro — Tabbed phase viewer with auto-advancing progress bar
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).endToEnd;

const e2eBlogLinks = lang === 'de'
  ? { creative: '/de/blog/ki-werbemittel/', whatsappLead: '/de/blog/whatsapp-lead-generierung/', salesAgents: '/de/blog/ki-verkaufsagenten/', broadcasts: '/de/blog/whatsapp-broadcast-kampagnen/' }
  : lang === 'sl'
  ? { creative: '/sl/blog/ai-oglasne-kreative/', whatsappLead: '/sl/blog/whatsapp-pridobivanje-leadov/', salesAgents: '/sl/blog/ai-prodajni-agenti/', broadcasts: '/sl/blog/whatsapp-broadcast-kampanje/' }
  : lang === 'hr'
  ? { creative: '/hr/blog/ai-oglasne-kreative/', whatsappLead: '/hr/blog/whatsapp-pridobivanje-leadova/', salesAgents: '/hr/blog/ai-prodajni-agenti/', broadcasts: '/hr/blog/whatsapp-broadcast-kampanje/' }
  : { creative: '/blog/ai-ad-creatives/', whatsappLead: '/blog/whatsapp-lead-generation/', salesAgents: '/blog/ai-sales-agents/', broadcasts: '/blog/whatsapp-broadcast-campaigns/' };

const blogLinks = [e2eBlogLinks.creative, e2eBlogLinks.whatsappLead, e2eBlogLinks.salesAgents, e2eBlogLinks.broadcasts];
const phaseClasses = ['create', 'capture', 'convert', 'retain'];

// Tab icons (larger, 20px viewport)
const tabIcons = [
  `<path d="M10 2l1.5 4h4l-3.2 2.3 1.2 4L10 10l-3.5 2.3 1.2-4L4.5 6h4z" fill="currentColor"/>`,
  `<rect x="1" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M1 8h18" stroke="currentColor" stroke-width="1.4"/><circle cx="6" cy="12" r="1.5" fill="currentColor" opacity=".7"/><circle cx="10" cy="12" r="1.5" fill="currentColor"/><circle cx="14" cy="12" r="1.5" fill="currentColor" opacity=".5"/>`,
  `<path d="M5 10l3.5 3.5L15 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.6"/>`,
  `<path d="M10 3.5C7.5 1 3 2.5 3 6.5c0 5 7 10 7 10s7-5 7-10c0-4-4.5-5.5-7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>`,
];

// Metric chips per phase
const phaseMetrics = [
  [{ v: '14×', l: 'more conversions', c: 'var(--c3)' }, { v: '90%+', l: 'creative accuracy', c: 'var(--c2)' }],
  [{ v: '40+', l: 'channels unified',  c: '#f97316'  }, { v: '0',    l: 'missed leads',     c: 'var(--c2)' }],
  [{ v: '81%', l: 'lead conversion',  c: 'var(--c1-light)' }, { v: '<60s', l: 'qualify time', c: 'var(--c2)' }],
  [{ v: '42.5×', l: 'avg broadcast ROI', c: 'var(--c2)' }, { v: '45d', l: 'to full ROI', c: 'var(--c3)' }],
];

const phaseIcons = [
  [
    `<rect x="2" y="2" width="5" height="5" rx="1" fill="currentColor"/><rect x="9" y="2" width="5" height="5" rx="1" fill="currentColor" opacity=".6"/><rect x="2" y="9" width="5" height="5" rx="1" fill="currentColor" opacity=".6"/><rect x="9" y="9" width="5" height="5" rx="1" fill="currentColor"/>`,
    `<path d="M8 1l2 5h5l-4 3 1.5 5L8 11l-4.5 3L5 9 1 6h5z" fill="currentColor"/>`,
    `<path d="M2 8h12M8 2v12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
    `<path d="M2 12l4-4 3 3 5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.8"/><path d="M8 5v3l2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>`,
  ],
  [
    `<rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M1 6h14" stroke="currentColor" stroke-width="1.2"/>`,
    `<circle cx="8" cy="6" r="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
    `<path d="M2 2h12v10H2zM6 12v2M10 12v2M4 14h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<path d="M8 2L2 5v9h12V5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 14V9h4v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
  ],
  [
    `<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M5.5 8l2 2 3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<path d="M3 3h10v8H9l-3 3V11H3z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<path d="M2 8h12M2 4h8M2 12h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>`,
    `<circle cx="4.5" cy="8" r="2" stroke="currentColor" stroke-width="1.4"/><circle cx="11.5" cy="4" r="2" stroke="currentColor" stroke-width="1.4"/><circle cx="11.5" cy="12" r="2" stroke="currentColor" stroke-width="1.4"/><path d="M6.4 7l3.2-2.2M6.4 9l3.2 2.2" stroke="currentColor" stroke-width="1.2"/>`,
    `<rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 1v4M11 1v4M2 7h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>`,
  ],
  [
    `<circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 5v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    `<path d="M2 4h12v9H2zM6 4V3a2 2 0 014 0v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<path d="M8 2v3M8 11v3M2 8h3M11 8h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="8" r="2.5" stroke="currentColor" stroke-width="1.5"/>`,
    `<path d="M8 1l1.8 4.5H14L10.2 8l1.4 4.5L8 10l-3.6 2.5L5.8 8 2 5.5h4.2z" fill="currentColor" opacity=".85"/>`,
  ],
];

const featIconStyle = [
  'background:rgba(168,85,247,.12);color:var(--c3)',
  'background:rgba(249,115,22,.12);color:#fb923c',
  'background:rgba(99,102,241,.12);color:var(--c1-light)',
  'background:rgba(34,211,238,.1);color:var(--c2)',
];

const arrowSvg = `<svg width="10" height="10" viewBox="0 0 11 11" fill="none" aria-hidden="true"><path d="M1.5 9.5L9.5 1.5M9.5 1.5H3.5M9.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="e2e v2-section" id="system">
  <div class="v2-container">

    <!-- Header -->
    <div class="e2e__head">
      <span class="v2-eyebrow" data-m="fade">{c.eyebrow}</span>
      <h2 class="e2e__h2" data-m="up" style="--m-d:.08s">
        {c.title}<br/><span class="v2-grad">{c.titleGrad}</span>
      </h2>
      <p class="e2e__lead" data-m="up" style="--m-d:.16s">{c.lead}</p>
    </div>

    <!-- Tab nav -->
    <div class="e2e__tabs" role="tablist" aria-label="System phases" data-m="up" style="--m-d:.2s">
      {phaseClasses.map((cls, i) => (
        <button
          class={`e2e__tab ${cls}${i === 0 ? ' active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`e2e-panel-${i}`}
          data-tab={i}
        >
          <span class="e2e__tab-progress" aria-hidden="true"></span>
          <span class={`e2e__tab-icon ${cls}`}>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" set:html={tabIcons[i]}/>
          </span>
          <span class="e2e__tab-body">
            <span class="e2e__tab-tag">{String(i).padStart(2,'0')} · {c.phases[i].tool}</span>
            <span class="e2e__tab-name">{c.phases[i].name}</span>
          </span>
        </button>
      ))}
    </div>

    <!-- Panels -->
    <div class="e2e__panel-wrap" data-m="up" style="--m-d:.26s">

      <!-- 00 CREATE -->
      <div class="e2e__panel active" id="e2e-panel-0" role="tabpanel" data-panel="0">
        <div class="e2e__panel-left">
          <div class="e2e__phase-hdr create">
            <span class="e2e__phase-icon create">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" set:html={tabIcons[0]}/>
            </span>
            <span class="e2e__phase-name">{c.phases[0].name}</span>
            <span class="e2e__phase-tool">{c.phases[0].tool}</span>
          </div>
          <div class="e2e__metrics">
            {phaseMetrics[0].map(m => (
              <div class="e2e__metric">
                <span class="e2e__metric-v" style={`color:${m.c}`}>{m.v}</span>
                <span class="e2e__metric-l">{m.l}</span>
              </div>
            ))}
          </div>
          <p class="e2e__phase-desc" set:html={c.phases[0].desc.replace('$35B+','<strong>$35B+</strong>')}></p>
          <ul class="e2e__features">
            {c.phases[0].features.map((f: string, fi: number) => (
              <li style={`--fi-d:${fi * 0.06}s`}>
                <span class="e2e__feat-icon" style={featIconStyle[0]}>
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" set:html={phaseIcons[0][fi]}/>
                </span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href={blogLinks[0]} class="e2e__blog-link">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M2 8h12M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {c.phases[0].blogLabel}
            <Fragment set:html={arrowSvg}/>
          </a>
        </div>
        <div class="e2e__panel-right">
          <img src="/images/e2e/create.jpg" alt="" class="e2e__panel-img" aria-hidden="true" loading="lazy"/>
          <div class="e2e__panel-overlay"></div>
          <div class="e2e__right-bg create"></div>
          <div class="e2e__float e2e__float--create">
            <div class="e2e__fn" style="--fn-d:1s"><span class="e2e__fn-ic">✦</span>Creative #3 · ▲97 — pushed live</div>
            <div class="e2e__fn" style="--fn-d:5.5s"><span class="e2e__fn-ic">📊</span>14× ROAS · A/B winner scaling</div>
            <div class="e2e__fn" style="--fn-d:10s"><span class="e2e__fn-ic">🎯</span>TikTok winner · 3× higher CTR</div>
          </div>
          <div class="e2e__mini-demo create-demo">
            <div class="e2e__demo-header">
              <span class="e2e__demo-lbl create">✦ AI Creative Engine</span>
              <span class="e2e__demo-status">
                <span class="e2e__demo-dot"></span>Generating
              </span>
            </div>
            <div class="e2e__demo-brief">
              <span class="e2e__demo-field">Brief</span>
              <span class="e2e__demo-txt">Real estate · CEO · €450k+<span class="e2e__cur">|</span></span>
            </div>
            <div class="e2e__demo-brief" style="--d:.25s">
              <span class="e2e__demo-field">Audience</span>
              <span class="e2e__demo-txt">HNW investors · 35–55 · DE/AT</span>
            </div>
            <div class="e2e__demo-divider">Creative Scoring Results</div>
            <div class="e2e__demo-creatives">
              <div class="e2e__dc win" style="--d:.3s">
                <span class="e2e__dc-score">▲97</span>
                <span class="e2e__dc-label">SCALING</span>
                <span class="e2e__dc-platform">Meta</span>
              </div>
              <div class="e2e__dc win" style="--d:.5s">
                <span class="e2e__dc-score">▲91</span>
                <span class="e2e__dc-label">SCALING</span>
                <span class="e2e__dc-platform">TikTok</span>
              </div>
              <div class="e2e__dc win" style="--d:.7s">
                <span class="e2e__dc-score">▲88</span>
                <span class="e2e__dc-label">SCALING</span>
                <span class="e2e__dc-platform">Google</span>
              </div>
              <div class="e2e__dc" style="--d:.9s">
                <span class="e2e__dc-score">▼74</span>
                <span class="e2e__dc-label">HOLD</span>
              </div>
              <div class="e2e__dc" style="--d:1.05s">
                <span class="e2e__dc-score">▼68</span>
                <span class="e2e__dc-label">HOLD</span>
              </div>
              <div class="e2e__dc" style="--d:1.2s">
                <span class="e2e__dc-score">▼61</span>
                <span class="e2e__dc-label">PAUSE</span>
              </div>
            </div>
            <div class="e2e__demo-footer" style="--d:1.4s">
              <svg width="10" height="10" viewBox="0 0 16 16" fill="none"><path d="M3 8l3.5 3.5L13 5" stroke="#22d3ee" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              3 winners selected · pushing to live
            </div>
          </div>
        </div>
      </div>

      <!-- 01 CAPTURE -->
      <div class="e2e__panel" id="e2e-panel-1" role="tabpanel" data-panel="1">
        <div class="e2e__panel-left">
          <div class="e2e__phase-hdr capture">
            <span class="e2e__phase-icon capture">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" set:html={tabIcons[1]}/>
            </span>
            <span class="e2e__phase-name">{c.phases[1].name}</span>
            <span class="e2e__phase-tool">{c.phases[1].tool}</span>
          </div>
          <div class="e2e__metrics">
            {phaseMetrics[1].map(m => (
              <div class="e2e__metric">
                <span class="e2e__metric-v" style={`color:${m.c}`}>{m.v}</span>
                <span class="e2e__metric-l">{m.l}</span>
              </div>
            ))}
          </div>
          <p class="e2e__phase-desc">{c.phases[1].desc}</p>
          <ul class="e2e__features">
            {c.phases[1].features.map((f: string, fi: number) => (
              <li style={`--fi-d:${fi * 0.06}s`}>
                <span class="e2e__feat-icon" style={featIconStyle[1]}>
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" set:html={phaseIcons[1][fi]}/>
                </span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href={blogLinks[1]} class="e2e__blog-link">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M2 8h12M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {c.phases[1].blogLabel}
            <Fragment set:html={arrowSvg}/>
          </a>
        </div>
        <div class="e2e__panel-right">
          <img src="/images/e2e/capture.jpg" alt="" class="e2e__panel-img" aria-hidden="true" loading="lazy"/>
          <div class="e2e__panel-overlay"></div>
          <div class="e2e__right-bg capture"></div>
          <div class="e2e__float e2e__float--capture">
            <div class="e2e__fn" style="--fn-d:.8s"><span class="e2e__fn-ic">⚡</span>New lead · WhatsApp · +49 157…</div>
            <div class="e2e__fn" style="--fn-d:4.5s"><span class="e2e__fn-ic">🔔</span>Instagram DM · 3 new replies</div>
            <div class="e2e__fn" style="--fn-d:8.5s"><span class="e2e__fn-ic">📥</span>47 new leads · last 2h</div>
          </div>
          <div class="e2e__mini-demo capture-demo">
            <div class="e2e__demo-header">
              <span class="e2e__demo-lbl capture">⬡ Unified Inbox</span>
              <span class="e2e__demo-counter" style="--d:.1s">
                <span class="e2e__counter-n" data-to="247">0</span> leads today
              </span>
            </div>
            <div class="e2e__ch-grid">
              {[
                { ch: 'WhatsApp', n: '94', d: '.1s', hot: true },
                { ch: 'Instagram', n: '51', d: '.2s', hot: false },
                { ch: 'TikTok', n: '38', d: '.3s', hot: false },
                { ch: 'Facebook', n: '32', d: '.4s', hot: false },
                { ch: 'Email', n: '19', d: '.5s', hot: false },
                { ch: 'SMS', n: '13', d: '.6s', hot: false },
              ].map(row => (
                <div class={`e2e__ch-row-item${row.hot ? ' hot' : ''}`} style={`--d:${row.d}`}>
                  <span class="e2e__ch-name">{row.ch}</span>
                  <span class="e2e__ch-bar-wrap">
                    <span class="e2e__ch-bar" style={`--w:${Math.round(parseInt(row.n)/94*100)}%`}></span>
                  </span>
                  <span class="e2e__ch-count">{row.n}</span>
                </div>
              ))}
            </div>
            <div class="e2e__inbox-row" style="--d:.9s">
              <span class="e2e__inbox-dot"></span>
              All 40+ channels · 0 missed leads
            </div>
          </div>
        </div>
      </div>

      <!-- 02 CONVERT -->
      <div class="e2e__panel" id="e2e-panel-2" role="tabpanel" data-panel="2">
        <div class="e2e__panel-left">
          <div class="e2e__phase-hdr convert">
            <span class="e2e__phase-icon convert">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" set:html={tabIcons[2]}/>
            </span>
            <span class="e2e__phase-name">{c.phases[2].name}</span>
            <span class="e2e__phase-tool">{c.phases[2].tool}</span>
          </div>
          <div class="e2e__metrics">
            {phaseMetrics[2].map(m => (
              <div class="e2e__metric">
                <span class="e2e__metric-v" style={`color:${m.c}`}>{m.v}</span>
                <span class="e2e__metric-l">{m.l}</span>
              </div>
            ))}
          </div>
          <p class="e2e__phase-desc">{c.phases[2].desc}</p>
          <ul class="e2e__features">
            {c.phases[2].features.map((f: string, fi: number) => (
              <li style={`--fi-d:${fi * 0.06}s`}>
                <span class="e2e__feat-icon" style={featIconStyle[2]}>
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" set:html={phaseIcons[2][fi]}/>
                </span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href={blogLinks[2]} class="e2e__blog-link">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M2 8h12M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {c.phases[2].blogLabel}
            <Fragment set:html={arrowSvg}/>
          </a>
        </div>
        <div class="e2e__panel-right">
          <img src="/images/e2e/convert.jpg" alt="" class="e2e__panel-img" aria-hidden="true" loading="lazy"/>
          <div class="e2e__panel-overlay"></div>
          <div class="e2e__right-bg convert"></div>
          <div class="e2e__float e2e__float--convert">
            <div class="e2e__fn" style="--fn-d:1.2s"><span class="e2e__fn-ic">🔥</span>HOT LEAD → Sarah K. · Score 96</div>
            <div class="e2e__fn" style="--fn-d:5.8s"><span class="e2e__fn-ic">✓</span>Appointment booked · Tomorrow 2pm</div>
            <div class="e2e__fn" style="--fn-d:10.5s"><span class="e2e__fn-ic">💬</span>AI qualified in 47s · 81% match</div>
          </div>
          <div class="e2e__mini-demo convert-demo">
            <div class="e2e__demo-header">
              <span class="e2e__demo-lbl convert">✨ AI Agent · Live</span>
              <span class="e2e__demo-time" style="--d:.05s">00:47s</span>
            </div>
            <div class="e2e__conv-thread">
              <div class="e2e__conv-msg user" style="--d:.1s">
                Hi, I'm looking for a 3BR apartment, budget €500k, need it asap
              </div>
              <div class="e2e__conv-msg ai" style="--d:.55s">
                <span class="e2e__conv-spark">✨</span>
                Great! To find the best match — is your budget firm at €500k, or is there flexibility?
              </div>
              <div class="e2e__conv-msg user" style="--d:1.0s">
                Firm. Pre-approved. Want to move within 60 days.
              </div>
              <div class="e2e__conv-bant" style="--d:1.4s">
                <span class="e2e__bant-item yes">B ✓</span>
                <span class="e2e__bant-item yes">A ✓</span>
                <span class="e2e__bant-item yes">N ✓</span>
                <span class="e2e__bant-item yes">T ✓</span>
                <span class="e2e__bant-score">Score 96</span>
              </div>
            </div>
            <div class="e2e__conv-hot" style="--d:1.9s">
              🔥 HOT LEAD routed → Sarah (Senior Sales)
            </div>
          </div>
        </div>
      </div>

      <!-- 03 RETAIN -->
      <div class="e2e__panel" id="e2e-panel-3" role="tabpanel" data-panel="3">
        <div class="e2e__panel-left">
          <div class="e2e__phase-hdr retain">
            <span class="e2e__phase-icon retain">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" set:html={tabIcons[3]}/>
            </span>
            <span class="e2e__phase-name">{c.phases[3].name}</span>
            <span class="e2e__phase-tool">{c.phases[3].tool}</span>
          </div>
          <div class="e2e__metrics">
            {phaseMetrics[3].map(m => (
              <div class="e2e__metric">
