---
// EndToEnd.astro
// Full lifecycle: Create → Capture → Convert → Retain
import getV2Content from '../../utils/v2i18n';
import type { Lang } from '../../utils/v2i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const c = getV2Content(lang).endToEnd;

const blogBase = lang === 'de' ? '/de/blog' : lang === 'sl' ? '/sl/blog' : '/blog';

// Phase CSS class keys
const phaseClasses = ['create', 'capture', 'convert', 'retain'];

// Phase feature icon SVGs (one set per phase)
const phaseIcons = [
  // Create (purple)
  [
    `<rect x="2" y="2" width="5" height="5" rx="1" fill="currentColor"/><rect x="9" y="2" width="5" height="5" rx="1" fill="currentColor" opacity=".6"/><rect x="2" y="9" width="5" height="5" rx="1" fill="currentColor" opacity=".6"/><rect x="9" y="9" width="5" height="5" rx="1" fill="currentColor"/>`,
    `<path d="M8 1l2 5h5l-4 3 1.5 5L8 11l-4.5 3L5 9 1 6h5z" fill="currentColor"/>`,
    `<path d="M2 8h12M8 2v12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
    `<path d="M2 12l4-4 3 3 5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.8"/><path d="M8 5v3l2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>`,
  ],
  // Capture (orange)
  [
    `<rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M1 6h14" stroke="currentColor" stroke-width="1.2"/>`,
    `<circle cx="8" cy="6" r="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>`,
    `<path d="M2 2h12v10H2zM6 12v2M10 12v2M4 14h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<path d="M8 2L2 5v9h12V5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 14V9h4v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
  ],
  // Convert (indigo)
  [
    `<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M5.5 8l2 2 3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<path d="M3 3h10v8H9l-3 3V11H3z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<path d="M2 8h12M2 4h8M2 12h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>`,
    `<circle cx="4.5" cy="8" r="2" stroke="currentColor" stroke-width="1.4"/><circle cx="11.5" cy="4" r="2" stroke="currentColor" stroke-width="1.4"/><circle cx="11.5" cy="12" r="2" stroke="currentColor" stroke-width="1.4"/><path d="M6.4 7l3.2-2.2M6.4 9l3.2 2.2" stroke="currentColor" stroke-width="1.2"/>`,
    `<rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 1v4M11 1v4M2 7h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>`,
  ],
  // Retain (cyan)
  [
    `<circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 5v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    `<path d="M2 4h12v9H2zM6 4V3a2 2 0 014 0v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
    `<path d="M8 2v3M8 11v3M2 8h3M11 8h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="8" r="2.5" stroke="currentColor" stroke-width="1.5"/>`,
    `<path d="M8 1l1.8 4.5H14L10.2 8l1.4 4.5L8 10l-3.6 2.5L5.8 8 2 5.5h4.2z" fill="currentColor" opacity=".85"/>`,
  ],
];

const phaseIconStyles = [
  'background:rgba(168,85,247,.1);color:var(--c3)',
  '',   // cap class
  '',   // con class
  '',   // ret class
];

// Mini-demo content per phase is hardcoded (animation strings) — stays EN
---

<section class="e2e v2-section" id="system">
  <div class="v2-container">

    <!-- ── Header ───────────────────────────────────── -->
    <div class="e2e__head">
      <span class="v2-eyebrow" data-m="fade">{c.eyebrow}</span>
      <h2 class="e2e__h2" data-m="up" style="--m-d:.08s">
        {c.title}<br/><span class="v2-grad">{c.titleGrad}</span>
      </h2>
      <p class="e2e__lead" data-m="up" style="--m-d:.16s">
        {c.lead}
      </p>
      

    <!-- ── 4 Phase columns ───────────────────────────── -->
    <div class="e2e__grid">

      <!-- ══ 00 CREATE ══ -->
      <div class="e2e__phase" data-m="up" style="--m-d:.05s">
        <div class="e2e__phase-hdr create">
          <span class="e2e__phase-tag">00</span>
          <span class="e2e__phase-name">{c.phases[0].name}</span>
          <span class="e2e__phase-tool">{c.phases[0].tool}</span>
        </div>

        <p class="e2e__phase-desc" set:html={c.phases[0].desc.replace('$35B+', '<strong>$35B+</strong>')}></p>

        <ul class="e2e__features">
          {c.phases[0].features.map((f: string, fi: number) => (
            <li>
              <span class="e2e__feat-icon" style="background:rgba(168,85,247,.1);color:var(--c3)">
                <svg width="11" height="11" viewBox="0 0 16 16" fill="none" set:html={phaseIcons[0][fi]} />
              </span>
              {f}
            </li>
          ))}
        </ul>

        <a href={`${blogBase}/ai-ad-creatives/`} class="e2e__blog-link">
          {c.phases[0].blogLabel}
          <svg width="10" height="10" viewBox="0 0 11 11" fill="none" aria-hidden="true"><path d="M1.5 9.5L9.5 1.5M9.5 1.5H3.5M9.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <div class="e2e__mini-demo create-demo">
          <div class="e2e__demo-brief">
            <span class="e2e__demo-lbl">BRIEF</span>
            <span class="e2e__demo-txt">Real estate · CEO · €450k+<span class="e2e__cur">|</span></span>
          </div>
          <div class="e2e__demo-creatives">
            <div class="e2e__dc win" style="--d:.2s">▲97 <span>SCALING</span></div>
            <div class="e2e__dc win" style="--d:.4s">▲91 <span>SCALING</span></div>
            <div class="e2e__dc win" style="--d:.6s">▲89 <span>SCALING</span></div>
            <div class="e2e__dc" style="--d:.8s">▼74</div>
            <div class="e2e__dc" style="--d:1.0s">▼68</div>
            <div class="e2e__dc" style="--d:1.2s">▼63</div>
          </div>
        </div>
      </div>


      <!-- ══ 01 CAPTURE ══ -->
      <div class="e2e__phase" data-m="up" style="--m-d:.13s">
        <div class="e2e__phase-hdr capture">
          <span class="e2e__phase-tag">01</span>
          <span class="e2e__phase-name">{c.phases[1].name}</span>
          <span class="e2e__phase-tool">{c.phases[1].tool}</span>
        </div>

        <p class="e2e__phase-desc">{c.phases[1].desc}</p>

        <ul class="e2e__features">
          {c.phases[1].features.map((f: string, fi: number) => (
            <li>
              <span class="e2e__feat-icon cap">
                <svg width="11" height="11" viewBox="0 0 16 16" fill="none" set:html={phaseIcons[1][fi]} />
              </span>
              {f}
            </li>
          ))}
        </ul>

        <a href={`${blogBase}/whatsapp-lead-generation/`} class="e2e__blog-link">
          {c.phases[1].blogLabel}
          <svg width="10" height="10" viewBox="0 0 11 11" fill="none" aria-hidden="true"><path d="M1.5 9.5L9.5 1.5M9.5 1.5H3.5M9.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <div class="e2e__mini-demo capture-demo">
          <div class="e2e__ch-row">
            {['WA','IG','TT','FB','✉','SMS'].map((ch, i) => (
              <span class="e2e__ch-tag" style={`--d:${i * 0.1}s`}>{ch}</span>
            ))}
          </div>
          <div class="e2e__inbox-row" style="--d:.8s">
            <span class="e2e__inbox-dot"></span>
            unified inbox · 0 missed leads
          </div>
        </div>
      </div>


      <!-- ══ 02 CONVERT ══ -->
      <div class="e2e__phase" data-m="up" style="--m-d:.21s">
        <div class="e2e__phase-hdr convert">
          <span class="e2e__phase-tag">02</span>
          <span class="e2e__phase-name">{c.phases[2].name}</span>
          <span class="e2e__phase-tool">{c.phases[2].tool}</span>
        </div>

        <p class="e2e__phase-desc">{c.phases[2].desc}</p>

        <ul class="e2e__features">
          {c.phases[2].features.map((f: string, fi: number) => (
            <li>
              <span class="e2e__feat-icon con">
                <svg width="11" height="11" viewBox="0 0 16 16" fill="none" set:html={phaseIcons[2][fi]} />
              </span>
              {f}
            </li>
          ))}
        </ul>

        <a href={`${blogBase}/ai-sales-agents/`} class="e2e__blog-link">
          {c.phases[2].blogLabel}
          <svg width="10" height="10" viewBox="0 0 11 11" fill="none" aria-hidden="true"><path d="M1.5 9.5L9.5 1.5M9.5 1.5H3.5M9.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="e2e__mini-demo convert-demo">
          <div class="e2e__conv-msg" style="--d:.15s">Hi! Pre-approved €500k, need 3BR now</div>
          <div class="e2e__conv-ai"  style="--d:.7s">
            <span class="e2e__conv-spark">✨</span> AI qualified · Score 96
          </div>
          <div class="e2e__conv-hot" style="--d:1.3s">🔥 HOT LEAD → Sarah (Sales Rep)</div>
        </div>
      </div>


      <!-- ══ 03 RETAIN ══ -->
      <div class="e2e__phase" data-m="up" style="--m-d:.29s">
        <div class="e2e__phase-hdr retain">
          <span class="e2e__phase-tag">03</span>
          <span class="e2e__phase-name">{c.phases[3].name}</span>
          <span class="e2e__phase-tool">{c.phases[3].tool}</span>
        </div>

        <p class="e2e__phase-desc">{c.phases[3].desc}</p>

        <ul class="e2e__features">
          {c.phases[3].features.map((f: string, fi: number) => (
            <li>
              <span class="e2e__feat-icon ret">
                <svg width="11" height="11" viewBox="0 0 16 16" fill="none" set:html={phaseIcons[3][fi]} />
              </span>
              <Fragment set:html={f.replace('&', '&amp;')} />
            </li>
          ))}
        </ul>

        <a href={`${blogBase}/whatsapp-broadcast-campaigns/`} class="e2e__blog-link">
          {c.phases[3].blogLabel}
          <svg width="10" height="10" viewBox="0 0 11 11" fill="none" aria-hidden="true"><path d="M1.5 9.5L9.5 1.5M9.5 1.5H3.5M9.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <div class="e2e__mini-demo retain-demo">
          <div class="e2e__ret-row" style="--d:.2s">
            <span class="e2e__ret-week">D+30</span>
            <span class="e2e__ret-txt">Renewal reminder · WA</span>
            <span class="e2e__ret-s sent">SENT</span>
          </div>
          <div class="e2e__ret-row" style="--d:.6s">
            <span class="e2e__ret-week">D+45</span>
            <span class="e2e__ret-txt">Exclusive offer broadcast</span>
            <span class="e2e__ret-s sent">SENT</span>
          </div>
          <div class="e2e__ret-row live" style="--d:1.0s">
            <span class="e2e__ret-week">D+60</span>
            <span class="e2e__ret-txt">CSAT survey · 94% positive</span>
            <span class="e2e__ret-s live">LIVE</span>
          </div>
        </div>
      </div>

    </div><!-- /grid -->


    <!-- ── Bottom ROI strip ──────────────────────────── -->
    <div class="e2e__strip" data-m="up" style="--m-d:.35s">
      {c.strip.map((item: { n: string; l: string }) => (
        <div class="e2e__strip-item">
          <span class="e2e__strip-n">{item.n}</span>
          <span class="e2e__strip-l">{item.l}</span>
        </div>
      ))}
    </div>

    <div class="v2-sc" data-m="up" style="--m-d:.4s">
      <a href="javascript:void(0)" class="v2-sc__btn primary" data-cal-link="kerim-alihodza-7u7w6q/30min" data-cal-namespace="30min" data-cal-config='{"layout":"month_view","theme":"dark"}'>
        {c.bottomCta}
      </a>
    </div>

  </div>
</section>


<style lang="scss" is:global>

@keyframes e2e-up   { from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none} }
@keyframes e2e-in   { from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:none} }
@keyframes e2e-fade { from{opacity:0}to{opacity:1} }
@keyframes e2e-blink{ 0%,49%{opacity:1}50%,100%{opacity:0} }
@keyframes e2e-dot  { 0%,100%{box-shadow:0 0 5px var(--c2)}50%{box-shadow:0 0 16px var(--c2),0 0 32px rgba(34,211,238,.3)} }

/* ── Section ────────────────────────────────────────── */
.e2e { padding: 96px 0; }

/* ── Head ───────────────────────────────────────────── */
.e2e__head {
  text-align: center; margin-bottom: 64px;
  display: flex; flex-direction: column; align-items: center; gap: 16px;
}
.e2e__h2 {
  font-family: var(--font-display);
  font-size: clamp(32px, 4vw, 60px);
  font-weight: 400; letter-spacing: -.025em; line-height: 1.1;
  color: var(--fg-0); margin: 0;
}
.e2e__lead {
  font-size: 16px; color: var(--fg-1); line-height: 1.7;
  max-width: 52ch; margin: 0;
}

/* platform badges */
.e2e__platforms {
  display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: center;
  padding: 14px 24px; border-radius: var(--r-lg);
  background: var(--glass); border: 1px solid var(--line);
}
.e2e__plat { display: flex; align-items: center; gap: 10px; }
.e2e__plat-icon {
  width: 36px; height: 36px; border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  &.ac { background: rgba(168,85,247,.15); color: var(--c3); border: 1px solid rgba(168,85,247,.3); }
  &.ri { background: rgba(34,211,238,.1);  color: var(--c2); border: 1px solid rgba(34,211,238,.3); }
}
.e2e__plat-name { font-size: 13px; font-weight: 600; color: var(--fg-0); }
.e2e__plat-role { font-family: var(--font-mono); font-size: 9px; color: var(--fg-2); letter-spacing: .06em; }
.e2e__plus, .e2e__equals {
  font-family: var(--font-display); font-size: 22px; color: var(--fg-3); line-height: 1;
}
.e2e__result { display: flex; align-items: center; }

/* ── Phase grid ─────────────────────────────────────── */
.e2e__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  align-items: stretch;
}

/* ── Phase card ─────────────────────────────────────── */
.e2e__phase {
  background: var(--bg-card); border: 1px solid var(--line);
  border-radius: var(--r-xl); overflow: hidden;
  display: flex; flex-direction: column; gap: 0;
  position: relative;
  transition: border-color .25s, box-shadow .25s;

  &:hover { border-color: rgba(99,102,241,.3); box-shadow: 0 20px 40px rgba(0,0,0,.25); }

  &::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    transform: scaleX(0); transform-origin: left;
    transition: transform .7s cubic-bezier(.22,.68,0,1.1);
  }
  &.io-in::before { transform: scaleX(1); }

  &:nth-child(1)::before { background: linear-gradient(90deg,var(--c3),rgba(168,85,247,.4)); }
  &:nth-child(2)::before { background: linear-gradient(90deg,#f97316,rgba(249,115,22,.4)); }
  &:nth-child(3)::before { background: linear-gradient(90deg,var(--c1),var(--c3)); }
  &:nth-child(4)::before { background: linear-gradient(90deg,var(--c2),rgba(34,211,238,.4)); }
}

/* phase header bar */
.e2e__phase-hdr {
  display: flex; align-items: center; gap: 8px;
  padding: 13px 16px 10px;
  border-bottom: 1px solid var(--line);
  background: var(--bg-elev);
  flex-wrap: wrap;
}
.e2e__phase-tag {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700; letter-spacing: .14em;
  padding: 2px 7px; border-radius: var(--r-pill); color: var(--fg-3);
  background: var(--glass); border: 1px solid var(--line);
}
.e2e__phase-name {
  font-size: 13px; font-weight: 700; flex: 1;
  .create  & { color: var(--c3); }
  .capture & { color: #f97316; }
  .convert & { color: var(--c1-light); }
  .retain  & { color: var(--c2); }
}
.e2e__phase-tool {
  font-family: var(--font-mono); font-size: 8px; font-weight: 700; letter-spacing: .08em;
  padding: 2px 6px; border-radius: var(--r-pill);
  .create  & { background:rgba(168,85,247,.1); color:var(--c3); border:1px solid rgba(168,85,247,.2); }
  .capture & { background:rgba(249,115,22,.1); color:#fb923c; border:1px solid rgba(249,115,22,.2); }
  .convert & { background:rgba(99,102,241,.1); color:var(--c1-light); border:1px solid rgba(99,102,241,.2); }
  .retain  & { background:rgba(34,211,238,.08);color:var(--c2); border:1px solid rgba(34,211,238,.2); }
}

.e2e__phase-desc {
  font-size: 12.5px; color: var(--fg-1); line-height: 1.65;
  padding: 14px 16px 0; margin: 0;
  strong { color: var(--fg-0); }
}

/* features list */
.e2e__features {
  list-style: none; padding: 12px 16px 0; margin: 0;
  display: flex; flex-direction: column; gap: 8px;

  li {
    display: flex; align-items: center; gap: 8px;
    font-size: 12px; color: var(--fg-1); line-height: 1.4;
  }
}
.e2e__feat-icon {
  width: 18px; height: 18px; border-radius: 4px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;

  &.cap { background:rgba(249,115,22,.1); color:#fb923c; }
  &.con { background:rgba(99,102,241,.1); color:var(--c1-light); }
  &.ret { background:rgba(34,211,238,.08);color:var(--c2); }
}

/* ── Blog deep-dive links ───────────────────────────── */
.e2e__blog-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 12px;
  margin: 10px 16px 0;
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgba(99,102,241,0.7);
  text-decoration: none;
  border-radius: var(--r-pill);
  border: 1px solid rgba(99,102,241,0.2);
  background: rgba(99,102,241,0.05);
  transition: color .15s, border-color .15s, gap .15s;
  align-self: flex-start;

  &:hover {
    color: #a5b4fc;
    border-color: rgba(99,102,241,0.4);
    gap: 7px;
  }
}

/* ── Mini demos ─────────────────────────────────────── */
.e2e__mini-demo {
  margin: 14px 16px 16px;
  border-radius: var(--r-md); overflow: hidden;
  background: rgba(255,255,255,.02); border: 1px solid var(--line);
  padding: 10px 12px;
  flex: 1;
}

/* Create demo */
.create-demo { display: flex; flex-direction: column; gap: 8px; }
.e2e__demo-brief {
  display: flex; align-items: center; gap: 7px;
  font-family: var(--font-mono); font-size: 9px;
}
.e2e__demo-lbl {
  color: var(--c3); background: rgba(168,85,247,.1); border: 1px solid rgba(168,85,247,.2);
  padding: 1px 5px; border-radius: 3px; font-weight: 700; letter-spacing: .1em;
}
.e2e__demo-txt { color: var(--fg-0); flex: 1; }
.e2e__cur { color: var(--c1-light); font-weight: 700; animation: e2e-blink .9s step-end infinite; }
.e2e__demo-creatives { display: grid; grid-template-columns: repeat(3,1fr); gap: 4px; }
.e2e__dc {
  font-family: var(--font-mono); font-size: 8.5px; font-weight: 700;
  padding: 4px 5px; border-radius: 4px; text-align: center;
  background: var(--glass); color: var(--fg-2); border: 1px solid var(--line);
  opacity: 0; animation: e2e-up .3s ease both; animation-delay: var(--d, 0s);
  span { display: block; font-size: 6.5px; letter-spacing: .08em; margin-top: 1px; }

  &.win {
    background: rgba(99,102,241,.08); color: var(--c2);
    border-color: rgba(99,102,241,.3); box-shadow: 0 0 8px rgba(99,102,241,.1);
  }
}

/* Capture demo */
.capture-demo { display: flex; flex-direction: column; gap: 7px; }
.e2e__ch-row { display: flex; flex-wrap: wrap; gap: 4px; }
.e2e__ch-tag {
