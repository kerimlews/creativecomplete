---
import CtaButton from './CtaButton.astro';
import { Image } from 'astro:assets';
import logo from '../images/logo-svg.svg';
import { COMPANY_SOCIAL_MEDIA } from '../utils/constants';
import { getLanguageFromUrl, t, getLocalizedUrl } from '../utils/translations';
import { getCollection } from 'astro:content';
import { getServiceUrl, getProjectUrl } from '../utils/routing';
import { capitalize } from '../utils/helpers';

const currentLang = getLanguageFromUrl(Astro.url);

// Load services dynamically from content collections (same as Header)
const allServices = await getCollection(`services${capitalize(currentLang)}` as any);

// Filter by current language and get featured services for footer
const footerServices = (allServices as any[])
  .filter((service: any) => {
    const parts = service?.filePath ? service.filePath.split('/') : [];
    const serviceLang = parts[3] || 'en';
    return serviceLang === currentLang;
  })
  .filter((service: any) => {
    // Only show main services in footer (exclude local-seo, use seo instead)
    const slug = service.data.slug || service.id;
    return ['seo', 'web-design', 'automation', 'saas-development', 'ecommerce', 'mobile-development'].includes(slug);
  })
  .slice(0, 6)
  .map((service: any) => ({
    slug: service.data.slug || service.id,
    title: service.data.title
  }))
  .sort((a, b) => {
    // Sort in a specific order for footer
    const order = ['seo', 'web-design', 'automation', 'saas-development', 'ecommerce', 'mobile-development'];
    return order.indexOf(a.slug) - order.indexOf(b.slug);
  });
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <!-- Company Info -->
      <div class="footer-section">
        <div class="footer-logo">
          <div class="logo-icon"><Image src={logo} width={70} height={100} alt="Logo" /></div>
          <span class="logo-text">Creative Complete LLC</span>
        </div>
        <p class="footer-description">
          Transforming businesses through strategic digital solutions since 2013. 
          10+ years of expertise in driving measurable results.
        </p>
        <div class="social-links">
          {Object.keys(COMPANY_SOCIAL_MEDIA).map(social => {
            const socialData = COMPANY_SOCIAL_MEDIA[social as keyof typeof COMPANY_SOCIAL_MEDIA];
            return (
              <a href={socialData.url} class="social-link" target="_blank" aria-label={socialData.tooltip}>
                <svg set:html={socialData.icon} />
              </a>
            );
          })}
        </div>
      </div>

      <!-- Services Links -->
      <div class="footer-section">
        <h4 class="footer-heading">{t('nav.services', currentLang)}</h4>
        <ul class="footer-links">
          {footerServices.map((service) => (
            <li><a href={getServiceUrl(currentLang, service.slug)}>{service.title}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div class="footer-section">
        <h4 class="footer-heading">{t('nav.about', currentLang)}</h4>
        <ul class="footer-links">
          <li><a href={getLocalizedUrl('/kerim-alihodza/', currentLang)}>About Kerim</a></li>
          <li><a href={getLocalizedUrl('/projects/', currentLang)}>Our Work</a></li>
          <li><a href={getLocalizedUrl('/services/', currentLang)}>Our Services</a></li>
          <li><a href={getLocalizedUrl('/#testimonials', currentLang)}>Testimonials</a></li>
          <li><a href={getLocalizedUrl('/contact/', currentLang)}>Contact</a></li>
          <li><a href={getLocalizedUrl('/privacy-policy/', currentLang)}>Privacy Policy</a></li>
          <li><a href={getLocalizedUrl('/terms-of-use/', currentLang)}>Terms of use</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="footer-section">
        <h4 class="footer-heading">Contact Info</h4>
        <div class="contact-info">
          <div class="contact-item">
            <strong>WhatsApp:</strong>
            <a href="https://wa.me/387603456771">+387 60 345 6771</a>
          </div>
          <div class="contact-item">
            <strong>Email:</strong>
            <a href="mailto:info@creativecomplete.com">info@creativecomplete.com</a>
          </div>
          <div class="contact-item">
            <strong>Response Time:</strong>
            <span>2-4 hours</span>
          </div>
        </div>
        <CtaButton 
          text="Start Your Project" 
          href={getLocalizedUrl('/contact/', currentLang)} 
          variant="primary" 
          size="sm" 
          class="footer-cta"
        />
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p>&copy; 2024 Digital Growth Agency. {t('footer.rights', currentLang)}</p>
    </div>
  </div>
</footer>
