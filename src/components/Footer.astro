---
import CtaButton from './CtaButton.astro';
import { Image } from 'astro:assets';
import logo from '../images/logo-svg.svg';
import { COMPANY_SOCIAL_MEDIA } from '../utils/constants';

---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <!-- Company Info -->
      <div class="footer-section">
        <div class="footer-logo">
          <div class="logo-icon"><Image src={logo} width={70} height={100} alt="Logo" /></div>
          <span class="logo-text">Creative Complete LLC</span>
        </div>
        <p class="footer-description">
          Transforming businesses through strategic digital solutions since 2013. 
          10+ years of expertise in driving measurable results.
        </p>
        <div class="social-links">
          {Object.keys(COMPANY_SOCIAL_MEDIA).map(social => (
            <a href={COMPANY_SOCIAL_MEDIA[social].url} class="social-link" target="_blank" aria-label={COMPANY_SOCIAL_MEDIA[social].tooltip}>
              <svg set:html={COMPANY_SOCIAL_MEDIA[social].icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Services Links -->
      <div class="footer-section">
        <h4 class="footer-heading">Our Services</h4>
        <ul class="footer-links">
          <li><a href="/services/local-seo-case-study-page-5-to-page-1/">SEO Strategy</a></li>
          <li><a href="/services/why-your-beautiful-website-isnt-making-sales/">Web Design</a></li>
          <li><a href="/services/ai-automation-saved-20-hours-weekly/">AI Automation</a></li>
          <li><a href="/services/from-idea-to-10k-mrr-saas-case-study/">SaaS Development</a></li>
          <li><a href="/services/why-your-online-store-isnt-converting/">E-commerce</a></li>
          <li><a href="/services/how-mobile-app-3x-revenue-local-business/">Mobile Apps</a></li>
          <li><a href="/services/sl/google-maps-optimizacija-slovenija/">Slovenija Local Business</a></li>
        </ul>
      </div>

      <!-- Company Links -->
      <div class="footer-section">
        <h4 class="footer-heading">Company</h4>
        <ul class="footer-links">
          <li><a href="/kerim-alihodza/">About Kerim</a></li>
          <li><a href="/projects/">Our Work</a></li>
          <li><a href="/services/">Our Services</a></li>
          <li><a href="/#testimonials">Testimonials</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-of-use/">Terms of use</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="footer-section">
        <h4 class="footer-heading">Contact Info</h4>
        <div class="contact-info">
          <div class="contact-item">
            <strong>WhatsApp:</strong>
            <a href="https://wa.me/387603456771">+387 60 345 6771</a>
          </div>
          <div class="contact-item">
            <strong>Email:</strong>
            <a href="mailto:info@creativecomplete.com">info@creativecomplete.com</a>
          </div>
          <div class="contact-item">
            <strong>Response Time:</strong>
            <span>2-4 hours</span>
          </div>
        </div>
        <CtaButton 
          text="Start Your Project" 
          href="/contact" 
          variant="primary" 
          size="sm" 
          class="footer-cta"
        />
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p>&copy; 2024 Digital Growth Agency. All rights reserved.</p>
    </div>
  </div>
</footer>
