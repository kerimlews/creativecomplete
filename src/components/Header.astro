---
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import logo from '../images/logo-svg.svg';
import { getLanguageFromUrl, t, getLocalizedUrl } from '../utils/translations';
import { getCollection } from 'astro:content';
import { getServiceUrl, getProjectUrl, filterByLanguage } from '../utils/routing';
import { capitalize } from '../utils/helpers';

const currentLang = getLanguageFromUrl(Astro.url);


// Load services and projects dynamically from content/[lang]
const allServices = await getCollection(`services${capitalize(currentLang)}`);
const allProjects = await getCollection(`projects${capitalize(currentLang)}`);

// Filter by current language
const services = allServices
  .filter(service => {
    const parts = service?.filePath ? service.filePath.split('/') : [];
    const serviceLang = parts[3] || 'en';
    return serviceLang === currentLang;
  })
  .slice(0, 6) // Limit to 6 for dropdown
  .map(service => ({
    slug: service.data.slug || service.id,
    title: service.data.title,
    description: service.data.description,
    category: service.data.category || 'General'
  }));

const projects = filterByLanguage(allProjects, currentLang)
  .slice(0, 5) // Limit to 5 for dropdown
  .map(project => ({
    slug: project.data.slug || project.id,
    title: project.data.title,
    description: project.data.description,
    category: project.data.category || 'General',
    logo: project.data.logo || null
  }));

// SVG Icons for different service categories - Animated and Colorful
const serviceIcons = {
  automation: `<svg viewBox="0 0 24 24" fill="none" class="service-icon service-icon-automation">
    <defs>
      <linearGradient id="automationGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#FF6B35;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#FF8C42;stop-opacity:1" />
        <animate attributeName="x1" values="0%;100%;0%" dur="3s" repeatCount="indefinite" />
        <animate attributeName="x2" values="100%;0%;100%" dur="3s" repeatCount="indefinite" />
      </linearGradient>
    </defs>
    <path d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87V4a1 1 0 00-1.6-.8L4.727 6.8a1 1 0 00-.001 1.6l3.2 2.133a1 1 0 01.4.8v5.133a1 1 0 01-1.6.8L2.4 11.2a1 1 0 00-1.6.8v6a1 1 0 001.6.8l4.072-3.067a1 1 0 011.6.8v5.133a1 1 0 001.6.8l4.072-3.067a1 1 0 01.928-.133l6.856 2.285a1 1 0 001.264-1.265l-2.285-6.856a1 1 0 00-.133-.928l-3.067-4.072a1 1 0 00-.8-.4h-5.133a1 1 0 01-.8-.4z" 
          stroke="url(#automationGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <animate attributeName="stroke-dasharray" values="0 50;50 0;0 50" dur="2s" repeatCount="indefinite" />
    </path>
  </svg>`,
  saas: `<svg viewBox="0 0 24 24" fill="none" class="service-icon service-icon-saas">
    <defs>
      <linearGradient id="saasGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
        <animate attributeName="x1" values="0%;100%;0%" dur="3s" repeatCount="indefinite" />
        <animate attributeName="x2" values="100%;0%;100%" dur="3s" repeatCount="indefinite" />
      </linearGradient>
    </defs>
    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" 
          stroke="url(#saasGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <animateTransform attributeName="transform" type="rotate" values="0 12 12;360 12 12" dur="8s" repeatCount="indefinite" />
    </path>
    <polyline points="3.27 6.96 12 12.01 20.73 6.96" stroke="url(#saasGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <line x1="12" y1="22.08" x2="12" y2="12" stroke="url(#saasGrad)" stroke-width="2.5" stroke-linecap="round" />
  </svg>`,
  ecommerce: `<svg viewBox="0 0 24 24" fill="none" class="service-icon service-icon-ecommerce">
    <defs>
      <linearGradient id="ecommerceGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#f093fb;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#f5576c;stop-opacity:1" />
        <animate attributeName="x1" values="0%;100%;0%" dur="3s" repeatCount="indefinite" />
        <animate attributeName="x2" values="100%;0%;100%" dur="3s" repeatCount="indefinite" />
      </linearGradient>
    </defs>
    <circle cx="9" cy="21" r="2" fill="url(#ecommerceGrad)">
      <animate attributeName="r" values="2;2.5;2" dur="1.5s" repeatCount="indefinite" />
    </circle>
    <circle cx="20" cy="21" r="2" fill="url(#ecommerceGrad)">
      <animate attributeName="r" values="2;2.5;2" dur="1.5s" begin="0.75s" repeatCount="indefinite" />
    </circle>
    <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6" 
          stroke="url(#ecommerceGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <animate attributeName="stroke-dasharray" values="0 30;30 0" dur="2s" repeatCount="indefinite" />
    </path>
  </svg>`,
  mobile: `<svg viewBox="0 0 24 24" fill="none" class="service-icon service-icon-mobile">
    <defs>
      <linearGradient id="mobileGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#4facfe;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#00f2fe;stop-opacity:1" />
        <animate attributeName="x1" values="0%;100%;0%" dur="3s" repeatCount="indefinite" />
        <animate attributeName="x2" values="100%;0%;100%" dur="3s" repeatCount="indefinite" />
      </linearGradient>
    </defs>
    <rect x="5" y="2" width="14" height="20" rx="2" ry="2" 
          stroke="url(#mobileGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <animate attributeName="rx" values="2;3;2" dur="2s" repeatCount="indefinite" />
    </rect>
    <circle cx="12" cy="18" r="1.5" fill="url(#mobileGrad)">
      <animate attributeName="r" values="1.5;2;1.5" dur="1.5s" repeatCount="indefinite" />
    </circle>
  </svg>`,
  seo: `<svg viewBox="0 0 24 24" fill="none" class="service-icon service-icon-seo">
    <defs>
      <linearGradient id="seoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#fa709a;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#fee140;stop-opacity:1" />
        <animate attributeName="x1" values="0%;100%;0%" dur="3s" repeatCount="indefinite" />
        <animate attributeName="x2" values="100%;0%;100%" dur="3s" repeatCount="indefinite" />
      </linearGradient>
    </defs>
    <path d="M12 19l7-7 3 3-7 7-3-3z" 
          stroke="url(#seoGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <animateTransform attributeName="transform" type="scale" values="1;1.1;1" dur="2s" repeatCount="indefinite" />
    </path>
    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" 
          stroke="url(#seoGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M2 2l7.586 7.586" stroke="url(#seoGrad)" stroke-width="2.5" stroke-linecap="round" />
    <circle cx="11" cy="11" r="2.5" fill="url(#seoGrad)">
      <animate attributeName="r" values="2.5;3;2.5" dur="1.5s" repeatCount="indefinite" />
    </circle>
  </svg>`,
  web: `<svg viewBox="0 0 24 24" fill="none" class="service-icon service-icon-web">
    <defs>
      <linearGradient id="webGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#30cfd0;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#330867;stop-opacity:1" />
        <animate attributeName="x1" values="0%;100%;0%" dur="3s" repeatCount="indefinite" />
        <animate attributeName="x2" values="100%;0%;100%" dur="3s" repeatCount="indefinite" />
      </linearGradient>
    </defs>
    <rect x="2" y="2" width="20" height="20" rx="2" ry="2" 
          stroke="url(#webGrad)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <animate attributeName="rx" values="2;4;2" dur="2s" repeatCount="indefinite" />
    </rect>
    <path d="M2 8h20" stroke="url(#webGrad)" stroke-width="2.5" stroke-linecap="round">
      <animate attributeName="stroke-dasharray" values="0 24;24 0" dur="2s" repeatCount="indefinite" />
    </path>
    <path d="M8 21V8" stroke="url(#webGrad)" stroke-width="2.5" stroke-linecap="round">
      <animate attributeName="stroke-dasharray" values="0 13;13 0" dur="2s" begin="1s" repeatCount="indefinite" />
    </path>
  </svg>`
};

const projectIcons = {
  revenue: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="12" y1="1" x2="12" y2="23"></line>
    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
  </svg>`,
  scaling: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
    <polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline>
    <polyline points="7.5 19.79 7.5 14.6 3 12"></polyline>
    <polyline points="21 12 16.5 14.6 16.5 19.79"></polyline>
    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
    <line x1="12" y1="22.08" x2="12" y2="12"></line>
  </svg>`,
  automation: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M2 2h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    <circle cx="10" cy="20" r="1"></circle>
    <circle cx="21" cy="20" r="1"></circle>
  </svg>`
};
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <!-- Logo -->
      <a href={getLocalizedUrl('/', currentLang)} class="logo">
        <div class="logo-icon">
            <Image src={logo} alt="Logo creativecomplete.com" width={30} height={50} />
        </div>
        <span class="logo-text">Creative Complete</span>
      </a>

      <!-- Navigation Menu -->
      <div class="nav-menu" id="navMenu">
        <!-- Services Dropdown - ONLY SERVICES -->
        <div class="nav-item has-dropdown">
          <a href={getLocalizedUrl('/services/', currentLang)} class="nav-link">
            {t('nav.services', currentLang)}
            <span class="dropdown-arrow">▼</span>
          </a>
          <div class="nav-dropdown">
            {services.length > 0 && (
              <div class="dropdown-section">
                <div class="section-title">{t('nav.services', currentLang)}</div>
                <div class="dropdown-grid">
                  {services.map((service, index) => {
                    // Determine icon based on category or slug
                    let icon = serviceIcons.web;
                    let iconType = 'web';
                    if (service.slug.includes('automation') || service.category.toLowerCase().includes('automation')) {
                      icon = serviceIcons.automation.replace('automationGrad', `automationGrad${index}`);
                      iconType = 'automation';
                    } else if (service.slug.includes('seo') || service.category.toLowerCase().includes('seo')) {
                      icon = serviceIcons.seo.replace('seoGrad', `seoGrad${index}`);
                      iconType = 'seo';
                    } else if (service.slug.includes('saas') || service.category.toLowerCase().includes('saas')) {
                      icon = serviceIcons.saas.replace('saasGrad', `saasGrad${index}`);
                      iconType = 'saas';
                    } else if (service.slug.includes('mobile') || service.category.toLowerCase().includes('mobile')) {
                      icon = serviceIcons.mobile.replace('mobileGrad', `mobileGrad${index}`);
                      iconType = 'mobile';
                    } else if (service.slug.includes('ecommerce') || service.category.toLowerCase().includes('ecommerce')) {
                      icon = serviceIcons.ecommerce.replace('ecommerceGrad', `ecommerceGrad${index}`);
                      iconType = 'ecommerce';
                    } else {
                      icon = serviceIcons.web.replace('webGrad', `webGrad${index}`);
                    }
                    
                    return (
                      <a href={getServiceUrl(currentLang, service.slug)} class="dropdown-item compact">
                        <div class="dropdown-icon" set:html={icon}></div>
                        <div class="dropdown-content">
                          <div class="dropdown-title">{service.title}</div>
                          <div class="dropdown-desc">{service.description.substring(0, 60)}...</div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Projects Dropdown - ONLY PROJECTS -->
        <div class="nav-item has-dropdown">
          <a href={getLocalizedUrl('/projects/', currentLang)} class="nav-link">
            {t('nav.projects', currentLang)}
            <span class="dropdown-arrow">▼</span>
          </a>
          <div class="nav-dropdown">
            {projects.length > 0 && (
              <div class="dropdown-section">
                <div class="section-title">{t('nav.projects', currentLang)}</div>
                <div class="dropdown-grid projects-row">
                  {projects.map((project) => {
                    return (
                      <a href={getProjectUrl(currentLang, project.slug)} class="dropdown-item projects-row-item">
                        {project.logo ? (
                          <img src={project.logo} alt={project.title} class="project-logo" loading="lazy" />
                        ) : (
                          <div class="dropdown-icon" set:html={projectIcons.revenue}></div>
                        )}
                        <div class="project-content">
                          <div class="dropdown-title">{project.title}</div>
                          <div class="dropdown-desc">{project.description.substring(0, 50)}...</div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Simple Links -->
        <div class="nav-item">
          <a href={getLocalizedUrl('/about/', currentLang)} class="nav-link">{t('nav.about', currentLang)}</a>
        </div>
        <div class="nav-item">
          <a href={getLocalizedUrl('/contact/', currentLang)} class="nav-link">{t('nav.contact', currentLang)}</a>
        </div>
      </div>

      <!-- CTA Button -->
      <div class="nav-actions">
        <CtaButton 
          text={t('cta.get_started', currentLang)} 
          href={getLocalizedUrl('/contact/', currentLang)} 
          variant="primary" 
          size="sm" 
        />
      </div>

      <!-- Language Switcher -->
      <LanguageSwitcher />

      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
  
  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
  // Mobile menu functionality
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const navMenu = document.getElementById('navMenu');
  const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
  const dropdownItems = document.querySelectorAll('.nav-item.has-dropdown');

  function toggleMobileMenu() {
    const isActive = mobileMenuBtn.classList.contains('active');
    
    mobileMenuBtn.classList.toggle('active');
    navMenu.classList.toggle('active');
    mobileMenuOverlay.classList.toggle('active');
    
    // Close all dropdowns when toggling menu
    if (!isActive) {
      dropdownItems.forEach(item => {
        const dropdown = item.querySelector('.nav-dropdown');
        const link = item.querySelector('.nav-link');
        dropdown.classList.remove('active');
        link.classList.remove('active');
      });
    }
    
    // Toggle body scroll
    document.body.style.overflow = isActive ? '' : 'hidden';
  }

  function closeMobileMenu() {
    mobileMenuBtn.classList.remove('active');
    navMenu.classList.remove('active');
    mobileMenuOverlay.classList.remove('active');
    document.body.style.overflow = '';
    
    // Close all dropdowns
    dropdownItems.forEach(item => {
      const dropdown = item.querySelector('.nav-dropdown');
      const link = item.querySelector('.nav-link');
      dropdown.classList.remove('active');
      link.classList.remove('active');
    });
  }

  // Mobile dropdown functionality - FIXED VERSION
// Mobile dropdown functionality - UPDATED VERSION
function setupMobileDropdowns() {      
  dropdownItems.forEach(item => {
    const link = item.querySelector('.nav-link');
    const dropdown = item.querySelector('.nav-dropdown');

    const clickHandler = (e) => {          
      // Only handle dropdown toggle on mobile/tablet
      if (window.innerWidth <= 1024) {
        e.preventDefault();
        e.stopPropagation();
        
        const isActive = dropdown.classList.contains('active');
        
        console.log('Dropdown clicked, current state:', isActive);
        
        // Close all other dropdowns first
        dropdownItems.forEach(otherItem => {
          if (otherItem !== item) {
            const otherDropdown = otherItem.querySelector('.nav-dropdown');
            const otherLink = otherItem.querySelector('.nav-link');
            otherDropdown.classList.remove('active');
            otherLink.classList.remove('active');
          }
        });
        
        // Toggle current dropdown
        dropdown.classList.toggle('active');
        link.classList.toggle('active');
        
        console.log('Dropdown new state:', dropdown.classList.contains('active'));
      }
      // On desktop, allow normal link behavior
    };

    // Remove any existing listeners and add new one
    link.removeEventListener('click', clickHandler);
    link.addEventListener('click', clickHandler);
  });

  // Close dropdowns when clicking on dropdown links (the actual service/project links)
  document.querySelectorAll('.nav-dropdown a').forEach(dropdownLink => {
    dropdownLink.addEventListener('click', (e) => {
      // Allow the link to work normally
      if (window.innerWidth <= 1024) {
        closeMobileMenu(); // Close entire mobile menu when a dropdown item is clicked
      }
    });
  });
}

  // Desktop hover functionality
  function setupDesktopHover() {
    dropdownItems.forEach(item => {
      const link = item.querySelector('.nav-link');
      const dropdown = item.querySelector('.nav-dropdown');
      
      // Reset styles first
      dropdown.style.opacity = '0';
      dropdown.style.visibility = 'hidden';
      dropdown.style.transform = 'translateX(-50%) translateY(10px)';
      
      if (window.innerWidth > 1024) {
        item.addEventListener('mouseenter', () => {
          dropdown.style.opacity = '1';
          dropdown.style.visibility = 'visible';
          dropdown.style.transform = 'translateX(-50%) translateY(0)';
        });
        
        item.addEventListener('mouseleave', () => {
          dropdown.style.opacity = '0';
          dropdown.style.visibility = 'hidden';
          dropdown.style.transform = 'translateX(-50%) translateY(10px)';
        });
      } else {
        // Remove hover effects on mobile
        dropdown.style.transition = 'none';
      }
    });
  }

  // Close dropdowns when clicking outside
  function setupClickOutside() {
    document.addEventListener('click', (e) => {
      if (window.innerWidth <= 1024) {
        const isClickInsideDropdown = e.target.closest('.nav-item.has-dropdown');
        const isClickOnMobileButton = e.target.closest('#mobileMenuBtn');
        
        if (!isClickInsideDropdown && !isClickOnMobileButton && navMenu.classList.contains('active')) {
          // Close all dropdowns but keep menu open
          dropdownItems.forEach(item => {
            const dropdown = item.querySelector('.nav-dropdown');
            const link = item.querySelector('.nav-link');
            dropdown.classList.remove('active');
            link.classList.remove('active');
          });
        }
      }
    });
  }

  // Event listeners
  mobileMenuBtn.addEventListener('click', toggleMobileMenu);
  mobileMenuOverlay.addEventListener('click', closeMobileMenu);

  // Close menu when clicking on nav links (non-dropdown)
  document.querySelectorAll('.nav-item:not(.has-dropdown) .nav-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Close menu on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobileMenu();
  });

  // Header scroll effect
  window.addEventListener('scroll', () => {
    const header = document.querySelector('.header');
    if (window.scrollY > 100) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });

  // Initialize all functionality
  setupMobileDropdowns();
  setupDesktopHover();
  setupClickOutside();
  
  // Re-initialize on resize
  window.addEventListener('resize', () => {
    setupDesktopHover();
    
    // Close mobile menu when switching to desktop
    if (window.innerWidth > 1024) {
      closeMobileMenu();
    }
  });
});
</script>