---
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import logo from '../images/logo-svg.svg';

// SVG Icons for different service categories
const serviceIcons = {
  automation: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87V4a1 1 0 00-1.6-.8L4.727 6.8a1 1 0 00-.001 1.6l3.2 2.133a1 1 0 01.4.8v5.133a1 1 0 01-1.6.8L2.4 11.2a1 1 0 00-1.6.8v6a1 1 0 001.6.8l4.072-3.067a1 1 0 011.6.8v5.133a1 1 0 001.6.8l4.072-3.067a1 1 0 01.928-.133l6.856 2.285a1 1 0 001.264-1.265l-2.285-6.856a1 1 0 00-.133-.928l-3.067-4.072a1 1 0 00-.8-.4h-5.133a1 1 0 01-.8-.4z"></path>
  </svg>`,
  saas: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path>
    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
    <line x1="12" y1="22.08" x2="12" y2="12"></line>
  </svg>`,
  ecommerce: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="9" cy="21" r="1"></circle>
    <circle cx="20" cy="21" r="1"></circle>
    <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"></path>
  </svg>`,
  mobile: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
    <path d="M12 18h.01"></path>
  </svg>`,
  seo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
    <path d="M2 2l7.586 7.586"></path>
    <circle cx="11" cy="11" r="2"></circle>
  </svg>`,
  web: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <rect x="2" y="2" width="20" height="20" rx="2" ry="2"></rect>
    <path d="M2 8h20M8 21V8"></path>
  </svg>`
};

const projectIcons = {
  revenue: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="12" y1="1" x2="12" y2="23"></line>
    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
  </svg>`,
  scaling: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
    <polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline>
    <polyline points="7.5 19.79 7.5 14.6 3 12"></polyline>
    <polyline points="21 12 16.5 14.6 16.5 19.79"></polyline>
    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
    <line x1="12" y1="22.08" x2="12" y2="12"></line>
  </svg>`,
  automation: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M2 2h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    <circle cx="10" cy="20" r="1"></circle>
    <circle cx="21" cy="20" r="1"></circle>
  </svg>`
};
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <!-- Logo -->
      <a href="/" class="logo">
        <div class="logo-icon">
            <Image src={logo} alt="Logo creativecomplete.com" width={50} height={30} />
        </div>
        <span class="logo-text">Creative Complete</span>
      </a>

      <!-- Navigation Menu -->
      <div class="nav-menu" id="navMenu">
        <!-- Services Dropdown - ONLY SERVICES -->
        <div class="nav-item has-dropdown">
          <a href="/services" class="nav-link">
            Services
            <span class="dropdown-arrow">▼</span>
          </a>
          <div class="nav-dropdown">
            <div class="dropdown-section">
              <div class="section-title">Automation & AI</div>
              <div class="dropdown-grid">
                <a href="/services/ai-automation-saved-20-hours-weekly" class="dropdown-item compact">
                  <div class="dropdown-icon" set:html={serviceIcons.automation}></div>
                  <div class="dropdown-content">
                    <div class="dropdown-title">AI Automation</div>
                    <div class="dropdown-desc">Save 20+ hours weekly with smart automation</div>
                  </div>
                </a>
                <a href="/services/why-your-beautiful-website-isnt-making-sales" class="dropdown-item compact">
                  <div class="dropdown-icon" set:html={serviceIcons.web}></div>
                  <div class="dropdown-content">
                    <div class="dropdown-title">Website Conversion</div>
                    <div class="dropdown-desc">217% lead increase in 3 months</div>
                  </div>
                </a>
                <a href="/services/local-seo-case-study-page-5-to-page-1" class="dropdown-item compact">
                  <div class="dropdown-icon" set:html={serviceIcons.seo}></div>
                  <div class="dropdown-content">
                    <div class="dropdown-title">Local SEO</div>
                    <div class="dropdown-desc">Page 5 to #1 in 90 days</div>
                  </div>
                </a>
              </div>
            </div>

            <div class="dropdown-section">
              <div class="section-title">Development</div>
              <div class="dropdown-grid">
                <a href="/services/from-idea-to-10k-mrr-saas-case-study" class="dropdown-item compact">
                  <div class="dropdown-icon" set:html={serviceIcons.saas}></div>
                  <div class="dropdown-content">
                    <div class="dropdown-title">SaaS Development</div>
                    <div class="dropdown-desc">From idea to $10k MRR</div>
                  </div>
                </a>
                <a href="/services/how-mobile-app-3x-revenue-local-business" class="dropdown-item compact">
                  <div class="dropdown-icon" set:html={serviceIcons.mobile}></div>
                  <div class="dropdown-content">
                    <div class="dropdown-title">Mobile Apps</div>
                    <div class="dropdown-desc">3x revenue for local businesses</div>
                  </div>
                </a>
                <a href="/services/why-your-online-store-isnt-converting" class="dropdown-item compact">
                  <div class="dropdown-icon" set:html={serviceIcons.ecommerce}></div>
                  <div class="dropdown-content">
                    <div class="dropdown-title">E-commerce</div>
                    <div class="dropdown-desc">185% conversion increase</div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Projects Dropdown - ONLY PROJECTS -->
        <div class="nav-item has-dropdown">
          <a href="/projects" class="nav-link">
            Projects
            <span class="dropdown-arrow">▼</span>
          </a>
          <div class="nav-dropdown">
            <div class="dropdown-section">
              <div class="section-title">Revenue Growth</div>
              <div class="dropdown-grid three-column">
                <a href="/projects/nianave-ecommerce-scaling-case-study" class="dropdown-item">
                  <div class="dropdown-icon" set:html={projectIcons.revenue}></div>
                  <div class="dropdown-title">Nianave Fashion</div>
                  <div class="dropdown-desc">$30k → $120k/month in 6 months</div>
                </a>
                <a href="/projects/careconnect-recruitment-automation" class="dropdown-item">
                  <div class="dropdown-icon" set:html={projectIcons.revenue}></div>
                  <div class="dropdown-title">CareConnect</div>
                  <div class="dropdown-desc">245% traffic growth + automation</div>
                </a>
              </div>
            </div>

            <div class="dropdown-section">
              <div class="section-title">Scaling & Automation</div>
              <div class="dropdown-grid three-column">
                <a href="/projects/paperpile-saas-scaling-case-study" class="dropdown-item">
                  <div class="dropdown-icon" set:html={projectIcons.scaling}></div>
                  <div class="dropdown-title">Paperpile SaaS</div>
                  <div class="dropdown-desc">200k+ academics, 95% performance</div>
                </a>
                <a href="/projects/fitovision-gym-saas" class="dropdown-item">
                  <div class="dropdown-icon" set:html={projectIcons.scaling}></div>
                  <div class="dropdown-title">Fitovision</div>
                  <div class="dropdown-desc">One platform replacing 7 tools</div>
                </a>
                <a href="/projects/prepme-automation-saas" class="dropdown-item">
                  <div class="dropdown-icon" set:html={projectIcons.automation}></div>
                  <div class="dropdown-title">PrepMe Automation</div>
                  <div class="dropdown-desc">280 hours/month saved</div>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Simple Links -->
        <div class="nav-item">
          <a href="/about" class="nav-link">About</a>
        </div>
        <div class="nav-item">
          <a href="/contact" class="nav-link">Contact</a>
        </div>
      </div>

      <!-- CTA Button -->
      <div class="nav-actions">
        <CtaButton 
          text="Get Started" 
          href="/contact" 
          variant="primary" 
          size="sm" 
        />
      </div>

      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
  
  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
  // Mobile menu functionality
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const navMenu = document.getElementById('navMenu');
  const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
  const dropdownItems = document.querySelectorAll('.nav-item.has-dropdown');

  function toggleMobileMenu() {
    const isActive = mobileMenuBtn.classList.contains('active');
    
    mobileMenuBtn.classList.toggle('active');
    navMenu.classList.toggle('active');
    mobileMenuOverlay.classList.toggle('active');
    
    // Close all dropdowns when toggling menu
    if (!isActive) {
      dropdownItems.forEach(item => {
        const dropdown = item.querySelector('.nav-dropdown');
        const link = item.querySelector('.nav-link');
        dropdown.classList.remove('active');
        link.classList.remove('active');
      });
    }
    
    // Toggle body scroll
    document.body.style.overflow = isActive ? '' : 'hidden';
  }

  function closeMobileMenu() {
    mobileMenuBtn.classList.remove('active');
    navMenu.classList.remove('active');
    mobileMenuOverlay.classList.remove('active');
    document.body.style.overflow = '';
    
    // Close all dropdowns
    dropdownItems.forEach(item => {
      const dropdown = item.querySelector('.nav-dropdown');
      const link = item.querySelector('.nav-link');
      dropdown.classList.remove('active');
      link.classList.remove('active');
    });
  }

  // Mobile dropdown functionality - FIXED VERSION
// Mobile dropdown functionality - UPDATED VERSION
function setupMobileDropdowns() {      
  dropdownItems.forEach(item => {
    const link = item.querySelector('.nav-link');
    const dropdown = item.querySelector('.nav-dropdown');

    const clickHandler = (e) => {          
      // Only handle dropdown toggle on mobile/tablet
      if (window.innerWidth <= 1024) {
        e.preventDefault();
        e.stopPropagation();
        
        const isActive = dropdown.classList.contains('active');
        
        console.log('Dropdown clicked, current state:', isActive);
        
        // Close all other dropdowns first
        dropdownItems.forEach(otherItem => {
          if (otherItem !== item) {
            const otherDropdown = otherItem.querySelector('.nav-dropdown');
            const otherLink = otherItem.querySelector('.nav-link');
            otherDropdown.classList.remove('active');
            otherLink.classList.remove('active');
          }
        });
        
        // Toggle current dropdown
        dropdown.classList.toggle('active');
        link.classList.toggle('active');
        
        console.log('Dropdown new state:', dropdown.classList.contains('active'));
      }
      // On desktop, allow normal link behavior
    };

    // Remove any existing listeners and add new one
    link.removeEventListener('click', clickHandler);
    link.addEventListener('click', clickHandler);
  });

  // Close dropdowns when clicking on dropdown links (the actual service/project links)
  document.querySelectorAll('.nav-dropdown a').forEach(dropdownLink => {
    dropdownLink.addEventListener('click', (e) => {
      // Allow the link to work normally
      if (window.innerWidth <= 1024) {
        closeMobileMenu(); // Close entire mobile menu when a dropdown item is clicked
      }
    });
  });
}

  // Desktop hover functionality
  function setupDesktopHover() {
    dropdownItems.forEach(item => {
      const link = item.querySelector('.nav-link');
      const dropdown = item.querySelector('.nav-dropdown');
      
      // Reset styles first
      dropdown.style.opacity = '0';
      dropdown.style.visibility = 'hidden';
      dropdown.style.transform = 'translateX(-50%) translateY(10px)';
      
      if (window.innerWidth > 1024) {
        item.addEventListener('mouseenter', () => {
          dropdown.style.opacity = '1';
          dropdown.style.visibility = 'visible';
          dropdown.style.transform = 'translateX(-50%) translateY(0)';
        });
        
        item.addEventListener('mouseleave', () => {
          dropdown.style.opacity = '0';
          dropdown.style.visibility = 'hidden';
          dropdown.style.transform = 'translateX(-50%) translateY(10px)';
        });
      } else {
        // Remove hover effects on mobile
        dropdown.style.transition = 'none';
      }
    });
  }

  // Close dropdowns when clicking outside
  function setupClickOutside() {
    document.addEventListener('click', (e) => {
      if (window.innerWidth <= 1024) {
        const isClickInsideDropdown = e.target.closest('.nav-item.has-dropdown');
        const isClickOnMobileButton = e.target.closest('#mobileMenuBtn');
        
        if (!isClickInsideDropdown && !isClickOnMobileButton && navMenu.classList.contains('active')) {
          // Close all dropdowns but keep menu open
          dropdownItems.forEach(item => {
            const dropdown = item.querySelector('.nav-dropdown');
            const link = item.querySelector('.nav-link');
            dropdown.classList.remove('active');
            link.classList.remove('active');
          });
        }
      }
    });
  }

  // Event listeners
  mobileMenuBtn.addEventListener('click', toggleMobileMenu);
  mobileMenuOverlay.addEventListener('click', closeMobileMenu);

  // Close menu when clicking on nav links (non-dropdown)
  document.querySelectorAll('.nav-item:not(.has-dropdown) .nav-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Close menu on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobileMenu();
  });

  // Header scroll effect
  window.addEventListener('scroll', () => {
    const header = document.querySelector('.header');
    if (window.scrollY > 100) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });

  // Initialize all functionality
  setupMobileDropdowns();
  setupDesktopHover();
  setupClickOutside();
  
  // Re-initialize on resize
  window.addEventListener('resize', () => {
    setupDesktopHover();
    
    // Close mobile menu when switching to desktop
    if (window.innerWidth > 1024) {
      closeMobileMenu();
    }
  });
});
</script>