---
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  image: any; // Should be ImageMetadata but using any for now
  features: string[];
  ctaText?: string;
  delay?: number;
  url?: string;
}

const { title, description, image, features, url, ctaText = "Learn More", delay = 0 } = Astro.props;

---

<div class="service-card" data-astro-animate="fadeInUp" data-astro-delay="{delay}">
  <div class="card-glass">
    <!-- Image on LEFT side -->
    {image && (
      <div class="card-image">
        <Image 
          src={image}
          alt={title}
          class="service-image"
          loading="lazy"
          width={500}
          height={400}
        />
        <div class="card-overlay"></div>
      </div>
    )}

    <!-- Content on RIGHT side -->
    <div class="card-content">
      <h3 class="card-title"><a href={url} style="text-decoration: underline;">{title} ↗</a></h3>
      <p class="card-description">{description}</p>
      
      <ul class="card-features">
        {features.map((feature, index) => (
          <li class="feature-item" data-astro-animate="fadeInRight" data-astro-delay={200 + (index * 100)}>
            <span class="feature-icon">✓</span>
            {feature}
          </li>
        ))}
      </ul>
      
      <a href={'/contact/'} class="cta-button magnetic">
        <span>{ctaText}</span>
        <svg class="arrow-icon" viewBox="0 0 24 24" fill="none">
          <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</div>
