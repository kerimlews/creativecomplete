---
import { Image } from 'astro:assets';
import { getServiceIcon } from '../utils/serviceIcons';

export interface Props {
  title: string;
  description: string;
  image?: any; // Should be ImageMetadata but using any for now - optional
  features: string[];
  ctaText?: string;
  delay?: number;
  url?: string;
  slug?: string;
  category?: string;
  index?: number;
}

const { title, description, image, features, url, ctaText = "Learn More", delay = 0, slug = '', category = '', index = 0 } = Astro.props;

// Get animated icon based on service type
const serviceIcon = getServiceIcon(slug || title.toLowerCase(), category, index);

---

<div class="service-card" data-service-card data-card-index={index}>
  <div class="card-glass">
    <!-- Animated Icon -->
    <div class="card-icon-wrapper">
      <div class="card-icon" set:html={serviceIcon}></div>
    </div>

    <!-- Content -->
    <div class="card-content">
      <h3 class="card-title"><a href={url} style="color: #FFFFFF !important; -webkit-text-fill-color: unset !important; opacity: 1 !important; visibility: visible !important; text-decoration: none !important; text-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 0 2px 4px rgba(255, 255, 255, 0.5) !important;">{title} ↗</a></h3>
      <p class="card-description">{description}</p>
    </div>
  </div>
</div>

<script>
  // Scroll animation for service cards
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('[data-service-card]');
    
    const observerOptions = {
      threshold: 0.15,
      rootMargin: '0px 0px -50px 0px'
    };

    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry, idx) => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          const cardIndex = parseInt(card.getAttribute('data-card-index') || '0');
          
          setTimeout(() => {
            card.classList.add('card-visible');
            
            // Animate icon
            const icon = card.querySelector('.card-icon');
            if (icon) {
              icon.classList.add('icon-animate');
            }
          }, cardIndex * 100);
          
          cardObserver.unobserve(card);
        }
      });
    }, observerOptions);

    cards.forEach((card) => {
      cardObserver.observe(card);
    });
  });
</script>
