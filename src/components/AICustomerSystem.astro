    { q: 'Koliko brzo možemo očekivati rezultate?', a: 'Većina agencija vidi prve AI-kvalificirane leade unutar 10 dana. Potpuni sustav zahtijeva 3–4 tjedna. Broadcast kampanje za postojeće leade tipično generiraju ROI unutar prvog mjeseca.' },
    { q: 'Koje kanale podržava?', a: 'AI sustav za kupce povezuje 40+ kanala: WhatsApp Business API, Instagram DM, TikTok, Facebook Messenger, e-pošta, SMS, web chat, Telegram, Viber i više.' },
    { q: 'Kakav ROI agencije mogu očekivati?', a: 'WhatsApp broadcast kampanje prosječno postižu 42,5× ROI. AI kreative donose 14× više konverzija. AI kvalifikacija postiže 81% stopu konverzije leadova.' },
    { q: 'Možemo li ovo white-labelirati za naše klijente?', a: 'Da. Konfiguriramo i upravljamo cjelokupnom infrastrukturom AI sustava za kupce pod vašim brendom. Upitajte o agencijskom partnerskom programu.' },
    { q: 'Kako se integrira s postojećim CRM-om?', a: 'AI sustav za kupce integrira se nativno s HubSpot, Salesforce, Pipedrive i 50+ CRM-ova putem Respond.io integracija i Zapier.' },
  ],
  fr: [
    { q: 'Qu\'est-ce qu\'un Système client IA ?', a: 'Système client IA est un moteur de qualification et de conversion de leads entièrement géré, combinant Respond.io et AdCreative.ai. Il qualifie automatiquement, convertit et génère des profits depuis votre base de leads existante.' },
    { q: 'Combien de temps pour voir des résultats ?', a: 'La plupart des agences voient leurs premiers leads qualifiés par IA en 10 jours. La construction complète du système prend 3 à 4 semaines. Les campagnes broadcast génèrent généralement un ROI dès le premier mois.' },
    { q: 'Quels canaux sont pris en charge ?', a: 'Système client IA se connecte à 40+ canaux : WhatsApp Business API, Instagram DM, TikTok, Facebook Messenger, email, SMS, chat web, Telegram, Viber et plus.' },
    { q: 'Quel ROI les agences peuvent-elles attendre ?', a: 'Les campagnes broadcast WhatsApp affichent en moyenne 42,5× de ROI. Les créatifs générés par IA livrent 14× plus de conversions. La qualification IA atteint 81% de taux de conversion des leads.' },
    { q: 'Peut-on white-labéliser pour nos clients ?', a: 'Oui. Nous configurons et gérons toute l\'infrastructure du Système client IA sous votre marque. Renseignez-vous sur notre programme partenaire agence.' },
    { q: 'Comment s\'intègre-t-il avec notre CRM existant ?', a: 'Système client IA s\'intègre nativement avec HubSpot, Salesforce, Pipedrive et 50+ CRMs via les intégrations Respond.io et Zapier.' },
  ],
}[lang] ?? faqItems['en'];
---

<section class="aic-wrap">

  <!-- Hero -->
  <div class="aic-hero">
    <span class="aic-eyebrow">🏆 {t.eyebrow}</span>
    <h1 class="aic-h1">
      {t.h1_1}<br/>
      <em class="aic-accent">{t.h1_2}</em><br/>
      {t.h1_3}
    </h1>
    <p class="aic-lead">{t.lead}</p>
    <div class="aic-actions">
      <a href="#book" class="aic-btn aic-btn--primary">{t.cta_primary} →</a>
      <a href="#process" class="aic-btn aic-btn--ghost">{t.cta_secondary}</a>
    </div>
    <p class="aic-proof"><strong>{t.proof}</strong> — {t.proof_sub}</p>
  </div>

  <!-- Stats -->
  <div class="aic-stats" id="stats">
    {stats.map(s => (
      <div class="aic-stat">
        <div class="aic-stat__num">{s.n}</div>
        <div class="aic-stat__label">{s.l}</div>
        <div class="aic-stat__caption">{s.c}</div>
      </div>
    ))}
  </div>

  <!-- Services -->
  <div class="aic-services" id="engines">
    <div class="aic-section-head">
      <span class="aic-eyebrow">{t.services_eyebrow}</span>
      <h2 class="aic-h2">
        {t.services_h2_1} <em class="aic-accent">{t.services_h2_2}</em>
      </h2>
    </div>
    <div class="aic-services__grid">
      {services.map(s => (
        <div class="aic-service-card">
          <span class="aic-service-card__icon">{s.icon}</span>
          <span class="aic-service-card__tag">{s.tag}</span>
          <h3 class="aic-service-card__title">{s.title}</h3>
          <p class="aic-service-card__body">{s.body}</p>
          <ul class="aic-service-card__bullets">
            {s.bullets.map(b => <li>{b}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- FAQ -->
  <div class="aic-faq" id="faq">
    <div class="aic-section-head">
      <span class="aic-eyebrow">{t.faq_eyebrow}</span>
      <h2 class="aic-h2">{t.faq_h2}</h2>
    </div>
    <div class="aic-faq__list">
      {faqItems.map((item, i) => (
        <details class="aic-faq__item">
          <summary class="aic-faq__q">
            <span class="aic-faq__num">{String(i + 1).padStart(2, '0')}</span>
            {item.q}
          </summary>
          <div class="aic-faq__a">{item.a}</div>
        </details>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <div class="aic-cta" id="book">
    <span class="aic-eyebrow">{t.cta_eyebrow}</span>
    <h2 class="aic-h2">
      {t.cta_h2_1} <em class="aic-accent">{t.cta_h2_2}</em>
    </h2>
    <p class="aic-lead">{t.cta_lead}</p>
    <a href="/contact/" class="aic-btn aic-btn--primary">{t.book} →</a>
  </div>

</section>

<style lang="scss">
  @import '../styles/utils/variables';
  @import '../styles/utils/mixins';

  .aic-wrap {
    font-family: var(--font-sans, 'Inter', sans-serif);
    color: var(--fg-0, #f6f1ea);
    container-type: inline-size;
  }

  /* Shared */
  .aic-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; font-family: var(--font-mono, monospace);
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--fg-2, #8a847b);
  }
  .aic-accent { font-style: italic; color: var(--brand-primary, #ff8c42); }
  .aic-h1 {
    font-family: var(--font-display, serif);
    font-size: clamp(40px, 6vw, 88px);
    line-height: 1; letter-spacing: -0.02em; font-weight: 400; margin: 16px 0;
  }
  .aic-h2 {
    font-family: var(--font-display, serif);
    font-size: clamp(32px, 4vw, 60px);
    line-height: 1.05; letter-spacing: -0.02em; font-weight: 400; margin: 16px 0;
  }
  .aic-lead {
    font-size: clamp(15px, 1.2vw, 18px);
    color: var(--fg-1, #c9c2b8); line-height: 1.6; max-width: 60ch;
  }

  /* Buttons */
  .aic-btn {
    display: inline-flex; align-items: center; gap: 8px;
    height: 48px; padding: 0 22px; border-radius: 999px;
    font-size: 15px; font-weight: 500; text-decoration: none;
    transition: transform .15s, background .15s;
  }
  .aic-btn--primary {
    background: var(--brand-primary, #ff8c42); color: #1a0d04;
    box-shadow: 0 10px 24px rgba(255,140,66,0.35);
    &:hover { transform: translateY(-1px); }
  }
  .aic-btn--ghost {
    background: rgba(255,255,255,0.04); color: var(--fg-0, #f6f1ea);
    border: 1px solid var(--line, #2a2725);
    &:hover { background: rgba(255,255,255,0.08); }
  }

  /* Hero */
  .aic-hero {
    padding: 80px 0 64px; text-align: center;
  }
  .aic-actions {
    display: flex; gap: 12px; justify-content: center;
    margin-top: 32px; flex-wrap: wrap;
  }
  .aic-proof {
    margin-top: 28px; font-size: 14px; color: var(--fg-2, #8a847b);
  }

  /* Stats */
  .aic-stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line, #2a2725);
    border-radius: 14px; overflow: hidden;
    background: var(--line, #2a2725); gap: 1px;
    margin-bottom: 96px;
  }
  .aic-stat {
    background: var(--bg-1, #111110); padding: 36px 28px; text-align: center;
  }
  .aic-stat__num {
    font-family: var(--font-display, serif);
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1; color: var(--brand-primary, #ff8c42);
  }
  .aic-stat__label { font-weight: 600; margin-top: 10px; font-size: 14px; }
  .aic-stat__caption { font-size: 12px; color: var(--fg-2, #8a847b); margin-top: 4px; }

  /* Section head */
  .aic-section-head {
    text-align: center; margin-bottom: 56px;
    display: flex; flex-direction: column; align-items: center; gap: 0;
  }

  /* Services */
  .aic-services { margin-bottom: 96px; }
  .aic-services__grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
  }
  .aic-service-card {
    background: linear-gradient(180deg, var(--bg-2, #1a1816), var(--bg-1, #111110));
    border: 1px solid var(--line, #2a2725);
    border-radius: 14px; padding: 32px;
  }
  .aic-service-card__icon { font-size: 28px; display: block; margin-bottom: 8px; }
  .aic-service-card__tag {
    font-family: var(--font-mono, monospace); font-size: 11px;
    color: var(--fg-3, #5a544c); letter-spacing: 0.1em;
  }
  .aic-service-card__title {
    font-family: var(--font-display, serif);
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 400; margin: 8px 0 12px;
  }
  .aic-service-card__body {
    font-size: 14px; color: var(--fg-1, #c9c2b8); line-height: 1.6; margin-bottom: 16px;
  }
  .aic-service-card__bullets {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 8px;
    li {
      font-size: 13px; color: var(--fg-1, #c9c2b8);
      padding-left: 16px; position: relative;
      &::before {
        content: ''; position: absolute; left: 0; top: 7px;
        width: 5px; height: 5px; border-radius: 50%;
        background: var(--brand-primary, #ff8c42);
      }
    }
  }

  /* FAQ */
  .aic-faq { margin-bottom: 96px; }
  .aic-faq__list { max-width: 760px; margin: 0 auto; }
  .aic-faq__item {
    border-bottom: 1px solid var(--line, #2a2725);
    &:first-child { border-top: 1px solid var(--line, #2a2725); }
  }
  .aic-faq__q {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 20px 0; cursor: pointer; list-style: none;
    font-weight: 500; font-size: 15px; color: var(--fg-0, #f6f1ea);
    &::-webkit-details-marker { display: none; }
    &:hover { color: var(--brand-primary, #ff8c42); }
  }
  .aic-faq__num {
    font-family: var(--font-mono, monospace); font-size: 11px;
    color: var(--fg-3, #5a544c); flex-shrink: 0; padding-top: 3px;
    letter-spacing: 0.1em;
  }
  .aic-faq__a {
    padding: 0 0 20px 36px;
    font-size: 14px; color: var(--fg-1, #c9c2b8); line-height: 1.65;
  }

  /* CTA */
  .aic-cta {
    background: linear-gradient(180deg, var(--bg-2, #1a1816), var(--bg-1, #111110));
    border: 1px solid var(--line, #2a2725);
    border-radius: 28px; padding: 64px 72px;
    text-align: center; margin-bottom: 64px;
    position: relative; overflow: hidden;
    &::before {
      content: ''; position: absolute;
      top: -120px; left: 50%; transform: translateX(-50%);
      width: 600px; height: 300px;
      background: radial-gradient(ellipse at center top, rgba(255,140,66,0.22) 0%, transparent 65%);
      filter: blur(40px); pointer-events: none;
    }
    .aic-eyebrow, .aic-h2, .aic-lead, .aic-btn { position: relative; z-index: 1; }
    .aic-lead { margin: 16px auto 32px; }
  }

  /* Responsive */
  @container (max-width: 960px) {
    .aic-stats { grid-template-columns: repeat(2, 1fr); }
    .aic-services__grid { grid-template-columns: 1fr; }
    .aic-cta { padding: 48px 32px; }
  }
  @container (max-width: 600px) {
    .aic-stats { grid-template-columns: 1fr 1fr; }
    .aic-cta { padding: 36px 20px; border-radius: 16px; }
  }
</style>
