{validImages.length === 0 && !fallbackImage ? (
    <div class="service-image-placeholder">
        <div class="animated-graphics">
            <div class="graphic-circle graphic-1"></div>
            <div class="graphic-circle graphic-2"></div>
            <div class="graphic-circle graphic-3"></div>
            <div class="graphic-line graphic-line-1"></div>
            <div class="graphic-line graphic-line-2"></div>
            <div class="graphic-line graphic-line-3"></div>
            <div class="graphic-dot graphic-dot-1"></div>
            <div class="graphic-dot graphic-dot-2"></div>
            <div class="graphic-dot graphic-dot-3"></div>
            <div class="graphic-dot graphic-dot-4"></div>
        </div>
    </div>
) : validImages.length === 0 && fallbackImage && fallbackImage.src ? (
    <div class="service-image">
        <Image 
            src={fallbackImage.src} 
            alt={fallbackImage.alt}
            width={600}
            height={500}
            loading="eager"
        />
    </div>
) : hasMultipleImages ? (
    <div class="stacked-images">
    {displayImages.map((img: any, index: number) => (
        <div class="stacked-item" data-index={index}>
        <Image 
            src={img.src} 
            alt={`${img.alt} - Image ${index + 1}`}
            width={600}
            height={400}
            loading={index === 0 ? "eager" : "lazy"}
        />
        </div>
    ))}
    {validImages.length > 3 && (
        <div class="image-counter">
        +{validImages.length - 3} more
        </div>
    )}
    </div>
) : validImages.length === 1 ? (
    <div class="service-image">
    <Image 
        src={validImages[0].src} 
        alt={validImages[0].alt}
        width={600}
        height={500}
        loading="eager"
    />
    </div>
) : (
    <div class="service-image">
    <div>No images available</div>
    </div>
)}
