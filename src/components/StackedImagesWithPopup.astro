---
import { Image } from "astro:assets";

const { images, service } = Astro.props;

// Filter out any invalid images
const validImages = (images || []).filter((img: any) => 
  img && 
  img.src && 
  typeof img.src === 'object' &&
  img.alt
);

const hasMultipleImages = validImages.length > 1;
const displayImages = hasMultipleImages ? validImages.slice(0, 3) : validImages;

// Try to load image from service.data.image if no images found
let fallbackImage: any = null;
if (validImages.length === 0 && service?.data?.image) {
  try {
    const imageName = service.data.image;
    const extensions = ['png', 'jpg', 'jpeg', 'webp'];
    const baseName = imageName.replace(/\.(png|jpg|jpeg|webp)$/, '');
    
    // Use import.meta.glob to find the image
    const serviceImages = import.meta.glob('/src/images/services/*.{png,jpg,jpeg,webp}', { eager: false });
    
    for (const ext of extensions) {
      const imagePath = `/src/images/services/${baseName}.${ext}`;
      if (serviceImages[imagePath]) {
        try {
          const imageModule = await serviceImages[imagePath]();
          if (imageModule && typeof imageModule === 'object') {
            // import.meta.glob for images returns { default: ImageMetadata }
            const imageMetadata = ('default' in imageModule && imageModule.default) || imageModule;
            
            // Verify it's a valid ImageMetadata object with src property
            if (imageMetadata && typeof imageMetadata === 'object' && 'src' in imageMetadata) {
              fallbackImage = {
                src: imageMetadata,
                alt: service.data.title || 'Service image'
              };
              break;
            }
          }
        } catch (e) {
          // Continue to next extension
          continue;
        }
      }
    }
  } catch (e) {
    // Image not found, will use animated graphics
    fallbackImage = null;
  }
}

