---
import { Image } from 'astro:assets';

// Import hero images for service cards
const heroImages = import.meta.glob('/src/images/hero/*.{jpg,jpeg,png}', { eager: true });
const heroImagesArray = Object.values(heroImages) as any[];

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "OUR SERVICES",
  subtitle = "What We Offer"
} = Astro.props;
---

<section class="services-section">
  <!-- Background Blur Elements -->
  <div class="services-background">
    <div class="bg-blur bg-blur-1"></div>
    <div class="bg-blur bg-blur-2"></div>
    <div class="bg-blur bg-blur-3"></div>
  </div>

  <div class="container">
    <div class="services-header">
      <p class="services-subtitle">{subtitle}</p>
      <h2 class="services-title">{title}</h2>
    </div>

    <div class="services-grid">
      <!-- Service 1: Dominate Local Search -->
      <div class="service-card" data-service="1">
        {heroImagesArray[0] && (
          <div class="service-image">
            <Image 
              src={heroImagesArray[0].default || heroImagesArray[0]} 
              alt="Local Search"
              class="service-bg-image"
              width={300}
              height={200}
              quality={80}
            />
            <div class="image-overlay"></div>
          </div>
        )}
        <div class="service-content">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
              <circle cx="12" cy="12" r="3" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="service-title">Dominate Local Search</h3>
          <p class="service-description">– Ranked #1 on Google Maps for our clients</p>
        </div>
      </div>

      <!-- Service 2: High-Converting Web Design -->
      <div class="service-card" data-service="2">
        {heroImagesArray[1] && (
          <div class="service-image">
            <Image 
              src={heroImagesArray[1].default || heroImagesArray[1]} 
              alt="Web Design"
              class="service-bg-image"
              width={300}
              height={200}
              quality={80}
            />
            <div class="image-overlay"></div>
          </div>
        )}
        <div class="service-content">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="service-title">High-Converting Web Design</h3>
          <p class="service-description">– Built for SEO, speed, and sales</p>
        </div>
      </div>

      <!-- Service 3: Professional Video Marketing -->
      <div class="service-card" data-service="3">
        {heroImagesArray[2] && (
          <div class="service-image">
            <Image 
              src={heroImagesArray[2].default || heroImagesArray[2]} 
              alt="Video Marketing"
              class="service-bg-image"
              width={300}
              height={200}
              quality={80}
            />
            <div class="image-overlay"></div>
          </div>
        )}
        <div class="service-content">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M10 4v16M2 8h6M2 12h6M2 16h6"/>
              <circle cx="16" cy="12" r="3"/>
            </svg>
          </div>
          <h3 class="service-title">Professional Video Marketing</h3>
          <p class="service-description">– Promotional videos that tell your story and drive action</p>
        </div>
      </div>

      <!-- Service 4: Efficiency Through AI -->
      <div class="service-card" data-service="4">
        {heroImagesArray[3] && (
          <div class="service-image">
            <Image 
              src={heroImagesArray[3].default || heroImagesArray[3]} 
              alt="AI Automation"
              class="service-bg-image"
              width={300}
              height={200}
              quality={80}
            />
            <div class="image-overlay"></div>
          </div>
        )}
        <div class="service-content">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="4" y="4" width="16" height="16" rx="2"/>
              <circle cx="9" cy="9" r="2"/>
              <path d="M21 15l-3.086-3.086a2 2 0 00-2.828 0L6 21"/>
            </svg>
          </div>
          <h3 class="service-title">Efficiency Through AI</h3>
          <p class="service-description">– Automate repetitive tasks and workflows</p>
        </div>
      </div>

      <!-- Service 5: Custom App Development -->
      <div class="service-card service-card-large" data-service="5">
        {heroImagesArray[4] && (
          <div class="service-image">
            <Image 
              src={heroImagesArray[4].default || heroImagesArray[4]} 
              alt="App Development"
              class="service-bg-image"
              width={400}
              height={250}
              quality={80}
            />
            <div class="image-overlay"></div>
          </div>
        )}
        <div class="service-content">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
              <line x1="12" y1="18" x2="12.01" y2="18"/>
            </svg>
          </div>
          <h3 class="service-title">Custom App Development</h3>
          <p class="service-description">– Seamless web, mobile, and desktop experiences</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 8rem 0;
    background: #1a202c;
    position: relative;
    overflow: hidden;
  }

  /* Background Blur Elements */
  .services-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 0;
  }

  .bg-blur {
    position: absolute;
    border-radius: 20px;
    filter: blur(60px);
    opacity: 0.3;
    animation: floatBackground 8s ease-in-out infinite;
  }

  .bg-blur-1 {
    width: 300px;
    height: 300px;
    background: linear-gradient(135deg, rgba(255, 112, 2, 0.4) 0%, rgba(102, 126, 234, 0.4) 100%);
    top: 10%;
    left: 5%;
    animation-delay: 0s;
  }

  .bg-blur-2 {
    width: 250px;
    height: 250px;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.4) 0%, rgba(255, 112, 2, 0.4) 100%);
    bottom: 20%;
    right: 10%;
    animation-delay: 2s;
  }

  .bg-blur-3 {
    width: 200px;
    height: 200px;
    background: linear-gradient(135deg, rgba(255, 112, 2, 0.3) 0%, rgba(66, 133, 244, 0.3) 100%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: 4s;
  }

  @keyframes floatBackground {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(20px, -20px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .services-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .services-subtitle {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
    background: linear-gradient(138deg, #ffc2ae 0%, #ff7002 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .services-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
    font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    text-shadow: 0 2px 20px rgba(255, 112, 2, 0.3);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: auto auto auto;
    gap: 2rem;
    position: relative;
  }

  .service-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.6s ease forwards;
    min-height: 280px;
  }

  .service-image {
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 150px;
    overflow: hidden;
    border-radius: 0 24px 0 0;
    z-index: 0;
  }

  .service-card-large .service-image {
    width: 300px;
    height: 200px;
  }

  .service-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(2px);
    transform: scale(1.1);
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 112, 2, 0.3) 0%, rgba(66, 133, 244, 0.3) 100%);
    z-index: 1;
  }

  .service-card:hover .service-bg-image {
    transform: scale(1.2);
    filter: blur(1px);
  }

  .service-content {
    position: relative;
    z-index: 2;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: linear-gradient(180deg, rgba(26, 32, 44, 0.95) 0%, rgba(26, 32, 44, 0.8) 50%, rgba(26, 32, 44, 0.95) 100%);
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 112, 2, 0.05) 0%, rgba(66, 133, 244, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    border-radius: 24px;
    pointer-events: none;
    z-index: 1;
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 112, 2, 0.3);
    box-shadow: 0 12px 40px rgba(255, 112, 2, 0.2);
  }

  .service-card[data-service="1"] {
    animation-delay: 0.1s;
  }

  .service-card[data-service="2"] {
    animation-delay: 0.2s;
  }

  .service-card[data-service="3"] {
    animation-delay: 0.3s;
  }

  .service-card[data-service="4"] {
    animation-delay: 0.4s;
  }

  .service-card[data-service="5"] {
    animation-delay: 0.5s;
  }

  .service-card-large {
    grid-column: 1 / -1;
    justify-self: center;
    max-width: 600px;
  }

  .service-icon {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    flex-shrink: 0;
    position: relative;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover .service-icon {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 12px 32px rgba(255, 112, 2, 0.4);
  }

  .service-card[data-service="1"] .service-icon {
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    color: #ffffff;
  }

  .service-card[data-service="2"] .service-icon {
    background: linear-gradient(135deg, #C0C0C0 0%, #808080 100%);
    color: #ffffff;
  }

  .service-card[data-service="3"] .service-icon {
    background: linear-gradient(135deg, #4A4A4A 0%, #2A2A2A 100%);
    color: #ffffff;
  }

  .service-card[data-service="4"] .service-icon {
    background: linear-gradient(135deg, #FF7002 0%, #FFA500 100%);
    color: #ffffff;
  }

  .service-card[data-service="5"] .service-icon {
    background: linear-gradient(135deg, #4A4A4A 0%, #2A2A2A 100%);
    color: #ffffff;
  }

  .service-icon svg {
    width: 36px;
    height: 36px;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  .service-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
    font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    position: relative;
    padding-bottom: 0.75rem;
  }

  .service-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #ff7002 0%, #ffc2ae 100%);
    border-radius: 2px;
  }

  .service-description {
    font-size: 1rem;
    color: #ffffff;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
    opacity: 0.9;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .service-card-large {
      grid-column: 1;
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .services-section {
      padding: 5rem 0;
    }

    .container {
      padding: 0 1rem;
    }

    .services-header {
      margin-bottom: 3rem;
    }

    .service-card {
      min-height: 240px;
    }

    .service-content {
      padding: 2rem;
    }

    .service-image {
      width: 150px;
      height: 120px;
    }

    .service-card-large .service-image {
      width: 200px;
      height: 150px;
    }

    .service-icon {
      width: 56px;
      height: 56px;
    }

    .service-icon svg {
      width: 28px;
      height: 28px;
    }
  }
</style>

<script>
  // Intersection Observer for scroll animations
  document.addEventListener('DOMContentLoaded', () => {
    const serviceCards = document.querySelectorAll('.service-card');
    
    const observerOptions = {
      threshold: 0.2,
      rootMargin: '0px'
    };

    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.style.animationPlayState = 'running';
        }
      });
    }, observerOptions);

    serviceCards.forEach((card) => {
      cardObserver.observe(card);
    });
  });
</script>
