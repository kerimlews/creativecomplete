---
import { getLanguageFromUrl, t } from '../utils/translations';
import { getCollection } from 'astro:content';
import { getServiceUrl } from '../utils/routing';
import type { Language } from '../utils/translations';
import ServiceCard from './ServiceCard.astro';
import { capitalize } from '../utils/helpers';

const currentLang: Language = getLanguageFromUrl(Astro.url);

// Get all services from content collection
const langServices = await getCollection(`services${capitalize(currentLang)}`);

// Load service images
const images = await import.meta.glob('/src/images/services/*.{png,jpg,jpeg,webp}');

async function getImage(slug: string) {
  if (!slug) return null;
  const extensions = ['png', 'jpg', 'jpeg', 'webp'];
  const baseName = slug.replace(/\.(png|jpg|jpeg|webp)$/, '');
  
  for (const ext of extensions) {
    const imagePath = `/src/images/services/${baseName}.${ext}`;
    if (images[imagePath]) {
      try {
        const imageModule = await images[imagePath]();
        return imageModule;
      } catch (e) {
        continue;
      }
    }
  }
  return null;
}

const services = await Promise.all(langServices.map(async s => {
  const serviceName = s.id.split('/').pop() || s.id;
  const imageSlug = s.data.image || serviceName;
  const image = await getImage(imageSlug);
  return { ...s, image };
}));

// Sort services by priority
const sortedServices = services.toSorted((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return (b.data.priority || 5) - (a.data.priority || 5);
});

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = t('services.simple.title', currentLang),
  subtitle = t('services.simple.subtitle', currentLang)
} = Astro.props;
---

<section class="services-section">
  <!-- Background Blur Elements -->
  <div class="services-background">
    <div class="bg-blur bg-blur-1"></div>
    <div class="bg-blur bg-blur-2"></div>
    <div class="bg-blur bg-blur-3"></div>
  </div>

  <div class="container">
    <div class="services-header">
      <p class="services-subtitle">{subtitle}</p>
      <h2 class="services-title">{title}</h2>
    </div>

    <div class="services-grid">
      {sortedServices.map((service, index) => {
        const serviceSlug = service.data.slug || service.id.split('/').pop() || service.id;
        const hasValidImage = service.image && 
                              typeof service.image === 'object' && 
                              service.image !== null &&
                              ('src' in service.image || 'default' in service.image);
        
        const cardProps: any = {
          title: service.data.title,
          description: service.data.description,
          features: service.data.features || [],
          ctaText: service.data.ctaText || 'Learn More',
          delay: service.data.delay || (index * 100),
          url: getServiceUrl(currentLang, serviceSlug)
        };
        
        if (hasValidImage) {
          cardProps.image = service.image;
        }
        
        return (
          <ServiceCard {...cardProps} />
        );
      })}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 8rem 0;
    background: transparent;
    position: relative;
    overflow: hidden;
  }

  /* Background Blur Elements */
  .services-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 0;
  }

  .bg-blur {
    display: none;
  }

  .bg-blur-1 {
    display: none;
  }

  .bg-blur-2 {
    display: none;
  }

  .bg-blur-3 {
    display: none;
  }

  @keyframes floatBackground {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(20px, -20px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .services-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .services-subtitle {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
    background: linear-gradient(138deg, #ffc2ae 0%, #ff7002 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .services-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
    font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    text-shadow: 0 2px 20px rgba(255, 112, 2, 0.3);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    position: relative;
  }
  
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(30px);
    min-height: 280px;
  }
  
  .service-card.visible {
    animation: fadeInUp 0.6s ease forwards;
  }

  .service-image {
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 150px;
    overflow: hidden;
    border-radius: 0 24px 0 0;
    z-index: 0;
  }

  .service-card-large .service-image {
    width: 300px;
    height: 200px;
  }

  .service-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(2px);
    transform: scale(1.1);
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 112, 2, 0.3) 0%, rgba(66, 133, 244, 0.3) 100%);
    z-index: 1;
  }

  .service-card:hover .service-bg-image {
    transform: scale(1.2);
    filter: blur(1px);
  }

  .service-content {
    position: relative;
    z-index: 2;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: linear-gradient(180deg, rgba(26, 32, 44, 0.95) 0%, rgba(26, 32, 44, 0.8) 50%, rgba(26, 32, 44, 0.95) 100%);
    width: 100%;
    height: 100%;
    min-height: 100%;
    flex: 1;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 112, 2, 0.05) 0%, rgba(66, 133, 244, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    border-radius: 24px;
    pointer-events: none;
    z-index: 1;
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 112, 2, 0.3);
    box-shadow: 0 12px 40px rgba(255, 112, 2, 0.2);
  }


  .service-icon {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    flex-shrink: 0;
    position: relative;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover .service-icon {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 12px 32px rgba(255, 112, 2, 0.4);
  }

  .service-icon {
    background: linear-gradient(135deg, #FF7002 0%, #FFA500 100%);
    color: #ffffff;
  }

  .service-icon svg {
    width: 36px;
    height: 36px;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  .service-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
    font-family: 'Poppins', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    position: relative;
    padding-bottom: 0.75rem;
  }

  .service-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #ff7002 0%, #ffc2ae 100%);
    border-radius: 2px;
  }

  .service-description {
    font-size: 1rem;
    color: #ffffff;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
    opacity: 0.9;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .service-card-large {
      grid-column: 1;
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .services-section {
      padding: 5rem 0;
    }

    .container {
      padding: 0 1rem;
    }

    .services-header {
      margin-bottom: 3rem;
    }

    .service-card {
      min-height: 240px;
      width: 100%;
      max-width: 100%;
    }

    .service-content {
      padding: 2rem;
      width: 100% !important;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      box-sizing: border-box;
    }

    .service-image {
      width: 150px;
      height: 120px;
    }

    .service-card-large .service-image {
      width: 200px;
      height: 150px;
    }

    .service-icon {
      width: 56px;
      height: 56px;
    }

    .service-icon svg {
      width: 28px;
      height: 28px;
    }
  }
</style>

<script>
  // Intersection Observer for scroll animations
  document.addEventListener('DOMContentLoaded', () => {
    const serviceCards = document.querySelectorAll('.service-card');
    
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting && entry.target instanceof HTMLElement) {
          setTimeout(() => {
            entry.target.classList.add('visible');
          }, index * 100);
          cardObserver.unobserve(entry.target);
        }
      });
    }, observerOptions);

    serviceCards.forEach((card) => {
      cardObserver.observe(card);
    });
  });
</script>
