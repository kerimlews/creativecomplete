<div id="consent-manager" class="cm">
  <!-- Main banner -->
  <div id="cm-modal" class="cm-modal" aria-modal="true" role="dialog" aria-label="Cookie consent">
    <div class="cm-header">
      <h3 class="cm-title">Your Privacy Matters</h3>
      <p class="cm-desc">We use cookies to analyse traffic and improve your experience. Choose your preferences below.</p>
    </div>

    <div class="cm-features">
      <span>Analyse website traffic</span>
      <span>Personalise your experience</span>
      <span>Improve our services</span>
    </div>

    <div class="cm-actions">
      <button id="cm-accept" class="cm-btn cm-btn--primary">Accept All</button>
      <button id="cm-customize" class="cm-btn cm-btn--ghost">Customize</button>
    </div>

    <div class="cm-footer">
      <a href="/privacy-policy/">Privacy Policy</a>
    </div>
  </div>

  <!-- Customization panel -->
  <div id="cm-custom" class="cm-modal cm-custom" aria-modal="true" role="dialog" aria-label="Cookie preferences" hidden>
    <h3 class="cm-title">Cookie Preferences</h3>
    <p class="cm-desc" style="margin-bottom:16px">Manage your preferences for each cookie category.</p>

    <div class="cm-options">
      <div class="cm-option">
        <div class="cm-option__info">
          <strong>Essential Cookies</strong>
          <span>Required for the website to function. Cannot be disabled.</span>
        </div>
        <label class="cm-toggle cm-toggle--disabled" aria-label="Essential cookies always on">
          <input type="checkbox" checked disabled />
          <span class="cm-track"><span class="cm-thumb"></span></span>
        </label>
      </div>

      <div class="cm-option">
        <div class="cm-option__info">
          <strong>Analytics Cookies</strong>
          <span>Help us understand how visitors use our site via Google Analytics.</span>
        </div>
        <label class="cm-toggle" aria-label="Toggle analytics cookies">
          <input type="checkbox" id="cm-analytics" checked />
          <span class="cm-track"><span class="cm-thumb"></span></span>
        </label>
      </div>

      <div class="cm-option">
        <div class="cm-option__info">
          <strong>Marketing Cookies</strong>
          <span>Used to track visitors for advertising purposes.</span>
        </div>
        <label class="cm-toggle" aria-label="Toggle marketing cookies">
          <input type="checkbox" id="cm-marketing" />
          <span class="cm-track"><span class="cm-thumb"></span></span>
        </label>
      </div>
    </div>

    <div class="cm-actions">
      <button id="cm-save" class="cm-btn cm-btn--primary">Save Preferences</button>
      <button id="cm-back" class="cm-btn cm-btn--ghost">Back</button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  const KEY = 'cc-consent-v1';

  function getSaved() {
    try { return JSON.parse(localStorage.getItem(KEY)); } catch { return null; }
  }
  function save(c) {
    try { localStorage.setItem(KEY, JSON.stringify(c)); } catch {}
  }
  function applyConsent(c) {
    if (typeof gtag === 'function') {
      gtag('consent', 'update', {
        analytics_storage: c.analytics ? 'granted' : 'denied',
        ad_storage: c.marketing ? 'granted' : 'denied',
      });
    }
    window.dispatchEvent(new CustomEvent('consentUpdated', { detail: c }));
  }

  var manager   = document.getElementById('consent-manager');
  var modal     = document.getElementById('cm-modal');
  var custom    = document.getElementById('cm-custom');
  var btnAccept = document.getElementById('cm-accept');
  var btnCustom = document.getElementById('cm-customize');
  var btnSave   = document.getElementById('cm-save');
  var btnBack   = document.getElementById('cm-back');

  function show(el)  { el.removeAttribute('hidden'); el.classList.add('cm-modal--in'); }
  function hide(el)  { el.classList.remove('cm-modal--in'); setTimeout(function(){ el.setAttribute('hidden', ''); }, 350); }
  function dismiss() { manager.setAttribute('hidden', ''); }

  // Already consented?
  var saved = getSaved();
  if (saved) {
    applyConsent(saved);
    manager.setAttribute('hidden', '');
  } else {
    setTimeout(function () { show(modal); }, 800);
  }

  btnAccept.addEventListener('click', function () {
    var c = { essential: true, analytics: true, marketing: true, ts: Date.now() };
    save(c); applyConsent(c); dismiss();
  });

  btnCustom.addEventListener('click', function () {
    hide(modal);
    setTimeout(function () { show(custom); }, 360);
  });

  btnSave.addEventListener('click', function () {
    var c = {
      essential: true,
      analytics: document.getElementById('cm-analytics').checked,
      marketing: document.getElementById('cm-marketing').checked,
      ts: Date.now(),
    };
    save(c); applyConsent(c); dismiss();
  });

  btnBack.addEventListener('click', function () {
    hide(custom);
    setTimeout(function () { show(modal); }, 360);
  });
})();
</script>

