---
import { Image } from 'astro:assets';
import hero from '../images/hero.png';

export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  youtubeShortsUrl?: string;
  shortsTitle?: string;
  shortsDescription?: string;
  heroImage?: string;
}
const { 
  title, 
  subtitle, 
  ctaText = "Start Your Project", 
  ctaHref = "/contact",
  secondaryCtaText = "View Our Work",
  secondaryCtaHref = "/projects",
  youtubeShortsUrl = "https://www.youtube.com/embed/D9PuWCs_Pa4",
  shortsTitle = "A Steady Presence",
  shortsDescription = "I'm here for you, even if you can't quite explain why",
  heroImage = "https://cdn.shopify.com/s/files/1/1025/3059/products/CLASSIC_BLACK_SUIT__076_7174a5be-76fa-4a1e-9599-7267edfd2cf8_1440x2000_crop_center.jpg?v=1746640257"
} = Astro.props;
---

<section class="hero-section">
  <!-- Animated Background Elements -->
  <div class="hero-background">
    <div class="floating-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
      <div class="shape shape-4"></div>
      <div class="shape shape-5"></div>
    </div>
    <div class="gradient-overlay"></div>
  </div>

  <div class="container">
    <div class="hero-content">
      <!-- Main Content -->
      <div class="hero-text">
        <h1 class="hero-title" data-astro-animate="fadeInUp" data-astro-delay="200">
          <span class="title-line line-1">{title.split(' ').slice(0, 4).join(' ')}</span>
          <span class="title-line line-2">{title.split(' ').slice(4).join(' ')}</span>
        </h1>

        <p class="hero-subtitle" data-astro-animate="fadeInUp" data-astro-delay="400">
          {subtitle}
        </p>

        <!-- Stats Bar -->
        <div class="hero-stats" data-astro-animate="fadeInUp" data-astro-delay="600">
          <div class="stat-item">
            <div class="stat-number" id="yearsStat">0+</div>
            <div class="stat-label">Years Experience</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" id="projectsStat">0+</div>
            <div class="stat-label">Projects Delivered</div>
          </div>
          <div class="stat-item">
            <div class="stat-number" id="satisfactionStat">0%</div>
            <div class="stat-label">Client Satisfaction</div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="hero-actions" data-astro-animate="fadeInUp" data-astro-delay="800">
          <a href={ctaHref} class="cta-button primary magnetic">
            <span class="button-text">{ctaText}</span>
            <div class="button-gradient"></div>
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          
          <a href={secondaryCtaHref} class="cta-button secondary magnetic">
            <span class="button-text">{secondaryCtaText}</span>
            <div class="play-icon">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M8 5V19L19 12L8 5Z" fill="currentColor"/>
              </svg>
            </div>
          </a>
        </div>

        <!-- YouTube Shorts Section -->
        <div class="youtube-shorts" data-astro-animate="fadeInUp" data-astro-delay="1000">
          <div class="shorts-label">
            <svg class="youtube-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            Latest Case Study
          </div>

          <div class="shorts-container">
            <div class="shorts-thumbnail" id="shortsThumbnail">
              <div class="thumbnail-image">
                <!-- Replace with actual thumbnail or keep gradient -->
                <div style="width:100%;height:100%;background:linear-gradient(135deg,#FF6B35,#FF8C42);display:flex;align-items:center;justify-content:center;color:white;font-size:0.8rem;">
                  YouTube Shorts Preview
                </div>
              </div>
              <div class="play-overlay">
                <div class="play-icon">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            </div>

            <div class="shorts-info">
              <h4 class="shorts-title">{shortsTitle}</h4>
              <p class="shorts-description">{shortsDescription}</p>
              <a href="#" class="watch-shorts-btn magnetic" id="watchShortsBtn">
                <svg class="youtube-icon-small" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                Watch Short
              </a>
            </div>
          </div>

          <!-- YouTube Popup -->
          <div class="youtube-popup" id="youtubePopup">
            <div class="popup-header">
              <h4 class="popup-title">Watch Case Study</h4>
              <button class="close-popup" id="closePopup">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                </svg>
              </button>
            </div>
            <div class="popup-content">
              <div class="youtube-embed">
                <iframe 
                  src={youtubeShortsUrl}
                  title="YouTube Shorts Case Study"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen>
                </iframe>
              </div>
            </div>
          </div>
        </div>
      </div>

     <!-- Hero Visual - Full Height Image with Social Media Elements -->
      <div class="hero-visual" data-astro-animate="fadeInLeft" data-astro-delay="1000">
        <div class="visual-container">
          <Image 
            src={hero} 
            alt="Kerim Alihodza - CEO / Digital Growth Services"
            class="hero-image"
            loading="eager"
            width={1200}
            fetchpriority="high"
            height={800}
            sizes="(max-width: 375px) 300px, (max-width: 768px) 500px, (max-width: 1024px) 800px, 1200px"
            />
          <div class="image-overlay"></div>
          <div class="floating-elements">
            <!-- LinkedIn -->
            <a href="https://linkedin.com/in/kerim-alihodza-a765aa145" target="_blank" class="social-card linkedin" data-tooltip="LinkedIn">
              <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>

            <!-- Twitter -->
            <a href="https://twitter.com/KAlihodza82975" target="_blank" class="social-card twitter" data-tooltip="Twitter">
              <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.213c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>

            <!-- WhatsApp -->
            <a href="https://wa.me/387603456771" target="_blank" class="social-card whatsapp" data-tooltip="WhatsApp">
              <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893-.001-3.189-1.262-6.209-3.553-8.485"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>


    <!-- Scroll Indicator -->
    <div class="scroll-indicator" data-astro-animate="fadeInUp" data-astro-delay="1200">
      <div class="scroll-text">Discover More</div>
      <div class="scroll-arrow">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 5V19M12 19L5 12M12 19L19 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Popup Overlay -->
  <div class="youtube-popup-overlay" id="popupOverlay"></div>
</section>

<script>
  // Counting Animation Function
  function animateValue(element, start, end, duration, suffix = '') {
    let startTimestamp = null;
    const step = (timestamp) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      // Use easing function for more natural animation
      const easedProgress = 1 - Math.pow(1 - progress, 3); // Cubic ease out
      const value = Math.floor(easedProgress * (end - start) + start);
      element.textContent = value + suffix;
      if (progress < 1) {
        window.requestAnimationFrame(step);
      }
    };
    window.requestAnimationFrame(step);
  }

  // Start counting animations when stats are in view
  function startStatsAnimation() {
    animateValue(document.getElementById('yearsStat'), 0, 10, 2000, '+');
    animateValue(document.getElementById('projectsStat'), 0, 20, 2500, '+');
    animateValue(document.getElementById('satisfactionStat'), 0, 100, 1800, '%');
  }

  // Intersection Observer for stats animation
  const statsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        startStatsAnimation();
        statsObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  // Observe the stats container
  const statsContainer = document.querySelector('.hero-stats');
  if (statsContainer) {
    statsObserver.observe(statsContainer);
  }

  // YouTube Shorts Popup functionality
  const shortsThumbnail = document.getElementById('shortsThumbnail');
  const watchShortsBtn = document.getElementById('watchShortsBtn');
  const youtubePopup = document.getElementById('youtubePopup');
  const closePopup = document.getElementById('closePopup');
  const popupOverlay = null //document.getElementById('popupOverlay');

  function openPopup() {
    youtubePopup.classList.add('active');
    popupOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closePopupFunc() {
    youtubePopup.classList.remove('active');
    popupOverlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Event listeners
  if (shortsThumbnail) {
    shortsThumbnail.addEventListener('click', openPopup);
  }
  if (watchShortsBtn) {
    watchShortsBtn.addEventListener('click', (e) => {
      e.preventDefault();
      openPopup();
    });
  }
  if (closePopup) {
    closePopup.addEventListener('click', closePopupFunc);
  }
  if (popupOverlay) {
    popupOverlay.addEventListener('click', closePopupFunc);
  }

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePopupFunc();
  });

  // Magnetic button effect
  document.querySelectorAll('.magnetic').forEach(button => {
    button.addEventListener('mousemove', (e) => {
      const rect = button.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      
      const deltaX = (x - centerX) * 0.1;
      const deltaY = (y - centerY) * 0.1;
      
      button.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
    });
    
    button.addEventListener('mouseleave', () => {
      button.style.transform = 'translate(0, 0)';
    });
  });
</script>

<style>
  /* Add counting animation styles */
  .hero-stats {
    display: flex;
    gap: 2rem;
    margin: 2rem 0;
  }

  .stat-item {
    text-align: center;
    flex: 1;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #FF6B35, #FF8C42);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 0.5rem;
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-label {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }

  /* Magnetic button effect base */
  .magnetic {
    transition: transform 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .hero-stats {
      gap: 1rem;
    }
    
    .stat-number {
      font-size: 2rem;
      min-height: 2.5rem;
    }
    
    .stat-label {
      font-size: 0.8rem;
    }
  }
</style>