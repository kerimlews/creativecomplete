---
import { getLanguageFromUrl, getLocalizedUrl, translationConfig } from '../utils/translations';

const currentLang = getLanguageFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
---

<div class="language-switcher">
  {translationConfig.supportedLanguages.map(lang => {
    const isActive = lang === currentLang;
    const href = getLocalizedUrl(currentPath, lang, currentLang);

    return (
      <a
        href={href}
        class={`language-link ${isActive ? 'active' : ''}`}
        title={translationConfig.languageNames[lang]}
      >
        {lang.toUpperCase()}
      </a>
    );
  })}
</div>

<style>
.language-switcher {
  display: none;
  gap: 0.5rem;
  align-items: center;
}

.language-link {
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}

.language-link:hover {
  color: var(--text-primary);
  background-color: var(--bg-secondary);
}

.language-link.active {
  color: var(--primary-color);
  border-color: var(--primary-color);
  background-color: rgba(var(--primary-rgb), 0.1);
}
</style>