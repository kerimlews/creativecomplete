---

<span class="tech-icon-wrapper" data-tooltip={name}>
  <span class="tech-icon" set:html={iconSvg}></span>
</span>

<style>
  .tech-icon-wrapper {
    position: relative;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 30px !important;
    height: 30px !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  
  .tech-icon {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 30px !important;
    height: 30px !important;
    color: #1a1a1a !important;
    flex-shrink: 0;
    visibility: visible !important;
    opacity: 1 !important;
  }
  
  .tech-icon svg {
    width: 30px !important;
    height: 30px !important;
    display: block !important;
    color: #1a1a1a !important;
    fill: #1a1a1a !important;
    stroke: #1a1a1a !important;
    flex-shrink: 0;
    visibility: visible !important;
    opacity: 1 !important;
  }
  
  .tech-icon svg * {
    fill: #1a1a1a !important;
    stroke: #1a1a1a !important;
    color: #1a1a1a !important;
  }
  
  .tech-icon svg path,
  .tech-icon svg circle,
  .tech-icon svg ellipse,
  .tech-icon svg rect,
  .tech-icon svg line {
    fill: #1a1a1a !important;
    stroke: #1a1a1a !important;
    color: #1a1a1a !important;
  }
  
  // Override any stroke="white" or fill="white" in SVG
  .tech-icon svg path[stroke="white"],
  .tech-icon svg path[fill="white"],
  .tech-icon svg *[stroke="white"],
  .tech-icon svg *[fill="white"] {
    stroke: #1a1a1a !important;
    fill: #1a1a1a !important;
  }
  
