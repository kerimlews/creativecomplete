---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { generateBlogPostJsonLd } from '../../utils/jsonld';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  return blogs.map((blog) => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

const { blog } = Astro.props;
const { Content } = await blog.render();

// Generate structured data
const structuredData = generateBlogPostJsonLd(blog);

// Breadcrumbs for JSON-LD
const breadcrumbs = [
  { name: 'Home', url: Astro.site.href },
  { name: 'Blog', url: `${Astro.site.href}/blogs` },
  { name: blog.data.title, url: Astro.url.href }
];
---

<Layout 
  title={blog.data.title}
  description={blog.data.description}
  canonicalUrl={`/blogs/${blog.slug}`}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
  openGraph={{
    title: blog.data.title,
    description: blog.data.description,
    type: 'article'
  }}
  service={blog}
>
  <article class="blog-post">
    <header class="blog-header">
      <div class="container">
        <nav class="breadcrumb">
          <a href="/">Home</a> / <a href="/blogs/">Blog</a> / <span>{blog.data.title}</span>
        </nav>
        <h1>{blog.data.title}</h1>
        {blog.data.subtitle && <p class="subtitle">{blog.data.subtitle}</p>}
        <div class="blog-meta">
          <span class="author">By {blog.data.author}</span>
          <span class="date">{new Date(blog.data.published).toLocaleDateString()}</span>
          {blog.data.updated && <span class="updated">Updated: {new Date(blog.data.updated).toLocaleDateString()}</span>}
        </div>
        {blog.data.image && (
          <div class="featured-image">
            <img src={blog.data.image} alt={blog.data.title} />
          </div>
        )}
      </div>
    </header>

    <div class="blog-content container">
      <Content />
    </div>

    {blog.data.faq && blog.data.faq.length > 0 && (
      <section class="blog-faq">
        <div class="container">
          <h2>FAQ</h2>
          <div class="faq-list">
            {blog.data.faq.map((item, index) => (
              <div class="faq-item" key={index}>
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>

<style lang="scss">
.blog-post {
  padding: 2rem 0;
}

.blog-header {
  background: linear-gradient(135deg, #0f0f1f 0%, #1a1a2e 100%);
  color: white;
  padding: 4rem 0 2rem;
  
  .breadcrumb {
    margin-bottom: 1rem;
    font-size: 0.9rem;
    
    a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      
      &:hover {
        color: white;
      }
    }
    
    span {
      color: #FF6B35;
    }
  }
  
  h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #fff 0%, #ffb399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  .subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
  }
  
  .blog-meta {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    
    .author {
      font-weight: 600;
    }
  }
  
  .featured-image {
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    
    img {
      width: 100%;
      height: auto;
      display: block;
    }
  }
}

.blog-content {
  max-width: 800px;
  margin: 0 auto;
  padding: 4rem 2rem;
  
  :global(h2) {
    font-size: 2rem;
    margin: 3rem 0 1.5rem;
    color: #1a1a2e;
  }
  
  :global(h3) {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: #2d3748;
  }
  
  :global(p) {
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #4a5568;
  }
  
  :global(ul), :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
    
    :global(li) {
      margin-bottom: 0.5rem;
      line-height: 1.6;
    }
  }
}

.blog-faq {
  background: #f7fafc;
  padding: 4rem 0;
  
  h2 {
    text-align: center;
    margin-bottom: 3rem;
    font-size: 2.5rem;
    color: #1a1a2e;
  }
  
  .faq-list {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .faq-item {
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    
    h3 {
      color: #1a1a2e;
      margin-bottom: 1rem;
      font-size: 1.25rem;
    }
    
    p {
      color: #4a5568;
      line-height: 1.6;
      margin: 0;
    }
  }
}

@media (max-width: 768px) {
  .blog-header {
    padding: 2rem 0 1rem;
    
    h1 {
      font-size: 2rem;
    }
    
    .blog-meta {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
  
  .blog-content {
    padding: 2rem 1rem;
  }
  
  .blog-faq {
    padding: 2rem 0;
    
    h2 {
      font-size: 2rem;
    }
    
    .faq-item {
      padding: 1.5rem;
    }
  }
}
</style>